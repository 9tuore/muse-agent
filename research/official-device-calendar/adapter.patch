+fn calendar_device_ms(value){
+    let epoch = calendar_iso_epoch(value)
+    if epoch == nil { return nil }
+    let day = page_time_floor(epoch / 86400)
+    let second = page_time_floor(epoch - day * 86400)
+    let fraction = "000" let parts = value.split(".")
+    if parts.len() == 2 {
+        let digits = parts[1].split("Z")[0].split("+")[0].split("-")[0].to_chars()
+        let chars = "".to_chars() let zero = "0".to_chars()[0]
+        for i in 3 { if i < digits.len() { chars.push(digits[i]) } else { chars.push(zero) } }
+        fraction = chars.to_string()
+    }
+    return day * 86400000 + second * 1000 + fraction.to_f64()
+}
+
+fn calendar_device_iso(ms){
+    let epoch = ms / 1000
+    let day = page_time_floor(epoch / 86400)
+    let second = page_time_floor(epoch - day * 86400)
+    let fraction = ms - day * 86400000 - second * 1000
+    let value = core_utc_iso(epoch)
+    if fraction == 0 { return value }
+    let digits = "" + fraction
+    if fraction < 100 { digits = "0" + digits }
+    if fraction < 10 { digits = "0" + digits }
+    return value.split("Z")[0] + "." + digits + "Z"
+}
+
+fn calendar_device_event(event,id){
+    if !event.is_object() || !event["id"].is_string() || event.id == ""
+        || !event["revision"].is_string() || event.revision == ""
+        || !event["start_ms"].is_number() || !event["end_ms"].is_number()
+        || event.end_ms <= event.start_ms || !event["title"].is_string()
+        || !event["timezone"].is_string() || !event["location"].is_string()
+        || !event["notes"].is_string() || !event["all_day"].is_bool()
+        || !event["recurring"].is_bool() || !event["has_attendees"].is_bool() { return nil }
+    return {id: event.id calendar_id: id version: event.revision title: event.title
+        start: calendar_device_iso(event.start_ms) end: calendar_device_iso(event.end_ms)
+        time_zone: event.timezone location: event.location notes: event.notes
+        all_day: event.all_day recurring: event.recurring has_attendees: event.has_attendees}
+}
+
+fn calendar_device_status(callback){
+    host.request("device_calendar.permission.status",{},fn(r){
+        if !r.is_ok || !r.data.is_object() || !r.data["supported"].is_bool()
+            || !r.data["app_consent"].is_bool() || !r.data["os_permission"].is_string() {
+            callback({is_ok: false error: "官方 Shell 未返回有效系统日历状态。"}) return
+        }
+        let permission = "unavailable"
+        if r.data.supported {
+            permission = r.data.os_permission
+            if permission == "granted" { permission = "full_access" }
+            if !r.data.app_consent { permission = "not_determined" }
+        }
+        if permission != "full_access" { callback({is_ok: true data: {permission: permission calendars: []}}) return }
+        host.request("device_calendar.calendars.list",{},fn(list){
+            if !list.is_ok || !list.data.is_object() || !list.data["calendars"].is_array()
+                || list.data.calendars.len() > 64 { callback({is_ok: false error: "官方系统日历列表未能读取。"}) return }
+            let calendars = []
+            for cal in list.data.calendars {
+                if !cal.is_object() || !cal["id"].is_string() || cal.id == ""
+                    || !cal["account"].is_string() || !cal["name"].is_string()
+                    || !cal["account_name"].is_string() || !cal["writable"].is_bool() {
+                    callback({is_ok: false error: "官方日历返回了无效账号或日历标识。"}) return
+                }
+                calendars.push({id: cal.id title: cal.name account: cal.account account_name: cal.account_name writable: cal.writable})
+            }
+            callback({is_ok: true data: {permission: "full_access" calendars: calendars}})
+        })
+    })
+}
 
