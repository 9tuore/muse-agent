if value=="Goal created"{return "目标已创建"}
if value=="Plan approved"{return "计划已批准"}
if value=="model called"{return "模型已调用"}
if value=="storage write"{return "存储已写入"}
if value=="readback"{return "回读已核验"}
if value=="restart restore"{return "重启后恢复"}
if value=="mail accepted"||value=="MAIL_SEND_ACCEPTED"||value=="MAIL_ACCEPTED"{return "邮件服务已受理"}
if value=="mail verified"||value=="MAIL_DELIVERY_CONFIRMED"||value=="MAIL_DELIVERY_USER_CONFIRMED"{return "本人已核对收件端"}
if value=="calendar write"{return "系统日历已受理"}
if value=="calendar readback"{return "系统日历已读回"}
if value=="calendar permission"{return "日历权限状态"}
if value=="MAIL_INCOMING"{return "新来信待处理"}
if value=="MAIL_REPLY_DECLINED"{return "已选择不予回复"}
if value=="mail read"{return "邮件正文已读取"}
if value=="mail sync"{return "邮箱已同步"}
if value=="PRECONDITION_REFRESH"{return "批准前重新检查日历"}
if value=="STALE_APPROVAL"{return "旧批准已失效，需重新审阅"}
if value=="EXTERNAL_STATE_CHANGED"{return "系统日历状态已变化"}
if value=="MODEL_RESULT_STALE"{return "迟到的模型结果已丢弃"}
if value=="UNKNOWN_EXTERNAL_RESULT"{return "外部动作结果未知，需对账"}
if value=="MAIL_DRAFT_CREATED"{return "邮件草稿已创建"}
if value=="MAIL_SEND_CONFIRMED"{return "邮件发送已单独确认"}
if value=="memory saved"{return "来源记忆已保存"}
if value=="memory corrected"{return "记忆已更正"}
if value=="memory pinned"{return "记忆固定状态已更新"}
if value=="memory deleted"{return "记忆已删除"}
