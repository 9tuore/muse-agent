if technical_open{Label{width:Fill text:"收信时间 · "+alert.date draw_text.color:muted draw_text.wrap:Words draw_text.text_style.font_size:11}}
if alert.to_json().search("\"source_body\":")>=0{
let body=alert.source_body
if body.trim()==""{body="（这封邮件没有文字正文）"}
if mail_original_open==alert.key{
ScrollYView{width:Fill height:"clamp(64px,22cqh,220px)" flow:Down
Label{width:Fill text:body draw_text.color:ink draw_text.wrap:Words draw_text.text_style.font_size:13}
}
Secondary{text:"收起原邮件" on_click: ||{mail_original_open="";mail_watch_refresh()}}
}else{
Label{width:Fill text:mail_body_preview(body)draw_text.color:ink draw_text.wrap:Words draw_text.text_style.font_size:13}
if body.to_chars().len()>60{Secondary{text:"展开原邮件全文" on_click: ||{mail_original_open=alert.key;mail_watch_refresh()}}}
}
}else{
Label{width:Fill text:"正在读取正文，或正文尚未加载。" draw_text.color:muted draw_text.wrap:Words draw_text.text_style.font_size:12}
Secondary{text:"重新读取正文" on_click: ||mail_watch_read_body(alert.key)}
if alert.to_json().search("\"body_error\":")>=0&&alert.body_error!=""{Label{width:Fill text:alert.body_error draw_text.color:#xff9c94 draw_text.wrap:Words}}
}
if alert["calendar_result"]!=nil{
Label{width:Fill text:calendar_alert_time(alert)draw_text.color:ink draw_text.wrap:Words}
if alert["goal_id"]!=nil&&calendar_observation_note(alert.goal_id)!=""{Label{width:Fill text:calendar_observation_note(alert.goal_id)draw_text.color:muted draw_text.wrap:Words draw_text.text_style.font_size:11}}
Label{width:Fill text:"下一步：检查回复后确认发送。" draw_text.color:muted draw_text.wrap:Words}
}
if alert["analysis"]!=nil{
Label{width:Fill text:alert.analysis.summary draw_text.color:ink draw_text.wrap:Words}
if alert.analysis.question!=""{Label{width:Fill text:alert.analysis.question draw_text.color:blue draw_text.wrap:Words}}
if alert.analysis.kind=="appointment"||alert.analysis.kind=="reschedule"{
Secondary{text:"处理这次约定" on_click: ||mail_analysis_calendar(alert.key)}
}
}
if alert.status=="new"{
Secondary{text:"回复这封邮件" on_click: ||mail_watch_reply(alert.key)}
}
if alert.status=="new"||alert.status=="intent"||alert.status=="draft_ready"||alert.status=="waiting_user"{
Secondary{text:"不予回复" on_click: ||mail_watch_dismiss(alert.key)}
}
if alert.status=="intent"||alert.status=="draft_ready"||alert.status=="waiting_user"{
Label{width:Fill text:"你想怎么回复？" draw_text.color:muted draw_text.wrap:Words draw_text.text_style.font_size:13}
mail_reply_intent_page:=TextInput{width:Fill height:90 text:alert.intent empty_text:"写下你的决定，或直接写回复正文" on_change: ||mail_watch_intent(alert.key,ui.mail_reply_intent_page.text())}
if!mail_pending&& !mail_model_pending&& !mail_sending&&alert.status=="intent"{Primary{text:"按我的意思起草回复" on_click: ||mail_watch_generate(alert.key)}}
if mail_pending||mail_model_pending||mail_sending{Label{width:Fill text:"正在处理，请等待；不会自动发送。" draw_text.color:muted draw_text.wrap:Words draw_text.text_style.font_size:11}}
}
if!mail_pending&& !mail_model_pending&& !mail_sending&&(alert.status=="new"||alert.status=="intent"||alert.status=="draft_ready"||alert.status=="waiting_user"){
Secondary{text:"自己写回复（不调用 AI）" on_click: ||mail_watch_manual(alert.key)}
}
let draft=mail_watch_draft(alert.key)
if draft!=nil&&(alert.status=="draft_ready"||alert.status=="waiting_user"||(alert.status=="intent"&&draft.body!="")){
Label{width:Fill text:"回复草稿" draw_text.color:ink draw_text.wrap:Words draw_text.text_style.font_size:12}
let account=mail_watch_account(draft.account)
if account!=nil{Label{width:Fill text:"发送账号 · "+account.address draw_text.color:muted draw_text.wrap:Words draw_text.text_style.font_size:11}}
Label{width:Fill text:"收件人 · "+draft.to draw_text.color:ink draw_text.wrap:Words draw_text.text_style.font_size:12}
Label{width:Fill text:"主题 · "+mail_watch_subject(draft.subject)draw_text.color:ink draw_text.wrap:Words draw_text.text_style.font_size:12}
mail_reply_body_page:=TextInput{width:Fill height:142 is_multiline:true text:draft.body
on_change: ||mail_watch_edit_body(alert.key,ui.mail_reply_body_page.text())}
if!mail_pending&& !mail_model_pending&& !mail_sending{
if alert.status!="intent"{Primary{text:"确认发送" on_click: ||mail_watch_send(alert.key,draft)}}
Secondary{text:"重新起草" on_click: ||mail_watch_again(alert.key)}
if draft["proposed"]!=nil{
