Label{visible:false width:Fill text:"Muse 与 OctoSense 保持运行时自动查看新邮件；关闭应用后停止。首次启用记录基线，不重复提醒历史邮件。" draw_text.color:muted draw_text.wrap:Words draw_text.text_style.font_size:11}
