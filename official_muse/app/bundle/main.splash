if mail_draft.incoming_key==alert.key&&mail_error!=""{Label{width:Fill text:mail_error draw_text.color:#xff9c94 draw_text.wrap:Words draw_text.text_style.font_size:11}}
if mail_reply_error!=""{Label{width:Fill text:mail_reply_error draw_text.color:#xff9c94 draw_text.wrap:Words draw_text.text_style.font_size:11}}
}
