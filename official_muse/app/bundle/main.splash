fn activity_visible(kind){
for value in["Goal created","MAIL_INCOMING","MAIL_REPLY_DECLINED","MAIL_DRAFT_CREATED",
"MAIL_SEND_ACCEPTED","MAIL_ACCEPTED","mail accepted","calendar readback",
"memory saved","memory corrected","memory pinned","memory deleted","readback","error",
"STALE_APPROVAL","EXTERNAL_STATE_CHANGED","UNKNOWN_EXTERNAL_RESULT"]{
if kind==value{return true}
}
return false
}
fn activity_summary(kind){
if kind=="readback"{return "结果已核对"}
if kind=="MAIL_INCOMING"{return "收到邮件"}
if kind=="MAIL_SEND_ACCEPTED"||kind=="MAIL_ACCEPTED"||kind=="mail accepted"{return "回复已发送，等待投递确认"}
if kind=="calendar readback"{return "日程已核对"}
if kind=="UNKNOWN_EXTERNAL_RESULT"{return "操作结果待核对"}
if kind=="STALE_APPROVAL"||kind=="EXTERNAL_STATE_CHANGED"{return "日程有变化，需要重新确认"}
return event_name(kind)
}

