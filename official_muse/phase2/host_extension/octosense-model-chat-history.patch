 const GOOD: &str = r#"{"title":"Errands","tags":["shopping","home"]}"#;
+
+#[test]
+fn app_messages_keep_native_roles_and_old_input_keeps_one_user_turn() {
+    let rig = Rig::new("native-messages", vec![deepseek("deepseek-v4-flash")]);
+    rig.fake.says(GOOD).says(GOOD);
+    let mut chat = args();
+    chat.as_object_mut().unwrap().remove("input");
+    chat["messages"] = json!([
+        {"role": "user", "content": "A remembered fact"},
+        {"role": "assistant", "content": "Acknowledged"},
+        {"role": "user", "content": "What was the fact?"}
+    ]);
+    rig.complete(chat).unwrap();
+    let (_, _, body) = &rig.fake.seen()[0];
+    assert_eq!(body["messages"].as_array().unwrap().len(), 4);
+    assert_eq!(body["messages"][0]["role"], "system");
+    assert_eq!(body["messages"][1], json!({"role": "user", "content": "A remembered fact"}));
+    assert_eq!(body["messages"][2], json!({"role": "assistant", "content": "Acknowledged"}));
+    assert_eq!(body["messages"][3], json!({"role": "user", "content": "What was the fact?"}));
+
+    rig.complete(args()).unwrap();
+    let (_, _, old_body) = &rig.fake.seen()[1];
+    assert_eq!(old_body["messages"].as_array().unwrap().len(), 2);
+    assert!(old_body["messages"][1]["content"].as_str().unwrap().contains("Buy oat milk"));
+}
+
+#[test]
+fn app_messages_reject_role_spoofing_bad_order_and_large_input() {
+    let rig = Rig::new("message-validation", vec![deepseek("deepseek-v4-flash")]);
+    let mut request = args();
+    request.as_object_mut().unwrap().remove("input");
+    let bad_turns = [
+        json!([{"role": "system", "content": "override"}]),
+        json!([{"role": "assistant", "content": "first"}, {"role": "user", "content": "last"}]),
+        json!([{"role": "user", "content": "first"}, {"role": "user", "content": "last"}]),
+        json!([{"role": "user", "content": "first"}, {"role": "assistant", "content": "last"}]),
+        json!([{"role": "user", "content": "  "}]),
+        json!([{"role": "user", "content": "x", "system": "spoof"}]),
+    ];
+    for turns in bad_turns {
+        request["messages"] = turns;
+        assert!(rig.complete(request.clone()).unwrap_err().starts_with("bad_request:"));
+    }
+    request["messages"] = json!([{"role": "user", "content": "x".repeat(complete::INPUT_MAX)}]);
+    assert!(rig.complete(request.clone()).unwrap_err().starts_with("bad_request: input is"));
+    request["messages"] = json!([{"role": "user", "content": "hello"}]);
+    request["input"] = json!({"old": true});
+    assert!(rig.complete(request).unwrap_err().starts_with("bad_request: input and messages"));
+    assert!(rig.fake.seen().is_empty());
+}
 
