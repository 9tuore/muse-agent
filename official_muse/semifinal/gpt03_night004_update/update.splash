// Native Calendar mutations retain the creation proof and advance the local plan.
let calendar_agent_update_state = {schema: 1 records: []}
let calendar_agent_update_writable = true
let calendar_agent_update_selected = ""
let calendar_agent_update_epoch = 0
fn calendar_agent_event_json(event){
    return "{\"end\":" + event.end.to_json() + ",\"id\":" + event.id.to_json()
        + ",\"location\":" + event.location.to_json() + ",\"notes\":" + event.notes.to_json()
        + ",\"request_id\":" + event.request_id.to_json() + ",\"start\":" + event.start.to_json()
        + ",\"timezone\":" + event.timezone.to_json() + ",\"title\":" + event.title.to_json() + "}"
}
fn calendar_agent_update_args(expected,event){
    // Exact official DTO: no top-level request_id, all replacement fields present.
    let text = "{\"end\":" + event.end.to_json() + ",\"expected\":" + calendar_agent_event_json(expected)
        + ",\"id\":" + expected.id.to_json() + ",\"location\":" + event.location.to_json()
        + ",\"notes\":" + event.notes.to_json() + ",\"start\":" + event.start.to_json()
        + ",\"timezone\":" + event.timezone.to_json() + ",\"title\":" + event.title.to_json() + "}"
    return {json: text get_digest: "sha256:" + fs.sha256("{\"id\":" + expected.id.to_json() + "}")
        update_digest: "sha256:" + fs.sha256(text)}
}
fn calendar_agent_update_index(binding){
    if !calendar_agent_binding_valid(binding) || binding.receipt_status != "verified" { return -1 }
    let index = -1
    for i in calendar_agent_update_state.records.len() {
        let record = calendar_agent_update_state.records[i]
        if record.creation_request_id == binding.payload.request_id && record.expected.id == binding.verification.event_id { index = i }
    }
    return index
}
fn calendar_agent_update_id_index(id){
    for i in calendar_agent_update_state.records.len() { if calendar_agent_update_state.records[i].request_id == id { return i } }
    return -1
}
fn calendar_agent_update_card_json(binding){
    let i = chat_session_index(binding.session_id)
    if i < 0 || !gm_array(chat_sessions[i]["proposals"]) { return "" }
    for card in chat_sessions[i].proposals { if card.id == binding.candidate_id { return card.to_json() } }
    return ""
}
fn calendar_agent_update_valid(record){
    if !gm_object(record) || !calendar_agent_binding_valid(record["creation_binding"])
        || record.creation_binding.receipt_status != "verified" || !calendar_agent_binding_valid(record["binding"])
        || record.binding.receipt_status != "unknown" || !gm_object(record["expected"]) || !gm_object(record["event"]) { return false }
    for event in [record.expected,record.event] {
        for key in ["id","title","start","end","timezone","location","notes","request_id"] {
            if !gm_string(event[key],600) { return false }
        }
    }
    for key in ["request_id","creation_request_id","creation_turn_id"] {
        if !gm_string(record[key],160) || record[key] == "" { return false }
    }
    if !gm_string(record["turn_id"],160) || !gm_string(record["prior_update_request_id"],160)
        || !gm_string(record["goal_json"],50000) || !gm_string(record["prior_goal_json"],50000)
        || !gm_string(record["creation_card_json"],12000) || !gm_string(record["candidate_card_json"],12000)
        || !gm_number(record["prior_revision"])
        || record.binding.plan_revision != record.prior_revision + 1
        || record.creation_request_id != record.creation_binding.payload.request_id
        || record.binding.payload.request_id != record.creation_request_id { return false }
    for key in ["goal_id","project_id","owner_id","user_id","accounts","account_id","session_id"] {
        if record.creation_binding[key] != record.binding[key] { return false }
    }
    let creation_card = record.creation_card_json.parse_json() let candidate_card = record.candidate_card_json.parse_json()
    if !gm_object(creation_card) || !gm_object(candidate_card)
        || creation_card["id"] != record.creation_binding.candidate_id || creation_card["revision"] != record.creation_binding.candidate_revision
        || creation_card["payload"].to_json() != record.creation_binding.candidate_json
        || candidate_card["id"] != record.binding.candidate_id || candidate_card["revision"] != record.binding.candidate_revision
        || candidate_card["payload"].to_json() != record.binding.candidate_json { return false }
    let prior = calendar_agent_delete_expected(record.creation_binding)
    if record.prior_update_request_id == "" {
        if record.prior_revision != record.creation_binding.plan_revision { return false }
    } else {
        let i = calendar_agent_update_id_index(record.prior_update_request_id)
        let current = calendar_agent_update_id_index(record.request_id)
        if i < 0 || current < 0 || i >= current { return false }
        let previous = calendar_agent_update_state.records[i]
        if previous.receipt_status != "verified" || previous.creation_request_id != record.creation_request_id
            || previous.creation_turn_id != record.creation_turn_id || previous.creation_binding.to_json() != record.creation_binding.to_json()
            || previous.binding.plan_revision != record.prior_revision || !gm_object(previous["verification"])
            || !calendar_agent_event_matches(previous.verification["event"],previous.event)
            || previous.verification.event.id != previous.event.id { return false }
        prior = previous.event
    }
    if prior == nil || calendar_agent_event_json(prior) != calendar_agent_event_json(record.expected) { return false }
    // Both snapshots contain exactly the eight authoritative fields.
    for event in [record.expected,record.event] {
        if event.to_json().parse_json().to_json() != event.to_json()
            || calendar_agent_event_json(event).parse_json().to_json() != event.to_json() { return false }
    }
    if record.event.id != record.expected.id || record.event.request_id != record.creation_request_id
        || record.event.notes != record.expected.notes || !calendar_agent_event_matches(record.event,record.binding.payload)
        || !gm_string(record.event.title,80) || !gm_string(record.event.location,120)
        || record.event.timezone != "Asia/Shanghai" || record.event.end == ""
        || record.expected.start == "" || record.expected.end == "" { return false }
    // Stored evidence stays valid after the meeting date. Future-time policy is
    // checked when preparing a new candidate, never when loading old proof.
    let payload = record.binding.candidate_json.parse_json()
    if !gm_object(payload) { return false }
    for key in ["title","start","end","time_zone","location"] { if !gm_string(payload[key],200) { return false } }
    let start = calendar_iso_epoch(payload.start) let end = calendar_iso_epoch(payload.end)
    if start == nil || end == nil || end <= start || start != floor(start / 60) * 60 || end != floor(end / 60) * 60
        || payload.time_zone != "Asia/Shanghai" || record.event.title != payload.title.trim()
        || record.event.start != calendar_agent_wall(payload.start) || record.event.end != calendar_agent_wall(payload.end)
        || record.event.timezone != payload.time_zone || record.event.location != payload.location.trim() { return false }
    let goal = record.goal_json.parse_json()
    let prior_goal = record.prior_goal_json.parse_json()
    if !gm_object(goal) || !gm_object(prior_goal) || prior_goal["id"] != record.binding.goal_id || prior_goal["version"] != record.prior_revision
        || prior_goal["source"] != goal["source"] || prior_goal["project_id"] != goal["project_id"]
        || prior_goal["owner_id"] != goal["owner_id"] || prior_goal["mail_source"].to_json() != goal["mail_source"].to_json() { return false }
    if !gm_object(goal) || goal["id"] != record.binding.goal_id || goal["version"] != record.binding.plan_revision
        || goal["status"] != "planned" || goal["archived"] != false || goal["approved_at"] != 0 { return false }
    let args = calendar_agent_update_args(record.expected,record.event)
    if record["get_digest"] != args.get_digest || record["update_digest"] != args.update_digest { return false }
    if record["status"] != "prepared" && record["status"] != "in_flight" && record["status"] != "blocked"
        && record["status"] != "unknown" && record["status"] != "turn_completed" { return false }
    if record["receipt_status"] != "unknown" && record["receipt_status"] != "accepted"
        && record["receipt_status"] != "failed" && record["receipt_status"] != "verified" { return false }
    if record.status == "turn_completed" && record.turn_id == "" { return false }
    if record.receipt_status == "verified" {
        let proof = record["verification"]
        if record.status != "turn_completed" || !gm_object(proof) || proof["status"] != "verified"
            || proof["event_id"] != record.event.id || !calendar_agent_event_matches(proof["event"],record.event)
            || proof.event.id != record.event.id || !gm_string(proof["session_id"],256) || proof.session_id == "" { return false }
        let ids = [] let tools = []
        for key in ["before_get_call_id","update_call_id","after_get_call_id"] {
            if !gm_string(proof[key],256) || proof[key] == "" { return false }
            for id in ids { if id == proof[key] { return false } } ids.push(proof[key])
        }
        for key in ["before_tool_call_id","update_tool_call_id","after_tool_call_id"] {
            if !gm_string(proof[key],256) || proof[key] == "" { return false }
            for id in tools { if id == proof[key] { return false } } tools.push(proof[key])
        }
    }
    return true
}
fn calendar_agent_update_current(record){
    let binding = calendar_agent_state["binding"]
    if !calendar_agent_update_writable || !calendar_agent_writable || !calendar_agent_update_valid(record)
        || calendar_agent_state.status != "turn_completed" || calendar_agent_state.request_id != record.creation_request_id
        || calendar_agent_state.turn_id != record.creation_turn_id || binding == nil
        || binding.to_json() != record.creation_binding.to_json()
        || !calendar_agent_binding_at_revision(record.creation_binding,record.binding.plan_revision)
        || !calendar_agent_binding_current(record.binding)
        || calendar_agent_update_card_json(record.creation_binding) != record.creation_card_json
        || calendar_agent_update_card_json(record.binding) != record.candidate_card_json { return false }
    let goal = ac_current_goal()
    return goal != nil && goal.to_json() == record.goal_json && goal.status == "planned"
}
fn calendar_agent_authority(){
    let binding = calendar_agent_state["binding"]
    if !calendar_agent_update_writable || calendar_agent_state.status != "turn_completed" || calendar_agent_state.turn_id == ""
        || !calendar_agent_binding_valid(binding) || binding.receipt_status != "verified"
        || binding.payload.request_id != calendar_agent_state.request_id { return nil }
    let i = calendar_agent_update_index(binding)
    if i >= 0 {
        let record = calendar_agent_update_state.records[i]
        if record.receipt_status != "verified" || !calendar_agent_update_current(record) { return nil }
        return {creation_request_id: record.creation_request_id creation_turn_id: record.creation_turn_id
            binding: record.creation_binding.to_json().parse_json() current_binding: record.binding.to_json().parse_json()
            event: record.event.to_json().parse_json() revision: record.binding.plan_revision update: record.to_json().parse_json()}
    }
    if !calendar_agent_binding_current(binding) { return nil }
    let event = calendar_agent_delete_expected(binding)
    if event == nil { return nil }
    return {creation_request_id: calendar_agent_state.request_id creation_turn_id: calendar_agent_state.turn_id
        binding: binding.to_json().parse_json() current_binding: binding.to_json().parse_json()
        event: event revision: binding.plan_revision}
}
fn calendar_agent_authority_valid(authority){
    if !gm_object(authority) || !calendar_agent_binding_valid(authority["binding"])
        || authority.binding.receipt_status != "verified" || !calendar_agent_binding_valid(authority["current_binding"])
        || !gm_object(authority["event"]) || authority["creation_request_id"] != authority.binding.payload.request_id
        || !gm_string(authority["creation_turn_id"],160) || authority.creation_turn_id == ""
        || authority["revision"] != authority.current_binding.plan_revision { return false }
    if gm_has(authority,"update") {
        let record = authority.update
        return calendar_agent_update_valid(record) && record.receipt_status == "verified"
            && record.creation_request_id == authority.creation_request_id && record.creation_turn_id == authority.creation_turn_id
            && record.creation_binding.to_json() == authority.binding.to_json()
            && record.binding.to_json() == authority.current_binding.to_json()
            && record.event.to_json() == authority.event.to_json()
    }
    let expected = calendar_agent_delete_expected(authority.binding)
    return expected != nil && authority.current_binding.to_json() == authority.binding.to_json()
        && expected.to_json() == authority.event.to_json()
}
fn calendar_agent_authority_current(authority){
    let current = calendar_agent_authority()
    return calendar_agent_authority_valid(authority) && current != nil && current.to_json() == authority.to_json()
}
fn calendar_agent_update_save(){
    if !calendar_agent_update_writable || calendar_agent_update_state.records.len() > 32 { return false }
    let ids = {}
    for record in calendar_agent_update_state.records {
        if !calendar_agent_update_valid(record) || ids[record.request_id] != nil { calendar_agent_update_writable = false return false }
        ids[record.request_id] = true
    }
    let text = calendar_agent_update_state.to_json()
    if storage_write("calendar-agent-update.json",text) != nil || storage_read("calendar-agent-update.json") != text {
        calendar_agent_update_writable = false calendar_agent_notice = "改期记录保存或回读失败，已停止派发；原记录保留。" return false
    }
    return true
}
fn calendar_agent_update_boot(){
    calendar_agent_update_selected = ""
    if !fs.exists("calendar-agent-update.json") { return }
    let saved = storage_read("calendar-agent-update.json").parse_json()
    if !gm_object(saved) || saved["schema"] != 1 || !gm_array(saved["records"]) || saved.records.len() > 32 {
        calendar_agent_update_writable = false return
    }
    calendar_agent_update_state = saved
    let interrupted = false let ids = {}
    for i in saved.records.len() {
        let record = saved.records[i]
        if !calendar_agent_update_valid(record) || ids[record.request_id] != nil { calendar_agent_update_writable = false return }
        ids[record.request_id] = true
        if record.status == "in_flight" || record.status == "prepared" {
            calendar_agent_update_state.records[i].status = "unknown" interrupted = true
        }
    }
    if interrupted { calendar_agent_update_save() }
}
fn calendar_agent_update_target(){
    let authority = calendar_agent_authority() let binding = calendar_agent_candidate
    if authority == nil || !calendar_agent_update_writable || !calendar_agent_writable || calendar_agent_busy
        || calendar_agent_delete_blocks(authority.binding) || !calendar_agent_binding_current(binding)
        || chat_payload_error("calendar_candidate",binding.candidate_json.parse_json()) != ""
        || calendar_agent_update_state.records.len() >= 32 { return nil }
    for key in ["goal_id","project_id","owner_id","user_id","accounts","account_id","session_id","plan_revision"] {
        if authority.current_binding[key] != binding[key] { return nil }
    }
    let event = authority.event.to_json().parse_json()
    for key in ["title","start","end","timezone","location"] { event[key] = binding.payload[key] }
    if event.to_json() == authority.event.to_json() { return nil }
    return {authority: authority candidate: binding.to_json().parse_json() event: event}
}
fn calendar_agent_update_hold_mail(){
    if !gm_has(mail_draft,"official_calendar") { return true }
    let context = {request_id: mail_draft.request_id}
    if mail_draft.status == "sending" { mail_calendar_hold(context) return mail_draft_writable }
    if mail_draft.status == "waiting_user" || mail_draft.status == "DRAFT" {
        mail_draft.status = "DRAFT" mail_draft.preview = ""
        mail_error = "日历改期已准备；原文保留，旧审阅失效。请核对新事件后另行准备草稿。"
        return mail_save()
    }
    return true
}
fn calendar_agent_update_select(){
    let target = calendar_agent_update_target()
    if target == nil { calendar_agent_notice = "请本人选择当前已核验事件及同一事项的新候选；未知改期不能重发。" redraw() return }
    let prior_goal_json = ac_current_goal().to_json()
    let goal = prior_goal_json.parse_json()
    goal.version = goal.version + 1 goal.status = "planned" goal.approved_at = 0 goal.archived = false
    goal.updated_at = time_now() goal.result_path = "results/" + goal.id + "-v" + goal.version + ".json"
    // Clear a previous exact plan payload; identity, source and goal history stay in place.
    goal.goal_spec = nil goal.model_summary = ""
    let record = {request_id: "muse-calendar-update-" + floor(time_now()) + "-" + random_u32()
        turn_id: "" status: "prepared" receipt_status: "unknown"
        creation_request_id: target.authority.creation_request_id creation_turn_id: target.authority.creation_turn_id
        creation_binding: target.authority.binding binding: target.candidate expected: target.authority.event
        creation_card_json: calendar_agent_update_card_json(target.authority.binding) candidate_card_json: calendar_agent_update_card_json(target.candidate)
        event: target.event prior_revision: target.authority.revision prior_update_request_id: "" goal_json: goal.to_json() prior_goal_json: prior_goal_json}
    if gm_has(target.authority,"update") { record.prior_update_request_id = target.authority.update.request_id }
    record.binding.plan_revision = goal.version record.binding.payload.notes = record.expected.notes
    record.binding.payload.request_id = record.creation_request_id
    let args = calendar_agent_update_args(record.expected,record.event)
    record.get_digest = args.get_digest record.update_digest = args.update_digest
    let index = calendar_agent_update_state.records.len()
    calendar_agent_update_state.records.push(record)
    calendar_agent_delete_selected = ""
    if !calendar_agent_update_save() { redraw() return }
    if !calendar_agent_update_hold_mail() || !core_replan_goal(record.binding.goal_id,goal) || !calendar_agent_update_current(record) {
        calendar_agent_update_state.records[index].status = "blocked" calendar_agent_update_save()
        calendar_agent_notice = "改期计划或旧草稿未可靠保存，未派发；原记录保留，不自动重试。" redraw() return
    }
    calendar_agent_update_selected = record.to_json()
    calendar_agent_candidate = record.binding.to_json().parse_json()
    calendar_agent_notice = "已冻结原事件ID和八字段、新候选及计划版本；请核对后明确确认改期，宿主仍须本人批准。"
    redraw()
}
fn calendar_agent_update_confirm(){
    if calendar_agent_busy || !calendar_agent_update_writable || calendar_agent_update_selected == "" { return }
    let selected = calendar_agent_update_selected.parse_json() let index = calendar_agent_update_id_index(selected["request_id"])
    if index < 0 { return }
    let record = calendar_agent_update_state.records[index]
    if record.status != "prepared" || record.to_json() != calendar_agent_update_selected || !calendar_agent_update_current(record) {
        calendar_agent_update_selected = "" calendar_agent_notice = "改期选择、身份或计划已变化，未派发；原记录保留。" redraw() return
    }
    record.status = "in_flight" calendar_agent_update_selected = ""
    if !calendar_agent_update_save() { redraw() return }
    let id = record.request_id let snapshot = record.to_json()
    calendar_agent_busy = true calendar_agent_notice = "正在提交所选事件的同ID改期请求。" redraw()
    host.request("octos.session.open",{},fn(opened){
        if index >= calendar_agent_update_state.records.len() || calendar_agent_update_state.records[index].request_id != id
            || calendar_agent_update_state.records[index].to_json() != snapshot { return }
        if !opened.is_ok || !gm_object(opened["data"]) || opened.data["open"] != true || !calendar_agent_update_current(record) {
            calendar_agent_busy = false calendar_agent_update_state.records[index].status = "blocked"
            calendar_agent_update_save() calendar_agent_notice = "改期前身份、候选或会话已变化，未派发；不重发。" redraw() return
        }
        let args = calendar_agent_update_args(record.expected,record.event)
        let prompt = "本人明确选择并确认将已核验事件同ID改期。改期请求ID：" + id
            + "。只使用以下三次官方Calendar调用，严格按顺序，不新增、删除、通知或发邮件，不换ID，不改expected。"
            + "\n1. calendar.get_event 参数：" + {id: record.expected.id}.to_json()
            + "。只有found=true且event八字段逐字等于expected才继续；不一致就停止。expected：" + calendar_agent_event_json(record.expected)
            + "\n2. calendar.update_event 精确参数：" + args.json
            + "。由本人在宿主批准，取消、失败或未知立即停止，不重试。返回data.event必须等于新八字段：" + calendar_agent_event_json(record.event)
            + "\n3. 仅成功后再用同一个id调用calendar.get_event，核对found=true及新八字段。模型文字不算执行回执。"
        host.request("octos.turn.start",{text: prompt trigger: "app"},fn(r){
            if index >= calendar_agent_update_state.records.len() || calendar_agent_update_state.records[index].request_id != id
                || calendar_agent_update_state.records[index].to_json() != snapshot { return }
            calendar_agent_busy = false calendar_agent_update_state.records[index].status = "unknown"
            if r.is_ok && gm_object(r["data"]) && gm_string(r.data["turn_id"],160) && r.data.turn_id != "" {
                calendar_agent_update_state.records[index].turn_id = r.data.turn_id
                if calendar_agent_update_current(record) { calendar_agent_update_state.records[index].status = "turn_completed" }
            }
            calendar_agent_notice = "改期结果按原回合的三条官方回执核对；未知不重发，事项未整体完成。"
            if calendar_agent_update_save() && calendar_agent_update_state.records[index].status == "turn_completed" { calendar_agent_update_history(index) }
            redraw()
        })
    })
}
fn calendar_agent_update_result(rows,record){
    let result = {status: "unknown"}
    if !calendar_agent_update_current(record) || record.turn_id == "" || !gm_array(rows) || rows.len() > 200 { return result }
    let phase = 0 let uncertain = false let failed = false let session = ""
    let before = "" let updated = "" let after = "" let before_tool = "" let update_tool = "" let after_tool = ""
    for row in rows {
        if gm_object(row) {
        let turn = row["turn_id"] if turn == nil { turn = row["thread_id"] }
        let tool = calendar_agent_tool_name(row["tool_name"])
        if row["role"] == "tool" && row["lane"] == "person" && turn == record.turn_id
            && (row["thread_id"] == nil || row.thread_id == turn) && tool != "" {
            let receipt = row["host_calendar_receipt"] let terminal = calendar_agent_delete_receipt(row,record)
            let digest = record.get_digest if tool == "calendar.update_event" { digest = record.update_digest }
            if (tool != "calendar.get_event" && tool != "calendar.update_event") || !gm_object(receipt)
                || receipt["args_digest"] != digest || !gm_string(receipt["session_id"],256) || receipt.session_id == ""
                || !gm_string(row["tool_call_id"],256) || row.tool_call_id == ""
                || (session != "" && session != receipt.session_id) { uncertain = true }
            else if terminal == "error" || terminal == "cancelled" { failed = true }
            else if terminal != "ok" || failed { uncertain = true }
            else {
                session = receipt.session_id let data = receipt.result["data"]
                if !gm_object(data) { uncertain = true }
                else if phase == 0 && tool == "calendar.get_event" && data["found"] == true
                    && gm_object(data["event"]) && calendar_agent_event_matches(data.event,record.expected)
                    && data.event.id == record.expected.id {
                    before = receipt.call_id before_tool = row.tool_call_id phase = 1
                } else if phase == 1 && tool == "calendar.update_event" && gm_object(data["event"])
                    && calendar_agent_event_matches(data.event,record.event) && data.event.id == record.event.id
                    && receipt.call_id != before && row.tool_call_id != before_tool {
                    updated = receipt.call_id update_tool = row.tool_call_id phase = 2
                } else if phase == 2 && tool == "calendar.get_event" && data["found"] == true
                    && gm_object(data["event"]) && calendar_agent_event_matches(data.event,record.event) && data.event.id == record.event.id
                    && receipt.call_id != before && receipt.call_id != updated
                    && row.tool_call_id != before_tool && row.tool_call_id != update_tool {
                    after = receipt.call_id after_tool = row.tool_call_id phase = 3
                } else { uncertain = true }
            }
        }
        }
    }
    if uncertain { return result }
    if updated != "" {
        result.status = "accepted"
        if phase == 3 && !failed {
            result.status = "verified" result.event_id = record.event.id result.event = record.event.to_json().parse_json()
            result.session_id = session result.before_get_call_id = before result.update_call_id = updated result.after_get_call_id = after
            result.before_tool_call_id = before_tool result.update_tool_call_id = update_tool result.after_tool_call_id = after_tool
        }
    } else if failed { result.status = "failed" }
    return result
}
fn calendar_agent_update_history(index){
    if index < 0 || index >= calendar_agent_update_state.records.len() { return }
    let record = calendar_agent_update_state.records[index].to_json().parse_json()
    if record.receipt_status == "verified" || !calendar_agent_update_current(record) || record.turn_id == "" { return }
    calendar_agent_update_epoch = calendar_agent_update_epoch + 1
    let epoch = calendar_agent_update_epoch let snapshot = calendar_agent_update_state.records[index].to_json()
    host.request("octos.session.history",{},fn(r){
        if epoch != calendar_agent_update_epoch || index >= calendar_agent_update_state.records.len()
            || snapshot != calendar_agent_update_state.records[index].to_json() || !calendar_agent_update_current(record) { return }
        if !r.is_ok || !gm_object(r["data"]) || !gm_array(r.data["messages"]) { calendar_agent_notice = "改期回执未返回，原请求保留，不会重发。" redraw() return }
        let result = calendar_agent_update_result(r.data.messages,record)
        calendar_agent_update_state.records[index].receipt_status = result.status
        if result.status == "verified" {
            calendar_agent_update_state.records[index].status = "turn_completed"
            calendar_agent_update_state.records[index].verification = result
        }
        if !calendar_agent_update_save() { redraw() return }
        calendar_agent_notice = "同ID改期回执状态：" + ac_state(result.status) + "；三步精确核验后才使用新事件，事项未整体完成。"
        redraw()
    })
}
fn calendar_agent_update_project(view,goal){
    let i = calendar_agent_update_index(calendar_agent_state["binding"])
    if i < 0 { return false }
    let record = calendar_agent_update_state.records[i]
    if !calendar_agent_update_current(record) || record.binding.goal_id != goal.id { return false }
    let status = record.status if status == "turn_completed" { status = record.receipt_status }
    ac_add(view,"官方日历同ID改期",status,"原创建证据保留；计划版本 " + record.binding.plan_revision,record.request_id)
    if record.receipt_status == "verified" {
        ac_add(view,"改期精确读回","verified",record.event.title + " · " + record.event.start + " → " + record.event.end,record.request_id)
        view.next = "新安排已按同ID精确核验；可另行准备邮件，旧审阅失效，事项未整体完成。"
    } else { view.next = "核对原改期回执；未知不重发，旧日历快照不用于邮件或删除。" }
    calendar_agent_delete_project(view,goal)
    return true
}
