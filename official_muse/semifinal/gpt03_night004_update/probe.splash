for extra_tool in ["calendar.add_event","calendar.remove_event","calendar.events","calendar.notify"] {
    let extra=receipt_row(extra_tool,record.turn_id,"extra",record.get_digest,{})
    checks["extra_"+extra_tool+"_not_verified"]=calendar_agent_update_result([rows[0],rows[1],extra,rows[2]],record).status!="verified"
}
rows=update_rows(record) rows[1].host_calendar_receipt.session_id="kernel:other"
checks.mixed_kernel_session_rejected=calendar_agent_update_result(rows,record).status!="verified"
rows=update_rows(record) rows[1].host_calendar_receipt.session_id=""
checks.empty_kernel_session_rejected=calendar_agent_update_result(rows,record).status!="verified"
for index in 3 {
