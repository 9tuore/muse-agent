let fixture_clock = 1700000000
let fixture_serial = 0
fn time_now(){return fixture_clock}
fn random_u32(){fixture_serial=fixture_serial+1 return fixture_serial}
let fs = {exists: |path| fixture_files[path] != nil sha256: |value| mod.fixture.sha256(value)}
let checks = {}
fn seed(){
    calendar_agent_delete_state={schema:1 records:[]} calendar_agent_delete_writable=true calendar_agent_delete_selected="" calendar_agent_delete_epoch=0
    calendar_agent_update_state={schema:1 records:[]} calendar_agent_update_writable=true calendar_agent_update_selected="" calendar_agent_update_epoch=0
    mail_draft={account:"" to:"" subject:"" body:"" status:"DRAFT" preview:"" attempt:"" request_id:""
        accepted_at:0 verified_at:0 verified_id:"" link_goal_id:"" link_event_id:"" link_run_id:"" incoming_key:""}
    mail_draft_writable=true mail_draft_last_state="" mail_sending=false mail_pending=false mail_model_pending=false
    mail_accounts=[{id:"fixture-account"}] mail_account=mail_accounts[0] activity=[] core_activity_ready=true core_last_activity=""
    chat_requests=[]
    fixture_files={} fixture_write_fail=false fixture_write_fail_path="" fixture_read_fail=false fixture_pending=[]
    core_storage_ready=true gm_ready=true chat_ready=true
    gm_user_id="fixture-user" gm_accounts=["local","fixture-account"] gm_project="fixture-project" gm_owner="fixture-owner"
    goals=[] runs=[] actions=[] core_last_goals="" task=nil
    chat_selected_id="chat:fixture" ac_selected_chat=chat_selected_id ac_selected_id=""
    chat_last_state="" messages=[] page="Chat"
    chat_sessions=[{id:chat_selected_id title:"fixture" created_at:fixture_clock updated_at:fixture_clock
        messages:[] proposals:[] focus_project:gm_project focus_owner:gm_owner goal_id:""}]
    calendar_agent_state={schema:1 request_id:"" turn_id:"" status:"idle" user_id:"" accounts:"" previous_requests:[]}
    calendar_agent_busy=false calendar_agent_writable=true calendar_agent_history_settle=false
    calendar_agent_history_epoch=0 calendar_agent_candidate=nil
    calendar_agent_reply="" calendar_agent_evidence="" calendar_agent_input_text="" calendar_agent_details=false
}
fn fixture_card(){return {id:"card:fixture" action:"calendar_candidate" state:"candidate" session_id:chat_selected_id
    project:gm_project owner:gm_owner account_id:"fixture-account" revision:1
    payload:{to:"" subject:"" body:"" objective:"" source:"synthetic-mail:first:meeting"
        title:"fixture meeting" start:"2030-12-12T10:00:00+08:00" end:"2030-12-12T11:00:00+08:00" time_zone:"Asia/Shanghai" location:"fixture"}}}
fn fixture_bound(){
    let card=fixture_card()
    chat_sessions[0].proposals.push(card)
    if !calendar_agent_ensure_matter(card){return false}
    return calendar_agent_prepare_candidate(card)
}
fn fixture_turn(){
    calendar_agent_state={schema:1 request_id:"request:fixture" turn_id:"turn:fixture" status:"turn_completed"
        user_id:gm_user_id accounts:gm_accounts.to_json() previous_requests:[]}
    calendar_agent_save()
}
fn fixture_row(tool,terminal,result_ok){
    let reply={} reply["ok"]=result_ok reply.data={}
    return {role:"tool" lane:"person" turn_id:"turn:fixture" tool_name:tool tool_call_id:"tool:fixture"
    host_calendar_receipt:{source:"broker_tool_result" owner:"os.calendar" caller:"muse-goals" kernel_persisted:true
        turn_id:"turn:fixture" tool_call_id:"tool:fixture" call_id:"call:fixture" tool:tool terminal:terminal result:reply}}}

let fixture_to="" let fixture_subject="" let fixture_body=""
let ui={mail_to:{text:||fixture_to set_text:|value|{fixture_to=value}}
    mail_subject:{text:||fixture_subject set_text:|value|{fixture_subject=value}}
    mail_body:{text:||fixture_body set_text:|value|{fixture_body=value}}}
fn receipt_row(tool,turn,serial,digest,data){
    let reply={} reply["ok"]=true reply.data=data
    return {role:"tool" lane:"person" turn_id:turn thread_id:turn tool_name:tool tool_call_id:"tool:"+serial
        host_calendar_receipt:{source:"broker_tool_result" owner:"os.calendar" caller:"muse-goals" kernel_persisted:true
            turn_id:turn tool_call_id:"tool:"+serial call_id:"call:"+serial tool:calendar_agent_tool_name(tool)
            session_id:"kernel:fixture" args_digest:digest terminal:"ok" result:reply}}
}
fn verified_create(){
    if !fixture_bound(){return false}
    calendar_agent_submit_candidate()
    fixture_pending[0].callback({is_ok:true data:{open:true}})
    fixture_pending[1].callback({is_ok:true data:{turn_id:"turn:create" text:"created"}})
    let payload=calendar_agent_state.binding.payload
    let event={end:payload.end id:"event:stable" location:payload.location notes:payload.notes
        request_id:payload.request_id start:payload.start timezone:payload.timezone title:payload.title}
    let add_json="{\"end\":"+payload.end.to_json()+",\"location\":"+payload.location.to_json()
        +",\"notes\":"+payload.notes.to_json()+",\"request_id\":"+payload.request_id.to_json()
        +",\"start\":"+payload.start.to_json()+",\"timezone\":"+payload.timezone.to_json()+",\"title\":"+payload.title.to_json()+"}"
    let add_digest="sha256:"+fs.sha256(add_json)
    let get_digest="sha256:"+fs.sha256("{\"id\":"+event.id.to_json()+"}")
    fixture_pending[2].callback({is_ok:true data:{messages:[
        receipt_row("calendar.add_event","turn:create","create",add_digest,{id:event.id start:event.start})
        receipt_row("calendar.get_event","turn:create","create-get",get_digest,{found:true event:event})]}})
    fixture_pending=[]
    return calendar_agent_state.binding.receipt_status=="verified"
}
fn second_mail_candidate(){
    let card=fixture_card() card.id="card:second-mail" card.goal_id=goals[0].id
    card.payload.source="synthetic-mail:second:reschedule" card.payload.start="2030-12-13T14:00:00+08:00"
    card.payload.end="2030-12-13T15:00:00+08:00" card.payload.location="second room"
    chat_sessions[0].proposals.push(card)
    return calendar_agent_ensure_matter(card) && calendar_agent_prepare_candidate(card)
}
fn prepared_update(){
    if !verified_create() || !second_mail_candidate(){return false}
    calendar_agent_update_select()
    return calendar_agent_update_state.records.len()==1 && calendar_agent_update_selected!=""
}
fn completed_update(){
    if !prepared_update(){return false}
    calendar_agent_update_confirm()
    fixture_pending[0].callback({is_ok:true data:{open:true}})
    fixture_pending[1].callback({is_ok:true data:{turn_id:"turn:update" text:"updated"}})
    return calendar_agent_update_state.records[0].status=="turn_completed" && fixture_pending.len()==3
}
fn update_rows(record){return [
    receipt_row("calendar.get_event",record.turn_id,"before",record.get_digest,{found:true event:record.expected.to_json().parse_json()})
    receipt_row("calendar.update_event",record.turn_id,"update",record.update_digest,{event:record.event.to_json().parse_json()})
    receipt_row("calendar.get_event",record.turn_id,"after",record.get_digest,{found:true event:record.event.to_json().parse_json()})]}
fn make_link(authority){
    let link={request_id:authority.creation_request_id turn_id:authority.creation_turn_id mail_account:mail_account.id
        binding:authority.binding.to_json().parse_json()}
    if gm_has(authority,"update"){link.authority=authority.to_json().parse_json()}
    return link
}
fn linked_draft(authority){
    mail_draft.account=mail_account.id mail_draft.to="person@example.invalid" mail_draft.subject="Original subject" mail_draft.body="My handwritten body"
    mail_draft.official_calendar=make_link(authority)
    mail_draft.link_goal_id=authority.binding.goal_id mail_draft.link_event_id=authority.event.id mail_draft.link_run_id=""
    return mail_calendar_current(mail_draft)
}
fn finish_update(){
    let record=calendar_agent_update_state.records[0]
    fixture_pending[2].callback({is_ok:true data:{messages:update_rows(record)}})
    return record.receipt_status=="verified"
}
seed()
checks.create_actual_wall_parameters_nonempty=verified_create() && calendar_agent_state.binding.payload.start=="2030-12-12T10:00"
    && calendar_agent_state.binding.payload.end=="2030-12-12T11:00"
let original_creation=calendar_agent_state.to_json()
let first_authority=calendar_agent_authority()
checks.original_mail_link_current=linked_draft(first_authority)
mail_draft.status="waiting_user" mail_draft.preview="old-approved-preview"
