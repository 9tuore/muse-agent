// Every mutation of the frozen identity/candidate/plan blocks dispatch or the
// result projection; callbacks retain their original turn for reconciliation.
for changed in ["user","accounts","project","owner","selection","version","candidate","refs","goal_source"] {
    seed() prepared_update() record=calendar_agent_update_state.records[0]
    calendar_agent_update_confirm()
    if changed=="user"{gm_user_id="another-user"}
    if changed=="accounts"{gm_accounts=["local"]}
    if changed=="project"{gm_project="another-project"}
    if changed=="owner"{gm_owner="another-owner"}
    if changed=="selection"{ac_selected_id="another-goal"}
    if changed=="version"{goals[0].version=3}
    if changed=="candidate"{chat_sessions[0].proposals[1].payload.location="edited"}
    if changed=="refs"{chat_sessions[0].proposals[1].memory_refs=[]}
    if changed=="goal_source"{goals[0].source="edited source"}
    fixture_pending[0].callback({is_ok:true data:{open:true}})
    checks["pre_dispatch_"+changed+"_blocks"]=fixture_pending.len()==1 && record.status=="blocked" && !calendar_agent_busy
}
