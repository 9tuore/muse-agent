checks.update_without_readback_at_most_accepted=calendar_agent_update_result([rows[0],rows[1]],record).status=="accepted"
checks.get_before_update_required=calendar_agent_update_result([rows[1],rows[0],rows[2]],record).status!="verified"
checks.get_old_only_unknown=calendar_agent_update_result([rows[0]],record).status=="unknown"
checks.empty_history_unknown=calendar_agent_update_result([],record).status=="unknown"
checks.after_get_before_update_rejected=calendar_agent_update_result([rows[0],rows[2],rows[1]],record).status!="verified"
