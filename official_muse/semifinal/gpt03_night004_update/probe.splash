chat_sessions[0].proposals.push(third)
calendar_agent_prepare_candidate(third)
calendar_agent_update_select()
let third_record=calendar_agent_update_state.records[1]
checks.next_explicit_update_uses_latest_authority=third_record.prior_update_request_id==calendar_agent_update_state.records[0].request_id
    && third_record.expected.to_json()==calendar_agent_update_state.records[0].event.to_json() && goals[0].version==3
    && calendar_agent_update_state.records[0].to_json()==previous
let pending_count=fixture_pending.len()
calendar_agent_submit_candidate()
checks.mutation_candidate_not_duplicated_as_create=fixture_pending.len()==pending_count

seed() completed_update() finish_update()
record=calendar_agent_update_state.records[0]
fixture_clock=2000000000
checks.retained_update_proof_valid_after_meeting_date=calendar_agent_update_valid(record) && calendar_agent_authority()!=nil
fixture_clock=1700000000
let forged=record.to_json().parse_json() forged.event.start="2030-12-13T13:00" forged.binding.payload.start=forged.event.start
let forged_args=calendar_agent_update_args(forged.expected,forged.event)
forged.get_digest=forged_args.get_digest forged.update_digest=forged_args.update_digest
checks.journal_event_must_derive_from_frozen_candidate=!calendar_agent_update_valid(forged)

// Deletion after a verified update consumes the new authority, while the
// creation proof and earlier update journal remain intact.
seed() completed_update() finish_update() record=calendar_agent_update_state.records[0]
fixture_pending=[]
let creation_before_delete=calendar_agent_state.to_json()
calendar_agent_delete_select()
calendar_agent_delete_confirm()
let deletion=calendar_agent_delete_state.records[0]
checks.delete_after_update_dispatches_with_new_expected=fixture_pending.len()==1 && deletion.expected.to_json()==record.event.to_json()
    && calendar_agent_delete_valid(deletion) && calendar_agent_delete_current(deletion)
fixture_pending[0].callback({is_ok:true data:{open:true}})
fixture_pending[1].callback({is_ok:true data:{turn_id:"turn:delete" text:"removed"}})
let delete_rows=[receipt_row("calendar.get_event",deletion.turn_id,"delete-before",deletion.get_digest,{found:true event:deletion.expected})
    receipt_row("calendar.remove_event",deletion.turn_id,"delete-remove",deletion.remove_digest,{removed:true})
    receipt_row("calendar.get_event",deletion.turn_id,"delete-after",deletion.get_digest,{found:false event:nil})]
fixture_pending[2].callback({is_ok:true data:{messages:delete_rows}})
checks.delete_after_update_three_phase_verified=deletion.receipt_status=="verified" && calendar_agent_state.to_json()==creation_before_delete
checks.deleted_updated_event_blocks_mail_and_further_update=!mail_calendar_verified() && calendar_agent_update_target()==nil

seed() completed_update() record=calendar_agent_update_state.records[0]
let same_record=record.to_json().parse_json()
same_record.expected.extra="unapproved"
checks.expected_extra_field_rejected=!calendar_agent_update_valid(same_record)
let missing_fields=record.to_json().parse_json() missing_fields.expected={}
checks.missing_expected_fields_fail_closed=!calendar_agent_update_valid(missing_fields)
let missing_event=record.to_json().parse_json() missing_event.event={}
checks.missing_event_fields_fail_closed=!calendar_agent_update_valid(missing_event)
let bad_file="{\"schema\":1,\"records\":[{}]}"
fixture_files["calendar-agent-update.json"]=bad_file
calendar_agent_update_boot()
checks.corrupt_journal_preserved_and_blocks_authority=!calendar_agent_update_writable && fixture_files["calendar-agent-update.json"]==bad_file
    && calendar_agent_authority()==nil && !mail_calendar_verified() && calendar_agent_delete_target()==nil

seed() verified_create()
chat_sessions[0].proposals[0].state="opened"
let original_card=chat_sessions[0].proposals[0].to_json()
let old_native=calendar_agent_state.to_json()
chat_requests=[{id:"chat:reschedule-request" session_id:chat_selected_id status:"running" editing:true
    project:gm_project owner:gm_owner candidate_id:chat_sessions[0].proposals[0].id
    candidate_payload:chat_sessions[0].proposals[0].payload.to_json() candidate_state:chat_sessions[0].proposals[0].state memory_refs:[]}]
let model_candidate={intent:"calendar_candidate" proposal:{title:"fixture meeting" start:"2030-12-13T14:00:00+08:00"
    end:"2030-12-13T15:00:00+08:00" time_zone:"Asia/Shanghai" location:"second room"}}
let added=chat_add_proposal(chat_selected_id,"chat:reschedule-request","fixture-account","把日程改到2030年12月13日14:00至15:00",model_candidate)
checks.actual_chat_edit_appends_new_candidate=added && chat_sessions[0].proposals.len()==2
    && chat_sessions[0].proposals[1].id=="chat:reschedule-request" && chat_sessions[0].proposals[1].goal_id==goals[0].id
checks.actual_chat_edit_preserves_creation_candidate=chat_sessions[0].proposals[0].to_json()==original_card
    && calendar_agent_state.to_json()==old_native && calendar_agent_authority()!=nil
let new_card=chat_sessions[0].proposals[1]
checks.actual_chat_edit_prepares_same_id_update=calendar_agent_ensure_matter(new_card) && calendar_agent_prepare_candidate(new_card)
calendar_agent_update_select()
checks.actual_chat_path_frozen_original_id=calendar_agent_update_state.records.len()==1
    && calendar_agent_update_state.records[0].event.id=="event:stable" && calendar_agent_update_selected!=""
let after_append=chat_sessions[0].proposals.len()
chat_requests[0].id="chat:blocked-edit"
let blocked=chat_add_proposal(chat_selected_id,"chat:blocked-edit","fixture-account","把日程改到2030年12月13日14:00至15:00",model_candidate)
checks.pending_update_does_not_mutate_creation_card=!blocked && chat_sessions[0].proposals.len()==after_append
    && chat_sessions[0].proposals[0].to_json()==original_card
({checks:checks happy_record:happy_record happy_args:happy_args}).to_json()
