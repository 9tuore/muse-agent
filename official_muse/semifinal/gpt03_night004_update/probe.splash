checks.full_update_dto_preserves_id_original_request=record.event.id==record.expected.id && record.event.request_id==record.creation_request_id
    && !gm_has(dto,"request_id") && dto.expected.request_id==record.creation_request_id
    && dto.title==record.event.title && dto.start==record.event.start && dto.end==record.event.end
    && dto.timezone==record.event.timezone && dto.location==record.event.location && dto.notes==record.event.notes
calendar_agent_update_confirm()
checks.journal_read_back_before_session=fixture_pending.len()==1 && record.status=="in_flight"
    && storage_read("calendar-agent-update.json")==calendar_agent_update_state.to_json()
fixture_pending[0].callback({is_ok:true data:{open:true}})
checks.one_turn_with_exact_dto=fixture_pending.len()==2 && fixture_pending[1].method=="octos.turn.start"
    && fixture_pending[1].payload.text.search(args.json)>=0
fixture_pending[1].callback({is_ok:true data:{turn_id:"turn:update" text:"updated"}})
checks.completed_turn_reads_history=record.status=="turn_completed" && fixture_pending.len()==3
checks.three_phase_verified=finish_update()
let current_authority=calendar_agent_authority()
checks.new_authority_retains_creation_proof=current_authority!=nil && current_authority.event.id==first_authority.event.id
    && current_authority.event.request_id==first_authority.event.request_id && current_authority.event.start==record.event.start
    && current_authority.binding.to_json()==first_authority.binding.to_json() && current_authority.revision==2
checks.delete_uses_latest_expected=calendar_agent_delete_target().expected.to_json()==record.event.to_json()
checks.old_mail_stays_invalid_after_verified=!mail_calendar_current(old_draft) && !mail_calendar_context_current(old_context)
mail_compose_from_agent_calendar()
checks.new_draft_binds_new_authority=mail_calendar_current(mail_draft) && mail_draft.body.search(record.event.start)>=0
    && mail_draft.official_calendar.authority.update.request_id==record.request_id
checks.handwriting_preserved_in_archive=storage_read("mail-draft-archive.json").parse_json().drafts[0].draft.body==old_draft.body
let count=fixture_pending.len()
calendar_agent_update_confirm()
checks.repeat_confirm_never_dispatches=fixture_pending.len()==count
let proof_snapshot=record.to_json()
calendar_agent_update_history(0)
checks.verified_history_does_not_rewrite_proof=record.to_json()==proof_snapshot && fixture_pending.len()==count
let happy_record=record.to_json().parse_json()
let happy_args=args.to_json().parse_json()

// Strict receipt checks are the production update verifier, with only Host
// history responses supplied by this fixture.
seed()
checks.completed_fixture=completed_update()
record=calendar_agent_update_state.records[0]
let rows=update_rows(record)
checks.dotted_tools_verified=calendar_agent_update_result(rows,record).status=="verified"
rows[1].tool_name="calendar_update_event"
