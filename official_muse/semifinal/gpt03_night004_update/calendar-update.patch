+            result.session_id = session result.before_get_call_id = before result.update_call_id = updated result.after_get_call_id = after
+            result.before_tool_call_id = before_tool result.update_tool_call_id = update_tool result.after_tool_call_id = after_tool
+        }
+    } else if failed { result.status = "failed" }
+    return result
+}
