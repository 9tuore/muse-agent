+fn calendar_agent_update_result(rows,record){
+    let result = {status: "unknown"}
+    if !calendar_agent_update_current(record) || record.turn_id == "" || !gm_array(rows) || rows.len() > 200 { return result }
+    let phase = 0 let uncertain = false let failed = false let session = ""
+    let before = "" let updated = "" let after = "" let before_tool = "" let update_tool = "" let after_tool = ""
+    for row in rows {
+        if gm_object(row) {
+        let turn = row["turn_id"] if turn == nil { turn = row["thread_id"] }
+        let tool = calendar_agent_tool_name(row["tool_name"])
+        if row["role"] == "tool" && row["lane"] == "person" && turn == record.turn_id
+            && (row["thread_id"] == nil || row.thread_id == turn) && tool != "" {
+            let receipt = row["host_calendar_receipt"] let terminal = calendar_agent_delete_receipt(row,record)
+            let digest = record.get_digest if tool == "calendar.update_event" { digest = record.update_digest }
+            if (tool != "calendar.get_event" && tool != "calendar.update_event") || !gm_object(receipt)
+                || receipt["args_digest"] != digest || !gm_string(receipt["session_id"],256) || receipt.session_id == ""
+                || !gm_string(row["tool_call_id"],256) || row.tool_call_id == ""
+                || (session != "" && session != receipt.session_id) { uncertain = true }
+            else if terminal == "error" || terminal == "cancelled" { failed = true }
+            else if terminal != "ok" || failed { uncertain = true }
+            else {
+                session = receipt.session_id let data = receipt.result["data"]
+                if !gm_object(data) { uncertain = true }
+                else if phase == 0 && tool == "calendar.get_event" && data["found"] == true
+                    && gm_object(data["event"]) && calendar_agent_event_matches(data.event,record.expected)
+                    && data.event.id == record.expected.id {
+                    before = receipt.call_id before_tool = row.tool_call_id phase = 1
+                } else if phase == 1 && tool == "calendar.update_event" && gm_object(data["event"])
+                    && calendar_agent_event_matches(data.event,record.event) && data.event.id == record.event.id
+                    && receipt.call_id != before && row.tool_call_id != before_tool {
+                    updated = receipt.call_id update_tool = row.tool_call_id phase = 2
+                } else if phase == 2 && tool == "calendar.get_event" && data["found"] == true
+                    && gm_object(data["event"]) && calendar_agent_event_matches(data.event,record.event) && data.event.id == record.event.id
+                    && receipt.call_id != before && receipt.call_id != updated
+                    && row.tool_call_id != before_tool && row.tool_call_id != update_tool {
+                    after = receipt.call_id after_tool = row.tool_call_id phase = 3
+                } else { uncertain = true }
+            }
+        }
+        }
+    }
+    if uncertain { return result }
+    if updated != "" {
+        result.status = "accepted"
+        if phase == 3 && !failed {
