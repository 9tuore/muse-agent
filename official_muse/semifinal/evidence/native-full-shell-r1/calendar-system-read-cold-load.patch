+#[cfg(any(feature = "app-hub", native_mobile))]
+#[test]
+fn cold_system_calendar_read_loads_owner_without_new_system_grants() {
+    const CHILD: &str = "OCTOSENSE_TEST_COLD_SYSTEM_CALENDAR_READ";
+    if std::env::var_os(CHILD).is_none() {
+        let output = std::process::Command::new(std::env::current_exe().unwrap())
+            .args(["--exact", "host_tools::tests::cold_system_calendar_read_loads_owner_without_new_system_grants", "--nocapture"])
+            .env(CHILD, "1").output().unwrap();
+        assert!(output.status.success(), "{}\n{}", String::from_utf8_lossy(&output.stdout), String::from_utf8_lossy(&output.stderr));
+        return;
+    }
+    let root = std::env::temp_dir().join(format!("octosense-cold-system-calendar-{}", std::process::id()));
+    octosense_appstore::set_data_root(root.clone());
+    octosense_app_hub_app::system_apps();
+    let grants = crate::system_chat::grants::host_tools();
+    assert!(!super::with_relay(|r| r.catalog.knows("os.calendar")));
+    assert_eq!(super::test_read_owner("calendar.events"), Some("os.calendar".into()));
+    assert_eq!(crate::agents::prepared("os.calendar"), None);
+    assert_eq!(crate::system_chat::grants::host_tools(), grants);
+    assert!(!grants.contains("calendar.get_event"));
+    assert_eq!(super::test_read_owner("calendar.get_event"), Some("os.calendar".into()));
+    for tool in ["calendar.add_event", "calendar.update_event", "calendar.remove_event", "calendar.notify"] {
+        assert_eq!(super::test_read_owner(tool), None, "diagnostic refuses non-read tools");
+    }
+    assert!(!super::with_relay(|r| r.catalog.may_call("muse-goals", "os.calendar", "calendar.events", false)));
+    let _ = std::fs::remove_dir_all(root);
 }
 
