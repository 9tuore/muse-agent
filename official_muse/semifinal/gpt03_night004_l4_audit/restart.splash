let checks={} let observations={}
checks.production_boot=core_boot_goals() && core_boot_activity() && core_boot_memory() && gm_boot()
let options=fixture_rpc("fixture.options",{}).data
mail_account=fixture_rpc("mail.accounts",{}).data[0] gm_set_accounts(["local","one"])
boot_restore("")
let queued_background=fixture_timers.len()-fixture_timer_index
// Background poll is outside this focused recovery case, as in existing restart probes.
fixture_timers=[] fixture_timer_index=0
let ai=core_action_index(mail_draft.request_id)
let before=mail_draft.to_json().parse_json()
if options.mode=="review-cancel" {
    checks.cancel_draft_restored=mail_draft.status=="DRAFT" && actions.len()==1 && actions[0].status=="failed"
} else {
    checks.pending_restored_unknown=mail_draft.status=="unknown" && ai>=0 && actions[ai].status=="unknown"
    mail_send_confirmed()
    checks.unknown_cannot_redispatch=fixture_rpc("fixture.counts",{}).data["mail.review_send"]==nil
    let status=fixture_rpc("mail.compose_status",{account:"one" compose_id:mail_draft.host_compose_id})
    checks.actual_same_terminal_attempt=status.is_ok && status.data.status=="accepted" && status.data.attempts.len()==1
    mail_check_host_status() fixture_drain()
    checks.readonly_reconciliation=mail_draft.status=="accepted" && actions[ai].status=="accepted"
    checks.original_payload_preserved=before.attempt==mail_draft.attempt && before.request_id==mail_draft.request_id
}
let receiver=fixture_rpc("fixture.receiver",{}).data
checks.new_process_no_transport=receiver.transport_calls==0 && receiver.real_smtp_calls==0
checks.no_new_review=fixture_rpc("fixture.counts",{}).data["mail.review_send"]==nil
checks.no_completion=goals.len()==0 && runs.len()==0 && memory.len()==0
observations={restored_before:before draft:mail_draft actions:actions receiver:receiver background_timers_not_drained:queued_background}
({checks:checks observations:observations boundary:"Fresh actual VM/Mail/recipient processes on own persisted state; only explicit readonly reconciliation is drained. No Kernel, GUI or real SMTP."}).to_json()
