let checks={} let observations={}
checks.production_boot=core_boot_goals() && core_boot_activity() && core_boot_memory() && gm_boot()
mail_account=fixture_rpc("mail.accounts",{}).data[0]
gm_set_accounts(["local","one"]) gm_set_focus("synthetic-project","synthetic-owner")
let options=fixture_rpc("fixture.options",{}).data
mail_new_draft() fixture_ui_to="receiver@example.invalid"
fixture_ui_subject="NIGHT004-L4-DURABILITY" fixture_ui_body="NIGHT004-L4-DURABILITY exact synthetic body"
mail_edit() mail_preview()
checks.exact_preview=mail_draft.status=="waiting_user"
mail_send_confirmed() fixture_drain()
let receiver=fixture_rpc("fixture.receiver",{}).data
let persisted=storage_read("mail-draft.json").parse_json()
let ai=core_action_index(persisted.request_id)
if options.mode=="receipt-os-error" {
    checks.post_delivery_storage_blocks=!mail_draft_writable && !mail_sending
    checks.persisted_uncertain_request=persisted.status=="sending" && ai>=0 && actions[ai].status=="in_flight"
    checks.exact_actual_recipient=receiver.transport_calls==1 && receiver.received.len()==1
        && receiver.received[0].body==fixture_ui_body && receiver.real_smtp_calls==0
} else if options.mode=="review-cancel" {
    checks.actual_cancel_restores_draft=mail_draft.status=="DRAFT" && mail_draft.attempt=="" && mail_draft.preview=="" && !mail_sending
    checks.actual_cancel_marks_original_action_failed=actions.len()==1 && actions[0].status=="failed"
    checks.cancel_no_transport=receiver.transport_calls==0 && receiver.received.len()==0 && receiver.real_smtp_calls==0
} else if options.mode=="gateway-timeout" {
    checks.elapsed_gateway_keeps_unknown=mail_draft.status=="unknown" && persisted.status=="unknown"
        && ai>=0 && actions[ai].status=="unknown" && !mail_sending
    checks.exact_actual_recipient=receiver.transport_calls==1 && receiver.received.len()==1
        && receiver.received[0].body==fixture_ui_body && receiver.real_smtp_calls==0
    mail_send_confirmed()
    checks.unknown_repeat_has_no_new_review=fixture_rpc("fixture.counts",{}).data["mail.review_send"]==1
        && fixture_rpc("fixture.receiver",{}).data.transport_calls==1
}
checks.original_handwriting_retained=mail_draft.body==fixture_ui_body
checks.no_completion=goals.len()==0 && runs.len()==0 && memory.len()==0
observations={draft:mail_draft persisted_draft:persisted actions:actions receiver:receiver mail_error:mail_error}
({checks:checks observations:observations boundary:"Actual production VM and actual SDK Mail fixture; synthetic Vault/native review/MockTransport. SIGKILL or actual OS receipt-write error is controlled by own parent, no Kernel or real SMTP."}).to_json()
