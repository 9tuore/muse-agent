use mod.math.*
use mod.std.*
let files = {} let calls = [] let serial = 0 let hold_turn = false let fail_archive = false
let fs = {exists: |path| files[path] != nil}
let gm_user_id = "fixture-person" let gm_accounts = ["local","A"]
let calendar_agent_state = {} let calendar_agent_busy = false let calendar_agent_writable = true
let calendar_agent_reply = "" let calendar_agent_evidence = "" let calendar_agent_input_text = ""
let calendar_agent_notice = "" let calendar_agent_details = false let calendar_agent_mail_source = nil
let calendar_agent_candidate = nil let calendar_agent_preflight = {status:"empty"}
let calendar_agent_update_state = {records:[]}
let mail_account = {id:"A"} let mail_selected = nil let mail_error = "" let page = "Mail"
fn redraw(){} fn mail_redraw(){} fn set_page(value){page=value}
fn time_now(){return 1791840000}
fn random_u32(){serial=serial+1 return serial}
fn storage_read(path){return files[path]}
fn storage_write(path,value){
    if fail_archive && path == "calendar-request-archive.json" {return "fixture failure"}
    files[path]=value return nil
}
fn calendar_agent_history(){}
fn calendar_agent_binding_current(binding){return binding != nil}
fn calendar_agent_binding_valid(binding){return binding != nil}
fn chat_payload_error(action,payload){return ""}
fn calendar_agent_session_notice(opened,operation,fallback){return fallback}
fn fixture_transport(method,args,cb){
    calls.push({method:method args:args})
    if method=="octos.session.open" {cb({is_ok:true data:{open:true}})}
    if method=="octos.turn.start" && !hold_turn {cb({is_ok:true data:{turn_id:"turn-"+serial text:"fixture result"}})}
}
fn seed(status,count){
    files={} calls=[] hold_turn=false fail_archive=false
    calendar_agent_busy=false calendar_agent_writable=true calendar_agent_mail_source=nil
    calendar_agent_reply="old reply" calendar_agent_evidence="old evidence" calendar_agent_input_text="old input"
    calendar_agent_notice="old notice" calendar_agent_details=false calendar_agent_preflight={status:"empty"}
    calendar_agent_candidate=nil calendar_agent_update_state={records:[]}
    let previous=[] for i in count {previous.push({request_id:"prior-"+i turn_id:"turn-prior-"+i status:"turn_completed" user_id:gm_user_id accounts:gm_accounts.to_json()})}
    calendar_agent_state={schema:1 request_id:"original" turn_id:"old-turn" status:status user_id:gm_user_id accounts:gm_accounts.to_json() previous_requests:previous}
    mail_account={id:"A"} mail_selected={id:"mail-1" subject:"会面邀请" body:"明天下午3点见面，持续一小时。" address:"self@fixture.invalid"}
    mail_error="" page="Mail"
}
// PRODUCT_FUNCTIONS
let results=[]
fn check(name,passed){results.push({name:name passed:passed})}
for status in ["turn_completed","unknown","blocked"] {
    seed(status,0)
    calendar_agent_submit_bound("查询明天的日程",nil)
    check("continue-after-"+status,calls.len()==2 && calendar_agent_state.status=="turn_completed" && calendar_agent_state.request_id!="original")
    check("preserve-prior-"+status,calendar_agent_state.previous_requests.len()==1 && calendar_agent_state.previous_requests[0].request_id=="original" && calendar_agent_state.previous_requests[0].status==status)
}
seed("turn_completed",32)
calendar_agent_submit_bound("查询明天",nil)
let archive=storage_read("calendar-request-archive.json").parse_json()
check("no-32-request-lock",calls.len()==2 && calendar_agent_state.previous_requests.len()==32)
check("oldest-request-archived",archive.requests.len()==1 && archive.requests[0].request_id=="prior-0" && calendar_agent_state.previous_requests[0].request_id=="prior-1")
seed("turn_completed",32) fail_archive=true
calendar_agent_submit_bound("查询明天",nil)
check("archive-failure-preserves-state",calls.len()==0 && calendar_agent_state.request_id=="original" && calendar_agent_state.previous_requests.len()==32)
seed("turn_completed",0) hold_turn=true
calendar_agent_submit_bound("查询明天",nil)
let active=calendar_agent_state.request_id
calendar_agent_submit_bound("再查询明天",nil)
check("active-turn-double-click",calls.len()==2 && calendar_agent_busy && calendar_agent_state.request_id==active)
seed("turn_completed",0)
calendar_agent_submit_bound("",nil)
check("empty-input-keeps-previous",calls.len()==0 && calendar_agent_state.request_id=="original")
seed("turn_completed",0)
calendar_agent_candidate={goal_id:"candidate" candidate_json:"{}" payload:{title:"meeting" start:"2026-10-14T15:00" end:"2026-10-14T16:00" timezone:"Asia/Shanghai" location:"" notes:""}}
calendar_agent_submit_candidate()
check("single-click-create-no-mandatory-query",calls.len()==2 && calls[1].args.text.search("calendar.add_event")>=0 && calendar_agent_state.binding.goal_id=="candidate")
calendar_agent_submit_candidate()
check("same-candidate-double-click",calls.len()==2)
seed("turn_completed",0)
mail_prepare_calendar()
check("mail-calendar-button-prepares-only",page=="Calendar" && calls.len()==0 && calendar_agent_input_text.search(mail_selected.body)>=0 && calendar_agent_mail_source.message_id=="mail-1")
check("mail-clears-old-result",calendar_agent_reply=="" && calendar_agent_candidate==nil && calendar_agent_notice=="")
calendar_agent_submit_bound(calendar_agent_input_text,nil)
check("explicit-calendar-submit-keeps-mail-source",calls.len()==2 && calendar_agent_state.mail_source.message_id=="mail-1" && calendar_agent_mail_source==nil)
seed("turn_completed",0) calendar_agent_busy=true mail_prepare_calendar()
check("mail-does-not-replace-running-calendar",page=="Mail" && calendar_agent_input_text=="old input" && calls.len()==0)
results.to_json()
