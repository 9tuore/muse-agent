use mod.math.*
use mod.std.*
let fixture_unexpected=0 let fixture_adapter_calls=0
let task = nil
let page = "Chat"
let chat_sessions = []
let chat_selected_id = ""
let activity = []
let goals = []
let mail_accounts = []
let mail_draft = {account: "" to: "" subject: "" body: "" status: "DRAFT"
    preview: "" attempt: "" request_id: "" accepted_at: 0 verified_at: 0 verified_id: ""
    link_goal_id: "" link_event_id: "" link_run_id: "" incoming_key: ""}
let calendar_links = []
let calendar_receipts = []
let calendar_selected_goal = ""
let calendar_conflicts = []
let mail_watch = {schema: 1 enabled: true accounts: [] alerts: []}
let runs = []
let actions = []
let core_storage_ready = false
let core_activity_ready = false
let gm_accounts = ["local"]
let gm_project = ""
let gm_owner = ""
let gm_ready = false
let ac_selected_id = ""
let ac_selected_chat = ""
fn is_calendar_goal(goal){
    if goal == nil { return false }
    return goal.to_json().split("\"kind\":\"calendar\"").len() > 1
}
fn calendar_enabled(){
    // Built-in Calendar is SYSTEM_APP_ONLY; use the official Agent relay.
    // No private EventKit bridge or direct os.calendar identity is permitted.
    return false
}
fn calendar_agent_project(view,goal){fixture_adapter_calls=fixture_adapter_calls+1 return false}
fn calendar_link_index(goal_id){fixture_unexpected=fixture_unexpected+1 return -1}
fn mail_reply_matches(intent,body){fixture_unexpected=fixture_unexpected+1 return false}
fn mail_watch_account(id){
    for account in mail_accounts { if account.id == id { return account } }
    return nil
}
fn mail_calendar_current(draft){fixture_unexpected=fixture_unexpected+1 return false}
fn gm_object(v){ return v.is_object() }
fn gm_array(v){ return v.is_array() }
fn gm_text(v){ return v.is_string() }
fn gm_number(v){ return v.is_number() && v >= 0 }
fn gm_get(obj,key){
    if !gm_object(obj) { return nil }
    return obj[key]
}
fn gm_has(obj,key){ return gm_object(obj) && gm_get(obj,key) != nil }
fn gm_string(v,limit){ return gm_text(v) && v.len() <= limit }
fn gm_account_allowed(account){
    for id in gm_accounts { if id == account { return true } }
    return false
}
fn chat_refs_valid(refs){fixture_unexpected=fixture_unexpected+1 return false}
fn chat_reply_context_valid(reply){fixture_unexpected=fixture_unexpected+1 return false}
fn ac_text(value){
    if !gm_string(value,20000) { return "" }
    if value.search("@") >= 0 { return "邮箱信息（已脱敏）" }
    let chars = value.to_chars() let out = "".to_chars()
    for i in min(chars.len(),100) { out.push(chars[i]) }
    if chars.len() > 100 { return out.to_string() + "…" }
    return out.to_string()
}
fn ac_field(record,key){
    if !gm_object(record) || !gm_string(record[key],2000) { return "" }
    return record[key]
}
fn ac_state(status){
    if status == "verified" { return "已核验" }
    if status == "running" || status == "in_flight" || status == "sending" { return "进行中" }
    if status == "planned" || status == "waiting_user" || status == "prepared" { return "等你确认" }
    if status == "blocked" || status == "paused" || status == "unavailable" { return "受阻" }
    if status == "conflict" { return "冲突" }
    if status == "stale" || status == "superseded" { return "已失效" }
    if status == "failed" || status == "error" { return "失败" }
    if status == "accepted" || status == "unknown" || status == "completed" { return "待核验" }
    if status == "new" || status == "DRAFT" || status == "candidate" || status == "editing" || status == "idle" { return "未执行" }
    return "待核验"
}
fn ac_goal_allowed(goal){
    if !gm_object(goal) || gm_project == "" || gm_owner == "" { return false }
    if ac_field(goal,"project_id") != gm_project || ac_field(goal,"owner_id") != gm_owner { return false }
    if gm_object(goal["mail_source"]) {
        let account = ac_field(goal.mail_source,"account_id")
        return account != "" && gm_account_allowed(account) && mail_watch_account(account) != nil
    }
    return gm_account_allowed("local")
}
fn ac_current_goal(){
    if !core_storage_ready || !gm_ready || !gm_array(goals) || !gm_array(chat_sessions) { return nil }
    let id = ""
    for index in min(chat_sessions.len(),16) {
        let session = chat_sessions[index]
        if gm_object(session) && ac_field(session,"id") == chat_selected_id
            && ac_field(session,"focus_project") == gm_project && ac_field(session,"focus_owner") == gm_owner {
            id = ac_field(session,"goal_id")
        }
    }
    if page == "Goal Detail" && gm_object(task) { id = ac_field(task,"id") }
    if ac_selected_chat == chat_selected_id && ac_selected_id != "" { id = ac_selected_id }
    for index in min(goals.len(),64) { let goal = goals[index] if gm_object(goal) && ac_field(goal,"id") == id && ac_goal_allowed(goal) { return goal } }
    return nil
}
fn ac_alert_allowed(alert,goal){
    if !gm_object(alert) || !ac_goal_allowed(goal) || !gm_object(goal["mail_source"]) { return false }
    if ac_field(alert,"account_id") != ac_field(goal.mail_source,"account_id") { return false }
    return ac_field(alert,"goal_id") == goal.id
        || ac_field(alert,"key") == goal.mail_source.account_id + ":" + ac_field(goal.mail_source,"message_id")
}
fn ac_current_alert(){
    let goal = ac_current_goal()
    if !gm_object(mail_watch) || !gm_array(mail_watch["alerts"]) { return nil }
    for offset in min(mail_watch.alerts.len(),32) {
        let alert = mail_watch.alerts[mail_watch.alerts.len()-1-offset]
        if ac_alert_allowed(alert,goal) && ac_field(alert,"status") != "dismissed" { return alert }
    }
    return nil
}
fn ac_alert_count(){
    let count = 0 let goal = ac_current_goal()
    if !gm_object(mail_watch) || !gm_array(mail_watch["alerts"]) { return 0 }
    for offset in min(mail_watch.alerts.len(),32) {
        if ac_alert_allowed(mail_watch.alerts[mail_watch.alerts.len()-1-offset],goal) { count = count + 1 }
    }
    return count
}
fn ac_add(view,title,status,detail,id){
    if view.nodes.len() >= 12 { view.limited = true return }
    view.nodes.push({title: title state: ac_state(status) detail: ac_text(detail) record_id: id
        node_id: title + ":" + id + ":" + view.nodes.len()})
}
fn ac_local_run_readback(goal,run){
    if !core_activity_ready || !gm_array(activity) || !gm_object(goal) || !gm_object(run)
        || ac_field(goal,"status") != "completed" || ac_field(run,"status") != "completed"
        || ac_field(goal,"id") == "" || ac_field(run,"id") == ""
        || ac_field(run,"goal_id") != ac_field(goal,"id") || !gm_number(goal["version"])
        || !gm_number(run["plan_revision"]) || run.plan_revision != goal.version
        || ac_field(goal,"result_path") == "" || ac_field(run,"result_path") != ac_field(goal,"result_path")
        || !gm_number(run["started_at"]) || !gm_number(run["finished_at"])
        || run.finished_at < run.started_at || gm_object(goal["mail_source"]) { return false }
    let spec = goal["goal_spec"]
    if !gm_object(spec) || spec["goal_id"] != goal.id || spec["revision"] != goal.version
        || !gm_array(spec["steps"]) || spec.steps.len() != 1 || !gm_object(spec.steps[0])
        || spec.steps[0]["capability"] != "storage.write" || !gm_object(spec.steps[0]["args"])
        || spec.steps[0].args["path"] != goal.result_path { return false }
    for offset in min(activity.len(),64) {
        let item = activity[activity.len()-1-offset]
        if gm_object(item) && ac_field(item,"kind") == "readback"
            && ac_field(item,"goal_id") == goal.id && ac_field(item,"run_id") == ac_field(run,"id")
            && gm_number(item["at"]) && item.at >= run.started_at && item.at <= run.finished_at { return true }
    }
    return false
}
fn ac_projection(){
    let view = {title: "当前会话尚未关联事项" sources: [] nodes: [] next: "关联事项后，已有来源、计划和回执会显示在这里。" limited: false}
    if !core_storage_ready || !gm_ready {
        view.title = "记录尚不可读" view.next = "受阻 · 等待记录恢复；未执行新操作。" return view
    }
    let goal = ac_current_goal()
    if goal == nil { return view }
    if !gm_number(goal["version"]) || !gm_string(goal["goal"],4000) || ac_field(goal,"id") == "" {
        view.title = "事项记录不完整" view.next = "原记录已保留；无法据此展示执行成功。" return view
    }
    view.title = ac_text(goal.goal)
    view.sources.push("任务记录")
    if ac_field(goal,"status") == "planned" { view.next = "查看现有计划，核对后再确认执行。" }
    if view.next == "关联事项后，已有来源、计划和回执会显示在这里。" { view.next = "查看事项详情或原结果卡；本链只展示已有记录。" }
    ac_add(view,"事项 · 当前计划",ac_field(goal,"status"),"版本 " + goal.version + " · 计划不等于执行成功",goal.id)
    let alert = ac_current_alert()
    if alert != nil {
        view.sources.push("邮件")
        let state = "new"
        if gm_string(alert["source_body"],20000) { state = "verified" }
        ac_add(view,"来信来源",state,ac_field(alert,"subject"),ac_field(alert,"key"))
        if ac_alert_count() > 1 { ac_add(view,"后续来信","new","同一事项有后续来信；旧执行记录继续保留",ac_field(alert,"key")) }
        if gm_object(alert["analysis"]) {
            let state = "new"
            if ac_field(alert,"analysis_state") == "running" { state = "running" }
            ac_add(view,"理解候选",state,"已有分析记录；不是执行或检索成功证据",ac_field(alert,"key"))
        }
    }
    if gm_array(calendar_links) {
        for offset in min(calendar_links.len(),32) {
            let link = calendar_links[calendar_links.len()-1-offset]
            if gm_object(link) && ac_field(link,"goal_id") == goal.id
                && gm_account_allowed(ac_field(link,"account_id")) {
                view.sources.push("日历")
                ac_add(view,"日历关联",ac_field(link,"status"),"已有日历关联记录；当前可用性不代表历史结果",goal.id)
                if ac_field(link,"last_error") != "" {
                    ac_add(view,"日程需重新核对","unknown",ac_field(link,"last_error"),goal.id)
                }
                if gm_array(link["memory_refs"]) && link.memory_refs.len() > 0 {
                    view.sources.push("全局记忆")
                    let state = "stale"
                    if chat_refs_valid(link.memory_refs) && chat_reply_context_valid({memory_refs: link.memory_refs}) { state = "verified" }
                    ac_add(view,"关联记忆",state,"记录中的相关记忆共 " + link.memory_refs.len() + " 条；不展示整库",goal.id)
                }
            }
        }
    }
    let official_link = calendar_agent_project(view,goal)
    if !calendar_enabled() && is_calendar_goal(goal) && !official_link {
        ac_add(view,"日历能力","blocked","请本人选择当前事项并打开日程候选，再单独提交官方助手请求；历史回执保留",goal.id)
        view.next = "请核对并提交绑定当前事项的官方日历候选；计划尚未执行。"
    }
    if gm_array(calendar_receipts) {
        let count = 0
        for offset in min(calendar_receipts.len(),64) {
            let receipt = calendar_receipts[calendar_receipts.len()-1-offset]
            if count < 2 && gm_object(receipt) && ac_field(receipt,"goal_id") == goal.id {
                ac_add(view,"独立读回回执",ac_field(receipt,"status"),"已有收据 · " + ac_field(receipt,"service"),ac_field(receipt,"request_id"))
                count = count + 1
            }
        }
        if calendar_receipts.len() > 64 { view.limited = true }
    }
    if gm_array(actions) {
        let matching = []
        for offset in min(actions.len(),64) {
            let action = actions[actions.len()-1-offset]
            if gm_object(action) && ac_field(action,"goal_id") == goal.id {
                if matching.len() < 4 { matching.push(action) } else { view.limited = true }
            }
        }
        for offset in matching.len() {
            let action = matching[matching.len()-1-offset]
            let detail = "已有动作记录 · " + ac_field(action,"service")
            if action["plan_revision"] != goal.version { detail = detail + " · 历史版本，事实仍保留" }
            if ac_field(action,"status") == "accepted" || ac_field(action,"status") == "unknown" { detail = detail + " · 仅受理，尚未核验" view.next = "核对原记录；结果未确认前不要重复执行。" }
            ac_add(view,"执行记录",ac_field(action,"status"),detail,ac_field(action,"id"))
        }
        if actions.len() > 64 { view.limited = true }
    }
    if gm_array(runs) && !gm_object(goal["mail_source"]) && gm_object(goal["goal_spec"])
        && gm_array(goal.goal_spec["steps"]) && goal.goal_spec.steps.len() == 1
        && gm_object(goal.goal_spec.steps[0]) && goal.goal_spec.steps[0]["capability"] == "storage.write" {
        let count = 0
        for offset in min(runs.len(),64) {
            let run = runs[runs.len()-1-offset]
            if count < 4 && gm_object(run) && ac_field(run,"id") != ""
                && gm_number(run["plan_revision"]) && ac_field(run,"goal_id") == goal.id {
                let detail = "已有执行记录 · 计划版本 " + run["plan_revision"]
                if run["plan_revision"] != goal.version { detail = detail + " · 历史版本" }
                ac_add(view,"执行记录",ac_field(run,"status"),detail,ac_field(run,"id"))
                if ac_local_run_readback(goal,run) {
                    ac_add(view,"本地结果读回记录","verified","该次执行已保存资料并独立回读；记录与当前计划版本匹配",ac_field(run,"id"))
                    view.nodes[0].state = "已核验"
                    view.next = "本地资料已保存并独立回读；可查看结果，修改计划后需重新确认。"
                }
                count = count + 1
            }
        }
        if runs.len() > 64 { view.limited = true }
    }
    if gm_object(mail_draft) && ac_field(mail_draft,"link_goal_id") == goal.id
        && gm_account_allowed(ac_field(mail_draft,"account"))
        && (!gm_has(mail_draft,"official_calendar") || mail_calendar_current(mail_draft)) {
        // Project the same Calendar dependency checked by mail_send_confirmed.
        // A changed event invalidates confirmation, never rewrites hand text.
        if ac_field(mail_draft,"link_event_id") != "" && !gm_has(mail_draft,"official_calendar") {
            let li = calendar_link_index(goal.id)
            if li < 0 || ac_field(calendar_links[li],"status") != "verified"
                || ac_field(calendar_links[li],"event_id") != mail_draft.link_event_id {
                if mail_draft.status == "DRAFT" || mail_draft.status == "waiting_user" {
                    ac_add(view,"关联日程已变化","stale","原发送确认已失效；保留回复原文，先核对新日程",ac_field(mail_draft,"request_id"))
                    view.next = "先处理新的日程，再核对回复内容并重新确认发送。"
                }
            }
        }
        let stale = gm_has(mail_draft,"memory_refs") && (!chat_refs_valid(mail_draft.memory_refs) || !chat_reply_context_valid(mail_draft))
        if alert != nil && ac_field(mail_draft,"incoming_key") == ac_field(alert,"key")
            && ac_field(alert,"reply_mode") != "manual" && gm_has(alert,"draft_intent")
            && (alert.draft_intent != alert.intent || !mail_reply_matches(alert.intent,ac_field(mail_draft,"body"))) { stale = true }
        if stale && (mail_draft.status == "DRAFT" || mail_draft.status == "waiting_user") {
            ac_add(view,"旧回复草稿已失效","stale","相关记忆或回复意图已变化，需要重新起草",ac_field(mail_draft,"request_id"))
            view.next = "请按新的信息重新起草；原文继续保留，暂不能发送旧方案。"
        } else {
            ac_add(view,"回复草稿",ac_field(mail_draft,"status"),"已有草稿状态；草稿或模型文字不等于已发送",ac_field(mail_draft,"request_id"))
        }
    }
    if gm_array(activity) && core_activity_ready {
        let count = 0
        for offset in min(activity.len(),64) {
            let item = activity[activity.len()-1-offset]
            if count < 2 && gm_object(item) && ac_field(item,"goal_id") == goal.id && ac_field(item,"kind") == "STALE_APPROVAL" {
                ac_add(view,"旧确认已失效","stale",ac_field(item,"detail"),ac_field(item,"request_id"))
                count = count + 1
            }
        }
        if activity.len() > 64 { view.limited = true }
    }
    if gm_array(calendar_conflicts) && calendar_selected_goal == goal.id && calendar_conflicts.len() > 0 {
        ac_add(view,"发现时间冲突","conflict","当前查询发现 " + calendar_conflicts.len() + " 个冲突；未修改其他安排",goal.id)
        view.next = "先核对冲突和候选时间，再进入原确认流程。"
    }
    return view
}

