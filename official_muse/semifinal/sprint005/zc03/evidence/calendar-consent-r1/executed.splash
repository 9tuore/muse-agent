
use mod.math.*
use mod.std.*
let calendar_agent_busy=false let calendar_agent_writable=true let calendar_agent_state={}
let calendar_agent_notice="" let calendar_agent_reply="" let calendar_agent_evidence="" let calendar_agent_details=false
let calendar_agent_preflight={status:"empty"} let calendar_agent_history_settle=false let calendar_agent_history_epoch=0
let gm_user_id="fixture-user" let gm_accounts=["local"]
let fixture_row={} let fixture_services=[] let fixture_saves=[] let fixture_unexpected=0
fn calendar_agent_save(){fixture_saves.push(calendar_agent_state.to_json()) return true}
fn calendar_agent_binding_current(binding){fixture_unexpected=fixture_unexpected+1 return false}
fn calendar_agent_tool_name(name){fixture_unexpected=fixture_unexpected+1 return ""}
fn calendar_agent_receipt_status(row){fixture_unexpected=fixture_unexpected+1 return "unverified"}
fn calendar_agent_link_result(rows){fixture_unexpected=fixture_unexpected+1 return {status:"unknown"}}
fn redraw(){}
fn time_now(){return 100}
fn random_u32(){return 23}
fn fixture_transport(method,args,cb){
 fixture_services.push(method)
 if method=="octos.session.open" {
   if fixture_row.identity {gm_user_id="changed-user"}
   cb(fixture_row.opened) return
 }
 if method=="octos.turn.start" {cb({is_ok:true data:{turn_id:"fixture-turn" text:"synthetic response"}}) return}
 if method=="octos.session.history" {cb({is_ok:false data:nil}) return}
 fixture_unexpected=fixture_unexpected+1
}
fn gm_object(v){ return v.is_object() }
fn gm_text(v){ return v.is_string() }
fn gm_string(v,limit){ return gm_text(v) && v.len() <= limit }
fn calendar_agent_session_notice(opened,operation,fallback){
    // First-use consent declines this call; allowing the agent does not replay it.
    // Recognize only the host's exact public error, never display raw diagnostics.
    if gm_object(opened) && opened["is_ok"] == false && gm_string(opened["error"],512)
        && opened.error == "Waiting for the person to allow this app's agent (OctoSense asks the first time)" {
        return "宿主已发出启用 Muse 助手的申请；授权完成后，请重新" + operation
            + "。本次尚未派发日历操作，不会自动重发。"
    }
    return fallback
}
fn calendar_agent_submit_bound(text,binding){
    if calendar_agent_busy || !calendar_agent_writable { return }
    if calendar_agent_state.status != "idle" && calendar_agent_state.status != "blocked" {
        calendar_agent_notice = "请先核对当前请求。其结果不会自动重做；另写不同事项前请保留下方待核对记录。"
        redraw() return
    }
    text = text.trim()
    if text == "" || text.len() > 6000 {
        calendar_agent_notice = "请输入日历请求，最多 6000 字节；新建请写明标题、开始、结束和时区。"
        redraw() return
    }
    let id = "muse-calendar-" + floor(time_now()) + "-" + random_u32()
    let user = gm_user_id let accounts = gm_accounts.to_json()
    calendar_agent_state = {schema: 1 request_id: id turn_id: "" status: "in_flight" user_id: user accounts: accounts previous_requests: calendar_agent_state.previous_requests}
    if binding == nil && calendar_agent_preflight.status == "query" { calendar_agent_preflight.request_id = id }
    if binding != nil {
        calendar_agent_state.binding = binding.to_json().parse_json()
        calendar_agent_state.binding.payload.request_id = id
    }
    calendar_agent_reply = "" calendar_agent_evidence = "" calendar_agent_details = false
    if !calendar_agent_save() { redraw() return }
    calendar_agent_busy = true calendar_agent_notice = "正在等待官方助手；需要批准时请在宿主界面本人决定。"
    redraw()
    fixture_transport("octos.session.open",{},fn(opened){
        if calendar_agent_state.request_id != id { return }
        if !opened.is_ok || !opened.data.is_object() || opened.data["open"] != true
            || user != gm_user_id || accounts != gm_accounts.to_json()
            || (binding != nil && !calendar_agent_binding_current(binding)) {
            calendar_agent_busy = false calendar_agent_state.status = "blocked"
            calendar_agent_notice = calendar_agent_session_notice(opened,"提交所选日历请求","官方会话未打开或账号已变化；未派发日历请求。请检查宿主助手授权与模型。")
            calendar_agent_save() redraw() return
        }
        if binding != nil { text = text + "\n精确 calendar.add_event 参数：" + calendar_agent_state.binding.payload.to_json() + "\n新建返回稳定 id 后，以该 id 调用 calendar.get_event 精确读回，并核对 request_id 与全部候选字段。" }
        let prompt = "本次日历请求 ID：" + id + "。仅使用已授权的官方 Calendar 工具。新建时使用此 request_id，并通过 calendar.get_event 读回；缺少时间或时区请先询问。不要把模型文字当作执行回执。\n用户请求：" + text
        fixture_transport("octos.turn.start",{text: prompt trigger: "app"},fn(r){
            if calendar_agent_state.request_id != id { return }
            calendar_agent_busy = false
            calendar_agent_state.status = "unknown"
            if r.is_ok && r.data.is_object() && r.data["turn_id"].is_string() && r.data.turn_id != "" && r.data.turn_id.len() <= 160 { calendar_agent_state.turn_id = r.data.turn_id }
            if r.is_ok && r.data.is_object() && r.data["turn_id"].is_string()
                && r.data.turn_id != "" && r.data.turn_id.len() <= 160
                && user == gm_user_id && accounts == gm_accounts.to_json()
                && (binding == nil || calendar_agent_binding_current(binding)) {
                calendar_agent_state.turn_id = r.data.turn_id
                calendar_agent_state.status = "turn_completed"
                if r.data["text"].is_string() && r.data.text.len() <= 24000 { calendar_agent_reply = r.data.text }
                calendar_agent_notice = "官方回合结束，正在读取工具记录；尚未认定日历操作成功。"
            } else {
                calendar_agent_notice = "请求失败或身份已变化，外部结果待核对；不会自动重做。请求 ID：" + id
            }
            if calendar_agent_save() && calendar_agent_state.status == "turn_completed" { calendar_agent_history() }
            redraw()
        })
    })
}
fn calendar_agent_history(){
    let settle = calendar_agent_history_settle
    calendar_agent_history_settle = false
    if calendar_agent_state.user_id != gm_user_id || calendar_agent_state.accounts != gm_accounts.to_json()
        || (calendar_agent_state["binding"] != nil && !calendar_agent_binding_current(calendar_agent_state.binding)) {
        calendar_agent_notice = "当前账号与请求记录不一致，未读取旧回合；请在宿主助手核对原请求，或用下方「结清上一条请求」保留记录后继续。"
        redraw() return
    }
    calendar_agent_history_epoch = calendar_agent_history_epoch + 1
    let epoch = calendar_agent_history_epoch let binding = calendar_agent_state.to_json()
    fixture_transport("octos.session.history",{},fn(r){
        if epoch != calendar_agent_history_epoch || binding != calendar_agent_state.to_json()
            || calendar_agent_state.user_id != gm_user_id || calendar_agent_state.accounts != gm_accounts.to_json()
            || (calendar_agent_state["binding"] != nil && !calendar_agent_binding_current(calendar_agent_state.binding)) { return }
        if !r.is_ok || !r.data.is_object() || !r.data["messages"].is_array() {
            calendar_agent_notice = "官方历史未返回，请在宿主助手中核对；不会重发请求。"
            redraw() return
        }
        let evidence = "" let count = 0 let completed = 0 let failed = 0 let unverified = 0
        let query_only = true
        if r.data.messages.len() > 200 { unverified = unverified + 1 }
        for offset in min(r.data.messages.len(),200) {
            let row = r.data.messages[r.data.messages.len()-1-offset]
            if row.is_object() {
            let turn = row["turn_id"] let thread = row["thread_id"]
            if turn == nil { turn = thread }
            let tool = row["tool_name"]
            let calendar_tool = calendar_agent_tool_name(tool) != ""
            if calendar_agent_state.turn_id != "" && calendar_tool
                && row["lane"] == "person" && turn == calendar_agent_state.turn_id
                && (thread == nil || thread == turn) && row["role"] == "tool"
                && row["tool_call_id"].is_string() && row.tool_call_id != "" {
                let terminal = calendar_agent_receipt_status(row)
                if terminal == "ok" { completed = completed + 1 }
                else if terminal == "error" || terminal == "cancelled" { failed = failed + 1 }
                else { unverified = unverified + 1 }
                if calendar_agent_tool_name(tool) != "calendar.events" && calendar_agent_tool_name(tool) != "calendar.get_event" { query_only = false }
                let text = row.to_json()
                if count < 12 && evidence.len() + text.len() <= 16000 {
                    evidence = text + "\n" + evidence count = count + 1
                }
            }
            }
        }
        if calendar_agent_state["binding"] != nil {
            let linked = calendar_agent_link_result(r.data.messages)
            calendar_agent_state.binding.receipt_status = linked.status
            if linked.status == "verified" { calendar_agent_state.binding.verification = linked }
            if !calendar_agent_save() { redraw() return }
        }
        calendar_agent_evidence = evidence
        if evidence == "" {
            calendar_agent_notice = "尚无可关联当前回合的工具记录；请用请求 ID 核对宿主历史，不能据回复认定执行成功。"
        } else {
            calendar_agent_notice = "当前回合工具回执：完成 " + completed + "，失败或取消 " + failed + "，未核验 " + unverified + "。新建事项还需精确读回，详情可展开核对。"
        }
        calendar_agent_preflight_history(r.data)
        if settle { calendar_agent_settle_if_resolved(completed,failed,unverified,query_only) }
        if calendar_agent_preflight_current() { calendar_agent_notice = calendar_agent_preflight_notice() }
        redraw()
    })
}

let direct_rows="[{\"name\": \"exact-no-consent\", \"opened\": {\"is_ok\": false, \"error\": \"Waiting for the person to allow this app's agent (OctoSense asks the first time)\"}, \"consent\": true}, {\"name\": \"turned-off\", \"opened\": {\"is_ok\": false, \"error\": \"Agent is turned off\"}, \"consent\": false}, {\"name\": \"signin\", \"opened\": {\"is_ok\": false, \"error\": \"Sign in required\"}, \"consent\": false}, {\"name\": \"unknown\", \"opened\": {\"is_ok\": false, \"error\": \"fixture-private-diagnostic\"}, \"consent\": false}, {\"name\": \"nil\", \"opened\": null, \"consent\": false}, {\"name\": \"array\", \"opened\": [], \"consent\": false}, {\"name\": \"missing-is_ok\", \"opened\": {\"error\": \"Waiting for the person to allow this app's agent (OctoSense asks the first time)\"}, \"consent\": false}, {\"name\": \"is_ok-string\", \"opened\": {\"is_ok\": \"false\", \"error\": \"Waiting for the person to allow this app's agent (OctoSense asks the first time)\"}, \"consent\": false}, {\"name\": \"is_ok-true\", \"opened\": {\"is_ok\": true, \"error\": \"Waiting for the person to allow this app's agent (OctoSense asks the first time)\"}, \"consent\": false}, {\"name\": \"error-object\", \"opened\": {\"is_ok\": false, \"error\": {\"message\": \"Waiting for the person to allow this app's agent (OctoSense asks the first time)\"}}, \"consent\": false}, {\"name\": \"error-number\", \"opened\": {\"is_ok\": false, \"error\": 12}, \"consent\": false}, {\"name\": \"error-too-long\", \"opened\": {\"is_ok\": false, \"error\": \"\"}, \"consent\": false}, {\"name\": \"near-prefix\", \"opened\": {\"is_ok\": false, \"error\": \"Waiting for the person to allow this app's agent (OctoSense asks the first time) \"}, \"consent\": false}, {\"name\": \"near-case\", \"opened\": {\"is_ok\": false, \"error\": \"waiting for the person to allow this app's agent (octosense asks the first time)\"}, \"consent\": false}, {\"name\": \"success\", \"opened\": {\"is_ok\": true, \"data\": {\"open\": true}}, \"consent\": false}, {\"name\": \"malformed-data\", \"opened\": {\"is_ok\": false, \"error\": \"Waiting for the person to allow this app's agent (OctoSense asks the first time)\", \"data\": \"malformed\"}, \"consent\": true}]".parse_json() let create_rows="[{\"name\": \"create-no-consent\", \"opened\": {\"is_ok\": false, \"error\": \"Waiting for the person to allow this app's agent (OctoSense asks the first time)\"}, \"services\": [\"octos.session.open\"], \"status\": \"blocked\", \"consent\": true, \"identity\": false, \"busy\": false}, {\"name\": \"create-unknown-refusal\", \"opened\": {\"is_ok\": false, \"error\": \"fixture-private-diagnostic\"}, \"services\": [\"octos.session.open\"], \"status\": \"blocked\", \"consent\": false, \"identity\": false, \"busy\": false}, {\"name\": \"create-turned-off\", \"opened\": {\"is_ok\": false, \"error\": \"Agent is turned off\"}, \"services\": [\"octos.session.open\"], \"status\": \"blocked\", \"consent\": false, \"identity\": false, \"busy\": false}, {\"name\": \"create-signin\", \"opened\": {\"is_ok\": false, \"error\": \"Sign in required\"}, \"services\": [\"octos.session.open\"], \"status\": \"blocked\", \"consent\": false, \"identity\": false, \"busy\": false}, {\"name\": \"create-open-false\", \"opened\": {\"is_ok\": true, \"data\": {\"open\": false}}, \"services\": [\"octos.session.open\"], \"status\": \"blocked\", \"consent\": false, \"identity\": false, \"busy\": false}, {\"name\": \"create-malformed-data\", \"opened\": {\"is_ok\": true, \"data\": []}, \"services\": [\"octos.session.open\"], \"status\": \"blocked\", \"consent\": false, \"identity\": false, \"busy\": false}, {\"name\": \"create-success\", \"opened\": {\"is_ok\": true, \"data\": {\"open\": true}}, \"services\": [\"octos.session.open\", \"octos.turn.start\", \"octos.session.history\"], \"status\": \"turn_completed\", \"consent\": false, \"identity\": false, \"busy\": false}, {\"name\": \"create-identity-changed\", \"opened\": {\"is_ok\": true, \"data\": {\"open\": true}}, \"services\": [\"octos.session.open\"], \"status\": \"blocked\", \"consent\": false, \"identity\": true, \"busy\": false}, {\"name\": \"create-busy-prevented\", \"opened\": {\"is_ok\": true, \"data\": {\"open\": true}}, \"services\": [], \"status\": \"idle\", \"consent\": false, \"identity\": false, \"busy\": true}]".parse_json() let results=[] let calls=[]
for row in direct_rows {
 let before=row.opened.to_json()
 let notice=calendar_agent_session_notice(row.opened,"提交合成请求","fixture-fallback")
 results.push({name:row.name notice:notice unchanged:before==row.opened.to_json()})
}
for row in create_rows {
 fixture_row=row fixture_services=[] fixture_saves=[]
 calendar_agent_busy=row.busy calendar_agent_writable=true
 calendar_agent_state={schema:1 request_id:"" turn_id:"" status:"idle" user_id:"fixture-user" accounts:["local"].to_json() previous_requests:[]}
 calendar_agent_preflight={status:"empty"} calendar_agent_history_settle=false calendar_agent_history_epoch=0
 calendar_agent_notice="" gm_user_id="fixture-user" gm_accounts=["local"]
 calendar_agent_submit_bound("合成查询请求",nil)
 let before=fixture_services.to_json()
 // Allowing consent later has no handler that replays this declined request.
 gm_user_id="fixture-user"
 let unchanged=before==fixture_services.to_json()
 calls.push({name:row.name notice:calendar_agent_notice services:fixture_services saves:fixture_saves state:calendar_agent_state busy:calendar_agent_busy no_auto_replay:unchanged})
}
({direct:results create:calls unexpected:fixture_unexpected}).to_json()
