+// The latest request can be a query. Keep the selected matter's receipt reachable.
+fn calendar_agent_request_matches_matter(record,goal){
+    if !gm_object(record) || record["user_id"] != gm_user_id || record["accounts"] != gm_accounts.to_json()
+        || !gm_string(record["request_id"],160) || record.request_id == "" { return false }
+    let binding = record["binding"]
+    if calendar_agent_binding_valid(binding) {
+        return binding.goal_id == goal.id && binding.project_id == gm_project && binding.owner_id == gm_owner
+            && binding.session_id == chat_selected_id && binding.payload.request_id == record.request_id
+    }
+    let mail = record["mail_source"]
+    return gm_object(mail) && mail["goal_id"] == goal.id && mail["session_id"] == chat_selected_id
+        && mail["project_id"] == gm_project && mail["owner_id"] == gm_owner && gm_account_allowed(mail["account_id"])
+}
+fn calendar_agent_request_for_matter(){
+    let goal = ac_current_goal()
+    if goal == nil { return nil }
+    if calendar_agent_request_matches_matter(calendar_agent_state,goal) { return calendar_agent_state }
+    for offset in calendar_agent_state.previous_requests.len() {
+        let record = calendar_agent_state.previous_requests[calendar_agent_state.previous_requests.len()-1-offset]
+        if calendar_agent_request_matches_matter(record,goal) { return record }
+    }
+    if fs.exists("calendar-request-archive.json") {
+        let archive = storage_read("calendar-request-archive.json").parse_json()
+        if gm_object(archive) && archive["schema"] == 1 && gm_array(archive["requests"]) {
+            for offset in archive.requests.len() {
+                let record = archive.requests[archive.requests.len()-1-offset]
+                if calendar_agent_request_matches_matter(record,goal) { return record }
+            }
+        }
+    }
+    return nil
+}
