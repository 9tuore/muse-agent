+    let notes = "\"notes\":" + payload.notes.to_json() + ","
+    return digest == "sha256:" + fs.sha256(head + place + notes + tail)
+        || (payload.location == "" && digest == "sha256:" + fs.sha256(head + notes + tail))
+        || (payload.notes == "" && digest == "sha256:" + fs.sha256(head + place + tail))
+        || (payload.location == "" && payload.notes == "" && digest == "sha256:" + fs.sha256(head + tail))
