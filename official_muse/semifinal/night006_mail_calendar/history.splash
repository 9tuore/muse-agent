let checks=[]
fn check(name,passed){checks.push({name:name passed:passed})}
fn receipt_rows(){
 let event={id:"mail-event" request_id:calendar_agent_state.request_id title:"Meeting" start:"2026-10-14T15:00" end:"2026-10-14T16:00" timezone:"Asia/Shanghai" location:"" notes:""}
 let args="{\"end\":"+event.end.to_json()+",\"location\":"+event.location.to_json()+",\"notes\":"+event.notes.to_json()+",\"request_id\":"+event.request_id.to_json()
  +",\"start\":"+event.start.to_json()+",\"timezone\":"+event.timezone.to_json()+",\"title\":"+event.title.to_json()+"}"
 let getargs="{\"id\":"+event.id.to_json()+"}"
 let rows=[]
 for tool in ["calendar.add_event","calendar.get_event"]{
  let call="call-add" let data={id:event.id start:event.start} let digest="sha256:"+fs.sha256(args)
  if tool=="calendar.get_event"{call="call-get" data={found:true event:event} digest="sha256:"+fs.sha256(getargs)}
  rows.push({role:"tool" lane:"person" turn_id:calendar_agent_state.turn_id thread_id:calendar_agent_state.turn_id tool_name:tool tool_call_id:"tool-"+call
   host_calendar_receipt:{source:"broker_tool_result" owner:"os.calendar" caller:"muse-goals" kernel_persisted:true
    turn_id:calendar_agent_state.turn_id tool_call_id:"tool-"+call call_id:call tool:tool terminal:"ok" session_id:"fixture-session" args_digest:digest result:{"ok":true data:data}}})
 }
 return rows
}
seed() mail_prepare_calendar() calendar_agent_submit_bound(calendar_agent_input_text,nil)
check("empty-history-does-not-claim-linked-event",calendar_agent_state["binding"]==nil)
history_rows=receipt_rows()
calendar_agent_history()
check("history-dispatch-adopts-mail-event",calendar_agent_state["binding"]!=nil && calendar_agent_state.binding.receipt_status=="verified")
let stored=storage_read("calendar-agent-state.json").parse_json()
check("independent-state-readback-has-exact-event",stored["binding"]!=nil && stored.binding.verification.event.id=="mail-event" && stored.binding.goal_id==ac_selected_id)
let stored_chat=storage_read("fixture-chat.json").parse_json()
check("independent-chat-readback-has-source-card",stored["binding"]!=nil && stored_chat[0].proposals[stored_chat[0].proposals.len()-1].id==stored.binding.candidate_id)
let cards=chat_sessions[0].proposals.len()
calendar_agent_history()
check("repeated-history-does-not-add-card",chat_sessions[0].proposals.len()==cards)
calendar_agent_submit_bound("查询今天",nil)
check("history-linked-event-survives-query",calendar_agent_authority()!=nil && calendar_agent_authority().event.id=="mail-event")
calendar_agent_state={schema:1 request_id:"" turn_id:"" status:"idle" user_id:"" accounts:"" previous_requests:[]}
calendar_agent_boot()
check("boot-preserves-linked-history-event",calendar_agent_authority()!=nil && calendar_agent_authority().event.id=="mail-event")
seed() mail_prepare_calendar() calendar_agent_submit_bound(calendar_agent_input_text,nil)
history_rows=receipt_rows() history_rows[1].host_calendar_receipt.owner="foreign.calendar"
calendar_agent_history()
check("history-rejects-wrong-owner",calendar_agent_state["binding"]==nil && calendar_agent_authority()==nil)
seed() mail_prepare_calendar() calendar_agent_submit_bound(calendar_agent_input_text,nil)
history_rows=receipt_rows() fail_store="fixture-chat.json"
calendar_agent_history()
check("history-shows-association-write-failure",calendar_agent_state["binding"]==nil && calendar_agent_notice.search("关联")>=0)
checks.to_json()
