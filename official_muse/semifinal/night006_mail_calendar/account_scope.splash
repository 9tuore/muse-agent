fn local_created(){
 seed() goals=[] ac_selected_id="" selected_id="" chat_sessions[0].goal_id="" chat_sessions[0].proposals=[]
 calendar_agent_state={schema:1 request_id:"" turn_id:"" status:"idle" user_id:"" accounts:"" previous_requests:[]}
 calendar_agent_submit_bound("明天下午3点开项目会，持续1小时",nil)
 history_rows=receipt_rows() calendar_agent_history()
}
local_created()
check("local-event-initially-has-authority",calendar_agent_authority()!=nil)
let original=calendar_agent_state.binding.to_json()
gm_set_accounts(["A","B"])
check("adding-second-mail-keeps-local-authority",calendar_agent_authority()!=nil)
check("adding-second-mail-keeps-local-delete-target",calendar_agent_delete_target()!=nil)
check("adding-second-mail-keeps-request-source-current",calendar_agent_request_context_current(calendar_agent_state.request_source))
let n=calls.len() calendar_agent_history()
check("adding-second-mail-allows-exact-readback",calls.len()==n+1 && calls[calls.len()-1].method=="octos.session.history")
check("mail-addition-does-not-rewrite-proof",calendar_agent_state.binding.to_json()==original)
calendar_agent_submit("改到下午5点")
check("adding-second-mail-keeps-same-id-edit",update_submissions.len()==1 && update_submissions[0].authority.event.id=="mail-event")
gm_set_accounts(["B","A"])
check("reordered-mail-list-keeps-local-authority",calendar_agent_authority()!=nil)
calendar_agent_submit_bound("查询今天",nil)
check("query-after-mail-addition-keeps-prior-event",calendar_agent_authority()!=nil && calendar_agent_authority().event.id=="mail-event")
gm_set_accounts(["B"])
calendar_agent_state={schema:1 request_id:"" turn_id:"" status:"idle" user_id:"" accounts:"" previous_requests:[]}
calendar_agent_boot()
check("boot-with-different-unrelated-mail-keeps-local-event",calendar_agent_authority()!=nil && calendar_agent_delete_target()!=nil)
for fault in ["user","project","owner","session","local-removed","goal-revised"]{
 local_created() gm_set_accounts(["A","B"])
 if fault=="user"{gm_user_id="different-user"}
 if fault=="project"{gm_project="different-project"}
 if fault=="owner"{gm_owner="different-owner"}
 if fault=="session"{chat_selected_id="different-session"}
 if fault=="local-removed"{gm_accounts=["A","B"]}
 if fault=="goal-revised"{goals[0].version=2}
 check("still-refuses-changed-"+fault,calendar_agent_authority()==nil && calendar_agent_delete_target()==nil)
}
seed() gm_set_accounts(["B"])
check("mail-origin-A-revoked-still-refused",calendar_agent_authority()==nil)
seed() gm_set_accounts(["A","B"])
check("mail-origin-snapshot-policy-not-broadened",calendar_agent_authority()==nil)
local_created()
let old_binding=calendar_agent_state.binding.to_json().parse_json()
let refreshed=old_binding.to_json().parse_json()
gm_set_accounts(["A","B"]) refreshed.accounts=gm_accounts.to_json()
check("mail-addition-does-not-bypass-duplicate-candidate-check",calendar_agent_same_candidate(old_binding,refreshed))
refreshed.account_id="B"
check("different-source-account-is-not-same-candidate",!calendar_agent_same_candidate(old_binding,refreshed))
seed() goals=[] ac_selected_id="" selected_id="" chat_sessions[0].goal_id="" chat_sessions[0].proposals=[]
calendar_agent_state={schema:1 request_id:"" turn_id:"" status:"idle" user_id:"" accounts:"" previous_requests:[]}
calendar_agent_submit_bound("明天下午3点开项目会，持续1小时",nil)
gm_set_accounts(["A","B"]) history_rows=receipt_rows() calendar_agent_history()
check("mail-addition-before-readback-still-adopts-local-result",calendar_agent_authority()!=nil)
let saved=storage_read("calendar-agent-state.json").parse_json()
check("mid-request-addition-keeps-internal-snapshot-consistent",saved["binding"]!=nil && saved.accounts==saved.binding.accounts)
calendar_agent_state={schema:1 request_id:"" turn_id:"" status:"idle" user_id:"" accounts:"" previous_requests:[]}
calendar_agent_boot()
check("mid-request-addition-restores-after-boot",calendar_agent_writable && calendar_agent_authority()!=nil)
seed()
chat_sessions[0].proposals[0].account_id="local"
let prepared=calendar_agent_state.binding.to_json().parse_json()
prepared.account_id="local" prepared.receipt_status="unknown"
calendar_agent_state={schema:1 request_id:"" turn_id:"" status:"idle" user_id:"" accounts:"" previous_requests:[]}
gm_set_accounts(["A","B"])
calendar_agent_submit_bound("创建已选中的精确候选",prepared)
let bound_saved=storage_read("calendar-agent-state.json").parse_json()
check("candidate-prepared-before-mail-addition-uses-consistent-new-request",bound_saved.binding.accounts==bound_saved.accounts)
calendar_agent_state={schema:1 request_id:"" turn_id:"" status:"idle" user_id:"" accounts:"" previous_requests:[]}
calendar_agent_boot()
check("candidate-prepared-before-mail-addition-still-loads",calendar_agent_writable && calendar_agent_state["binding"]!=nil)
checks.to_json()
