fn time_now(){return 1791907200}
fn random_u32(){serial=serial+1 return serial}
fn redraw(){} fn mail_redraw(){} fn set_page(value){page=value}
fn storage_read(path){return files[path]}
fn storage_write(path,value){if path==fail_store{return "fixture write failure"} files[path]=value return nil}
fn storage_hash_valid(value){return value.is_string() && value.len()==64}
fn gm_account_allowed(value){for a in gm_accounts{if a==value{return true}} return false}
fn gm_set_focus(project,owner){gm_project=project gm_owner=owner}
fn core_goal_index(id){for i in goals.len(){if goals[i].id==id{return i}}return -1}
fn ac_current_goal(){let i=core_goal_index(ac_selected_id) if i<0{return nil}return goals[i]}
fn ac_goal_allowed(goal){return goal.project_id==gm_project && goal.owner_id==gm_owner}
fn ac_choose_matter(id){ac_selected_id=id ac_selected_chat=chat_selected_id}
fn ac_add(view,title,status,detail,id){view.rows.push({title:title status:status detail:detail id:id})}
fn chat_session_index(id){for i in chat_sessions.len(){if chat_sessions[i].id==id{return i}}return -1}
fn chat_card_scope_current(session,card){return card.project==session.focus_project && card.owner==session.focus_owner}
fn chat_reply_context_valid(card){return true}
fn chat_save(){return storage_write("fixture-chat.json",chat_sessions.to_json())==nil}
fn chat_bind_goal(id){let i=chat_session_index(chat_selected_id) if i<0{return false}chat_sessions[i].goal_id=id return chat_save()}
fn chat_select_session(id){let i=chat_session_index(id) if i<0{return false}chat_selected_id=id gm_set_focus(chat_sessions[i].focus_project,chat_sessions[i].focus_owner)return true}
fn mail_watch_account(id){if id=="A"{return {id:"A"}}return nil}
fn core_add_goal(goal){if core_goal_index(goal.id)>=0{return false}goals.push(goal) selected_id=goal.id return storage_write("fixture-goals.json",goals.to_json())==nil}
fn core_upsert_goal(goal){let i=core_goal_index(goal.id) if i<0{return false}goals[i]=goal return storage_write("fixture-goals.json",goals.to_json())==nil}
fn goal_spec(id,revision,objective,path){return {id:id revision:revision objective:objective path:path}}
fn core_utc_iso(value){return "2026-10-13T16:00:00Z"}

