 chat_sessions=[{id:chat_selected_id focus_project:gm_project focus_owner:gm_owner goal_id:"goal-a" proposals:[{id:"card-a" action:"calendar_candidate" state:"opened" payload:candidate account_id:"A" revision:1 project:gm_project owner:gm_owner}]}]
 calendar_agent_state={schema:1 request_id:"create-a" turn_id:"turn-a" status:"turn_completed" user_id:gm_user_id accounts:gm_accounts.to_json()
  binding:binding mail_source:{account_id:"A" message_id:"mail-a" subject:"Fixture invitation" address:"self@fixture.invalid"} previous_requests:[]}
 mail_account={id:"A"} mail_selected={id:"mail-b" subject:"Project meeting" body:"2026年10月14日下午3点项目会，持续1小时。" address:"self@fixture.invalid"}
