let fixture_clock = 1700000000
let fixture_serial = 0
fn time_now(){return fixture_clock}
fn random_u32(){fixture_serial=fixture_serial+1 return fixture_serial}
let fs = {exists: |path| fixture_files[path] != nil sha256: |value| mod.fixture.sha256(value) mkdir: |path| nil sha256_file: |path| mod.fixture.sha256(fixture_read(path))}
let checks = {}
fn seed(){
    calendar_agent_delete_state={schema:1 records:[]} calendar_agent_delete_writable=true calendar_agent_delete_selected="" calendar_agent_delete_epoch=0
    calendar_agent_update_state={schema:1 records:[]} calendar_agent_update_writable=true calendar_agent_update_selected="" calendar_agent_update_epoch=0
    mail_draft={account:"" to:"" subject:"" body:"" status:"DRAFT" preview:"" attempt:"" request_id:""
        accepted_at:0 verified_at:0 verified_id:"" link_goal_id:"" link_event_id:"" link_run_id:"" incoming_key:""}
    mail_draft_writable=true mail_draft_last_state="" mail_sending=false mail_pending=false mail_model_pending=false
    mail_accounts=[{id:"fixture-account"}] mail_account=mail_accounts[0] activity=[] core_activity_ready=true core_last_activity=""
    chat_requests=[]
    fixture_files={} fixture_write_fail=false fixture_write_fail_path="" fixture_read_fail=false fixture_pending=[]
    core_storage_ready=true gm_ready=true chat_ready=true
    gm_user_id="fixture-user" gm_accounts=["local","fixture-account"] gm_project="fixture-project" gm_owner="fixture-owner"
    goals=[] runs=[] actions=[] core_last_goals="" task=nil
    chat_selected_id="chat:fixture" ac_selected_chat=chat_selected_id ac_selected_id=""
    chat_last_state="" messages=[] page="Chat"
    chat_sessions=[{id:chat_selected_id title:"fixture" created_at:fixture_clock updated_at:fixture_clock
        messages:[] proposals:[] focus_project:gm_project focus_owner:gm_owner goal_id:""}]
    calendar_agent_state={schema:1 request_id:"" turn_id:"" status:"idle" user_id:"" accounts:"" previous_requests:[]}
    calendar_agent_busy=false calendar_agent_writable=true calendar_agent_history_settle=false
    calendar_agent_history_epoch=0 calendar_agent_candidate=nil
    calendar_agent_reply="" calendar_agent_evidence="" calendar_agent_input_text="" calendar_agent_details=false
}
fn fixture_card(){return {id:"card:fixture" action:"calendar_candidate" state:"candidate" session_id:chat_selected_id
    project:gm_project owner:gm_owner account_id:"fixture-account" revision:1
    payload:{to:"" subject:"" body:"" objective:"" source:"synthetic-mail:first:meeting"
        title:"fixture meeting" start:"2030-12-12T10:00:00+08:00" end:"2030-12-12T11:00:00+08:00" time_zone:"Asia/Shanghai" location:"fixture"}}}
fn fixture_bound(){
    let card=fixture_card()
    chat_sessions[0].proposals.push(card)
    if !calendar_agent_ensure_matter(card){return false}
    return calendar_agent_prepare_candidate(card)
}
fn fixture_turn(){
    calendar_agent_state={schema:1 request_id:"request:fixture" turn_id:"turn:fixture" status:"turn_completed"
        user_id:gm_user_id accounts:gm_accounts.to_json() previous_requests:[]}
    calendar_agent_save()
}
fn fixture_row(tool,terminal,result_ok){
    let reply={} reply["ok"]=result_ok reply.data={}
    return {role:"tool" lane:"person" turn_id:"turn:fixture" tool_name:tool tool_call_id:"tool:fixture"
    host_calendar_receipt:{source:"broker_tool_result" owner:"os.calendar" caller:"muse-goals" kernel_persisted:true
        turn_id:"turn:fixture" tool_call_id:"tool:fixture" call_id:"call:fixture" tool:tool terminal:terminal result:reply}}}

let fixture_to="" let fixture_subject="" let fixture_body=""
let ui={mail_to:{text:||fixture_to set_text:|value|{fixture_to=value}}
    mail_subject:{text:||fixture_subject set_text:|value|{fixture_subject=value}}
    mail_body:{text:||fixture_body set_text:|value|{fixture_body=value}}
    mail_test_id:{text:||""}}
fn receipt_row(tool,turn,serial,digest,data){
    let reply={} reply["ok"]=true reply.data=data
    return {role:"tool" lane:"person" turn_id:turn thread_id:turn tool_name:tool tool_call_id:"tool:"+serial
        host_calendar_receipt:{source:"broker_tool_result" owner:"os.calendar" caller:"muse-goals" kernel_persisted:true
            turn_id:turn tool_call_id:"tool:"+serial call_id:"call:"+serial tool:calendar_agent_tool_name(tool)
            session_id:"kernel:fixture" args_digest:digest terminal:"ok" result:reply}}
}
fn verified_create(){
    if !fixture_bound(){return false}
    calendar_agent_submit_candidate()
    fixture_pending[0].callback({is_ok:true data:{open:true}})
    fixture_pending[1].callback({is_ok:true data:{turn_id:"turn:create" text:"created"}})
    let payload=calendar_agent_state.binding.payload
    let event={end:payload.end id:"event:stable" location:payload.location notes:payload.notes
        request_id:payload.request_id start:payload.start timezone:payload.timezone title:payload.title}
    let add_json="{\"end\":"+payload.end.to_json()+",\"location\":"+payload.location.to_json()
        +",\"notes\":"+payload.notes.to_json()+",\"request_id\":"+payload.request_id.to_json()
        +",\"start\":"+payload.start.to_json()+",\"timezone\":"+payload.timezone.to_json()+",\"title\":"+payload.title.to_json()+"}"
    let add_digest="sha256:"+fs.sha256(add_json)
    let get_digest="sha256:"+fs.sha256("{\"id\":"+event.id.to_json()+"}")
    fixture_pending[2].callback({is_ok:true data:{messages:[
        receipt_row("calendar.add_event","turn:create","create",add_digest,{id:event.id start:event.start})
        receipt_row("calendar.get_event","turn:create","create-get",get_digest,{found:true event:event})]}})
    fixture_pending=[]
    return calendar_agent_state.binding.receipt_status=="verified"
}
fn second_mail_candidate(){
    let card=fixture_card() card.id="card:second-mail" card.goal_id=goals[0].id
    card.payload.source="synthetic-mail:second:reschedule" card.payload.start="2030-12-13T14:00:00+08:00"
    card.payload.end="2030-12-13T15:00:00+08:00" card.payload.location="second room"
    chat_sessions[0].proposals.push(card)
    return calendar_agent_ensure_matter(card) && calendar_agent_prepare_candidate(card)
}
fn prepared_update(){
    if !verified_create() || !second_mail_candidate(){return false}
    calendar_agent_update_select()
    return calendar_agent_update_state.records.len()==1 && calendar_agent_update_selected!=""
}
fn completed_update(){
    if !prepared_update(){return false}
    calendar_agent_update_confirm()
    fixture_pending[0].callback({is_ok:true data:{open:true}})
    fixture_pending[1].callback({is_ok:true data:{turn_id:"turn:update" text:"updated"}})
    return calendar_agent_update_state.records[0].status=="turn_completed" && fixture_pending.len()==3
}
fn update_rows(record){return [
    receipt_row("calendar.get_event",record.turn_id,"before",record.get_digest,{found:true event:record.expected.to_json().parse_json()})
    receipt_row("calendar.update_event",record.turn_id,"update",record.update_digest,{event:record.event.to_json().parse_json()})
    receipt_row("calendar.get_event",record.turn_id,"after",record.get_digest,{found:true event:record.event.to_json().parse_json()})]}
fn make_link(authority){
    let link={request_id:authority.creation_request_id turn_id:authority.creation_turn_id mail_account:mail_account.id
        binding:authority.binding.to_json().parse_json()}
    if gm_has(authority,"update"){link.authority=authority.to_json().parse_json()}
    return link
}
fn linked_draft(authority){
    mail_draft.account=mail_account.id mail_draft.to="person@example.invalid" mail_draft.subject="Original subject" mail_draft.body="My handwritten body"
    mail_draft.official_calendar=make_link(authority)
    mail_draft.link_goal_id=authority.binding.goal_id mail_draft.link_event_id=authority.event.id mail_draft.link_run_id=""
    return mail_calendar_current(mail_draft)
}
fn finish_update(){
    let record=calendar_agent_update_state.records[0]
    fixture_pending[2].callback({is_ok:true data:{messages:update_rows(record)}})
    return record.receipt_status=="verified"
}
fn add_other_goal(){
 let goal=goals[0].to_json().parse_json()
 goal.id="goal:unrelated" goal.goal="different event" goal.source="synthetic:unrelated" goal.result_path="results/unrelated.json"
 goal.goal_spec=goal_spec(goal.id,goal.version,goal.goal,goal.result_path)
 return core_add_goal(goal)
}

let completion_timers=[] let completion_compose=nil let completion_rpc=[] let completion_mode="accepted"
fn start_timeout(delay,callback){completion_timers.push(callback)}
fn completion_drain(){
    let steps=0
    while (completion_timers.len()>0 || fixture_pending.len()>0) && steps<200 {
        if completion_timers.len()>0 {
            let callback=completion_timers[0] let rest=[]
            for i in completion_timers.len(){if i>0{rest.push(completion_timers[i])}}
            completion_timers=rest callback()
        } else {
            let request=fixture_pending[0] let rest=[]
            for i in fixture_pending.len(){if i>0{rest.push(fixture_pending[i])}}
            fixture_pending=rest completion_rpc.push(request.method)
            if request.method=="mail.compose" {
                completion_compose=request.payload.to_json().parse_json()
                completion_compose.compose_id="compose-completion" completion_compose.revision=1 completion_compose.status="draft"
                request.callback({is_ok:true data:completion_compose})
            } else if request.method=="mail.review_send" {
                completion_compose.status=completion_mode
                request.callback({is_ok:true data:{accepted:completion_mode=="accepted" status:completion_mode
                    compose_id:completion_compose.compose_id revision:1 operation_id:"operation:completion"}})
            } else {request.callback({is_ok:false error:"Unexpected fixture RPC"})}
        }
        steps=steps+1
    }
}
fn completion_seed(updated,mode){
    seed() completion_timers=[] completion_rpc=[] completion_compose=nil completion_mode=mode
    mail_verifying=false mail_watch_writable=true mail_error="" mail_notice=""
    memory=[] memory_sources=[] memory_forget=[] core_last_memory="" core_memory_ready=true gm_boot_pending=false
    if updated { if !completed_update() || !finish_update(){return false} }
    else if !verified_create(){return false}
    fixture_pending=[]
    if !linked_draft(calendar_agent_authority()){return false}
    fixture_to=mail_draft.to fixture_subject=mail_draft.subject fixture_body=mail_draft.body
    let methods=[]
    for name in ["mail.compose","mail.review_send","mail.compose_status"] {
        methods.push({implemented:true supported:true descriptor:{name:name version:1}})
    }
    official_discovery={methods:methods} official_discovery_done=true
    mail_preview() mail_send_confirmed() completion_drain()
    return core_action_index(mail_draft.request_id)>=0
}
let observed={}
checks.production_mail_send_after_creation=completion_seed(false,"accepted") && mail_draft.status=="accepted" && actions[0].status=="accepted"
checks.accepted_no_completion=goals[0].status=="planned" && runs.len()==0 && memory.len()==0
mail_verify_received() completion_drain()
checks.production_user_receipt_saved=mail_draft.status=="verified" && actions[0].status=="verified" && mail_draft.verified_at>0 && mail_draft.verified_id==mail_draft.request_id
checks.native_creation_goal_completed=goals[0].status=="completed" && runs.len()==1 && runs[0].status=="completed"
let remembered=false
for item in memory {if gm_completed_receipt(item.document){remembered=true}}
checks.native_creation_completed_memory=remembered
observed.creation={goal:goals[0] runs:runs memory:memory draft:mail_draft error:mail_error calls:completion_rpc}
checks.production_mail_send_after_update=completion_seed(true,"accepted") && mail_draft.status=="accepted" && goals[0].version==2
mail_verify_received() completion_drain()
checks.native_update_goal_completed=goals[0].status=="completed" && runs.len()==1 && runs[0].plan_revision==2 && runs[0].status=="completed"
remembered=false
for item in memory {if gm_completed_receipt(item.document){remembered=true}}
checks.native_update_completed_memory=remembered
observed.updated={goal:goals[0] runs:runs memory:memory draft:mail_draft error:mail_error calls:completion_rpc}
checks.completed_latest_authority_retained=calendar_agent_authority()!=nil && mail_calendar_current(mail_draft)
let before_replay=completion_rpc.len()
let saved_result=fixture_read(goals[0].result_path)
mail_finish_linked_result() completion_drain()
checks.completed_replay_one_run_one_memory=runs.len()==1 && memory.len()==1 && fixture_read(goals[0].result_path)==saved_result
checks.completed_replay_no_mail_dispatch=completion_rpc.len()==before_replay
checks.nil_completion_goal_rejected=!mail_native_completion_matches(nil,nil)

completion_seed(true,"accepted")
let other_saved=add_other_goal()
ac_choose_matter("goal:unrelated") other_saved=other_saved && ac_selected_id=="goal:unrelated"
mail_verify_received() completion_drain() mail_finish_linked_result() completion_drain()
checks.other_goal_user_selection_saved=other_saved
checks.other_goal_no_completion=runs.len()==0 && memory.len()==0 && goals[0].status=="planned" && goals[1].status=="planned" && mail_draft.status=="accepted"

completion_seed(true,"accepted")
let next=goals[0].to_json().parse_json()
next.version=3 next.result_path="results/new-revision-v3.json" next.goal_spec=goal_spec(next.id,next.version,next.goal,next.result_path)
checks.new_revision_replanned=core_replan_goal(next.id,next)
mail_verify_received() completion_drain() mail_finish_linked_result() completion_drain()
observed.revision={error:core_error goals:goals next:next}
checks.stale_revision_no_completion=runs.len()==0 && memory.len()==0 && goals[0].status=="planned" && mail_draft.status=="accepted"

completion_seed(true,"accepted")
gm_user_id="fixture-different-user"
mail_verify_received() completion_drain() mail_finish_linked_result() completion_drain()
checks.other_user_no_completion=runs.len()==0 && memory.len()==0 && goals[0].status=="planned" && mail_draft.status=="accepted"

completion_seed(true,"accepted")
fixture_write_fail_path=goals[0].result_path
mail_verify_received() completion_drain()
checks.result_write_failure_no_completion=runs.len()==0 && memory.len()==0 && goals[0].status=="planned" && mail_draft.status=="verified"
fixture_write_fail_path=""
let retry_calls=completion_rpc.len()
mail_finish_linked_result() completion_drain()
checks.write_retry_completes_once=runs.len()==1 && memory.len()==1 && goals[0].status=="completed"
checks.write_retry_no_mail_dispatch=completion_rpc.len()==retry_calls

completion_seed(true,"accepted")
mail_verify_received()
// Drain the four production receipt phases, stopping before native Run creation.
for i in 4 {
 let callback=completion_timers[0] let rest=[]
 for j in completion_timers.len(){if j>0{rest.push(completion_timers[j])}}
 completion_timers=rest callback()
}
checks.prepared_receipt_before_run=mail_draft.status=="verified" && runs.len()==0 && fs.exists(goals[0].result_path)
fixture_write_fail_path=goals[0].result_path
completion_drain()
checks.run_rewrite_failure_pending=goals[0].status=="running" && runs.len()==1 && memory.len()==0
fixture_write_fail_path=""
retry_calls=completion_rpc.len()
mail_finish_linked_result() completion_drain()
observed.rewrite={goal:goals[0] runs:runs memory:memory draft:mail_draft error:mail_error
 native_matches:mail_native_completion_matches(goals[0],calendar_agent_update_state.records[0])
 authority_available:calendar_agent_authority()!=nil artifact:fixture_read(goals[0].result_path).parse_json()}
checks.run_rewrite_retry_same_run=runs.len()==1 && runs[0].status=="completed" && memory.len()==1 && goals[0].status=="completed"
checks.run_rewrite_retry_no_mail_dispatch=completion_rpc.len()==retry_calls

completion_seed(true,"accepted")
mail_verify_received()
for i in 4 {
 let callback=completion_timers[0] let rest=[]
 for j in completion_timers.len(){if j>0{rest.push(completion_timers[j])}}
 completion_timers=rest callback()
}
add_other_goal() ac_choose_matter("goal:unrelated")
completion_drain()
checks.selection_changed_after_prepare_no_completion=runs.len()==0 && memory.len()==0 && goals[0].status=="planned" && goals[1].status=="planned"
completion_seed(true,"accepted")
fixture_write_fail_path="activity.json"
mail_verify_received() completion_drain()
checks.missing_saved_receiver_declaration_no_completion=mail_draft.status=="verified" && actions[0].status=="verified" && goals[0].status=="planned" && runs.len()==0 && memory.len()==0
fixture_write_fail_path=""

completion_seed(true,"accepted")
mail_verify_received() completion_drain()
let exact_receipt=fixture_read(goals[0].result_path)
let changed_receipt=exact_receipt.parse_json()
changed_receipt.extra="altered after source digest"
fixture_write(goals[0].result_path,changed_receipt.to_json())
checks.changed_result_digest_invalidates_completion_authority=calendar_agent_authority()==nil && !mail_calendar_current(mail_draft)
let tamper_calls=completion_rpc.len()
mail_finish_linked_result() completion_drain()
checks.changed_result_no_new_completion_or_dispatch=runs.len()==1 && memory.len()==1 && completion_rpc.len()==tamper_calls
fixture_write(goals[0].result_path,exact_receipt)
checks.restored_exact_result_authority_returns=calendar_agent_authority()!=nil
completion_seed(true,"accepted")
mail_verify_received()
for i in 4 {
 let callback=completion_timers[0] let rest=[]
 for j in completion_timers.len(){if j>0{rest.push(completion_timers[j])}}
 completion_timers=rest callback()
}
let original_prepared=fixture_read(goals[0].result_path)
let malformed=original_prepared.parse_json()
malformed.receiver_declaration.request_id="different-request"
fixture_write(goals[0].result_path,malformed.to_json())
completion_drain()
mail_finish_linked_result() completion_drain()
checks.malformed_prepared_receipt_no_completion=runs.len()==0 && memory.len()==0 && goals[0].status=="planned"
fixture_write(goals[0].result_path,original_prepared)
mail_finish_linked_result() completion_drain()
checks.exact_prepared_receipt_retry_completes=runs.len()==1 && memory.len()==1 && goals[0].status=="completed"
checks.production_unknown_saved=completion_seed(true,"unknown") && mail_draft.status=="unknown"
mail_verify_received() completion_drain() mail_finish_linked_result() completion_drain()
checks.unknown_no_completion=goals[0].status=="planned" && runs.len()==0 && memory.len()==0
({checks:checks observed:observed boundary:"Real production send/receipt/completion functions; Calendar history and Mail transport/UI/user declaration are synthetic. No fixture writes verified/completed Goal, Run, Action or Memory states."}).to_json()
