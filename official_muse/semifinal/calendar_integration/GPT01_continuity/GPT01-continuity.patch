+    fn continuity_action(&mut self, action: LoopAction) {
+        if self.model.continuity.busy {
+            let command = Command::Continuity(action);
+            if !self.queued.contains(&command) { self.queued.push(command); }
+            return;
+        }
+        if matches!(action, LoopAction::Enable | LoopAction::Resume) && !self.continuity_policy() {
+            self.continuity_error(continuity::POLICY_MISSING, false);
+            return;
+        }
+        if matches!(action, LoopAction::Refresh | LoopAction::Enable | LoopAction::Resume) {
+            self.list_continuity((action != LoopAction::Refresh).then_some(action));
+            return;
+        }
+        self.send_continuity_control(action);
+    }
+
+    fn send_continuity_control(&mut self, action: LoopAction) {
+        let state = &self.model.continuity;
+        if action == LoopAction::Enable {
+            if state.loop_id.is_some() || state.uncertain || !state.checked {
+                self.continuity_error("已有或未确认的循环；请刷新，不会重复创建。", false);
+                return;
+            }
+        } else if state.loop_id.is_none() {
+            self.continuity_error("没有可控制的真实循环 ID。", false);
+            return;
+        }
+        if action == LoopAction::Resume {
+            let now = std::time::SystemTime::now().duration_since(std::time::UNIX_EPOCH).unwrap_or_default().as_millis() as i64;
+            if !state.checked || state.uncertain || !state.record.as_ref().is_some_and(|r| r.status == "paused" && r.expires_at_ms > now) {
+                self.continuity_error("循环尚未核实为可恢复的暂停状态。", false);
+                return;
+            }
+        }
+        let id = state.loop_id.clone();
+        let params = if action == LoopAction::Enable {
+            json!({"session_id": SYSTEM_SESSION, "profile_id": SYSTEM_PROFILE, "prompt": continuity::PROMPT,
+                "mode": "fixed_interval", "interval_seconds": continuity::INTERVAL_SECONDS})
+        } else { json!({"session_id": SYSTEM_SESSION, "profile_id": SYSTEM_PROFILE, "loop_id": id}) };
+        let mut state = self.model.continuity.clone();
+        state.busy = true;
+        state.uncertain = true;
+        state.error = None;
+        self.model.set_continuity(state);
+        self.wanted = true;
+        if !self.request(action.method(), params, Pending::LoopControl { action, id }) {
+            self.continuity_error("循环请求中断，结果未知；请刷新，不会重试创建。", true);
+        }
+    }
+
+    fn continuity_list_reply(&mut self, result: Option<&Value>, error: Option<String>, then: Option<LoopAction>) {
+        let parsed = (|| -> Result<Option<LoopRecord>, String> {
+            if let Some(e) = error { return Err(e); }
+            let v = result.ok_or("循环查询没有结果。")?;
+            if v["session_id"].as_str() != Some(SYSTEM_SESSION) || v["profile_id"].as_str() != Some(SYSTEM_PROFILE) {
+                return Err("循环查询的会话或 profile 不匹配。".into());
+            }
+            let rows = v["loops"].as_array().ok_or("循环查询没有有效的 loops 列表。")?;
+            let known = self.model.continuity.loop_id.as_deref();
+            let candidates: Vec<&Value> = rows.iter().filter(|r| match known {
+                Some(id) => r["loop_id"].as_str() == Some(id),
+                None => r["prompt"].as_str() == Some(continuity::PROMPT),
+            }).collect();
+            if candidates.len() > 1 { return Err("发现多个持续循环，不能确定归属；不会创建。".into()); }
+            candidates.first().map(|r| LoopRecord::parse(r)).transpose()
+        })();
+        match parsed {
+            Err(e) => self.continuity_error(&e, true),
+            Ok(record) => {
+                let mut state = self.model.continuity.clone();
+                state.busy = false;
+                state.checked = true;
+                state.error = None;
+                if let Some(r) = &record { state.loop_id = Some(r.loop_id.clone()); state.uncertain = false; }
+                else if state.loop_id.is_some() || state.uncertain {
+                    state.error = Some("原循环未找到或创建结果未知；不会自动重建。".into());
+                }
+                state.record = record;
+                self.model.set_continuity(state);
+                match then {
+                    Some(LoopAction::Enable) if self.model.continuity.record.is_none() => self.send_continuity_control(LoopAction::Enable),
+                    Some(LoopAction::Resume) => self.send_continuity_control(LoopAction::Resume),
+                    _ => {}
+                }
+            }
+        }
+        self.flush_continuity_commands();
+        self.release_continuity_link();
+    }
+
+    fn continuity_control_reply(&mut self, result: Option<&Value>, error: Option<String>, action: LoopAction, id: Option<String>) {
+        if let Some(e) = error {
+            // Do not infer that an error means a mutation never committed.
+            // A list of the real record must resolve the outcome first.
+            self.continuity_error(&e, true);
+        } else {
+            let parsed = (|| -> Result<LoopRecord, String> {
+                let v = result.ok_or("循环控制没有结果。")?;
+                let r = LoopRecord::parse(&v["loop"])?;
+                let expected = match action { LoopAction::Enable | LoopAction::Resume => "active", LoopAction::Pause => "paused", LoopAction::Delete => "deleted", LoopAction::Refresh => unreachable!() };
+                if v["ok"] != true || v["session_id"].as_str() != Some(SYSTEM_SESSION)
+                    || (!v["profile_id"].is_null() && v["profile_id"].as_str() != Some(SYSTEM_PROFILE))
+                    || v["loop_id"].as_str() != Some(r.loop_id.as_str())
+                    || id.as_ref().is_some_and(|id| *id != r.loop_id) || r.status != expected
+                    || (action == LoopAction::Delete && v["deleted"] != true) {
+                    return Err("循环控制未返回匹配的成功终态。".into());
+                }
+                Ok(r)
+            })();
+            match parsed {
+                Err(e) => self.continuity_error(&e, true),
+                Ok(r) => {
+                    let mut state = self.model.continuity.clone();
+                    state.busy = false; state.checked = true; state.uncertain = false; state.error = None;
+                    state.loop_id = (action != LoopAction::Delete).then(|| r.loop_id.clone());
+                    state.record = (action != LoopAction::Delete).then_some(r);
+                    self.model.set_continuity(state);
+                }
+            }
+        }
+        self.flush_continuity_commands();
+        self.release_continuity_link();
+    }
+
+    fn flush_continuity_commands(&mut self) {
+        if self.opened && !self.model.continuity.busy {
+            for command in std::mem::take(&mut self.queued) { self.command(command); }
+        }
+    }
+
+    fn release_continuity_link(&mut self) {
+        if !self.pane_open && !self.model.continuity.busy && !self.model.continuity.keep_connection()
+            && self.model.phase().running_turn().is_none() {
+            self.wanted = false;
+            self.drop_link();
+            self.model.set_phase(Phase::Idle);
         }
     }
 
