+// Test-only bridge: all replies below originate from actual Broker/Kernel/owner
+// calls. Model planning and approval gestures are explicit synthetic fixtures.
+fn night004_bridge_emit(root:&Path,request:&Value,result:Result<Value,String>){
+    use std::io::Write;
+    let response=match result{Ok(data)=>json!({"request_id":request["request_id"],"method":request["method"],"is_ok":true,"data":data}),
+        Err(error)=>json!({"request_id":request["request_id"],"method":request["method"],"is_ok":false,"error":{"kind":"bridge_error","message":error}})};
+    let mut log=std::fs::OpenOptions::new().create(true).append(true).open(root.join("bridge-replies.jsonl")).unwrap();
+    writeln!(log,"{response}").unwrap();println!("NIGHT004_BRIDGE_JSON {response}");std::io::stdout().flush().unwrap();
+}
+fn night004_bridge_copy(source:&Path,dest:&Path)->Result<(),String>{
+    let meta=std::fs::symlink_metadata(source).map_err(|e|e.to_string())?;
+    if meta.file_type().is_symlink(){return Err("Signed fixture sources may not be symlinks".into());}
+    if meta.is_dir(){std::fs::create_dir_all(dest).map_err(|e|e.to_string())?;
+        for entry in std::fs::read_dir(source).map_err(|e|e.to_string())?{let entry=entry.map_err(|e|e.to_string())?;
+            night004_bridge_copy(&entry.path(),&dest.join(entry.file_name()))?;}}
+    else if dest.is_file(){if std::fs::read(source).map_err(|e|e.to_string())?!=std::fs::read(dest).map_err(|e|e.to_string())?{
+        return Err("Restart cannot replace an existing frozen bundle/catalog".into());}}
+    else{std::fs::copy(source,dest).map_err(|e|e.to_string())?;}
+    Ok(())
+}
+fn night004_bridge_session(root:&Path,session:&str){
+    if session.is_empty(){return;}
+    let file=root.join("observed-kernel-sessions.json");
+    let mut sessions:Vec<String>=if file.is_file(){serde_json::from_slice(&std::fs::read(&file).unwrap()).unwrap()}else{Vec::new()};
+    if !sessions.iter().any(|s|s==session){sessions.push(session.into());std::fs::write(file,serde_json::to_vec_pretty(&sessions).unwrap()).unwrap();}
+}
