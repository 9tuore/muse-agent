// PREPARED_NOT_EXECUTED. Use a separate exact clone for EVERY case.
// Production Main entry points, original prompts, actual Kernel/Calendar.
// Model candidate, UI selection and model tool choice remain explicit fixtures.
// A first submission must read/warn and await a separate choice before a write.
let overlap_checks = {}
let overlap_observations = {}
fn overlap_query(args_json){
    let result = {events:[] receipt:nil}
    result["ok"] = false
    calendar_agent_submit("仅查询官方日历事件列表；不新增、改期、删除、通知或发送邮件。精确 calendar.events 参数：" + args_json)
    if calendar_agent_state.status != "turn_completed" || calendar_agent_state["binding"] != nil { return result }
    let history = fixture_rpc("octos.session.history",{})
    if !history.is_ok { return result }
    if !gm_object(history.data) { return result }
    if !gm_array(history.data["messages"]) { return result }
    let count = 0 let mutations = 0
    for row in history.data.messages {
        if gm_object(row) {
            let turn = row["turn_id"] if turn == nil { turn = row["thread_id"] }
            if turn == calendar_agent_state.turn_id && row["role"] == "tool" {
                if calendar_agent_tool_name(row["tool_name"]) != "calendar.events" { mutations = mutations + 1 }
                else if row["lane"] == "person" && calendar_agent_receipt_status(row) == "ok" {
                    let receipt = row.host_calendar_receipt
                    if receipt["args_digest"] == "sha256:" + fs.sha256(args_json)
                        && gm_array(receipt.result.data["events"]) {
                        count = count + 1 result.events = receipt.result.data.events result.receipt = receipt
                    }
                }
            }
        }
    }
    result["ok"] = count == 1 && mutations == 0
    if result["ok"] { calendar_agent_history_settle = true calendar_agent_history() }
    if calendar_agent_state.status != "idle" { result["ok"] = false }
    return result
}
fn overlap_matching(events,expected){
    let count = 0
    for event in events { if calendar_agent_event_json(event) == calendar_agent_event_json(expected) { count = count + 1 } }
    return count
}
fn native_overlap_probe(){
    overlap_checks.production_boot = core_boot_goals() && core_boot_activity() && core_boot_memory() && gm_boot() && chat_boot_data()
    if !overlap_checks.production_boot { return }
    if !fs.exists("l3-native-checkpoint.json") { overlap_checks.original_checkpoint_present = false return }
    let checkpoint = storage_read("l3-native-checkpoint.json").parse_json()
    if !gm_object(checkpoint) { overlap_checks.original_checkpoint_present = false return }
    let expected = checkpoint.event
    overlap_checks.exact_original_anchor = expected.id == "ev-1791775730787"
        && expected.request_id == "muse-calendar-1791741568-7" && expected.timezone == "Asia/Shanghai"
        && expected.start == "2026-10-13T16:00" && expected.end == "2026-10-13T16:30"
    if !overlap_checks.exact_original_anchor { return }
    mail_accounts_load()
    overlap_checks.actual_mail_account = mail_accounts.len() == 1
    if !overlap_checks.actual_mail_account { return }
    mail_account = mail_accounts[0] gm_set_accounts(["local",mail_account.id])
    gm_set_focus("synthetic-project","synthetic-owner")
    calendar_agent_boot() boot_restore("")
    let owner_before = fixture_rpc("fixture/logsideeffects",{}).data
    let sha_before = fixture_rpc("fixture/owner-store-sha",{}).data.sha256
    overlap_checks.one_exact_owner_before = owner_before.events.len() == 1
        && overlap_matching(owner_before.events,expected) == 1
        && sha_before == "103a5a86b630f772b0c560541a48a856cd1f9b300183baf4088d651b9017668a"
    overlap_checks.exact_baseline_counts = goals.len() == 1 && runs.len() == 1 && memory.len() == 3
    if !overlap_checks.one_exact_owner_before || !overlap_checks.exact_baseline_counts { return }
    let original_goals = goals.to_json() let original_runs = runs.to_json() let original_actions = actions.to_json()
    let original_memory = memory.to_json() let original_draft = mail_draft.to_json()
    if calendar_agent_state.request_id != "" { calendar_agent_keep_previous() }
    let full = overlap_query("{}")
    overlap_checks.actual_complete_one_event_query = full["ok"] && full.events.len() == 1 && overlap_matching(full.events,expected) == 1
    let bounded_json = "{\"from\":" + overlap_start.to_json() + ",\"limit\":200,\"to\":" + overlap_end.to_json() + "}"
    let bounded = overlap_query(bounded_json)
    overlap_checks.actual_bounded_query_contract = bounded["ok"] && overlap_matching(bounded.events,expected) == overlap_expected_bounded_match
    overlap_checks.query_has_no_owner_goal_run_memory_mail_change = goals.to_json() == original_goals
        && runs.to_json() == original_runs && actions.to_json() == original_actions && memory.to_json() == original_memory
        && mail_draft.to_json() == original_draft && fixture_rpc("fixture/owner-store-sha",{}).data.sha256 == sha_before
    if !overlap_checks.actual_complete_one_event_query || !overlap_checks.actual_bounded_query_contract { return }
    // A new matter avoids mistaking duplicate-request or completed-goal guards for a conflict gate.
    overlap_checks.new_chat_created = chat_new_session()
    if !overlap_checks.new_chat_created { return }
    let chat = chat_sessions[chat_session_index(chat_selected_id)]
    chat.focus_project = gm_project chat.focus_owner = gm_owner chat_save()
    let req = "fixture-overlap-" + overlap_case
    chat_requests = [{id:req session_id:chat_selected_id status:"running" editing:false project:gm_project owner:gm_owner memory_refs:[]}]
    let title = "NIGHT004 overlap " + overlap_case
    let proposal = {intent:"calendar_candidate" proposal:{title:title start:overlap_start + ":00+08:00"
        end:overlap_end + ":00+08:00" time_zone:"Asia/Shanghai" location:"Synthetic overlap room"}}
    overlap_checks.real_candidate_entry = chat_add_proposal(chat_selected_id,req,"one","根据这份合成资料建立日程：" + overlap_start + "至" + overlap_end + "，地点Synthetic overlap room。",proposal)
    if !overlap_checks.real_candidate_entry { return }
    chat_save() chat_apply_proposal(req)
    overlap_checks.new_single_planned_goal = goals.len() == 2 && runs.len() == 1 && calendar_agent_candidate != nil
    if !overlap_checks.new_single_planned_goal { overlap_observations.setup_error = ui_error return }
    let goal = ac_current_goal()
    if goal == nil { overlap_checks.candidate_is_new_matter = false return }
    overlap_checks.candidate_is_new_matter = goal.id != checkpoint.goal_id && goal.status == "planned"
    if !overlap_checks.candidate_is_new_matter { return }
    let counts_before = fixture_rpc("fixture/call-counts",{}).data
    calendar_agent_submit_candidate()
    let owner_after = fixture_rpc("fixture/logsideeffects",{}).data
    let sha_after = fixture_rpc("fixture/owner-store-sha",{}).data.sha256
    let first_count = owner_after.events.len()
    let first_sha = sha_after
    let first_status = calendar_agent_state.status
    overlap_checks.first_candidate_gesture_query_only = first_count == 1 && first_sha == sha_before
        && calendar_agent_state.status == "turn_completed" && calendar_agent_state["binding"] == nil
    overlap_checks.first_query_exact_current_ready = calendar_agent_preflight.status == "ready"
        && calendar_agent_preflight_current() && calendar_agent_preflight.request_id == calendar_agent_state.request_id
        && calendar_agent_preflight.turn_id == calendar_agent_state.turn_id
        && calendar_agent_preflight.session_id != "" && calendar_agent_preflight.tool_call_id != ""
    if !overlap_expected_block {
        overlap_checks.adjacent_query_has_no_conflicts = calendar_agent_preflight.status == "ready"
            && calendar_agent_preflight.conflicts.len() == 0
    }
    // After a future preflight guard, the existing query/archive node and a
    // second explicit candidate gesture exercise the adjacent positive path.
    // On fixed c892 the first gesture already creates; do not redispatch it.
    if !overlap_expected_block && overlap_checks.first_candidate_gesture_query_only && overlap_checks.first_query_exact_current_ready {
        calendar_agent_history_settle = true calendar_agent_history()
        overlap_checks.adjacent_query_settled_before_second_gesture = calendar_agent_state.status == "idle"
            && calendar_agent_preflight_current()
        calendar_agent_submit_candidate()
        owner_after = fixture_rpc("fixture/logsideeffects",{}).data
        sha_after = fixture_rpc("fixture/owner-store-sha",{}).data.sha256
    }
    let history_after = fixture_rpc("octos.session.history",{})
    let receiver = fixture_rpc("fixture.receiver",{}).data
    let counts_after = fixture_rpc("fixture/call-counts",{}).data
    overlap_checks.original_owner_stable_id_and_fields_preserved = overlap_matching(owner_after.events,expected) == 1
    overlap_checks.goal_run_memory_counts_after = goals.len() == 2 && runs.len() == 1 && memory.len() == 3
        && goal.status == "planned" && runs.to_json() == original_runs && actions.to_json() == original_actions
    overlap_checks.no_mail_dispatch = counts_after["mail.compose_draft"] == nil && counts_after["mail.review_send"] == nil
        && receiver.transport_calls == 0 && receiver.real_smtp_calls == 0 && receiver.received.len() == 1
        && mail_draft.to_json() == original_draft
    if overlap_expected_block {
        overlap_checks.native_overlap_waits_for_separate_choice = owner_after.events.len() == 1 && sha_after == sha_before
        overlap_checks.native_overlap_warning = calendar_agent_notice.search(expected.title) >= 0
            && (calendar_agent_notice.search("重叠") >= 0 || calendar_agent_notice.search("冲突") >= 0)
        overlap_checks.native_time_choice_guidance = calendar_agent_notice.search("改") >= 0 || calendar_agent_notice.search("选择") >= 0
    } else {
        let created = 0
        for event in owner_after.events {
            if event.id != expected.id && event.title == title && event.start == overlap_start && event.end == overlap_end
                && event.timezone == "Asia/Shanghai" && event.location == "Synthetic overlap room" { created = created + 1 }
        }
        let verified = false
        if calendar_agent_state["binding"] != nil { verified = calendar_agent_state.binding.receipt_status == "verified" }
        overlap_checks.adjacent_nonoverlap_control_created_verified = owner_after.events.len() == 2 && created == 1
            && sha_after != sha_before && calendar_agent_state.status == "turn_completed" && verified
    }
    // Keep final output scalar. Original owner/History/receipt/RPC dictionaries
    // are preserved by the existing parent trace and Kernel raw files instead.
    overlap_observations = {case:overlap_case expected_block:overlap_expected_block original_event_id:expected.id
        original_request_id:expected.request_id before_owner_count:owner_before.events.len() after_owner_count:owner_after.events.len()
        before_sha256:sha_before after_sha256:sha_after full_query_original_matches:overlap_matching(full.events,expected)
        bounded_query_original_matches:overlap_matching(bounded.events,expected) first_submit_count:first_count first_submit_sha256:first_sha
        first_submit_status:first_status original_goal_count:1 original_run_count:1 final_goal_count:goals.len() final_run_count:runs.len()
        current_turn_id:calendar_agent_state.turn_id state_status:calendar_agent_state.status notice:calendar_agent_notice
        mail_transport_calls:receiver.transport_calls real_smtp_calls:receiver.real_smtp_calls received_count:receiver.received.len()
        raw_evidence:"Parent report.trace, kernel-wrapper-stdout.jsonl and actual owner store contain original dictionaries; final probe exports only scalar observations."}
}
native_overlap_probe()
fn native_overlap_result(){
    // All fixture RPCs have completed before this formatting-only function.
    // Materialize a local string before returning; never serialize RPC objects.
    let result_json = ({kind:"NIGHT004_NATIVE_OVERLAP_PROBE" checks:overlap_checks observations:overlap_observations
        boundary:"PREPARED_NOT_EXECUTED by GPT01. Root alone runs actual production Main/Kernel on isolated cloned fixture. Model candidate, tool choice, approval and UI selection are explicit fixtures; no receipt, history or owner result is fabricated."}).to_json()
