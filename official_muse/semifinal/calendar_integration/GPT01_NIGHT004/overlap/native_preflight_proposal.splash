// UNAPPLIED MAIN PROPOSAL. Pure VM guards do not establish a Host approval.
// A runtime check is never restored as approval after restart.
let calendar_agent_preflight = {status:"empty" candidate_json:"" request_id:"" turn_id:"" session_id:"" tool_call_id:"" events:[] conflicts:[] reason:""}
fn calendar_agent_preflight_current(){
    if calendar_agent_preflight.status != "ready" && calendar_agent_preflight.status != "unknown" { return false }
    if !calendar_agent_binding_current(calendar_agent_candidate) { return false }
    if calendar_agent_preflight.candidate_json != calendar_agent_candidate.to_json() { return false }
    if calendar_agent_state.request_id != "" {
        return calendar_agent_state.request_id == calendar_agent_preflight.request_id
            && calendar_agent_state.turn_id == calendar_agent_preflight.turn_id
            && calendar_agent_state.status == "turn_completed" && calendar_agent_state["binding"] == nil
    }
    let previous = calendar_agent_state.previous_requests
    if previous.len() == 0 { return false }
    let last = previous[previous.len()-1]
    return last.request_id == calendar_agent_preflight.request_id && last.turn_id == calendar_agent_preflight.turn_id
        && last.status == "turn_completed" && last["binding"] == nil
        && last.user_id == gm_user_id && last.accounts == gm_accounts.to_json()
}
// Parse only the current persisted query occurrence. The prompt is not a
// per-turn tool permission; extra actual tool rows make this check unknown.
fn calendar_agent_preflight_query(history,args_json){
    if !gm_object(history) { return nil }
    if !gm_string(history["session_id"],256) || history.session_id == "" { return nil }
    if !gm_object(history["context_state"]) { return nil }
    if history.context_state["session_id"] != history.session_id { return nil }
    let rows = history["messages"]
    if !gm_array(rows) { return nil }
    if rows.len() > 200 || calendar_agent_state.turn_id == "" { return nil }
    let count = 0 let occurrences = 0 let occurrence = nil
    for row in rows {
        if gm_object(row) {
            let turn = row["turn_id"] if turn == nil { turn = row["thread_id"] }
            if row["role"] == "tool" && (!gm_string(turn,256) || turn == "") { return nil }
            if row["role"] == "tool" && turn == calendar_agent_state.turn_id {
                occurrences = occurrences + 1
                if calendar_agent_tool_name(row["tool_name"]) == "calendar.events"
                    && row["lane"] == "person" && (row["thread_id"] == nil || row.thread_id == turn)
                    && gm_string(row["tool_call_id"],256) && row.tool_call_id != ""
                    && calendar_agent_receipt_status(row) == "ok" {
                    let receipt = row.host_calendar_receipt
                    if receipt["args_digest"] == "sha256:" + fs.sha256(args_json)
                        && gm_string(receipt["session_id"],256) && receipt.session_id != ""
                        && receipt.session_id == history.session_id && receipt.result["call_id"] == receipt.call_id
                        && gm_string(row["persisted_at"],128) && row.persisted_at != ""
                        && gm_object(receipt.result["data"]) {
                        if gm_array(receipt.result.data["events"]) {
                            count = count + 1 occurrence = receipt
                        }
                    }
                }
            }
        }
    }
    if count != 1 || occurrences != 1 { return nil }
    let same_ids = 0
    for row in rows {
        if gm_object(row) && row["role"] == "tool" {
            let receipt = row["host_calendar_receipt"]
            if row["tool_call_id"] == occurrence.tool_call_id
                || (gm_object(receipt) && receipt["call_id"] == occurrence.call_id) { same_ids = same_ids + 1 }
        }
    }
    if same_ids != 1 { return nil }
    return occurrence
}
// Compare the returned wall-time fields. This does not reserve the slot or
// create an approval, and is independent of receipt/session validation.
fn calendar_agent_preflight_compare(candidate,events){
    let result = {status:"unknown" conflicts:[] reason:"当前工具记录或事件字段不足以核验重叠；候选未继续提交，请核对宿主实际记录。"}
    if !gm_array(events) || !gm_object(candidate) { return result }
    // At 200 the service gives no exhaustion/truncation flag. Do not infer
    // absence beyond the precise supported limit from a bounded snapshot.
    if events.len() >= 200 {
        result.reason = "官方列表达到200条上限，无法判断是否还有未读事件；候选未继续提交。" return result
    }
    if candidate["timezone"] != "Asia/Shanghai" || !gm_string(candidate["start"],16)
        || !gm_string(candidate["end"],16) || candidate.start.len() != 16 || candidate.end.len() != 16 { return result }
    let start = calendar_iso_epoch(candidate.start + ":00+08:00")
    let end = calendar_iso_epoch(candidate.end + ":00+08:00")
    if start == nil || end == nil { return result }
    if end <= start { return result }
    let conflicts = []
    for event in events {
        if !gm_object(event) { return result }
        if !gm_string(event["id"],64) || !gm_string(event["title"],80)
            || event.id == "" || event.title == ""
            || !gm_string(event["start"],32) || !gm_string(event["end"],32) { return result }
        if event["timezone"] != "Asia/Shanghai" || event.start.len() != 16 || event.end.len() != 16 {
            result.reason = "已有事件的时区或结束时间无法精确比较；请本人核对并补充资料，候选未继续提交。" return result
        }
        let event_start = calendar_iso_epoch(event.start + ":00+08:00")
        let event_end = calendar_iso_epoch(event.end + ":00+08:00")
        if event_start == nil || event_end == nil { return result }
        if event_end <= event_start { return result }
        // Half-open intervals: adjacency is not overlap; spanning is overlap.
        if event_start < end && event_end > start { conflicts.push(event) }
    }
    result.conflicts = conflicts result.status = "ready" result.reason = ""
    return result
}
fn calendar_agent_preflight_history(history){
    if calendar_agent_preflight.status != "query" { return }
    if calendar_agent_state.request_id != calendar_agent_preflight.request_id || calendar_agent_state["binding"] != nil { return }
    if !calendar_agent_binding_current(calendar_agent_candidate)
        || calendar_agent_preflight.candidate_json != calendar_agent_candidate.to_json() {
        calendar_agent_preflight.status = "expired" return
    }
    calendar_agent_preflight.turn_id = calendar_agent_state.turn_id
    calendar_agent_preflight.status = "unknown"
    calendar_agent_preflight.reason = "当前工具记录或事件字段不足以核验重叠；候选未继续提交，请核对宿主实际记录。"
    let receipt = calendar_agent_preflight_query(history,"{\"limit\":200}")
    if receipt == nil { return }
    calendar_agent_preflight.session_id = receipt.session_id
    calendar_agent_preflight.tool_call_id = receipt.tool_call_id
    calendar_agent_preflight.events = receipt.result.data.events
    let compared = calendar_agent_preflight_compare(calendar_agent_candidate.payload,receipt.result.data.events)
    calendar_agent_preflight.status = compared.status
    calendar_agent_preflight.conflicts = compared.conflicts
    calendar_agent_preflight.reason = compared.reason
}
fn calendar_agent_preflight_notice(){
    if calendar_agent_preflight.status == "unknown" { return calendar_agent_preflight.reason }
    if calendar_agent_preflight.status != "ready" { return "候选或查询已变化，请重新查询。" }
    if calendar_agent_preflight.conflicts.len() == 0 { return "当前查询快照未发现重叠，查询不保留时段；请先回读并结清查询，再次确认创建，宿主仍按原批准规则执行。" }
    let text = "当前查询快照发现时间重叠，查询不保留时段，尚未新建："
    for event in calendar_agent_preflight.conflicts { text = text + "\n" + event.title + " · " + event.start + " → " + event.end }
    return text + "\n请修改候选时间并重新查询；如本人选择保留此时间，先回读并结清查询，再点「已核对重叠，仍创建此候选」。"
}
fn calendar_agent_candidate_submit_label(){
    if !calendar_agent_preflight_current() { return "查询当前事项候选的重叠" }
    if calendar_agent_preflight.status != "ready" { return "核对未能判断的事件后重新准备候选" }
    if calendar_agent_preflight.conflicts.len() > 0 { return "已核对重叠，仍创建此候选" }
    return "再次确认并创建当前候选"
}
