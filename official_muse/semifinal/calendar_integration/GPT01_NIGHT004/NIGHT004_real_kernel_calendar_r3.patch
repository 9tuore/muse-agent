+    let retried=read(json!({"request_id":request_id}));assert_eq!(retried["event"],old);
+    let stored=octosense_calendar_service::handle("os.calendar","events",&json!({}),
+        &host_dir,chrono::Local::now().naive_local(),None).unwrap();
+    assert_eq!(stored["events"].as_array().unwrap().len(),1,"two Kernel add turns cause one stored event");
+    assert_eq!(stored["events"][0],old);
+    eprintln!("NIGHT004_STABLE_REQUEST_RETRY {}",json!({"request_id":request_id,"id":id,"stored_event_count":1,"owner_read":stored}));
+    let get=turn("calendar.get_event",json!({"id":id}),Answer::Once);
+    assert!(get["text"].as_str().unwrap().contains(&id));
+    let before_denial=std::fs::read(host_dir.join("calendar/events.json")).unwrap();
+    let denied_args=json!({"title":"DENIED fixture","start":"2026-10-13T17:00","end":"2026-10-13T17:30",
+        "timezone":"Asia/Shanghai","location":"Synthetic denied room","notes":"Synthetic denied notes","request_id":"night004-denied"});
+    let denied=run(ContextOp::Turn{text:format!("CALL_TOOL:calendar_add_event {}",denied_args)},
+        Some(("calendar.add_event",denied_args,Answer::Deny)));
+    eprintln!("NIGHT004_KERNEL_DENIED {denied:?}");
+    assert!(approvals.lock().unwrap().iter().any(|r|r["approved"]==false),"real Router answered this fixture deny");
+    assert_eq!(std::fs::read(host_dir.join("calendar/events.json")).unwrap(),before_denial);
+    assert_eq!(read(json!({"request_id":"night004-denied"}))["found"],false);
+    let update=json!({"id":id,"expected":old,"title":"NIGHT004 revised","start":"2026-10-13T16:00","end":"2026-10-13T16:45",
+        "timezone":"Asia/Shanghai","location":"Synthetic room B","notes":"Synthetic revised notes"});
+    turn("calendar.update_event",update.clone(),Answer::Once);
+    let current=read(json!({"id":id}))["event"].clone();
+    assert_eq!(current["id"],id);assert_eq!(current["request_id"],request_id);
+    for field in ["title","start","end","timezone","location","notes"] {
+        assert_eq!(current[field],update[field],"updated owner field {field}");
+    }
+    eprintln!("NIGHT004_UPDATED_OWNER {}",json!({"id":id,"request_id":request_id,"event":current}));
+    turn("calendar.get_event",json!({"id":id}),Answer::Once);
+    let before_stale=std::fs::read(host_dir.join("calendar/events.json")).unwrap();
+    let stale=turn("calendar.remove_event",json!({"id":id,"expected":old}),Answer::Once);
+    assert!(stale["text"].as_str().unwrap().contains("changed"));
+    assert_eq!(std::fs::read(host_dir.join("calendar/events.json")).unwrap(),before_stale);
+    turn("calendar.remove_event",json!({"id":id,"expected":current}),Answer::Once);
+    let absent=turn("calendar.get_event",json!({"id":id}),Answer::Once);
+    assert!(absent["text"].as_str().unwrap().contains("false"));
+    assert_eq!(read(json!({"id":id})),json!({"found":false,"event":null}));
