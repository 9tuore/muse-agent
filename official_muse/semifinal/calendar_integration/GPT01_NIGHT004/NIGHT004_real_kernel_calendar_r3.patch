+    let withdrawn=run(ContextOp::Turn{text:format!("CALL_TOOL:calendar_add_event {}",revoked_args)},None);
+    assert!(withdrawn.as_ref().err().is_some_and(|e|e.to_lowercase().contains("withdrawn")),"signed withdrawal: {withdrawn:?}");
+    assert_eq!(std::fs::read(host_dir.join("calendar/events.json")).unwrap(),before_withdrawal);
+    let requests:Vec<Value>=std::fs::read_to_string(&offered_log).unwrap().lines().map(|l|serde_json::from_str(l).unwrap()).collect();
+    let first=requests.iter().find(|r|r["user"].as_str().unwrap_or("").contains("CALL_TOOL")).unwrap();
