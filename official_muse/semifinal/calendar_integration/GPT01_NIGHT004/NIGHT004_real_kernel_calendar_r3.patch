+    eprintln!("NIGHT004_FIXTURE_APPROVALS {}",json!(*approvals.lock().unwrap()));
+    eprintln!("NIGHT004_RESULT {}",json!({"state":"REAL_KERNEL_CALENDAR_SYNTHETIC_FIXTURE_PASS",
