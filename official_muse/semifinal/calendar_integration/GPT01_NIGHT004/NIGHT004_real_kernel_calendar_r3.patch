+    let add=json!({"title":"NIGHT004 synthetic","start":"2026-10-13T15:00","end":"2026-10-13T15:30",
+        "timezone":"Asia/Shanghai","location":"Synthetic room A","notes":"Synthetic initial notes","request_id":request_id});
+    turn("calendar.add_event",add.clone(),Answer::Once);
+    let created=read(json!({"request_id":request_id}));assert_eq!(created["found"],true);
+    let old=created["event"].clone();let id=old["id"].as_str().unwrap().to_string();
+    for field in ["title","start","end","timezone","location","notes","request_id"] {
+        assert_eq!(old[field],add[field],"created owner field {field}");
+    }
+    // A distinct Kernel turn retries the same stable request_id and exact data.
+    // Count actual stored events, so repeated model wording cannot prove idempotency.
