+        eprintln!("NIGHT004_KERNEL_TURN {}",json!({"tool":tool,"args":args,"reply":reply}));
+        assert!(reply["text"].as_str().unwrap_or("").starts_with("TOOL SAID"),"actual tool result reached local model: {reply}");
+        reply
+    };
