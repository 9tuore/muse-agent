// Central-only real Splash follow-up after applying mail-terminal-recovery.patch.
// Synthetic data only; this probe never calls Mail or approves anything.
let receipt_checks = {} let receipt_calls = []
fn probe_transport(method,args,cb){
    receipt_calls.push(method)
    cb({is_ok: false error: "Receipt-only probe forbids Host calls"})
}
fn receipt_fixture(status,accepted){
    return {revision: 1 status: status to: "self@example.invalid" subject: "Synthetic" body: "No delivery"
        attempts: [{operation_id: "synthetic-operation" revision: 1 status: status
            payload: {to: "self@example.invalid" subject: "Synthetic" body: "No delivery"}
            receipt: {accepted: accepted}}]}.to_json().parse_json()
}
fn receipt_begin(){
    receipt_checks.before_delivery = mail_host_receipt_status(receipt_fixture("failed_before_delivery",false)) == "failed_before_delivery"
    receipt_checks.accepted = mail_host_receipt_status(receipt_fixture("accepted",true)) == "accepted"
    receipt_checks.accepted_without_evidence = mail_host_receipt_status(receipt_fixture("accepted",false)) == "unknown"
    receipt_checks.unknown = mail_host_receipt_status(receipt_fixture("outcome_unknown",false)) == "unknown"
    receipt_checks.cancelled = mail_host_receipt_status(receipt_fixture("cancelled",false)) == "unknown"
    receipt_checks.draft = mail_host_receipt_status(receipt_fixture("draft",false)) == "unknown"
    let stale = receipt_fixture("failed_before_delivery",false)
    stale.attempts[0].revision = 2
    receipt_checks.stale_revision = mail_host_receipt_status(stale) == "unknown"
    let changed = receipt_fixture("failed_before_delivery",false)
    changed.attempts[0].payload.body = "Different"
    receipt_checks.changed_payload = mail_host_receipt_status(changed) == "unknown"
    fs.write("probe.json",{checks: receipt_checks calls: receipt_calls}.to_json())
}
start_timeout(0.05,|| receipt_begin())
