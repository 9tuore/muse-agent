-fn calendar_agent_submit(text){
+// Selected candidate only; never mint owner access or replay an unknown turn.
+let calendar_agent_candidate = nil
+fn calendar_agent_event_matches(event,payload){
+    if !gm_object(event) || !gm_object(payload) || !gm_string(event["id"],64) || event.id == "" { return false }
+    for key in ["request_id","title","start","end","timezone","location","notes"] {
+        if event[key] != payload[key] { return false }
+    }
+    return true
+}
+fn calendar_agent_binding_valid(binding){
+    if !gm_object(binding) || !gm_object(binding["payload"]) { return false }
+    for key in ["goal_id","project_id","owner_id","user_id","account_id","session_id","candidate_id"] {
+        if !gm_string(binding[key],200) || binding[key] == "" { return false }
+    }
+    if !gm_string(binding["accounts"],8000) || !gm_string(binding["candidate_json"],6000)
+        || !gm_number(binding["plan_revision"]) || binding.plan_revision < 1 || floor(binding.plan_revision) != binding.plan_revision
+        || !gm_number(binding["candidate_revision"]) || binding.candidate_revision < 1 || floor(binding.candidate_revision) != binding.candidate_revision { return false }
+    for key in ["request_id","title","start","end","timezone","location","notes"] {
+        if !gm_string(binding.payload[key],200) { return false }
+    }
+    if binding["receipt_status"] != "unknown" && binding["receipt_status"] != "accepted"
+        && binding["receipt_status"] != "failed" && binding["receipt_status"] != "verified" { return false }
+    if binding.receipt_status == "verified" {
+        let proof = binding["verification"]
+        if !gm_object(proof) || !calendar_agent_event_matches(proof["event"],binding.payload)
+            || proof["event_id"] != proof.event.id || !gm_string(proof["add_call_id"],256) || proof.add_call_id == ""
+            || !gm_string(proof["get_call_id"],256) || proof.get_call_id == "" { return false }
+    }
+    return true
+}
+fn calendar_agent_binding_current(binding){
+    if !calendar_agent_binding_valid(binding) || !core_storage_ready || !gm_ready || binding.user_id != gm_user_id
+        || binding.accounts != gm_accounts.to_json() || binding.project_id != gm_project || binding.owner_id != gm_owner
+        || !gm_account_allowed(binding.account_id) || binding.session_id != chat_selected_id
+        || ac_selected_chat != chat_selected_id || ac_selected_id != binding.goal_id { return false }
+    let goal = ac_current_goal()
+    if goal == nil || goal.id != binding.goal_id || goal.version != binding.plan_revision
+        || !ac_goal_allowed(goal) || goal.archived || goal.status == "cancelled" { return false }
+    let si = chat_session_index(binding.session_id)
+    if si < 0 || !gm_array(chat_sessions[si]["proposals"]) { return false }
+    for card in chat_sessions[si].proposals {
+        if card.id == binding.candidate_id {
+            return card.action == "calendar_candidate" && (card.state == "candidate" || card.state == "opened")
+                && (card.account_id == binding.account_id || (card.account_id == "" && binding.account_id == "local"))
+                && card.revision == binding.candidate_revision && card.payload.to_json() == binding.candidate_json
+                && chat_card_scope_current(chat_sessions[si],card) && chat_reply_context_valid(card)
+        }
+    }
+    return false
+}
+fn calendar_agent_wall(value){
+    let parts = calendar_display_time(value).split(" ")
+    if parts.len() != 2 { return "" }
+    return parts[0] + "T" + parts[1]
+}
+fn calendar_agent_prepare_candidate(card){
+    let goal = ac_current_goal()
+    if goal == nil || ac_selected_chat != chat_selected_id || ac_selected_id != goal.id
+        || !ac_goal_allowed(goal) || goal.status != "planned" || goal.archived {
+        ui_error = "请先在行动链中本人选择当前事项，再核对日程候选。" redraw() return false
+    }
+    if card.session_id != chat_selected_id || card.project != gm_project || card.owner != gm_owner
+        || (gm_has(card,"goal_id") && card.goal_id != goal.id) || !gm_number(card["revision"]) || card.revision < 1 {
+        ui_error = "候选与当前事项或版本不一致，未准备官方请求。" redraw() return false
+    }
+    let error = chat_payload_error("calendar_candidate",card.payload)
+    if error != "" { ui_error = error redraw() return false }
+    let start = calendar_iso_epoch(card.payload.start) let end = calendar_iso_epoch(card.payload.end)
+    if card.payload.time_zone != "Asia/Shanghai" || start != floor(start / 60) * 60 || end != floor(end / 60) * 60
+        || card.payload.title.trim().len() > 80 || card.payload.location.trim().len() > 120 {
+        ui_error = "当前候选联动支持 Asia/Shanghai、整分钟时间、80字节标题和120字节地点；其他请求请在官方助手中单独核对。" redraw() return false
+    }
+    let binding = {}
+    binding.goal_id = goal.id
+    binding.plan_revision = goal.version
+    binding.project_id = gm_project
+    binding.owner_id = gm_owner
+    binding.user_id = gm_user_id
+    binding.accounts = gm_accounts.to_json()
+    binding.account_id = "local"
+    if card.account_id != "" { binding.account_id = card.account_id }
+    binding.session_id = chat_selected_id
+    binding.candidate_id = card.id
+    binding.candidate_revision = card.revision
+    binding.candidate_json = card.payload.to_json()
+    binding.payload = {}
+    binding.payload.title = card.payload.title.trim()
+    binding.payload.start = calendar_agent_wall(card.payload.start)
+    binding.payload.end = calendar_agent_wall(card.payload.end)
+    binding.payload.timezone = card.payload.time_zone
+    binding.payload.location = card.payload.location.trim()
+    binding.payload.request_id = ""
+    binding.payload.notes = ""
+    binding.receipt_status = "unknown"
+    if !calendar_agent_binding_current(binding) { ui_error = "候选已变化，未准备官方请求。" redraw() return false }
+    calendar_agent_candidate = binding
+    calendar_agent_notice = "候选已关联当前事项；请核对后单独提交官方请求，需要批准时由本人在宿主决定。"
+    return true
+}
+fn calendar_agent_same_candidate(a,b){
+    if !calendar_agent_binding_valid(a) || !calendar_agent_binding_valid(b) { return false }
+    for key in ["goal_id","project_id","owner_id","user_id","account_id","accounts"] {
+        if a[key] != b[key] { return false }
+    }
+    for key in ["title","start","end","timezone","location","notes"] {
+        if a.payload[key] != b.payload[key] { return false }
+    }
+    return true
+}
+fn calendar_agent_submit_candidate(){
+    if !calendar_agent_binding_current(calendar_agent_candidate)
+        || chat_payload_error("calendar_candidate",calendar_agent_candidate.candidate_json.parse_json()) != "" {
+        calendar_agent_notice = "事项、账号或候选版本已变化，未派发旧请求。" redraw() return
+    }
+    for previous in calendar_agent_state.previous_requests {
+        if previous.status != "blocked" && calendar_agent_same_candidate(previous["binding"],calendar_agent_candidate) {
+            calendar_agent_notice = "原候选已有保留请求，不能再次派发；请按原请求核对宿主记录。" redraw() return
+        }
+    }
+    calendar_agent_submit_bound("仅创建下列精确候选，不改期、不发送邮件。",calendar_agent_candidate)
+}
+fn calendar_agent_link_result(rows){
+    let result = {status: "unknown"}
+    let binding = calendar_agent_state["binding"]
+    if !calendar_agent_binding_current(binding) || !gm_array(rows) || rows.len() > 200
+        || calendar_agent_state.turn_id == "" || binding.payload.request_id != calendar_agent_state.request_id { return result }
+    let added = "" let readback = nil let add_call = "" let get_call = ""
+    let uncertain = false let failed = false
+    for row in rows {
+        if gm_object(row) {
+        let turn = row["turn_id"]
+        if turn == nil { turn = row["thread_id"] }
+        if row["role"] == "tool" && row["lane"] == "person" && turn == calendar_agent_state.turn_id
+            && (row["thread_id"] == nil || row.thread_id == turn) {
+            let tool = calendar_agent_tool_name(row["tool_name"])
+            if tool == "calendar.add_event" || tool == "calendar.get_event" {
+                let terminal = calendar_agent_receipt_status(row)
+                if terminal == "error" || terminal == "cancelled" { failed = true }
+                else if terminal != "ok" || !gm_string(row.host_calendar_receipt["call_id"],256) { uncertain = true }
+                else {
+                    let data = row.host_calendar_receipt.result["data"]
+                    if tool == "calendar.add_event" {
+                        if !gm_object(data) || !gm_string(data["id"],64) || data.id == "" || data["start"] != binding.payload.start
+                            || (added != "" && added != data.id) { uncertain = true }
+                        else { added = data.id add_call = row.host_calendar_receipt.call_id }
+                    } else {
+                        if !gm_object(data) || data["found"] != true || !gm_object(data["event"]) { uncertain = true }
+                        else {
+                            let event = data.event
+                            if !calendar_agent_event_matches(event,binding.payload)
+                                || (readback != nil && readback.to_json() != event.to_json()) { uncertain = true }
+                            else { readback = event get_call = row.host_calendar_receipt.call_id }
+                        }
+                    }
+                }
+            }
+        }
+        }
+    }
+    if uncertain { return result }
+    if added != "" {
+        result.status = "accepted"
+        result.event_id = added
+        if !failed && readback != nil && readback.id == added {
+            result.status = "verified"
+            result.add_call_id = add_call
+            result.get_call_id = get_call
+            result.event = readback
+        }
+    } else if failed { result.status = "failed" }
+    return result
+}
+fn calendar_agent_project(view,goal){
+    let binding = calendar_agent_state["binding"]
+    if !calendar_agent_binding_current(binding) || goal.id != binding.goal_id { return false }
+    let status = calendar_agent_state.status
+    if status == "turn_completed" { status = binding.receipt_status }
+    ac_add(view,"官方日历请求",status,"请求与当前事项版本绑定；模型回复不算工具回执",calendar_agent_state.request_id)
+    if status == "verified" {
+        ac_add(view,"官方日历精确读回","verified","新建稳定 ID 与精确事件字段一致 · " + binding.verification.event_id,calendar_agent_state.request_id)
+        view.next = "日历已精确核验；关联确认邮件和改期尚未接通，事项尚未整体完成。"
+    } else { view.next = "核对官方请求记录；未知结果不重发，尚未完成当前事项。" }
+    return true
+}
