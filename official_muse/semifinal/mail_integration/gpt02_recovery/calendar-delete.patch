+fn calendar_agent_delete_expected(binding){
+    if !calendar_agent_binding_valid(binding) || binding.receipt_status != "verified" { return nil }
+    let event = binding.verification.event
+    let expected = {}
+    for key in ["end","id","location","notes","request_id","start","timezone","title"] {
+        if !gm_string(event[key],600) { return nil }
+        expected[key] = event[key]
+    }
+    if expected.id != binding.verification.event_id || expected.request_id != binding.payload.request_id
+        || !gm_string(expected.id,64) || expected.id == "" || !gm_string(expected.request_id,160) || expected.request_id == ""
+        || !gm_string(expected.title,80) || !gm_string(expected.start,32) || !gm_string(expected.end,32)
+        || !gm_string(expected.location,120) || !gm_string(expected.timezone,64) { return nil }
+    return expected
+}
+fn calendar_agent_delete_args(expected){
+    // Kernel digest_tool_args: recursively sorted keys, compact JSON, sha256: prefix.
+    let text = "{\"end\":" + expected.end.to_json() + ",\"id\":" + expected.id.to_json()
+        + ",\"location\":" + expected.location.to_json() + ",\"notes\":" + expected.notes.to_json()
+        + ",\"request_id\":" + expected.request_id.to_json() + ",\"start\":" + expected.start.to_json()
+        + ",\"timezone\":" + expected.timezone.to_json() + ",\"title\":" + expected.title.to_json() + "}"
+    return {get_digest: "sha256:" + fs.sha256("{\"id\":" + expected.id.to_json() + "}")
+        remove_digest: "sha256:" + fs.sha256("{\"expected\":" + text + ",\"id\":" + expected.id.to_json() + "}")}
+}
+fn calendar_agent_delete_valid(record){
+    if !gm_object(record) || !calendar_agent_binding_valid(record["binding"])
+        || record.binding.receipt_status != "verified" || !gm_object(record["expected"]) { return false }
+    for key in ["request_id","creation_request_id","creation_turn_id"] {
+        if !gm_string(record[key],160) || record[key] == "" { return false }
+    }
+    if !gm_string(record["turn_id"],160) || record.creation_request_id != record.binding.payload.request_id { return false }
+    let expected = calendar_agent_delete_expected(record.binding)
+    if expected == nil || expected.to_json() != record.expected.to_json() { return false }
+    let digests = calendar_agent_delete_args(expected)
+    if record["get_digest"] != digests.get_digest || record["remove_digest"] != digests.remove_digest { return false }
+    if record["status"] != "in_flight" && record["status"] != "blocked"
+        && record["status"] != "unknown" && record["status"] != "turn_completed" { return false }
+    if record["receipt_status"] != "unknown" && record["receipt_status"] != "accepted"
+        && record["receipt_status"] != "failed" && record["receipt_status"] != "verified" { return false }
+    if record.status == "turn_completed" && record.turn_id == "" { return false }
+    if record.receipt_status == "verified" {
+        if record.status != "turn_completed" { return false }
+        let proof = record["verification"]
+        if !gm_object(proof) || proof["event_id"] != expected.id || proof["found"] != false { return false }
+        for key in ["before_get_call_id","remove_call_id","after_get_call_id"] {
+            if !gm_string(proof[key],256) || proof[key] == "" { return false }
+        }
+        if proof.before_get_call_id == proof.remove_call_id || proof.before_get_call_id == proof.after_get_call_id
+            || proof.remove_call_id == proof.after_get_call_id { return false }
+    }
+    return true
+}
