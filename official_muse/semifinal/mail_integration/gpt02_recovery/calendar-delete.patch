+fn calendar_agent_delete_save(){
+    let state = calendar_agent_delete_state
+    if !calendar_agent_delete_writable || !gm_object(state) || state["schema"] != 1
+        || !gm_array(state["records"]) || state.records.len() > 32 { return false }
+    for record in state.records { if !calendar_agent_delete_valid(record) { calendar_agent_delete_writable = false return false } }
+    let text = state.to_json()
+    if storage_write("calendar-agent-delete.json",text) != nil || storage_read("calendar-agent-delete.json") != text {
+        calendar_agent_delete_writable = false calendar_agent_notice = "删除请求未可靠保存，已停止派发；原记录保留。" return false
