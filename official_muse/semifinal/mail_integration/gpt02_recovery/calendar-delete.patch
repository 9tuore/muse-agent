+fn calendar_agent_delete_receipt(row,record){
+    let receipt = row["host_calendar_receipt"]
+    if !gm_object(receipt) || receipt["source"] != "broker_tool_result" || receipt["owner"] != "os.calendar"
+        || (receipt["caller"] != "muse-goals" && receipt["caller"] != "card.muse-goals")
+        || receipt["kernel_persisted"] != true || receipt["turn_id"] != record.turn_id
+        || receipt["tool_call_id"] != row["tool_call_id"] || !gm_string(receipt["call_id"],256) || receipt.call_id == ""
+        || receipt["tool"] != calendar_agent_tool_name(row["tool_name"]) || receipt["result_omitted"] == true { return "unverified" }
+    if receipt["terminal"] == "cancelled" { return "cancelled" }
+    if !gm_object(receipt["result"]) { return "unverified" }
+    if receipt.terminal == "error" && receipt.result["ok"] == false { return "error" }
+    if receipt.terminal == "ok" && receipt.result["ok"] == true { return "ok" }
+    return "unverified"
+}
+fn calendar_agent_delete_result(rows,record){
+    let result = {status: "unknown"}
+    if !calendar_agent_delete_current(record) || !gm_array(rows) || rows.len() > 200 || record.turn_id == "" { return result }
+    let phase = 0 let uncertain = false let failed = false let session = ""
+    let before = "" let removed = "" let after = ""
+    let before_tool = "" let remove_tool = "" let after_tool = ""
+    for row in rows {
+        if gm_object(row) {
+        let turn = row["turn_id"] if turn == nil { turn = row["thread_id"] }
+        let tool = calendar_agent_tool_name(row["tool_name"])
+        if row["role"] == "tool" && row["lane"] == "person" && turn == record.turn_id
+            && (row["thread_id"] == nil || row.thread_id == turn) && tool != "" {
+            let terminal = calendar_agent_delete_receipt(row,record)
+            let receipt = row["host_calendar_receipt"]
+            let digest = record.get_digest if tool == "calendar.remove_event" { digest = record.remove_digest }
+            if (tool != "calendar.get_event" && tool != "calendar.remove_event") || !gm_object(receipt)
+                || receipt["args_digest"] != digest || !gm_string(receipt["session_id"],256) || receipt.session_id == ""
+                || !gm_string(row["tool_call_id"],256) || row.tool_call_id == ""
+                || (session != "" && session != receipt.session_id) { uncertain = true }
+            else if terminal == "error" || terminal == "cancelled" { failed = true }
+            else if terminal != "ok" || failed { uncertain = true }
+            else {
+                session = receipt.session_id
+                let data = receipt.result["data"]
+                if !gm_object(data) { uncertain = true }
+                else if phase == 0 && tool == "calendar.get_event" && data["found"] == true
+                    && gm_object(data["event"]) && calendar_agent_event_matches(data.event,record.expected)
+                    && data.event.id == record.expected.id {
+                    before = receipt.call_id before_tool = row.tool_call_id phase = 1
+                } else if phase == 1 && tool == "calendar.remove_event" && data["removed"] == true
+                    && receipt.call_id != before && row.tool_call_id != before_tool {
+                    removed = receipt.call_id remove_tool = row.tool_call_id phase = 2
+                } else if phase == 2 && tool == "calendar.get_event" && data["found"] == false && gm_has_key(data,"event") && data["event"] == nil
+                    && receipt.call_id != before && receipt.call_id != removed
+                    && row.tool_call_id != before_tool && row.tool_call_id != remove_tool {
+                    after = receipt.call_id after_tool = row.tool_call_id phase = 3
+                } else { uncertain = true }
+            }
+        }
+        }
+    }
+    if uncertain { return result }
+    if removed != "" {
+        result.status = "accepted"
+        if phase == 3 && !failed {
+            result.status = "verified" result.event_id = record.expected.id result.found = false
+            result.before_get_call_id = before result.remove_call_id = removed result.after_get_call_id = after
+        }
+    } else if failed { result.status = "failed" }
+    return result
+}
