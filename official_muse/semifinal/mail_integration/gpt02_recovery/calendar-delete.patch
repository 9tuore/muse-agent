+fn calendar_agent_delete_boot(){
+    if !fs.exists("calendar-agent-delete.json") { return }
+    let saved = storage_read("calendar-agent-delete.json").parse_json()
+    if !gm_object(saved) || saved["schema"] != 1 || !gm_array(saved["records"]) || saved.records.len() > 32 {
+        calendar_agent_delete_writable = false return
+    }
+    for record in saved.records { if !calendar_agent_delete_valid(record) { calendar_agent_delete_writable = false return } }
+    calendar_agent_delete_state = saved
+    let interrupted = false
+    for i in saved.records.len() {
+        if saved.records[i].status == "in_flight" { calendar_agent_delete_state.records[i].status = "unknown" interrupted = true }
+    }
+    if interrupted { calendar_agent_delete_save() }
