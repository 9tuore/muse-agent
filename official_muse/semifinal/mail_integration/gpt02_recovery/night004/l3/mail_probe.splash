let bridge_checks = {}
let bridge_observations = {}
fn bridge_mail(){
    bridge_checks.boot = core_boot_goals() && core_boot_activity() && core_boot_memory() && gm_boot()
    let accounts = fixture_rpc("mail.accounts",{}).data
    bridge_checks.synthetic_granted_account = accounts.is_array() && accounts.len() == 1 && accounts[0].id == "one"
    mail_account = accounts[0]
    gm_set_accounts(["local",mail_account.id])
    gm_set_focus("synthetic-project","synthetic-owner")
    mail_new_draft()
    fixture_ui_to = "receiver@example.invalid"
    fixture_ui_subject = "MUSE-R2-L3-001 synthetic bridge"
    fixture_ui_body = "MUSE-R2-L3-001 exact synthetic payload"
    mail_edit()
    bridge_checks.local_draft_saved = mail_draft_valid(storage_read("mail-draft.json").parse_json())
    mail_preview()
    bridge_checks.waiting_for_explicit_confirmation = mail_draft.status == "waiting_user"
    // This is a fixture user confirmation, followed by the actual native-review helper.
    mail_send_confirmed()
    fixture_drain()
    bridge_checks.actual_service_receipt_accepted = mail_draft.status == "accepted" && !mail_sending
    let ai = core_action_index(mail_draft.request_id)
    bridge_checks.accepted_action_saved = ai >= 0 && actions[ai].status == "accepted"
    bridge_checks.accepted_is_not_completed_memory = memory.len() == 0 && runs.len() == 0
    let receiver = fixture_rpc("fixture.receiver",{}).data
    let status = fixture_rpc("mail.compose_status",{account:mail_account.id compose_id:mail_draft["host_compose_id"]})
    bridge_checks.host_status_same_compose_revision = status.is_ok && status.data["compose_id"] == mail_draft["host_compose_id"]
        && status.data["revision"] == mail_draft["host_revision"] && status.data["status"] == "accepted"
    bridge_checks.independent_receiver_one = receiver.received.len() == 1 && receiver.transport_calls == 1 && receiver.real_smtp_calls == 0
    let recipient_matches = false
    if status.is_ok && status.data.attempts.len() > 0 && receiver.received.len() == 1 {
        let attempt = status.data.attempts[status.data.attempts.len()-1]
        recipient_matches = receiver.received[0].message_id == attempt.payload.message_id
            && receiver.received[0].body == mail_draft.body && receiver.received[0].to == mail_draft.to
    }
    bridge_checks.recipient_exact_message_id_payload = recipient_matches
    if recipient_matches { mail_verify_received() fixture_drain() }
    ai = core_action_index(mail_draft.request_id)
    bridge_checks.receiver_confirmation_saved = mail_draft.status == "verified" && ai >= 0 && actions[ai].status == "verified"
    bridge_checks.no_linked_goal_invented = goals.len() == 0 && memory.len() == 0
    bridge_checks.timers_drained = fixture_timer_index == fixture_timers.len()
    bridge_observations = {draft:mail_draft actions:actions receiver:receiver host_status:status.data
        memory_claims:memory.len() goal_count:goals.len() receipt_confirmation:"fixture user declaration after independent synthetic recipient data"}
}
bridge_mail()
({checks:bridge_checks observations:bridge_observations boundary:"Production Muse Mail functions → actual Rust Mail service → independent synthetic recipient. Kernel/Calendar/whole-chain remain separate."}).to_json()
