let bridge_checks = {}
let bridge_observations = {}
fn mail_fault_attempt_signature(attempt){
    let accepted = nil
    if attempt["receipt"] != nil { accepted = attempt.receipt["accepted"] }
    return {operation_id:attempt.operation_id revision:attempt.revision status:attempt.status notice:attempt["notice"]
        started_at:attempt["started_at"] finished_at:attempt["finished_at"] prior_attempt:attempt["prior_attempt"]
        message_id:attempt.payload.message_id to:attempt.payload.to from:attempt.payload.from subject:attempt.payload.subject
        body:attempt.payload.body in_reply_to:attempt.payload.in_reply_to references:attempt.payload.references
        receipt_accepted:accepted}.to_json()
}
fn mail_fault_restart(){
    bridge_checks.production_boot = core_boot_goals() && core_boot_activity() && core_boot_memory() && gm_boot() && chat_boot_data()
    if !fs.exists("mail-fault-checkpoint.json") { bridge_checks.actual_checkpoint_present = false return }
    let checkpoint = storage_read("mail-fault-checkpoint.json").parse_json()
    let accounts = fixture_rpc("mail.accounts",{}).data
    mail_account = accounts[0] gm_set_accounts(["local","one"])
    boot_restore("")
    bridge_checks.native_same_persisted_draft = mail_draft.to_json() == checkpoint.draft.to_json()
    let status = fixture_rpc("mail.compose_status",{account:"one" compose_id:checkpoint.status.compose_id})
    let same = status.is_ok && status.data.compose_id == checkpoint.status.compose_id && status.data.status == checkpoint.status.status
        && status.data.revision == checkpoint.status.revision && status.data.account == checkpoint.status.account
        && status.data.to == checkpoint.status.to && status.data.subject == checkpoint.status.subject && status.data.body == checkpoint.status.body
        && status.data.attempts.len() == 1 && checkpoint.status.attempts.len() == 1
    if same {
        same = mail_fault_attempt_signature(status.data.attempts[0]) == mail_fault_attempt_signature(checkpoint.status.attempts[0])
    }
    bridge_checks.actual_engine_same_id_status_attempts = same
    mail_send_confirmed()
    let receiver = fixture_rpc("fixture.receiver",{}).data
    bridge_checks.new_process_no_automatic_resend = receiver.transport_calls == 0 && receiver.received.to_json() == checkpoint.recipient.received.to_json()
    let direct = fixture_rpc("mail.review_send",{account:"one" compose_id:status.data.compose_id expected_revision:status.data.revision
        to:status.data.to subject:status.data.subject body:status.data.body})
    bridge_checks.actual_restored_engine_duplicate_refused = !direct.is_ok && fixture_rpc("fixture.receiver",{}).data.transport_calls == 0
    mail_check_host_status()
    bridge_checks.readonly_check_never_repeats_transport = fixture_rpc("fixture.receiver",{}).data.transport_calls == 0
    bridge_checks.no_completed_goal_run_memory = goals.len() == 0 && runs.len() == 0 && memory.len() == 0
    bridge_observations = {draft:mail_draft actual_host_status:status receiver:receiver duplicate_reply:direct
        background_timers_not_drained:fixture_timers.len()-fixture_timer_index}
}
mail_fault_restart()
({kind:"NIGHT004_NATIVE_MAIL_FAULT_COMPONENT_RESTART" checks:bridge_checks observations:bridge_observations}).to_json()
