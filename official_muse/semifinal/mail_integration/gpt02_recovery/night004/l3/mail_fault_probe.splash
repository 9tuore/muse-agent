// Exact production Mail call closure. Transport modes and lost reply are fixture faults.
let bridge_checks = {}
let bridge_observations = {}
fn mail_fault(){
    bridge_checks.production_boot = core_boot_goals() && core_boot_activity() && core_boot_memory() && gm_boot()
    let account_reply = fixture_rpc("mail.accounts",{})
    bridge_checks.actual_granted_account = account_reply.is_ok && account_reply.data.len() == 1
    if !bridge_checks.actual_granted_account { return }
    mail_account = account_reply.data[0] gm_set_accounts(["local","one"]) gm_set_focus("synthetic-project","synthetic-owner")
    let options = fixture_rpc("fixture.fault.options",{}).data
    let mode_reply = fixture_rpc("fixture.mode",{mode:options.mail_mode})
    bridge_checks.existing_transport_fault_selected = mode_reply.is_ok && mode_reply.data.mode == options.mail_mode
    mail_new_draft()
    fixture_ui_to = "receiver@example.invalid" fixture_ui_subject = "MUSE-R2-L3-FAULT-001"
    fixture_ui_body = "MUSE-R2-L3-FAULT-001 exact synthetic fault payload"
    mail_edit() mail_preview()
    bridge_checks.explicit_preview = mail_draft.status == "waiting_user"
    mail_send_confirmed() fixture_drain()
    let first_draft = mail_draft.to_json().parse_json()
    let expected = "unknown"
    if options.mail_mode == "accepted" && options.reply_fault == "none" { expected = "accepted" }
    bridge_checks.initial_state_from_actual_or_lost_reply = mail_draft.status == expected && !mail_sending
    let compose_id = mail_draft["host_compose_id"]
    let status = fixture_rpc("mail.compose_status",{account:"one" compose_id:compose_id})
    let actual_status = "accepted"
    if options.mail_mode == "before" { actual_status = "failed_before_delivery" }
    if options.mail_mode == "unknown" { actual_status = "outcome_unknown" }
    bridge_checks.actual_host_one_terminal_attempt = status.is_ok && status.data.status == actual_status && status.data.attempts.len() == 1
    let recipient = fixture_rpc("fixture.receiver",{}).data
    let expected_received = 1 if options.mail_mode == "before" { expected_received = 0 }
    bridge_checks.actual_recipient_sideeffect_count = recipient.transport_calls == 1 && recipient.received.len() == expected_received && recipient.real_smtp_calls == 0
    let exact = true
    if expected_received == 1 {
        exact = recipient.received[0].message_id == status.data.attempts[0].payload.message_id
            && recipient.received[0].body == mail_draft.body && recipient.received[0].to == mail_draft.to
    }
    bridge_checks.actual_recipient_exact_message = exact
    let counts = fixture_rpc("fixture/call-counts",{}).data
    mail_send_confirmed() fixture_drain()
    bridge_checks.native_duplicate_confirmation_no_dispatch = fixture_rpc("fixture/call-counts",{}).data["mail.review_send"] == counts["mail.review_send"]
        && fixture_rpc("fixture.receiver",{}).data.transport_calls == 1
    // Real service independently refuses repeating the same compose/revision.
    let direct = fixture_rpc("mail.review_send",{account:"one" compose_id:compose_id expected_revision:status.data.revision
        to:status.data.to subject:status.data.subject body:status.data.body})
    bridge_checks.actual_engine_duplicate_review_refused = !direct.is_ok && fixture_rpc("fixture.receiver",{}).data.transport_calls == 1
    mail_check_host_status() fixture_drain()
    let reconciled = "accepted"
    if options.mail_mode == "before" { reconciled = "DRAFT" }
    if options.mail_mode == "unknown" { reconciled = "unknown" }
    bridge_checks.readonly_reconcile_matches_actual_terminal = mail_draft.status == reconciled && fixture_rpc("fixture.receiver",{}).data.transport_calls == 1
    bridge_checks.no_completed_goal_run_memory = goals.len() == 0 && runs.len() == 0 && memory.len() == 0
    let ai = core_action_index(mail_draft.request_id)
    let action_state = "accepted"
    if options.mail_mode == "before" { action_state = "failed" }
    if options.mail_mode == "unknown" { action_state = "unknown" }
    bridge_checks.native_action_state_matches_reconciliation = ai >= 0 && actions[ai].status == action_state
    storage_write("mail-fault-checkpoint.json",{options:options draft:mail_draft status:status.data
        recipient:recipient request_id:mail_draft.request_id}.to_json())
    bridge_observations = {initial_draft:first_draft draft:mail_draft host_status:status.data receiver:recipient actions:actions
        duplicate_reply:direct boundary:"No Kernel/Calendar involved. MockTransport modes are actual existing test transport branches. Parent reply timeout/JSON decode refusal is explicit; original actual service reply retained by driver."}
}
mail_fault()
({kind:"NIGHT004_NATIVE_MAIL_FAULT_COMPONENT" checks:bridge_checks observations:bridge_observations}).to_json()
