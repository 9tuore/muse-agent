let bridge_checks = {}
let bridge_observations = {}
fn native_delete_restart(){
    bridge_checks.production_boot = core_boot_goals() && core_boot_activity() && core_boot_memory() && gm_boot() && chat_boot_data()
    if !fs.exists("l3-delete-checkpoint.json") { bridge_checks.actual_checkpoint_present = false return }
    let checkpoint = storage_read("l3-delete-checkpoint.json").parse_json()
    mail_accounts_load() mail_account = mail_accounts[0] gm_set_accounts(["local",mail_account.id])
    calendar_agent_boot() calendar_agent_update_boot() calendar_agent_delete_boot() boot_restore("")
    bridge_checks.original_chat_selected = chat_select_session(checkpoint.chat_id)
    let chat = chat_sessions[chat_session_index(chat_selected_id)] gm_set_focus(chat.focus_project,chat.focus_owner)
    ac_choose_matter(checkpoint.goal_id)
    bridge_checks.original_single_goal_not_completed = ac_current_goal() != nil && ac_current_goal().id == checkpoint.goal_id
        && goals.len() == 1 && ac_current_goal().status != "completed"
    bridge_checks.actual_saved_delete_verified = calendar_agent_delete_state.records.len() == 1
        && calendar_agent_delete_state.records[0].receipt_status == "verified"
        && calendar_agent_delete_state.records[0].status == "turn_completed"
    if !bridge_checks.actual_saved_delete_verified { return }
    let deletion = calendar_agent_delete_state.records[0]
    bridge_checks.original_delete_request_turn_event_retained = deletion.request_id == checkpoint.deletion.request_id
        && deletion.turn_id == checkpoint.deletion.turn_id && deletion.expected.id == checkpoint.event.id
        && calendar_agent_event_json(deletion.expected) == calendar_agent_event_json(checkpoint.event)
        && calendar_agent_delete_valid(deletion)
    bridge_checks.actual_saved_three_call_proof_retained = deletion.verification.event_id == checkpoint.event.id
        && deletion.verification.found == false
        && deletion.verification.before_get_call_id == checkpoint.deletion.verification.before_get_call_id
        && deletion.verification.remove_call_id == checkpoint.deletion.verification.remove_call_id
        && deletion.verification.after_get_call_id == checkpoint.deletion.verification.after_get_call_id
    bridge_checks.original_creation_request_retained = calendar_agent_state.request_id == checkpoint.creation_request_id
        && calendar_agent_state.turn_id == checkpoint.creation_turn_id && calendar_agent_state.binding.receipt_status == "verified"
    let independent = fixture_rpc("fixture/read-owner",{method:"get_event" args:{id:checkpoint.event.id}})
    bridge_checks.actual_owner_same_id_absent_zero_events = independent.is_ok && independent.data.found == false
        && gm_has_key(independent.data,"event") && independent.data.event == nil
        && fixture_rpc("fixture/logsideeffects",{}).data.events.len() == 0
    calendar_agent_delete_select() calendar_agent_delete_confirm() calendar_agent_delete_confirm() calendar_agent_submit_candidate()
    let counts = fixture_rpc("fixture/call-counts",{}).data
    bridge_checks.new_process_no_turn_or_mail_resubmit = counts["octos.turn.start"] == nil
        && counts["mail.compose"] == nil && counts["mail.review_send"] == nil
        && fixture_rpc("fixture.receiver",{}).data.transport_calls == 0
        && calendar_agent_delete_state.records.len() == 1 && calendar_agent_delete_target() == nil
    let view = ac_projection() let request_node = false let verified_node = false
    for node in view.nodes {
        if node.record_id == deletion.request_id && node.state == ac_state("verified") {
            if node.title == "官方日历删除请求" { request_node = true }
            if node.title == "官方日历删除精确核验" { verified_node = true }
        }
    }
    bridge_checks.native_action_chain_delete_nodes_restored = request_node && verified_node
    let completed = false for entry in memory { if gm_completed_receipt(entry.document) { completed = true } }
    bridge_checks.no_completed_goal_run_memory_invented = !completed && runs.len() == 0 && goals[0].status != "completed"
    let old = chat_selected_id
    bridge_checks.new_chat_created = chat_new_session() && chat_selected_id != old
    bridge_checks.actual_mail_source_memory_recalled = gm_context("合成日历安排",chat_selected_id,"").hits.len() > 0
    bridge_observations = {delete_state:calendar_agent_delete_state owner_read:independent action_chain:view counters:counts
        goals:goals runs:runs memory:memory background_timers_not_drained:fixture_timers.len()
        boundary:"New VM/Mail/Kernel processes read the original persisted native delete journal. No old Broker receipts reconstructed or history injected; independent actual owner remains empty."}
}
native_delete_restart()
({kind:"NIGHT004_NATIVE_DELETE_RESTART" checks:bridge_checks observations:bridge_observations}).to_json()
