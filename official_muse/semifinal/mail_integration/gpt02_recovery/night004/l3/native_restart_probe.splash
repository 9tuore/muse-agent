let bridge_checks = {}
let bridge_observations = {}
fn native_restart(){
    bridge_checks.production_boot = core_boot_goals() && core_boot_activity() && core_boot_memory() && gm_boot() && chat_boot_data()
    if !fs.exists("l3-native-checkpoint.json") { bridge_checks.native_checkpoint_present = false return }
    let checkpoint = storage_read("l3-native-checkpoint.json").parse_json()
    if !gm_object(checkpoint) { bridge_checks.native_checkpoint_present = false return }
    mail_accounts_load() mail_account = mail_accounts[0] gm_set_accounts(["local",mail_account.id])
    let chat = chat_sessions[chat_session_index(chat_selected_id)] gm_set_focus(chat.focus_project,chat.focus_owner)
    calendar_agent_boot() calendar_agent_update_boot() calendar_agent_delete_boot() boot_restore("")
    bridge_checks.actual_saved_update_verified = calendar_agent_update_state.records.len() == 1 && calendar_agent_update_state.records[0].receipt_status == "verified"
    let status = fixture_rpc("mail.compose_status",{account:"one" compose_id:checkpoint.compose_id})
    let receiver = fixture_rpc("fixture.receiver",{}).data
    bridge_checks.same_message_no_resend = status.is_ok && status.data.status == "accepted" && status.data.compose_id == checkpoint.compose_id
        && status.data.attempts.len() == 1 && status.data.attempts[0].payload.message_id == checkpoint.message_id
        && receiver.received.len() == 1 && receiver.transport_calls == 0 && receiver.received[0].message_id == checkpoint.message_id
    bridge_checks.restored_verified_mail = mail_draft.status == "verified" && mail_draft.request_id == checkpoint.request_id
    mail_send_confirmed()
    bridge_checks.verified_restore_no_dispatch = fixture_rpc("fixture.receiver",{}).data.transport_calls == 0
    let independent = fixture_rpc("fixture/read-owner",{method:"get_event" args:{id:checkpoint.event.id}})
    bridge_checks.actual_owner_same_updated_event = independent.is_ok && independent.data.found
        && calendar_agent_event_json(independent.data.event) == calendar_agent_event_json(checkpoint.event)
    let history = fixture_rpc("fixture/history-sessions",{})
    bridge_checks.actual_old_kernel_history_read = history.is_ok && history.data.source == "actual_kernel_session_hydrate"
        && history.data.broker_receipts_reconstructed == false && history.data.histories.len() > 0
    let old = chat_selected_id
    bridge_checks.new_chat_created = chat_new_session() && chat_selected_id != old
    let recalled = gm_context("合成日历安排",chat_selected_id,"")
    bridge_checks.new_chat_recall_has_actual_sources = recalled.hits.len() > 0
    let found_completed = false
    for hit in recalled.hits {
        for entry in memory { if entry.document.id == hit.id && gm_completed_receipt(entry.document) { found_completed = true } }
    }
    bridge_checks.new_chat_recalls_completed_memory = found_completed
    bridge_checks.new_chat_does_not_select_old_goal = ac_current_goal() == nil && ac_projection().nodes.len() == 0
    bridge_checks.original_chat_selected = chat_select_session(checkpoint.chat_id)
    ac_choose_matter(checkpoint.goal_id)
    let view = ac_projection()
    let has_calendar = false let has_mail = false
    for node in view.nodes {
        if node.title == "官方日历同ID改期" { has_calendar = true }
        if node.title == "回复草稿" { has_mail = true }
    }
    bridge_checks.original_action_chain_restored = ac_current_goal() != nil && ac_current_goal().id == checkpoint.goal_id && has_calendar && has_mail
    bridge_checks.completed_goal_restored = ac_current_goal().status == "completed"
    bridge_observations = {owner_read:independent host_status:status receiver:receiver history:history
        recall:recalled goals:goals runs:runs memory:memory draft:mail_draft action_chain:view
        background_timeouts_queued:fixture_timers.len()
        boundary:"New VM/Mail/recipient/Kernel bridge processes. Actual owner and raw old Kernel hydrate read independently; no old rows injected into current Broker history. Background timers not drained."}
}
native_restart()
({kind:"NIGHT004_NATIVE_L3_FULL_CHAIN" checks:bridge_checks observations:bridge_observations}).to_json()
