let bridge_checks = {}
let bridge_observations = {}
fn mail_write_failure(){
    bridge_checks.production_boot = core_boot_goals() && core_boot_activity() && core_boot_memory() && gm_boot()
    mail_account = fixture_rpc("mail.accounts",{}).data[0] gm_set_accounts(["local","one"])
    mail_new_draft() fixture_ui_to = "receiver@example.invalid"
    fixture_ui_subject = "MUSE-R2-L3-WRITE-001" fixture_ui_body = "MUSE-R2-L3-WRITE-001 retained synthetic bytes"
    mail_edit() mail_preview()
    let saved = storage_read("mail-draft.json") let backup = storage_read("mail-draft.backup.json")
    bridge_checks.exact_preview_saved = mail_draft.status == "waiting_user"
    bridge_checks.actual_os_fault_armed = fixture_rpc("fixture.fault.arm_write",{path:"mail-draft.backup.json"}).is_ok
    mail_send_confirmed() fixture_drain()
    let receiver = fixture_rpc("fixture.receiver",{}).data
    bridge_checks.before_host_failure_no_delivery = receiver.transport_calls == 0 && receiver.received.len() == 0
    bridge_checks.native_storage_blocked = !mail_draft_writable && !mail_sending
    bridge_checks.original_draft_and_backup_bytes_preserved = storage_read("mail-draft.json") == saved && storage_read("mail-draft.backup.json") == backup
    let counts = fixture_rpc("fixture/call-counts",{}).data
    bridge_checks.no_actual_compose_or_review_dispatch = counts["mail.compose"] == nil && counts["mail.review_send"] == nil
    bridge_checks.original_body_preserved = mail_draft.body == fixture_ui_body && goals.len() == 0 && runs.len() == 0 && memory.len() == 0
    bridge_observations = {draft:mail_draft error:mail_error receiver:receiver counters:counts
        boundary:"Parent inserts directory at own backup file path for one actual Path.write_text; OS errno and before/after SHA retained. No synthetic write error or Host result."}
}
mail_write_failure()
({kind:"NIGHT004_NATIVE_MAIL_REAL_OS_WRITE_FAILURE" checks:bridge_checks observations:bridge_observations}).to_json()
