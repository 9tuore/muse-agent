// Model outputs, incoming content, user selections and review gestures are explicit fixtures.
// Every Calendar result comes from the actual Kernel bridge. No result/history is written here.
let bridge_checks = {}
let bridge_observations = {}
fn native_incoming(id,body){return {id:id uid:id sender:"Synthetic sender" address:"receiver@example.invalid"
    subject:"合成日历安排" preview:body body:body date:"2026-10-12T02:30:00+08:00" time:"Oct 12" unread:true}}
fn native_read_remember(message,mailbox){
    let seeded = fixture_rpc("fixture.incoming",{messages:mailbox state:{}})
    if !seeded.is_ok { return false }
    mail_open(message.id)
    if mail_selected == nil || mail_selected.id != message.id || mail_selected.body != message.body { return false }
    // Explicit fixture user scope selection; production memory entry/source commit follows.
    mail_scope_project = gm_project mail_scope_owner = gm_owner
    memory_remember_mail()
    let mi = core_memory_index("memory:mail:one:" + message.id,"one")
    if mi < 0 { return false }
    let doc = memory[mi].document let si = core_source_index(doc.payload.source_ids[0],"one")
    return doc.payload.epistemic_type == "external_claim" && si >= 0 && memory_sources[si].content_sha256 == fs.sha256(message.body)
}
fn native_delete(){
    bridge_checks.production_boot = core_boot_goals() && core_boot_activity() && core_boot_memory() && gm_boot() && chat_boot_data()
    mail_accounts_load()
    if mail_accounts.len() != 1 { bridge_checks.actual_mail_account = false return }
    mail_account = mail_accounts[0] gm_set_accounts(["local",mail_account.id])
    gm_set_focus("synthetic-project","synthetic-owner")
    let chat = chat_sessions[chat_session_index(chat_selected_id)]
    chat.focus_project = gm_project chat.focus_owner = gm_owner chat_save()
    let first = native_incoming("synthetic-incoming-001","合成日历安排：2026-10-13 15:00至15:30，地点合成会议室。外部声明。")
    bridge_checks.first_mail_actual_read_and_memory = native_read_remember(first,[first])
    let first_refs = chat_context_refs(gm_context("合成日历安排",chat_selected_id,"").hits)
    chat_requests = [{id:"fixture-model-first" session_id:chat_selected_id status:"running" editing:false
        project:gm_project owner:gm_owner memory_refs:first_refs}]
    let output = {intent:"calendar_candidate" proposal:{title:"合成日历安排" start:"2026-10-13T15:00:00+08:00"
        end:"2026-10-13T15:30:00+08:00" time_zone:"Asia/Shanghai" location:"合成会议室"}}
    bridge_checks.first_candidate_actual_chat_entry = chat_add_proposal(chat_selected_id,"fixture-model-first","one","根据这封合成邮件建立日程：2026年10月13日15:00至15:30，合成会议室。",output)
    chat_save() chat_apply_proposal("fixture-model-first")
    bridge_checks.one_goal_before_kernel = goals.len() == 1 && goals[0].status == "planned" && calendar_agent_candidate != nil
    if !bridge_checks.one_goal_before_kernel { bridge_observations.error = ui_error return }
    calendar_agent_submit_candidate()
    bridge_checks.real_kernel_create_verified = calendar_agent_state.status == "turn_completed"
        && calendar_agent_state["binding"] != nil && calendar_agent_state.binding.receipt_status == "verified"
    bridge_observations.create_state = calendar_agent_state.to_json().parse_json()
    bridge_observations.create_notice = calendar_agent_notice
    if !bridge_checks.real_kernel_create_verified { return }
    let original = calendar_agent_authority()
    let creation_json = calendar_agent_state.to_json()
    let goal_json = goals[0].to_json() let run_json = runs.to_json() let memory_json = memory.to_json()
    let before = fixture_rpc("fixture/read-owner",{method:"get_event" args:{id:original.event.id}})
    bridge_checks.actual_created_single_event = before.is_ok && before.data.found
        && calendar_agent_event_json(before.data.event) == calendar_agent_event_json(original.event)
        && fixture_rpc("fixture/logsideeffects",{}).data.events.len() == 1
    ac_choose_matter(goals[0].id)
    calendar_agent_delete_select()
    bridge_checks.native_exact_delete_selection = calendar_agent_delete_selected != ""
        && calendar_agent_event_json(calendar_agent_delete_selected.parse_json().expected) == calendar_agent_event_json(original.event)
    if !bridge_checks.native_exact_delete_selection { return }
    calendar_agent_delete_confirm()
    bridge_checks.real_kernel_delete_verified = calendar_agent_delete_state.records.len() == 1
        && calendar_agent_delete_state.records[0].status == "turn_completed"
        && calendar_agent_delete_state.records[0].receipt_status == "verified"
    bridge_observations.delete_state = calendar_agent_delete_state.to_json().parse_json()
    bridge_observations.delete_notice = calendar_agent_notice
    if !bridge_checks.real_kernel_delete_verified { return }
    let deletion = calendar_agent_delete_state.records[0]
    bridge_checks.delete_same_id_expected_original_creation = deletion.expected.id == original.event.id
        && calendar_agent_event_json(deletion.expected) == calendar_agent_event_json(original.event)
        && deletion.creation_request_id == calendar_agent_state.request_id && deletion.creation_turn_id == calendar_agent_state.turn_id
        && deletion.request_id != deletion.creation_request_id && deletion.turn_id != deletion.creation_turn_id
        && calendar_agent_delete_valid(deletion) && deletion.verification.event_id == original.event.id && deletion.verification.found == false
    let history = fixture_rpc("octos.session.history",{})
    let gets = 0 let removes = 0 let other = 0 let receipts = [] let removed = false let absent = false
    if history.is_ok && gm_array(history.data["messages"]) {
        for row in history.data.messages {
            if gm_object(row) && row["role"] == "tool" {
                let turn = row["turn_id"] if turn == nil { turn = row["thread_id"] }
                if turn == deletion.turn_id {
                    let tool = calendar_agent_tool_name(row["tool_name"])
                    if row["lane"] != "person" || calendar_agent_delete_receipt(row,deletion) != "ok" { other = other + 1 }
                    else {
                        let receipt = row.host_calendar_receipt
                        if tool == "calendar.get_event" && receipt.args_digest == deletion.get_digest {
                            gets = gets + 1
                            if receipt.result.data["found"] == false && gm_has_key(receipt.result.data,"event") && receipt.result.data["event"] == nil { absent = true }
                            receipts.push(receipt)
                        } else if tool == "calendar.remove_event" && receipt.args_digest == deletion.remove_digest {
                            removes = removes + 1 removed = receipt.result.data["removed"] == true receipts.push(receipt)
                        } else { other = other + 1 }
                    }
                }
            }
        }
    }
    bridge_checks.actual_three_delete_receipts = gets == 2 && removes == 1 && other == 0 && receipts.len() == 3
    bridge_checks.actual_removed_and_absence_receipts = removed && absent
    let audit = fixture_rpc("fixture/approval-audit",{})
    let approved = 0
    if audit.is_ok && audit.data["source"] == "actual_fixture_router_approval_audit" {
        for row in audit.data.rows {
            if row["owner"] == "os.calendar" && row["tool"] == "calendar.remove_event" && row["approved"] == true
                && row["fixture_gesture"] == true && gm_object(row["args"]) && row.args["id"] == original.event.id {
                if calendar_agent_delete_args(row.args.expected).remove_digest == deletion.remove_digest { approved = approved + 1 }
            }
        }
    }
    bridge_checks.actual_router_approved_exact_remove_once = approved == 1
    let independent = fixture_rpc("fixture/read-owner",{method:"get_event" args:{id:original.event.id}})
    bridge_checks.actual_owner_same_id_absent_zero_events = independent.is_ok && independent.data.found == false
        && gm_has_key(independent.data,"event") && independent.data.event == nil
        && fixture_rpc("fixture/logsideeffects",{}).data.events.len() == 0
    bridge_checks.original_creation_journal_retained = calendar_agent_state.to_json() == creation_json
    bridge_checks.no_goal_run_memory_completion = goals[0].to_json() == goal_json && goals[0].status != "completed"
        && runs.to_json() == run_json && memory.to_json() == memory_json
    let count_before = fixture_rpc("fixture/call-counts",{}).data["octos.turn.start"]
    calendar_agent_delete_select() calendar_agent_delete_confirm() calendar_agent_delete_confirm() calendar_agent_submit_candidate()
    bridge_checks.duplicate_delete_create_no_new_turn = fixture_rpc("fixture/call-counts",{}).data["octos.turn.start"] == count_before
        && calendar_agent_delete_state.records.len() == 1 && calendar_agent_delete_target() == nil
    let counts = fixture_rpc("fixture/call-counts",{}).data
    bridge_checks.no_mail_compose_or_delivery = counts["mail.compose"] == nil && counts["mail.review_send"] == nil
        && fixture_rpc("fixture.receiver",{}).data.transport_calls == 0
    let view = ac_projection() let request_node = false let verified_node = false
    for node in view.nodes {
        if node.record_id == deletion.request_id && node.state == ac_state("verified") {
            if node.title == "官方日历删除请求" { request_node = true }
            if node.title == "官方日历删除精确核验" { verified_node = true }
        }
    }
    bridge_checks.native_action_chain_verified_delete_nodes = ac_current_goal() != nil && ac_current_goal().id == goals[0].id
        && request_node && verified_node
    storage_write("l3-delete-checkpoint.json",{chat_id:chat_selected_id goal_id:goals[0].id event:original.event deletion:deletion
        creation_request_id:calendar_agent_state.request_id creation_turn_id:calendar_agent_state.turn_id}.to_json())
    bridge_observations = {delete_state:calendar_agent_delete_state delete_notice:calendar_agent_notice actual_history:history
        actual_receipts:receipts actual_audit:audit owner_read:independent action_chain:view goals:goals runs:runs memory:memory counters:counts
        boundary:"Original create/select/confirm/history/project. Only actual Kernel Broker receipts prove removal; actual independent owner reads prove absence. UI/model/approval gestures are fixtures. No receipt/history/Goal state synthesized. Background timers not drained."}
}
native_delete()
({kind:"NIGHT004_NATIVE_DELETE" checks:bridge_checks observations:bridge_observations}).to_json()
