// Model outputs, incoming content, user selections and review gestures are explicit fixtures.
// Every Calendar result comes from the actual Kernel bridge. No result/history is written here.
let bridge_checks = {}
let bridge_observations = {}
fn native_incoming(id,body){return {id:id uid:id sender:"Synthetic sender" address:"receiver@example.invalid"
    subject:"合成日历安排" preview:body body:body date:"2026-10-12T02:30:00+08:00" time:"Oct 12" unread:true}}
fn native_read_remember(message,mailbox){
    let seeded = fixture_rpc("fixture.incoming",{messages:mailbox state:{}})
    if !seeded.is_ok { return false }
    mail_open(message.id)
    if mail_selected == nil || mail_selected.id != message.id || mail_selected.body != message.body { return false }
    // Explicit fixture user scope selection; production memory entry/source commit follows.
    mail_scope_project = gm_project mail_scope_owner = gm_owner
    memory_remember_mail()
    let mi = core_memory_index("memory:mail:one:" + message.id,"one")
    if mi < 0 { return false }
    let doc = memory[mi].document let si = core_source_index(doc.payload.source_ids[0],"one")
    return doc.payload.epistemic_type == "external_claim" && si >= 0 && memory_sources[si].content_sha256 == fs.sha256(message.body)
}
fn native_cas_fault(){
    bridge_checks.production_boot = core_boot_goals() && core_boot_activity() && core_boot_memory() && gm_boot() && chat_boot_data()
    mail_accounts_load()
    if mail_accounts.len() != 1 { bridge_checks.actual_mail_account = false return }
    mail_account = mail_accounts[0] gm_set_accounts(["local",mail_account.id])
    gm_set_focus("synthetic-project","synthetic-owner")
    let chat = chat_sessions[chat_session_index(chat_selected_id)]
    chat.focus_project = gm_project chat.focus_owner = gm_owner chat_save()
    let first = native_incoming("synthetic-incoming-001","合成日历安排：2026-10-13 15:00至15:30，地点合成会议室。外部声明。")
    bridge_checks.first_mail_actual_read_and_memory = native_read_remember(first,[first])
    let first_refs = chat_context_refs(gm_context("合成日历安排",chat_selected_id,"").hits)
    chat_requests = [{id:"fixture-model-first" session_id:chat_selected_id status:"running" editing:false
        project:gm_project owner:gm_owner memory_refs:first_refs}]
    let output = {intent:"calendar_candidate" proposal:{title:"合成日历安排" start:"2026-10-13T15:00:00+08:00"
        end:"2026-10-13T15:30:00+08:00" time_zone:"Asia/Shanghai" location:"合成会议室"}}
    bridge_checks.first_candidate_actual_chat_entry = chat_add_proposal(chat_selected_id,"fixture-model-first","one","根据这封合成邮件建立日程：2026年10月13日15:00至15:30，合成会议室。",output)
    chat_save() chat_apply_proposal("fixture-model-first")
    bridge_checks.one_goal_before_kernel = goals.len() == 1 && goals[0].status == "planned" && calendar_agent_candidate != nil
    if !bridge_checks.one_goal_before_kernel { bridge_observations.error = ui_error return }
    if !native_create_preflight() { return }
    // Second explicit candidate gesture: the original create entry remains add/get-only.
    calendar_agent_submit_candidate()
    bridge_checks.preflight_and_create_distinct_requests_turns = calendar_agent_state.request_id != native_preflight_snapshot.state.request_id
        && calendar_agent_state.turn_id != native_preflight_snapshot.state.turn_id && calendar_agent_preflight.status == "consumed"
    bridge_checks.real_kernel_create_verified = calendar_agent_state.status == "turn_completed"
        && calendar_agent_state["binding"] != nil && calendar_agent_state.binding.receipt_status == "verified"
    bridge_observations.create_state = calendar_agent_state.to_json().parse_json()
    bridge_observations.create_notice = calendar_agent_notice
    if !bridge_checks.real_kernel_create_verified { return }
    let count_before = fixture_rpc("fixture/call-counts",{}).data["octos.turn.start"]
    let goal_count = goals.len() let memory_count = memory.len()
    calendar_agent_submit_candidate()
    bridge_checks.native_duplicate_create_no_new_turn = fixture_rpc("fixture/call-counts",{}).data["octos.turn.start"] == count_before
        && goals.len() == goal_count && fixture_rpc("fixture/logsideeffects",{}).data.events.len() == 1
    bridge_checks.repeated_incoming_keeps_one_memory = native_read_remember(first,[first]) && memory.len() == memory_count
    let original = calendar_agent_authority()
    let creation_json = calendar_agent_state.to_json()
    let old_card_json = chat.proposals[0].to_json()
    let old_goal_json = goals[0].to_json()
    mail_compose_from_agent_calendar()
    fixture_ui_to = "receiver@example.invalid"
    fixture_ui_body = "手写原安排：15点见。MUSE-R2-L3-001"
    mail_edit() mail_preview()
    let old_draft = mail_draft.to_json().parse_json()
    bridge_checks.old_draft_waits_without_delivery = old_draft.status == "waiting_user" && mail_calendar_current(old_draft)
        && fixture_rpc("fixture.receiver",{}).data.transport_calls == 0
    let second = native_incoming("synthetic-incoming-002","合成日历安排改期：2026-10-13 16:00至16:30，地点第二合成会议室。外部声明。")
    bridge_checks.second_mail_actual_read_and_memory = native_read_remember(second,[first,second])
    let latest_refs = chat_context_refs(gm_context("合成日历安排改期",chat_selected_id,"").hits)
    let active = chat_active_candidate(chat_selected_id)
    chat_requests = [{id:"fixture-model-update" session_id:chat_selected_id status:"running" editing:true
        project:gm_project owner:gm_owner goal_id:goals[0].id candidate_id:active.id candidate_payload:active.payload.to_json()
        candidate_state:active.state memory_refs:latest_refs}]
    let changed = {intent:"calendar_candidate" proposal:{title:"合成日历安排" start:"2026-10-13T16:00:00+08:00"
        end:"2026-10-13T16:30:00+08:00" time_zone:"Asia/Shanghai" location:"第二合成会议室"}}
    bridge_checks.second_mail_appends_same_goal = chat_add_proposal(chat_selected_id,"fixture-model-update","one","把日程改到2026年10月13日16:00至16:30",changed)
        && chat.proposals.len() == 2 && chat.proposals[1].goal_id == goals[0].id && chat.proposals[0].to_json() == old_card_json
    chat_save() chat_apply_proposal("fixture-model-update")
    calendar_agent_update_select()
    bridge_checks.update_prepared_old_plan_invalid = calendar_agent_update_state.records.len() == 1
        && calendar_agent_update_selected != "" && goals.len() == 1 && goals[0].version == 2 && goals[0].approved_at == 0
        && calendar_agent_update_state.records[0].prior_goal_json == old_goal_json
    bridge_checks.old_draft_invalid_handwriting_retained = !mail_calendar_current(old_draft) && mail_draft.preview == ""
        && mail_draft.body == old_draft.body && fixture_rpc("fixture.receiver",{}).data.transport_calls == 0
    if !bridge_checks.update_prepared_old_plan_invalid { bridge_observations.update_notice = calendar_agent_notice return }
    let selected = calendar_agent_update_state.records[0].to_json().parse_json()
    mail_send_confirmed()
    bridge_checks.old_draft_cannot_send = fixture_rpc("fixture.receiver",{}).data.transport_calls == 0
        && !mail_calendar_current(mail_draft) && mail_draft.body == old_draft.body
    let external_args = {id:selected.expected.id expected:selected.expected title:selected.expected.title
        start:selected.expected.start end:selected.expected.end timezone:selected.expected.timezone
        location:selected.expected.location notes:(selected.expected.notes + " 外部合成编辑").trim()}
    let edited = fixture_rpc("fixture/owner-update",external_args)
    bridge_checks.independent_actual_owner_edit = edited.is_ok && edited.data.event.id == original.event.id
        && edited.data.event.request_id == original.event.request_id && edited.data.event.notes == external_args.notes
    bridge_observations.external_reply = edited
    if !bridge_checks.independent_actual_owner_edit { return }
    let external_bytes = fixture_rpc("fixture/owner-store-sha",{}).data
    calendar_agent_update_confirm()
    let mutation = calendar_agent_update_state.records[0]
    bridge_checks.native_stale_expected_not_verified = mutation.receipt_status != "verified" && mutation.status != "prepared"
        && mutation.expected.to_json() == selected.expected.to_json() && mutation.turn_id != ""
    let actual_history = fixture_rpc("octos.session.history",{})
    let cas_error = false let actual_error_receipt = nil
    if actual_history.is_ok && gm_array(actual_history.data["messages"]) {
        for row in actual_history.data.messages {
            if gm_object(row) && row["role"] == "tool" {
                let actual_turn = row["turn_id"] if actual_turn == nil { actual_turn = row["thread_id"] }
                if actual_turn == mutation.turn_id && calendar_agent_tool_name(row["tool_name"]) == "calendar.update_event"
                    && calendar_agent_delete_receipt(row,mutation) == "error" {
                    let receipt = row.host_calendar_receipt
                    if receipt["args_digest"] == mutation.update_digest && receipt.result.to_json().search("changed elsewhere") >= 0 {
                        cas_error = true actual_error_receipt = receipt
                    }
                }
            }
        }
    }
    bridge_checks.actual_kernel_persisted_cas_error_receipt = cas_error
    let readback = fixture_rpc("fixture/read-owner",{method:"get_event" args:{id:original.event.id}})
    bridge_checks.external_same_event_not_overwritten = readback.is_ok && readback.data.found
        && calendar_agent_event_json(readback.data.event) == calendar_agent_event_json(edited.data.event)
        && fixture_rpc("fixture/logsideeffects",{}).data.events.len() == 1
    bridge_checks.actual_cas_refusal_keeps_owner_bytes = fixture_rpc("fixture/owner-store-sha",{}).data.sha256 == external_bytes.sha256
    let before_repeat = fixture_rpc("fixture/call-counts",{}).data["octos.turn.start"]
    calendar_agent_update_confirm() calendar_agent_submit_candidate()
    bridge_checks.native_duplicate_update_or_create_no_turn = fixture_rpc("fixture/call-counts",{}).data["octos.turn.start"] == before_repeat
    bridge_checks.old_creation_journal_retained = calendar_agent_state.to_json() == creation_json && chat.proposals[0].to_json() == old_card_json
    bridge_checks.failed_update_no_completed_goal_run = goals[0].status != "completed" && runs.len() == 0
    let completed = false for entry in memory { if gm_completed_receipt(entry.document) { completed = true } }
    bridge_checks.failed_update_no_completed_memory = !completed
    bridge_checks.no_old_or_new_mail_transport = fixture_rpc("fixture.receiver",{}).data.transport_calls == 0
    storage_write("l3-cas-fault-checkpoint.json",{chat_id:chat_selected_id goal_id:goals[0].id event:edited.data.event
        creation_json:creation_json mutation:mutation old_draft:old_draft owner_store_sha256:external_bytes.sha256}.to_json())
    bridge_observations.owner_read = readback bridge_observations.mutation = mutation
    bridge_observations.actual_cas_error_receipt = actual_error_receipt bridge_observations.actual_history = actual_history
    bridge_observations.goals = goals bridge_observations.memory = memory bridge_observations.draft = mail_draft
    bridge_observations.boundary = "Actual Kernel create/update/history; explicit model tool plan submits preserved old snapshot to test actual owner CAS. Dedicated actual CalendarService process edits notes on the exact marked event. No history or completed state invented. Background timers not drained."
}
let native_preflight_snapshot = nil
fn native_create_preflight(){
    let owner_before = fixture_rpc("fixture/logsideeffects",{})
    let goals_before = goals.to_json() let runs_before = runs.to_json() let memory_before = memory.to_json()
    // First explicit candidate gesture: production code submits only its query turn.
    calendar_agent_submit_candidate()
    bridge_checks.preflight_query_ready_without_binding = calendar_agent_state.status == "turn_completed"
        && calendar_agent_state["binding"] == nil && calendar_agent_preflight.status == "ready"
        && calendar_agent_preflight_current()
    native_preflight_snapshot = {state:calendar_agent_state.to_json().parse_json()
        preflight:calendar_agent_preflight.to_json().parse_json() notice:calendar_agent_notice}
    bridge_observations.preflight = native_preflight_snapshot
    if !bridge_checks.preflight_query_ready_without_binding { return false }
    let history = fixture_rpc("octos.session.history",{})
    let receipt = nil
    if history.is_ok { receipt = calendar_agent_preflight_query(history.data,"{\"limit\":200}") }
    let owner_after = fixture_rpc("fixture/logsideeffects",{})
    bridge_checks.preflight_actual_only_events_limit200_no_owner_write = receipt != nil
        && owner_before.is_ok && owner_after.is_ok && owner_before.data.events.len() == 0
        && owner_after.data.events.to_json() == owner_before.data.events.to_json()
    bridge_checks.preflight_no_goal_run_memory_write = goals.to_json() == goals_before
        && runs.to_json() == runs_before && memory.to_json() == memory_before
    native_preflight_snapshot.actual_history = history native_preflight_snapshot.actual_receipt = receipt
    native_preflight_snapshot.owner_before = owner_before native_preflight_snapshot.owner_after = owner_after
    if !bridge_checks.preflight_actual_only_events_limit200_no_owner_write || !bridge_checks.preflight_no_goal_run_memory_write { return false }
    // Same explicit user gesture as 回读并结清; only the production callback archives.
    calendar_agent_history_settle = true calendar_agent_history()
    let previous = calendar_agent_state.previous_requests
    let last = nil if previous.len() > 0 { last = previous[previous.len()-1] }
    bridge_checks.preflight_archived_idle_current = calendar_agent_state.status == "idle" && last != nil
        && calendar_agent_preflight.status == "ready" && calendar_agent_preflight_current()
        && last.request_id == native_preflight_snapshot.state.request_id && last.turn_id == native_preflight_snapshot.state.turn_id
        && last.status == "turn_completed" && last["binding"] == nil
    native_preflight_snapshot.archived_state = calendar_agent_state.to_json().parse_json()
    return bridge_checks.preflight_archived_idle_current
}
native_cas_fault()
({kind:"NIGHT004_NATIVE_CALENDAR_CAS_FAULT" checks:bridge_checks observations:bridge_observations}).to_json()
