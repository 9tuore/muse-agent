let checks={} let diagnostics={}
checks.production_boot=core_boot_goals() && core_boot_activity() && core_boot_memory() && gm_boot() && chat_boot_data()
let checkpoint=storage_read("l3-native-checkpoint.json").parse_json()
mail_accounts=[{id:"one"}] mail_account=mail_accounts[0] gm_set_accounts(["local","one"])
let current_chat=chat_sessions[chat_session_index(chat_selected_id)]
gm_set_focus(current_chat.focus_project,current_chat.focus_owner)
calendar_agent_boot() calendar_agent_update_boot() calendar_agent_delete_boot() boot_restore("")
checks.new_chat_created=chat_new_session()
let recalled=gm_context("合成日历安排",chat_selected_id,"")
checks.new_chat_empty_chain=ac_current_goal()==nil && ac_projection().nodes.len()==0
checks.original_chat_selected=chat_select_session(checkpoint.chat_id)
ac_choose_matter(checkpoint.goal_id)
let goal=ac_current_goal()
let record=calendar_agent_update_state.records[0]
let artifact=storage_read(goal.result_path).parse_json()
let authority=artifact.native_calendar.authority
let prior=artifact.native_calendar.goal_json.parse_json()
let normalized=goal.to_json().parse_json()
normalized.status=prior.status normalized.approved_at=prior.approved_at normalized.updated_at=prior.updated_at
diagnostics.goal_status=goal.status
diagnostics.artifact_shape=gm_object(artifact) && artifact["schema"]==1 && artifact.task_id==goal.id
    && artifact.plan_revision==goal.version && artifact.mail_status=="verified_by_user"
    && gm_object(artifact.native_calendar) && gm_string(artifact.native_calendar.goal_json,65536)
    && gm_string(artifact.mail_payload_json,12000) && gm_string(artifact.request_id,160) && artifact.request_id!=""
    && gm_string(artifact.mail_verified_id,100) && artifact.mail_verified_id!="" && gm_number(artifact.verified_at) && artifact.verified_at>0
diagnostics.authority_valid=calendar_agent_authority_valid(authority)
diagnostics.authority_goal=prior.id==goal.id && prior.version==goal.version && prior.status=="planned"
    && authority.current_binding.goal_id==goal.id && authority.revision==goal.version
    && artifact.event_id==authority.event.id && artifact.start==authority.event.start && artifact.end==authority.event.end
diagnostics.record_update_equal=authority.update.to_json()==record.to_json().parse_json().to_json()
diagnostics.record_update_canonical_equal=authority.update.to_json().parse_json().to_json()==record.to_json().parse_json().to_json()
diagnostics.record_update_structural_equal=authority.update==record.to_json().parse_json()
diagnostics.authority_update_json=authority.update.to_json()
diagnostics.current_update_json=record.to_json().parse_json().to_json()
diagnostics.record_goal_json_equal=artifact.native_calendar.goal_json==record.goal_json
diagnostics.normalized_goal_equal=normalized.to_json()==prior.to_json()
diagnostics.normalized_goal=normalized.to_json() diagnostics.prior_goal=prior.to_json()
let ai=core_action_index(artifact.request_id)
let action=actions[ai]
diagnostics.action_exact=ai>=0 && action.status=="verified" && action.service=="mail.send"
    && action.goal_id=="" && action.run_id=="" && action.plan_revision==0
    && action.target_scope==artifact.mail_account && action.payload_json==artifact.mail_payload_json
let payload=artifact.mail_payload_json.parse_json()
let declaration=artifact.receiver_declaration
diagnostics.payload_exact=payload.account==artifact.mail_account && payload.to==artifact.mail_to
    && payload.subject==artifact.mail_subject && payload.body==artifact.mail_body
diagnostics.declaration_exact=gm_object(declaration) && declaration.kind=="MAIL_DELIVERY_USER_CONFIRMED"
    && declaration.request_id==artifact.request_id && declaration.goal_id==goal.id && declaration.account_scope==artifact.mail_account
    && declaration.at>=artifact.verified_at && gm_string(declaration.detail,500) && declaration.detail.search(artifact.mail_verified_id)>=0
let matches=0 let bound_run="" let run_valid=true
for run in runs {
    if run.request_id==artifact.request_id && run.goal_id==goal.id {
        if run.plan_revision!=goal.version || run.result_path!=goal.result_path || run.status!=goal.status
            || artifact.run_id!=run.id {run_valid=false}
        matches=matches+1 bound_run=run.id
    }
}
diagnostics.run_exact=matches==1 && run_valid
let si=core_source_index("source:mail-result:"+bound_run,artifact.mail_account)
let mi=core_memory_index("memory:result:"+bound_run,artifact.mail_account)
diagnostics.source_index=si diagnostics.memory_index=mi
diagnostics.actual_artifact_sha256=fs.sha256(storage_read(goal.result_path))
diagnostics.saved_artifact_sha256=memory_sources[si].content_sha256
diagnostics.source_digest_exact=si>=0 && memory_sources[si].content_sha256==fs.sha256(storage_read(goal.result_path))
diagnostics.source_exists_for_memory=mi<0 || si>=0
diagnostics.completion_matches=mail_native_completion_matches(goal,record)
diagnostics.update_current=calendar_agent_update_current(record)
diagnostics.authority_present=calendar_agent_authority()!=nil
diagnostics.mail_calendar_current=mail_calendar_current(mail_draft)
diagnostics.mail_authority_current=calendar_agent_authority_current(mail_draft.official_calendar.authority)
let current_authority=calendar_agent_authority()
if current_authority!=nil {
    diagnostics.mail_authority_structural_equal=current_authority.to_json().parse_json()==mail_draft.official_calendar.authority.to_json().parse_json()
    diagnostics.current_authority_json=current_authority.to_json()
    diagnostics.mail_authority_json=mail_draft.official_calendar.authority.to_json()
}
let view=ac_projection()
let has_calendar=false let has_mail=false
for node in view.nodes {
    if node.title=="官方日历同ID改期"{has_calendar=true}
    if node.title=="回复草稿"{has_mail=true}
}
checks.original_action_chain_restored=goal.id==checkpoint.goal_id && has_calendar && has_mail
checks.no_transport=fixture_trace.len()==0 && fixture_pending.len()==0
({checks:checks diagnostics:diagnostics action_chain:view
    boundary:"Actual Root L3 fixture bytes copied read-only to this VM's isolated memory IO. Production recovery/matcher/projection functions unchanged. No Kernel/Mail/Host/network action."}).to_json()
