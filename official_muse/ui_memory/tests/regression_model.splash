// Existing twelve stale-candidate checks; full Memory DSL fixture fields are
// necessary because the production wrapper now retrieves global context.
fn model_seed(){
    fixture_queue = []
    calendar_selected_goal = ""
    goals = [{id: "fixture-goal" version: 1 status: "planned" archived: false
        mail_source: {account_id: "fixture-account" message_id: "fixture-message" source_id: "fixture-source"}}]
    memory_sources = [{source_id: "fixture-source" kind: "runtime_receipt" locator: "fixture-mail:fixture-message"
        content_sha256: fs.sha256("synthetic") observed_at: "2026-10-03T00:00:00Z" updated_at: "t1" support_excerpt: "synthetic"}]
    memory_sources[0]["scope"] = core_memory_scope("fixture-account")
    memory_sources[0]["scope"].user_id = gm_user_id
    memory_sources[0]["scope"].project_id = ""
    memory_sources[0]["scope"].owner_id = ""
    memory = "[{\"pinned\":false,\"document\":{\"schema_version\":\"muse.dsl/1\",\"kind\":\"memory\",\"id\":\"fixture-claim\",\"revision\":1,\"created_at\":\"2026-10-03T00:00:00Z\",\"updated_at\":\"2026-10-03T00:00:00Z\",\"origin\":{\"type\":\"local_runtime\",\"ref\":\"fixture-mail-host\"},\"scope\":{\"account\":\"fixture-account\",\"project\":\"muse-goals\",\"visibility\":\"personal\"},\"payload\":{\"subject_id\":\"fixture-goal\",\"predicate\":\"calendar_source_message\",\"value\":\"synthetic\",\"epistemic_type\":\"external_claim\",\"source_ids\":[\"fixture-source\"],\"observed_at\":\"2026-10-03T00:00:00Z\",\"valid_from\":null,\"valid_until\":null,\"relations\":[],\"deleted\":false}},\"memory_type\":\"source\",\"source_history\":[\"fixture-source\"],\"history\":[],\"conversation_id\":\"fixture-conversation\"}]".parse_json()
    memory[0].document["scope"].user_id = gm_user_id
    memory[0].document["scope"].project_id = ""
    memory[0].document["scope"].owner_id = ""
    memory_forget = []
    calendar_links = [{goal_id: "fixture-goal" account_id: "fixture-account" message_id: "fixture-message"
        source_id: "fixture-source" source_claim_id: "fixture-claim" candidate_revision: 1
        candidate: {title: "before"} status: "candidate"}]
    calendar_model_candidate("fixture-goal","fixture-account","fixture-message","合成主题","合成正文")
}
fn reply(){
    let callback = fixture_queue[0]
    callback({is_ok: true data: {output: {title: "late" start: "" end: "" time_zone: "Asia/Shanghai" location: ""}}})
    return calendar_links.len() == 0 || calendar_links[0].candidate.title == "before"
}
let model_checks = {}
let model_case = 0
fn probe(){
    fixture_seed()
    gm_boot()
    start_timeout(0.05, || model_seed_case())
}
fn model_seed_case(){
    // The current-generation assertion uses the preceding superseded request.
    // Each other case prepares exactly one model request in its own callback.
    if model_case != 8 { model_seed() }
    fs.write("model-progress.json",{case: model_case phase: "seeded" checks: model_checks}.to_json())
    start_timeout(0.05, || model_run_case())
}
fn model_run_case(){
    if model_case == 0 { goals[0].version = 2 model_checks.goal_revision = reply() }
    if model_case == 1 { goals[0].status = "cancelled" model_checks.cancel_goal = reply() && goals[0].status == "cancelled" }
    if model_case == 2 { memory_sources[0].content_sha256 = fs.sha256("replaced") model_checks.source_digest = reply() }
    if model_case == 3 { memory_sources[0].updated_at = "t2" model_checks.source_revision = reply() }
    if model_case == 4 { memory[0].document.revision = 2 model_checks.claim_revision = reply() }
    if model_case == 5 {
        memory_forget = [{source_id: "fixture-source" subject_id: "fixture-goal"
            predicate: "calendar_source_message" account_scope: "fixture-account"
            at: "2026-10-03T00:00:00Z" content_sha256: fs.sha256("synthetic") "scope": memory_sources[0]["scope"]}]
        model_checks.forgotten_tombstone = reply()
    }
    if model_case == 6 { memory_sources = [] model_checks.source_deleted = reply() }
    if model_case == 7 {
        calendar_model_candidate("fixture-goal","fixture-account","fixture-message","新主题","新正文")
        model_checks.superseded_request = reply()
    }
    if model_case == 8 {
        let current_callback = fixture_queue[1]
        current_callback({is_ok: true data: {output: {title: "current" start: "" end: "" time_zone: "Asia/Shanghai" location: ""}}})
        model_checks.current_generation = calendar_links[0].candidate.title == "current" && calendar_links[0].candidate_revision == 2
    }
    if model_case == 9 { memory[0].document.payload.deleted = true model_checks.forgotten_source = reply() }
    if model_case == 10 { calendar_links[0].candidate_revision = 2 model_checks.candidate_edited = reply() }
    if model_case == 11 { goals = [] model_checks.goal_deleted = reply() }
    fs.write("model-progress.json",{case: model_case phase: "asserted" checks: model_checks}.to_json())
    model_case = model_case + 1
    if model_case < 12 { start_timeout(0.05, || model_seed_case()) }
    else { model_checks.activity = activity fs.write("probe.json",model_checks.to_json()) }
}
start_timeout(0.1, || probe())
