// Production mail -> candidate -> approval -> CRUD/get, entirely synthetic transport.
let chain_calls = []
let chain_models = []
let chain_event = nil
let chain_conflict = false
let chain_write_count = 0
let chain_goal = ""
let chain_result = {}
let chain_preview = ""
fn chain_fixture_request(service,args,cb){
    chain_calls.push({service: service args: args})
    if service == "mail.accounts" { cb({is_ok: true data: [{id: "synthetic-account" address: "self@example.invalid"}]}) return }
    if service == "model.complete" { chain_models.push(cb) return }
    if service == "calendar.status" {
        cb({is_ok: true data: {permission: "full_access" calendars: [{id: "fixture-calendar" writable: true}]}}) return
    }
    if service == "calendar.list" {
        let events = []
        if chain_conflict { events.push({id: "conflict" version: "conflict-v1" calendar_id: "fixture-calendar"
            title: "外部合成冲突" start: args.start end: args.end time_zone: "Asia/Shanghai" location: "合成"}) }
        if chain_event != nil && calendar_iso_utc(chain_event.start) < calendar_iso_utc(args.end)
            && calendar_iso_utc(chain_event.end) > calendar_iso_utc(args.start) { events.push(chain_event) }
        cb({is_ok: true data: {events: events truncated: false}}) return
    }
    if service == "calendar.get" {
        cb({is_ok: true data: {found: chain_event != nil event: chain_event}}) return
    }
    if service == "calendar.create" {
        chain_write_count = chain_write_count + 1
        chain_event = {id: "fixture-chain-event" calendar_id: args.calendar_id version: "fixture-v1"
            title: args.title start: args.start end: args.end time_zone: args.time_zone location: args.location}
        cb({is_ok: true data: {event_id: chain_event.id version: chain_event.version}}) return
    }
    if service == "calendar.update" {
        chain_write_count = chain_write_count + 1
        chain_event = args.changes.to_json().parse_json()
        chain_event += {id: args.event_id calendar_id: args.calendar_id version: "fixture-v2"}
        cb({is_ok: true data: {event_id: chain_event.id version: chain_event.version}}) return
    }
    if service == "calendar.delete" {
        chain_write_count = chain_write_count + 1 chain_event = nil
        cb({is_ok: true data: {deleted: true}}) return
    }
    cb({is_ok: false error: "Synthetic chain forbids other services"})
}
fn chain_count(service){
    let count = 0 for call in chain_calls { if call.service == service { count = count + 1 } }
    return count
}
fn probe(){
    fixture_seed()
    start_timeout(0.03,|| chain_setup())
}
fn chain_setup(){
    chat_boot() gm_boot() gm_set_focus("合成验收","个人")
    notification_enabled = false
    mail_accounts = [{id: "synthetic-account" address: "self@example.invalid"}]
    mail_account = mail_accounts[0]
    gm_set_accounts(["synthetic-account"])
    // Explicit mail scope is user input; current Chat focus no longer assigns mail ownership.
    mail_scope_project = "合成验收" mail_scope_owner = "个人"
    mail_selected = {id: "fixture-meeting" sender: "合成邀请人" address: "sender@example.invalid"
        subject: "MUSE-R2-OVERNIGHT 日程邀请" body: "2026-10-04 15:00至16:00，Asia/Shanghai，合成会议室。"}
    start_timeout(0.03,|| chain_link_mail())
}
fn chain_link_mail(){
    mail_link_calendar()
    start_timeout(0.03,|| chain_assert_source())
}
fn chain_assert_source(){
    chain_goal = selected_id
    let li = calendar_link_index(chain_goal)
    chain_result.mail_source_bound = goals.len() == 1 && li >= 0 && chain_models.len() == 1
        && goals[0].mail_source.message_id == "fixture-meeting" && calendar_links[li].source_id == goals[0].mail_source.source_id
    if !chain_result.mail_source_bound { fs.write("probe.json",chain_result.to_json()) return }
    start_timeout(0.03,|| chain_ambiguous_candidate())
}
fn chain_ambiguous_candidate(){
    chain_models[0]({is_ok: true data: {output: {title: "MUSE-R2-OVERNIGHT" start: "" end: "" time_zone: "Asia/Shanghai" location: "合成会议室"}}})
    calendar_calendar_id = "fixture-calendar"
    start_timeout(0.03,|| chain_ambiguous_check())
}
fn chain_ambiguous_check(){
    calendar_check_conflicts()
    start_timeout(0.03,|| chain_ambiguous_preview())
}
fn chain_ambiguous_preview(){
    calendar_preview_action()
    chain_result.ambiguous_date_blocks = calendar_preview == "" && chain_write_count == 0 && calendar_error != ""
    start_timeout(0.03,|| chain_request_dates())
}
fn chain_request_dates(){
    calendar_model_candidate(chain_goal,"synthetic-account","fixture-meeting",mail_selected.subject,mail_selected.body)
    start_timeout(0.03,|| chain_dates_candidate())
}
fn chain_dates_candidate(){
    chain_models[1]({is_ok: true data: {output: {title: "MUSE-R2-OVERNIGHT" start: "2026-10-04T15:00:00+08:00"
        end: "2026-10-04T16:00:00+08:00" time_zone: "Asia/Shanghai" location: "合成会议室"}}})
    calendar_calendar_id = "fixture-calendar"
    let li = calendar_link_index(chain_goal)
    chain_result.explicit_dates_candidate = ui.calendar_start.text() == "2026-10-04T15:00:00+08:00"
        && ui.calendar_end.text() == "2026-10-04T16:00:00+08:00" && calendar_links[li].status == "candidate" && chain_write_count == 0
    start_timeout(0.03,|| chain_conflict_check())
}
fn chain_conflict_check(){
    chain_conflict = true calendar_check_conflicts()
    start_timeout(0.03,|| chain_conflict_preview())
}
fn chain_conflict_preview(){
    calendar_preview_action()
    chain_result.conflict_blocks_preview = calendar_conflicts.len() == 1 && calendar_preview == "" && chain_write_count == 0
    start_timeout(0.03,|| chain_clear_check())
}
fn chain_clear_check(){
    chain_conflict = false calendar_check_conflicts()
    start_timeout(0.03,|| chain_waiting_preview())
}
fn chain_waiting_preview(){
    calendar_preview_action()
    let li = calendar_link_index(chain_goal)
    chain_result.waiting_user_no_write = calendar_preview != "" && calendar_links[li].status == "waiting_user"
        && goals[0].status == "planned" && runs.len() == 0 && actions.len() == 0 && chain_write_count == 0
    fs.write("chain-waiting-user.json",{goal: goals[0] link: calendar_links[li] preview: calendar_preview
        writes: chain_write_count calls: chain_calls}.to_json())
    start_timeout(0.03,|| chain_create())
}
fn chain_create(){
    calendar_confirm_action()
    start_timeout(0.03,|| chain_assert_create())
}
fn chain_assert_create(){
    let li = calendar_link_index(chain_goal)
    let artifact = fs.read(goals[core_goal_index(chain_goal)].result_path).parse_json()
    chain_result.synthetic_create_independent_get = chain_write_count == 1 && chain_count("calendar.get") == 1
        && chain_event != nil && actions.len() == 1 && actions[0].status == "verified"
        && runs.len() == 1 && runs[0].status == "completed" && calendar_links[li].status == "verified"
        && artifact.task_id == chain_goal && artifact.event_id == chain_event.id && artifact.version == "fixture-v1"
    start_timeout(0.03,|| chain_duplicate_create())
}
fn chain_duplicate_create(){
    calendar_confirm_action()
    chain_result.duplicate_create_blocked = chain_write_count == 1
    let artifact = fs.read(goals[core_goal_index(chain_goal)].result_path).parse_json()
    fs.write("chain-created.json",{event: chain_event goals: goals runs: runs actions: actions artifact: artifact}.to_json())
    start_timeout(0.03,|| chain_update())
}
fn chain_update(){
    calendar_selected_goal = ""
    calendar_selected_event = chain_event.to_json().parse_json()
    calendar_operation = "update"
    ui.calendar_title.set_text("MUSE-R2-OVERNIGHT updated")
    calendar_edit()
    start_timeout(0.03,|| chain_update_check())
}
fn chain_update_check(){
    calendar_check_conflicts()
    start_timeout(0.03,|| chain_update_preview())
}
fn chain_update_preview(){
    calendar_preview_action()
    chain_preview = calendar_preview
    start_timeout(0.03,|| chain_update_confirm())
}
fn chain_update_confirm(){
    calendar_confirm_action()
    start_timeout(0.03,|| chain_assert_update())
}
fn chain_assert_update(){
    chain_result.synthetic_update_independent_get = chain_preview != "" && chain_write_count == 2 && chain_count("calendar.get") == 3
        && chain_event.title == "MUSE-R2-OVERNIGHT updated" && chain_event.version == "fixture-v2"
        && actions.len() == 2 && actions[1].status == "verified"
    fs.write("chain-updated.json",{event: chain_event actions: actions}.to_json())
    start_timeout(0.03,|| chain_delete())
}
fn chain_delete(){
    calendar_selected_event = chain_event.to_json().parse_json()
    calendar_operation = "delete"
    ui.calendar_delete_id.set_text("MUSE-R2-OVERNIGHT")
    calendar_preview_action()
    chain_preview = calendar_preview
    start_timeout(0.03,|| chain_delete_confirm())
}
fn chain_delete_confirm(){
    calendar_confirm_action()
    start_timeout(0.03,|| chain_assert_delete())
}
fn chain_assert_delete(){
    chain_result.synthetic_delete_independent_get = chain_preview != "" && chain_write_count == 3 && chain_count("calendar.get") == 5
        && chain_event == nil && calendar_selected_event == nil && actions.len() == 3 && actions[2].status == "verified"
    let forbidden = []
    for call in chain_calls { if call.service == "mail.send" || call.service == "mail.delete" { forbidden.push(call.service) } }
    chain_result.forbidden_calls = forbidden chain_result.host_calls = chain_calls
    chain_result.boundary = "All Calendar mutation replies and get results are synthetic; no OS service or real mail invoked."
    fs.write("probe.json",chain_result.to_json())
}
start_timeout(0.1,|| probe())
