// Synthetic transport; exercise the unmodified production model wrapper.
// No model inference, account grant or external action is performed.
let identity_checks = {}
let identity_calls = []
let identity_case = 0
let identity_current = true
fn probe_transport(method,args,callback){
    identity_calls.push(method)
    if method == "mail.accounts" {
        callback({is_ok: true data: [{id: "synthetic-account"}]}) return
    }
    if method != "model.complete" {
        callback({is_ok: false error: "Unexpected synthetic request"}) return
    }
    if identity_case == 1 { gm_set_accounts([]) }
    if identity_case == 2 { gm_user_id = "synthetic-other-user" }
    if identity_case == 3 { gm_enabled = false }
    if identity_case == 4 { identity_current = false }
    if identity_case == 5 { gm_set_focus("other-project","other-owner") }
    callback({is_ok: true data: {output: {reply: "synthetic"}}})
}
fn identity_next(){
    gm_user_id = "synthetic-user" gm_enabled = true gm_ready = true
    gm_set_accounts([]) gm_set_focus("project-a","owner-a")
    memory = [] memory_sources = [] memory_forget = [] goals = []
    identity_current = true
    muse_model_request("synthetic query","","",|| identity_current,
        {task: "Synthetic identity regression" input: {} schema: {}},fn(r){
        let rejected = !r.is_ok && r.error.search("cancelled:") == 0
        if identity_case == 0 { identity_checks.current_identity_accepted = r.is_ok }
        if identity_case == 1 { identity_checks.revoked_account_rejected = rejected }
        if identity_case == 2 { identity_checks.changed_user_rejected = rejected }
        if identity_case == 3 { identity_checks.disabled_memory_rejected = rejected }
        if identity_case == 4 { identity_checks.cancelled_request_rejected = rejected }
        if identity_case == 5 { identity_checks.unrelated_focus_does_not_cancel_valid_request = r.is_ok }
        identity_case = identity_case + 1
        if identity_case < 6 { start_timeout(0.05,|| identity_next()) }
        else { fs.write("probe.json",{checks: identity_checks calls: identity_calls}.to_json()) }
    })
}
start_timeout(0.05,|| identity_next())
