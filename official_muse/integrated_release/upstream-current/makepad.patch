new file mode 100644
index 0000000..1fe6ef7
--- /dev/null
+++ b/platform/src/system_browser.rs
@@ -0,0 +1,123 @@
+//! Navigation boundaries shared by the desktop embedded-browser adapters.
+//! The caller has already checked the app's initial URL grant. Native page
+//! navigations must not turn that grant into file, device or external-app access.
+use std::net::IpAddr;
+use url::{Host, Url};
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum NavigationDecision {
+    Allow,
+    Block,
+    /// Intercept before loading; deliver only through the host auth event.
+    Callback,
+}
+
+#[derive(Clone)]
+pub struct BrowserPolicy {
+    initial: Url,
+    navigable: bool,
+    callback: Option<Url>,
+}
+
+impl BrowserPolicy {
+    pub fn reader(initial: &str, navigable: bool) -> Result<Self, &'static str> {
+        let initial = address(initial).ok_or("Invalid embedded page address")?;
+        if !page_scheme(&initial) && initial.as_str() != "about:blank" {
+            return Err("Embedded pages require an HTTP or HTTPS address");
+        }
+        Ok(Self { initial, navigable, callback: None })
+    }
+
+    pub fn auth(initial: &str, callback: &str) -> Result<Self, &'static str> {
+        let initial = address(initial).filter(auth_scheme)
+            .ok_or("Invalid authentication origin")?;
+        let callback = address(callback).filter(auth_scheme)
+            .filter(|url| url.query().is_none() && url.fragment().is_none())
+            .ok_or("Invalid authentication callback")?;
+        Ok(Self { initial, navigable: false, callback: Some(callback) })
+    }
+
+    pub fn is_auth(&self) -> bool { self.callback.is_some() }
+
+    pub fn decide(&self, requested: &str, main_frame: bool) -> NavigationDecision {
+        let Some(requested) = address(requested) else { return NavigationDecision::Block; };
+        if let Some(callback) = &self.callback {
+            if requested.origin() == callback.origin() && requested.path() == callback.path() {
+                return if main_frame && requested.fragment().is_none() {
+                    NavigationDecision::Callback
+                } else { NavigationDecision::Block };
+            }
+            return if auth_scheme(&requested) && requested.origin() == self.initial.origin() {
+                NavigationDecision::Allow
+            } else { NavigationDecision::Block };
+        }
+        // Fragment changes stay inside the same document; redirects or links
+        // to another path/query do not inherit a read-only document grant.
+        if same_document(&self.initial, &requested) {
+            return NavigationDecision::Allow;
+        }
+        if self.navigable && public_https(&requested) {
+            NavigationDecision::Allow
+        } else { NavigationDecision::Block }
+    }
+}
+
+fn address(value: &str) -> Option<Url> {
+    if value.is_empty() || value.len() > 16_384
+        || value.chars().any(|c| c.is_control() || c.is_whitespace() || c == '\\')
+    { return None; }
+    let parsed = Url::parse(value).ok()?;
+    if !parsed.username().is_empty() || parsed.password().is_some() { return None; }
+    Some(parsed)
+}
+
+fn page_scheme(url: &Url) -> bool {
+    matches!(url.scheme(), "http" | "https") && url.host().is_some()
+}
+
+fn auth_scheme(url: &Url) -> bool {
+    url.host().is_some() && (url.scheme() == "https"
+        || (url.scheme() == "http" && url.host_str() == Some("127.0.0.1")))
+}
+
+fn same_document(initial: &Url, requested: &Url) -> bool {
+    let mut initial = initial.clone();
+    let mut requested = requested.clone();
+    initial.set_fragment(None);
+    requested.set_fragment(None);
+    initial == requested
+}
+
+fn public_https(url: &Url) -> bool {
+    if url.scheme() != "https" { return false; }
+    match url.host() {
+        Some(Host::Ipv4(ip)) => public_ip(ip.into()),
+        Some(Host::Ipv6(ip)) => public_ip(ip.into()),
+        Some(Host::Domain(host)) => {
+            let host = host.trim_end_matches('.');
+            host.contains('.') && !["localhost", "internal", "local", "lan", "home.arpa"]
+                .iter().any(|name| host == *name || host.strip_suffix(name).is_some_and(|prefix| prefix.ends_with('.')))
+        }
+        None => false,
+    }
+}
+
+fn public_ip(ip: IpAddr) -> bool {
+    match ip {
+        IpAddr::V4(ip) => {
+            let [a, b, ..] = ip.octets();
+            !(ip.is_loopback() || ip.is_private() || ip.is_link_local()
+                || ip.is_unspecified() || ip.is_broadcast() || ip.is_documentation()
+                || ip.is_multicast() || a == 0 || a >= 240
+                || (a == 100 && (64..128).contains(&b)))
+        }
+        IpAddr::V6(ip) => {
+            if let Some(v4) = ip.to_ipv4_mapped() { return public_ip(v4.into()); }
+            let parts = ip.segments();
+            !(ip.is_loopback() || ip.is_unspecified() || ip.is_multicast()
+                || (parts[0] & 0xfe00) == 0xfc00 || (parts[0] & 0xffc0) == 0xfe80
+                || (parts[0] & 0xffc0) == 0xfec0
+                || (parts[0] == 0x2001 && parts[1] == 0xdb8))
+        }
+    }
+}
