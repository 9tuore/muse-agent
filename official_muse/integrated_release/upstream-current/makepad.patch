diff --git a/platform/src/input_provenance.rs b/platform/src/input_provenance.rs
new file mode 100644
index 0000000..172a091
--- /dev/null
+++ b/platform/src/input_provenance.rs
@@ -0,0 +1,148 @@
+//! Input provenance for host-owned approval controls.
+//!
+//! Android touchscreen metadata and macOS AppKit pointer metadata establish
+//! trust. Other platforms, remote input and synthetic dispatch default to false.
+//! This is an
+//! app-level boundary, not attestation against a compromised OS/root process
+//! that can impersonate a physical input device.
+use std::cell::Cell;
+
+thread_local! {
+    static TRUSTED: Cell<bool> = const { Cell::new(false) };
+    static FORCE_UNTRUSTED: Cell<bool> = const { Cell::new(false) };
+}
+
+/// True only during a verified native input's synchronous application handler.
+/// This is not a persistent approval token; hosts must bind the actual gesture
+/// and reviewed operation. Script tasks and subsequent actions are untrusted.
+pub fn trusted_user_input() -> bool {
+    TRUSTED.with(Cell::get)
+}
+
+/// Run synthetic/direct-widget input without inheriting a surrounding native
+/// gesture. This API can remove trust but cannot create it.
+pub fn with_untrusted_input<R>(f: impl FnOnce() -> R) -> R {
+    let _guard = UntrustedInputGuard::enter();
+    f()
+}
+
+pub(crate) struct InputTrustGuard(bool);
+impl InputTrustGuard {
+    pub(crate) fn enter(trusted: bool) -> Self {
+        let trusted = trusted && !FORCE_UNTRUSTED.with(Cell::get);
+        Self(TRUSTED.with(|value| value.replace(trusted)))
+    }
+}
+impl Drop for InputTrustGuard {
+    fn drop(&mut self) {
+        TRUSTED.with(|value| value.set(self.0));
+    }
+}
+
+/// Synthetic dispatch is a sticky deny for its entire synchronous scope,
+/// including a nested native callback. Restores both flags during unwind.
+pub(crate) struct UntrustedInputGuard {
+    previous_trust: bool,
+    previous_forced: bool,
+}
+impl UntrustedInputGuard {
+    pub(crate) fn enter() -> Self {
+        Self {
+            previous_trust: TRUSTED.with(|value| value.replace(false)),
+            previous_forced: FORCE_UNTRUSTED.with(|value| value.replace(true)),
+        }
+    }
+}
+impl Drop for UntrustedInputGuard {
+    fn drop(&mut self) {
+        FORCE_UNTRUSTED.with(|value| value.set(self.previous_forced));
+        TRUSTED.with(|value| value.set(self.previous_trust));
+    }
+}
+
+/// AppKit must supply an actual CGEvent from the HID source with no source
+/// process. A nil CGEvent, combined/private event source or posted process is
+/// rejected. This is source metadata, not attestation against forged HID input.
+#[cfg(any(target_os = "macos", test))]
+pub(crate) fn macos_pointer_is_trusted(has_cg_event: bool, source_state: i64, source_pid: i64) -> bool {
+    has_cg_event && source_state == 1 && source_pid == 0
+}
+
+/// Android MotionEvent metadata. Missing/virtual devices, non-touch sources,
+/// obscured windows and cancellation never establish approval provenance.
+#[cfg(any(target_os = "android", test))]
+pub(crate) fn android_touch_is_trusted(
+    device_id: i32,
+    physical_device: bool,
+    source: i32,
+    flags: i32,
+    action: i32,
+) -> bool {
+    const SOURCE_TOUCHSCREEN: i32 = 0x1002;
+    const OBSCURED: i32 = 0x1 | 0x2;
+    device_id > 0
+        && physical_device
+        && source & SOURCE_TOUCHSCREEN == SOURCE_TOUCHSCREEN
+        && flags & OBSCURED == 0
+        && matches!(action, 0 | 1 | 2 | 5 | 6)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn synthetic_nested_dispatch_cannot_inherit_native_trust() {
+        assert!(!trusted_user_input());
+        {
+            let _native = InputTrustGuard::enter(true);
+            assert!(trusted_user_input());
+            with_untrusted_input(|| {
+                assert!(!trusted_user_input());
+                with_untrusted_input(|| assert!(!trusted_user_input()));
+                let _nested_native = InputTrustGuard::enter(true);
+                assert!(!trusted_user_input());
+            });
+            assert!(trusted_user_input());
+        }
+        assert!(!trusted_user_input());
+    }
+
+    #[test]
+    fn unwind_restores_previous_scope_and_threads_do_not_share_trust() {
+        let _native = InputTrustGuard::enter(true);
+        assert!(!std::thread::spawn(trusted_user_input).join().unwrap());
+        let result = std::panic::catch_unwind(|| with_untrusted_input(|| panic!("test")));
+        assert!(result.is_err());
+        assert!(trusted_user_input());
+    }
+
+    #[test]
+    fn macos_requires_an_event_from_the_hid_source_without_a_posting_process() {
+        assert!(macos_pointer_is_trusted(true, 1, 0));
+        for (present, state, pid) in [
+            (false, 1, 0), (true, 0, 0), (true, -1, 0),
+            (true, 1, 123), (true, 1, -1), (true, 42, 0),
+        ] {
+            assert!(!macos_pointer_is_trusted(present, state, pid));
+        }
+    }
+
+    #[test]
+    fn android_requires_physical_unobscured_touch_and_never_cancel() {
+        for action in [0, 1, 2, 5, 6] {
+            assert!(android_touch_is_trusted(4, true, 0x1002, 0, action));
+        }
+        for (id, physical, source, flags, action) in [
+            (0, true, 0x1002, 0, 1),
+            (-1, true, 0x1002, 0, 1),
+            (4, false, 0x1002, 0, 1),
+            (4, true, 0x2002, 0, 1),
+            (4, true, 0x1002, 1, 1),
+            (4, true, 0x1002, 2, 1),
+            (4, true, 0x1002, 0, 3),
+        ] {
+            assert!(!android_touch_is_trusted(id, physical, source, flags, action));
+        }
+    }
+}
