+    fn completion_cannot_claim_another_device_or_direction() {
+        let input = Arc::new(());
+        let output = Arc::new(());
+        let device = AudioDeviceId(LiveId(9));
+        let units = vec![RunningAudioUnit {
+            device_id: device, generation: input.clone(), audio_unit: None,
+        }];
+        assert_eq!(pending_audio_unit_index(&units, device, &output), None);
+        assert_eq!(pending_audio_unit_index(&units, AudioDeviceId(LiveId(10)), &input), None);
+        assert_eq!(pending_audio_unit_index(&units, device, &input), Some(0));
+    }
+}
