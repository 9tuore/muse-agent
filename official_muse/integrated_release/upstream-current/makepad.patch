+    #[test]
+    fn cancelled_open_cannot_reclaim_same_device_after_restart() {
+        let device = AudioDeviceId(LiveId(7));
+        let original = Arc::new(());
+        let mut units = vec![RunningAudioUnit {
+            device_id: device, generation: original.clone(), audio_unit: None,
+        }];
+        assert_eq!(pending_audio_unit_index(&units, device, &original), Some(0));
+        units.clear();
+        assert_eq!(pending_audio_unit_index(&units, device, &original), None);
+        let replacement = Arc::new(());
+        units.push(RunningAudioUnit {
+            device_id: device, generation: replacement.clone(), audio_unit: None,
+        });
+        assert_eq!(pending_audio_unit_index(&units, device, &original), None,
+            "late success or failure cannot start or remove the replacement");
+        assert_eq!(pending_audio_unit_index(&units, device, &replacement), Some(0));
+    }
+
