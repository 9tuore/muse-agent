diff --git a/platform/src/os/apple/apple_auth_browser.rs b/platform/src/os/apple/apple_auth_browser.rs
new file mode 100644
index 0000000..d597c63
--- /dev/null
+++ b/platform/src/os/apple/apple_auth_browser.rs
@@ -0,0 +1,258 @@
+//! Restricted, host-owned authentication mode for the existing WKWebView.
+//! WebKit invokes these delegates on the main thread. State is boxed for a
+//! stable ObjC ivar address and detached before the delegate/state is released.
+use super::*;
+use crate::{cx::Cx, event::NativeAuthBrowserEvent};
+use std::{cell::Cell, sync::OnceLock};
+
+#[derive(PartialEq, Eq)]
+struct Origin {
+    scheme: String,
+    host: String,
+    port: i64,
+}
+
+struct Address {
+    origin: Origin,
+    path: String,
+    fragment: bool,
+    query: bool,
+}
+
+impl Address {
+    unsafe fn from_url(url: ObjcId) -> Option<Self> {
+        if url == nil { return None; }
+        let components: ObjcId = msg_send![class!(NSURLComponents), componentsWithURL: url resolvingAgainstBaseURL: NO];
+        if components == nil { return None; }
+        let user: ObjcId = msg_send![components, user];
+        let password: ObjcId = msg_send![components, password];
+        if user != nil || password != nil { return None; }
+        let scheme: ObjcId = msg_send![components, scheme];
+        let host: ObjcId = msg_send![components, host];
+        if scheme == nil || host == nil { return None; }
+        let scheme = crate::os::apple::apple_util::nsstring_to_string(scheme).to_ascii_lowercase();
+        let host = crate::os::apple::apple_util::nsstring_to_string(host).to_ascii_lowercase();
+        // Production registrations are HTTPS; HTTP is limited to the explicit
+        // local acceptance backend. No file/data/javascript/custom URL schemes.
+        if host.is_empty() || !(scheme == "https" || (scheme == "http" && host == "127.0.0.1")) {
+            return None;
+        }
+        let port: ObjcId = msg_send![components, port];
+        let port: i64 = if port == nil { if scheme == "https" { 443 } else { 80 } }
+            else { msg_send![port, longLongValue] };
+        if !(1..=65535).contains(&port) { return None; }
+        // Compare encoded paths, not lossy decoded paths. Callback lookalikes
+        // such as an encoded slash must never be recognized as the callback.
+        let path: ObjcId = msg_send![components, percentEncodedPath];
+        let mut path = if path == nil { String::new() }
+            else { crate::os::apple::apple_util::nsstring_to_string(path) };
+        if path.is_empty() { path.push('/'); }
+        let fragment: ObjcId = msg_send![components, fragment];
+        let query: ObjcId = msg_send![components, query];
+        Some(Self { origin: Origin { scheme, host, port }, path,
+            fragment: fragment != nil, query: query != nil })
+    }
+
+    fn parse(url: &str) -> Option<Self> {
+        if url.is_empty() || url.len() > 16384 || url.chars().any(char::is_control) { return None; }
+        unsafe {
+            let url: ObjcId = msg_send![class!(NSURL), URLWithString: str_to_nsstring(url)];
+            Self::from_url(url)
+        }
+    }
+}
+
+struct AuthState {
+    browser_id: u64,
+    origin: Option<Origin>,
+    callback: Option<Address>,
+    finished: Cell<bool>,
+}
+
+impl AuthState {
+    fn emit(&self, kind: &str, url: String) {
+        Cx::post_action(NativeAuthBrowserEvent {
+            browser_id: self.browser_id, kind: kind.into(), url,
+        });
+    }
+
+    fn cancel(&self) {
+        if !self.finished.replace(true) { self.emit("cancelled", String::new()); }
+    }
+
+    fn blocked(&self) {
+        if !self.finished.get() { self.emit("blocked", String::new()); }
+    }
+
+    fn same_origin(&self, address: &Address) -> bool {
+        self.callback.is_some() && self.origin.as_ref() == Some(&address.origin)
+    }
+
+    // Returns the WebKit policy: 0 = cancel, 1 = allow. Never open an external
+    // app/browser on behalf of a backend page. Only the exact callback carries
+    // a URL into a host action; other events contain no path/query/credential.
+    unsafe fn navigation(&self, url: ObjcId, main_frame: bool, has_frame: bool) -> i64 {
+        if self.finished.get() { return 0; }
+        let Some(address) = Address::from_url(url) else { self.blocked(); return 0; };
+        if let Some(callback) = &self.callback {
+            if address.origin == callback.origin && address.path == callback.path {
+                if main_frame && !address.fragment {
+                    let absolute: ObjcId = msg_send![url, absoluteString];
+                    if absolute != nil {
+                        let value = crate::os::apple::apple_util::nsstring_to_string(absolute);
+                        if value.len() <= 16384 {
+                            self.finished.set(true);
+                            self.emit("callback", value);
+                            return 0;
+                        }
+                    }
+                }
+                self.blocked();
+                return 0;
+            }
+        }
+        if has_frame && self.same_origin(&address) { 1 }
+        else { self.blocked(); 0 }
+    }
+}
+
+pub(super) struct AuthBrowser {
+    delegate: ObjcId,
+    state: Box<AuthState>,
+    inspectable: bool,
+}
+
+impl AuthBrowser {
+    pub(super) fn new(browser_id: u64, url: &str, callback_url: &str, inspectable: bool) -> Self {
+        let state = Box::new(AuthState {
+            browser_id,
+            origin: Address::parse(url).map(|address| address.origin),
+            callback: Address::parse(callback_url).filter(|address| !address.fragment && !address.query),
+            finished: Cell::new(false),
+        });
+        unsafe {
+            let delegate: ObjcId = msg_send![delegate_class(), new];
+            (*delegate).set_ivar("auth_state", &*state as *const AuthState as *mut c_void);
+            let browser = Self { delegate, state, inspectable };
+            if browser.state.origin.is_none() || browser.state.callback.is_none() {
+                browser.error();
+            }
+            browser
+        }
+    }
+
+    pub(super) fn inspectable(&self) -> bool { self.inspectable }
+
+    pub(super) fn error(&self) {
+        if !self.state.finished.get() { self.state.emit("error", String::new()); }
+    }
+
+    pub(super) fn may_load(&self, url: &str) -> bool {
+        let allowed = !self.state.finished.get() && self.state.callback.is_some()
+            && Address::parse(url).is_some_and(|address| self.state.same_origin(&address));
+        if !allowed { self.state.blocked(); }
+        allowed
+    }
+
+    pub(super) unsafe fn attach(&self, web_view: ObjcId) {
+        let () = msg_send![web_view, setNavigationDelegate: self.delegate];
+        let () = msg_send![web_view, setUIDelegate: self.delegate];
+    }
+
+    pub(super) fn detach(&self, web_view: ObjcId) {
+        self.state.cancel();
+        unsafe {
+            if web_view != nil {
+                let () = msg_send![web_view, setNavigationDelegate: nil];
+                let () = msg_send![web_view, setUIDelegate: nil];
+            }
+        }
+    }
+}
+
+impl Drop for AuthBrowser {
+    fn drop(&mut self) {
+        unsafe {
+            (*self.delegate).set_ivar("auth_state", std::ptr::null_mut::<c_void>());
+            let () = msg_send![self.delegate, release];
+        }
+    }
+}
+
+unsafe fn state(this: &Object) -> Option<&AuthState> {
+    let pointer: *mut c_void = *this.get_ivar("auth_state");
+    (pointer as *const AuthState).as_ref()
+}
+
+fn delegate_class() -> *const Class {
+    static CLASS: OnceLock<usize> = OnceLock::new();
+    *CLASS.get_or_init(|| {
+        extern "C" fn decide(this: &Object, _: Sel, _: ObjcId, action: ObjcId, handler: ObjcId) {
+            unsafe {
+                let policy = if let Some(state) = state(this) {
+                    let request: ObjcId = msg_send![action, request];
+                    let url: ObjcId = msg_send![request, URL];
+                    let frame: ObjcId = msg_send![action, targetFrame];
+                    let main: BOOL = if frame == nil { NO } else { msg_send![frame, isMainFrame] };
+                    let source: ObjcId = msg_send![action, sourceFrame];
+                    let source_main: BOOL = if source == nil { NO } else { msg_send![source, isMainFrame] };
+                    state.navigation(url, main == YES && source_main == YES, frame != nil)
+                } else { 0 };
+                objc_block_invoke!(handler, invoke((policy): i64));
+            }
+        }
+        extern "C" fn response(this: &Object, _: Sel, _: ObjcId, response: ObjcId, handler: ObjcId) {
+            unsafe {
+                let policy = if let Some(state) = state(this) {
+                    let value: ObjcId = msg_send![response, response];
+                    let url: ObjcId = msg_send![value, URL];
+                    let display: BOOL = msg_send![response, canShowMIMEType];
+                    if !state.finished.get() && display == YES
+                        && Address::from_url(url).is_some_and(|address| state.same_origin(&address)) { 1i64 }
+                    else { state.blocked(); 0i64 }
+                } else { 0i64 };
+                objc_block_invoke!(handler, invoke((policy): i64));
+            }
+        }
+        extern "C" fn started(this: &Object, _: Sel, _: ObjcId, _: ObjcId) {
+            unsafe { if let Some(state) = state(this) { if !state.finished.get() { state.emit("loading", String::new()); } } }
+        }
+        extern "C" fn finished(this: &Object, _: Sel, _: ObjcId, _: ObjcId) {
+            unsafe { if let Some(state) = state(this) { if !state.finished.get() { state.emit("loaded", String::new()); } } }
+        }
+        extern "C" fn failed(this: &Object, _: Sel, _: ObjcId, _: ObjcId, error: ObjcId) {
+            unsafe {
+                let code: i64 = msg_send![error, code];
+                // WebKit reports cancellation after intentional policy refusal.
+                if code == -999 { return; }
+                if let Some(state) = state(this) { if !state.finished.get() { state.emit("error", String::new()); } }
+            }
+        }
+        extern "C" fn terminated(this: &Object, _: Sel, _: ObjcId) {
+            unsafe { if let Some(state) = state(this) { if !state.finished.get() { state.emit("error", String::new()); } } }
+        }
+        extern "C" fn closed(this: &Object, _: Sel, _: ObjcId) {
+            unsafe { if let Some(state) = state(this) { state.cancel(); } }
+        }
+        extern "C" fn popup(this: &Object, _: Sel, _: ObjcId, _: ObjcId, _: ObjcId, _: ObjcId) -> ObjcId {
+            unsafe { if let Some(state) = state(this) { state.blocked(); } }
+            nil
+        }
+        let mut declaration = ClassDecl::new("MakepadAuthBrowserDelegate", class!(NSObject)).unwrap();
+        declaration.add_ivar::<*mut c_void>("auth_state");
+        unsafe {
+            declaration.add_method(sel!(webView:decidePolicyForNavigationAction:decisionHandler:), decide as extern "C" fn(&Object, Sel, ObjcId, ObjcId, ObjcId));
+            declaration.add_method(sel!(webView:decidePolicyForNavigationResponse:decisionHandler:), response as extern "C" fn(&Object, Sel, ObjcId, ObjcId, ObjcId));
+            declaration.add_method(sel!(webView:didStartProvisionalNavigation:), started as extern "C" fn(&Object, Sel, ObjcId, ObjcId));
+            declaration.add_method(sel!(webView:didFinishNavigation:), finished as extern "C" fn(&Object, Sel, ObjcId, ObjcId));
+            declaration.add_method(sel!(webView:didFailNavigation:withError:), failed as extern "C" fn(&Object, Sel, ObjcId, ObjcId, ObjcId));
+            declaration.add_method(sel!(webView:didFailProvisionalNavigation:withError:), failed as extern "C" fn(&Object, Sel, ObjcId, ObjcId, ObjcId));
+            declaration.add_method(sel!(webViewWebContentProcessDidTerminate:), terminated as extern "C" fn(&Object, Sel, ObjcId));
+            declaration.add_method(sel!(webViewDidClose:), closed as extern "C" fn(&Object, Sel, ObjcId));
+            declaration.add_method(sel!(webView:createWebViewWithConfiguration:forNavigationAction:windowFeatures:), popup as extern "C" fn(&Object, Sel, ObjcId, ObjcId, ObjcId, ObjcId) -> ObjcId);
+            if let Some(protocol) = Protocol::get("WKNavigationDelegate") { declaration.add_protocol(protocol); }
+            if let Some(protocol) = Protocol::get("WKUIDelegate") { declaration.add_protocol(protocol); }
+        }
+        declaration.register() as *const Class as usize
+    }) as *const Class
+}
