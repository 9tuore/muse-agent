new file mode 100644
index 0000000..bf1ca2e
--- /dev/null
+++ b/platform/src/os/windows/windows_webview.rs
@@ -0,0 +1,1091 @@
+//! WebView2 lives inside a clipping child HWND of the Makepad window. COM
+//! completions run on the existing STA message loop; no nested pump or worker
+//! waits. A weak state reference prevents late creation callbacks resurrecting
+//! closed views. Pages never receive host objects or an IPC bridge.
+use crate::{
+    cx::Cx,
+    event::{NativeAuthBrowserEvent, NativeSystemBrowserNavigation, NativeSystemBrowserPageError, NativeSystemBrowserPolicyBlocked},
+    makepad_live_id::LiveId,
+    makepad_math::Rect,
+    system_browser::{BrowserPolicy, NavigationDecision},
+    window::WindowId,
+};
+use std::{
+    cell::RefCell,
+    rc::Rc,
+    sync::atomic::{AtomicU64, Ordering},
+};
+use webview2_com::{Microsoft::Web::WebView2::Win32::*, *};
+use webview2_windows::{
+    core::{w, Interface, Result, BOOL, PCWSTR, PWSTR},
+    Win32::{
+        Foundation::{E_FAIL, HWND, RECT},
+        System::{
+            Com::{
+                CoTaskMemFree, IStream, StructuredStorage::CreateStreamOnHGlobal, STATFLAG_NONAME,
+                STATSTG, STREAM_SEEK_SET,
+            },
+            LibraryLoader::GetModuleHandleW,
+        },
+        UI::WindowsAndMessaging::*,
+    },
+};
+
+static NEXT_PROFILE: AtomicU64 = AtomicU64::new(1);
+
+type Shared = Rc<RefCell<State>>;
+
+struct State {
+    id: LiveId,
+    policy: Option<BrowserPolicy>,
+    navigable: bool,
+    auth: bool,
+    auth_finished: bool,
+    closed: bool,
+    creating: bool,
+    observed_web_messages: u64,
+    web_message_observer_active: bool,
+    attached_window: Option<WindowId>,
+    child: HWND,
+    bounds: RECT,
+    visible: bool,
+    controller: Option<ICoreWebView2Controller>,
+    webview: Option<ICoreWebView2>,
+    pending: Document,
+    inline: bool,
+}
+
+#[derive(Clone)]
+enum Document {
+    Url(String, bool),
+    Html(String),
+}
+
+pub(crate) struct WindowsSystemBrowser {
+    state: Shared,
+}
+
+impl WindowsSystemBrowser {
+    pub(crate) fn new(id: LiveId, url: &str, navigable: bool) -> Self {
+        Self::create(id, url, navigable, None)
+    }
+
+    pub(crate) fn new_auth(id: LiveId, url: &str, callback: &str) -> Self {
+        Self::create(id, url, false, Some(callback))
+    }
+
+    fn create(id: LiveId, url: &str, navigable: bool, callback: Option<&str>) -> Self {
+        let policy = if let Some(callback) = callback {
+            BrowserPolicy::auth(url, callback)
+        } else {
+            BrowserPolicy::reader(url, navigable)
+        };
+        let state = Rc::new(RefCell::new(State {
+            id,
+            policy: policy.ok(),
+            navigable,
+            auth: callback.is_some(),
+            auth_finished: false,
+            closed: false,
+            creating: false,
+            observed_web_messages: 0,
+            web_message_observer_active: false,
+            attached_window: None,
+            child: HWND::default(),
+            bounds: RECT::default(),
+            visible: false,
+            controller: None,
+            webview: None,
+            pending: Document::Url(url.into(), false),
+            inline: false,
+        }));
+        if state.borrow().policy.is_none() {
+            report_error(&state, "The browser URL is not permitted", -1);
+        }
+        Self { state }
+    }
+
+    pub(crate) fn attached_window(&self) -> Option<WindowId> {
+        self.state.borrow().attached_window
+    }
+
+    pub(crate) fn update(
+        &mut self,
+        window: WindowId,
+        parent: windows::Win32::Foundation::HWND,
+        rect: Rect,
+        clip: Rect,
+        dpi: f64,
+        visible: bool,
+    ) {
+        let parent = HWND(parent.0);
+        // Keep the WebView's full document size while the outer HWND clips it
+        // to the widget's visible area (scrolling, portals and covered edges).
+        let pixel = |v: f64| (v * dpi).round().clamp(i32::MIN as f64, i32::MAX as f64) as i32;
+        let visible = visible && clip.size.x > 0.0 && clip.size.y > 0.0;
+        let bounds = RECT {
+            left: pixel(rect.pos.x - clip.pos.x),
+            top: pixel(rect.pos.y - clip.pos.y),
+            right: pixel(rect.pos.x - clip.pos.x + rect.size.x),
+            bottom: pixel(rect.pos.y - clip.pos.y + rect.size.y),
+        };
+        let (mut child, old_window, controller, creating, closed) = {
+            let mut state = self.state.borrow_mut();
+            let old = state.attached_window;
+            state.attached_window = Some(window);
+            state.bounds = bounds;
+            state.visible = visible;
+            (
+                state.child,
+                old,
+                state.controller.clone(),
+                state.creating,
+                state.closed,
+            )
+        };
+        if closed {
+            return;
+        }
+        unsafe {
+            if child.is_invalid() {
+                let result = CreateWindowExW(
+                    WINDOW_EX_STYLE::default(),
+                    w!("STATIC"),
+                    w!(""),
+                    WS_CHILD | WS_CLIPCHILDREN | WS_CLIPSIBLINGS,
+                    0,
+                    0,
+                    0,
+                    0,
+                    Some(parent),
+                    None,
+                    GetModuleHandleW(None).ok().map(Into::into),
+                    None,
+                );
+                match result {
+                    Ok(hwnd) => {
+                        child = hwnd;
+                        self.state.borrow_mut().child = hwnd;
+                    }
+                    Err(error) => {
+                        report_error(
+                            &self.state,
+                            "Cannot attach the embedded browser",
+                            error.code().0,
+                        );
+                        return;
+                    }
+                }
+            } else if old_window != Some(window) {
+                if let Err(error) = SetParent(child, Some(parent)) {
+                    report_error(
+                        &self.state,
+                        "Cannot reattach the embedded browser",
+                        error.code().0,
+                    );
+                    return;
+                }
+            }
+            if let Err(error) = SetWindowPos(
+                child,
+                None,
+                pixel(clip.pos.x),
+                pixel(clip.pos.y),
+                pixel(clip.size.x).max(0),
+                pixel(clip.size.y).max(0),
+                SWP_NOACTIVATE | SWP_NOZORDER,
+            ) {
+                report_error(
+                    &self.state,
+                    "Cannot resize the embedded browser",
+                    error.code().0,
+                );
+            }
+            let _ = ShowWindow(child, if visible { SW_SHOWNA } else { SW_HIDE });
+            if let Some(controller) = controller {
+                if let Err(error) = controller
+                    .SetBounds(bounds)
+                    .and_then(|_| controller.SetIsVisible(visible))
+                    .and_then(|_| controller.NotifyParentWindowPositionChanged())
+                {
+                    report_error(
+                        &self.state,
+                        "Cannot update the embedded browser",
+                        error.code().0,
+                    );
+                }
+            } else if !creating {
+                self.state.borrow_mut().creating = true;
+                if let Err(error) = start_environment(&self.state, child) {
+                    report_error(
+                        &self.state,
+                        "WebView2 could not start; install the Microsoft Edge WebView2 Runtime",
+                        error.code().0,
+                    );
+                }
+            }
+        }
+    }
+
+    pub(crate) fn detach(&mut self) {
+        let (child, controller) = {
+            let mut state = self.state.borrow_mut();
+            state.visible = false;
+            // Keep ownership tied to the window so its destruction also closes
+            // detached views. The next update may reparent the hidden child.
+            (state.child, state.controller.clone())
+        };
+        unsafe {
+            if let Some(controller) = controller {
+                let _ = controller.SetIsVisible(false);
+            }
+            if !child.is_invalid() {
+                let _ = ShowWindow(child, SW_HIDE);
+            }
+        }
+    }
+
+    pub(crate) fn set_url(&mut self, url: &str, replace: bool) {
+        let accepted = {
+            let mut state = self.state.borrow_mut();
+            if state.auth {
+                !state.auth_finished
+                    && state
+                        .policy
+                        .as_ref()
+                        .is_some_and(|p| matches!(p.decide(url, true), NavigationDecision::Allow))
+            } else if let Ok(policy) = BrowserPolicy::reader(url, state.navigable) {
+                state.policy = Some(policy);
+                true
+            } else {
+                false
+            }
+        };
+        if !accepted {
+            report_blocked(&self.state);
+            return;
+        }
+        {
+            let mut state = self.state.borrow_mut();
+            state.inline = false;
+            state.pending = Document::Url(url.into(), replace);
+        }
+        load_pending(&self.state);
+    }
+
+    pub(crate) fn set_html(&mut self, html: &str, base_url: &str) {
+        if self.state.borrow().auth {
+            report_blocked(&self.state);
+            return;
+        }
+        // NavigateToString keeps an opaque about:blank origin. A base element
+        // resolves relative resources but never grants a host origin or IPC.
+        if html.len() > 2 * 1024 * 1024 {
+            report_error(&self.state, "Embedded HTML exceeds the 2 MiB limit", -1);
+            return;
+        }
+        let html = if base_url.is_empty() || base_url == "about:blank" {
+            html.to_owned()
+        } else if public_resource(base_url) {
+            format!("<base href=\"{}\">{}", html_attribute(base_url), html)
+        } else {
+            report_blocked(&self.state);
+            return;
+        };
+        {
+            let mut state = self.state.borrow_mut();
+            state.inline = true;
+            state.pending = Document::Html(html);
+        }
+        load_pending(&self.state);
+    }
+
+    pub(crate) fn eval_js(&self, js: &str) {
+        let state = self.state.borrow();
+        if state.auth || state.closed || js.len() > 1024 * 1024 {
+            return;
+        }
+        let webview = state.webview.clone();
+        drop(state);
+        if let Some(webview) = webview {
+            if let Err(error) = unsafe { execute(&webview, js) } {
+                report_error(
+                    &self.state,
+                    "The embedded browser script failed",
+                    error.code().0,
+                );
+            }
+        }
+    }
+
+    pub(crate) fn history_go(&self, delta: i32) {
+        // The host's Back/Forward control is allowed in auth, but arbitrary
+        // script evaluation remains forbidden. Every traversal is rechecked.
+        let (auth, finished, webview) = {
+            let s = self.state.borrow();
+            (s.auth, s.closed || s.auth_finished, s.webview.clone())
+        };
+        if finished {
+            return;
+        }
+        if auth {
+            if let Some(webview) = webview {
+                let result = unsafe {
+                    match delta {
+                        -1 => webview.GoBack(),
+                        1 => webview.GoForward(),
+                        _ => return,
+                    }
+                };
+                if let Err(error) = result {
+                    report_error(
+                        &self.state,
+                        "Browser history is unavailable",
+                        error.code().0,
+                    );
+                }
+            }
+        } else {
+            self.eval_js(&format!("history.go({delta})"));
+        }
+    }
+
+    /// Host-owned native acceptance instrumentation. It is unavailable on
+    /// authentication views and writes only to the native caller's paths.
+    pub(crate) fn inspect(
+        &self,
+        result_path: String,
+        snapshot_path: Option<String>,
+        scroll_y: Option<f64>,
+    ) {
+        let (webview, allowed) = {
+            let s = self.state.borrow();
+            let width = s.bounds.right.saturating_sub(s.bounds.left);
+            let height = s.bounds.bottom.saturating_sub(s.bounds.top);
+            (
+                s.webview.clone(),
+                !s.auth && !s.closed && width > 0 && height > 0 && width <= 2048 && height <= 2048,
+            )
+        };
+        if !allowed {
+            let _ = std::fs::write(
+                result_path,
+                r#"{"error":"Browser inspection is unavailable or exceeds 2048px"}"#,
+            );
+            return;
+        }
+        let Some(webview) = webview else {
+            let _ = std::fs::write(result_path, r#"{"error":"Browser is not ready"}"#);
+            return;
+        };
+        // Read the actual native policy. The chrome.webview namespace remains
+        // present when messaging is disabled; namespace presence is not a grant.
+        let settings = unsafe {
+            (|| -> Result<(bool, bool)> {
+                let settings = webview.Settings()?;
+                let mut messages = BOOL::default();
+                let mut objects = BOOL::default();
+                settings.IsWebMessageEnabled(&mut messages)?;
+                settings.AreHostObjectsAllowed(&mut objects)?;
+                Ok((messages.as_bool(), objects.as_bool()))
+            })()
+        };
+        let Ok((web_message_enabled, host_objects_allowed)) = settings else {
+            let _ = std::fs::write(result_path, r#"{"error":"Browser policy inspection failed"}"#);
+            return;
+        };
+        let (web_message_observer_active, observed_web_messages) = {
+            let s = self.state.borrow();
+            (s.web_message_observer_active, s.observed_web_messages)
+        };
+        let scroll = scroll_y
+            .filter(|v| v.is_finite())
+            .map(|v| format!("window.scrollTo(0,{v});"))
+            .unwrap_or_default();
+        let script = wide(&format!(
+            r#"{scroll}({{
+            readyState:document.readyState,title:document.title.slice(0,512),
+            scrollY:window.scrollY,scrollHeight:document.documentElement.scrollHeight,
+            viewportHeight:window.innerHeight,viewportWidth:window.innerWidth,
+            hostBridgePresent:typeof window.octos!=='undefined'||typeof window.octos_native!=='undefined',
+            webMessageEnabled:{web_message_enabled},hostObjectsAllowed:{host_objects_allowed},
+            webMessageObserverActive:{web_message_observer_active},observedWebMessages:{observed_web_messages}
+        }})"#
+        ));
+        let weak = Rc::downgrade(&self.state);
+        let capture_view = webview.clone();
+        let error_path = result_path.clone();
+        let result = unsafe {
+            webview.ExecuteScript(
+                PCWSTR(script.as_ptr()),
+                &ExecuteScriptCompletedHandler::create(Box::new(move |result, metadata| {
+                    let Some(state) = weak.upgrade() else {
+                        return Ok(());
+                    };
+                    if state.borrow().closed {
+                        return Ok(());
+                    }
+                    if result.is_err() || metadata.len() > 16 * 1024 {
+                        let _ = std::fs::write(
+                            &result_path,
+                            r#"{"error":"Browser inspection failed"}"#,
+                        );
+                        return Ok(());
+                    }
+                    if let Some(path) = snapshot_path {
+                        if let Err(error) =
+                            capture(&capture_view, path, result_path.clone(), metadata)
+                        {
+                            let _ = std::fs::write(
+                                result_path,
+                                format!(
+                                    "{{\"error\":\"Browser capture failed ({})\"}}",
+                                    error.code().0
+                                ),
+                            );
+                        }
+                    } else {
+                        let _ = std::fs::write(result_path, metadata);
+                    }
+                    Ok(())
+                })),
+            )
+        };
+        if result.is_err() {
+            let _ = std::fs::write(error_path, r#"{"error":"Browser inspection failed"}"#);
+        }
+    }
+
+    pub(crate) fn cleanup(&mut self) {
+        let (controller, child, cancel) = {
+            let mut state = self.state.borrow_mut();
+            if state.closed {
+                return;
+            }
+            state.closed = true;
+            state.webview.take();
+            let cancel = state.auth && !state.auth_finished;
+            state.auth_finished = true;
+            let child = std::mem::take(&mut state.child);
+            (state.controller.take(), child, cancel)
+        };
+        if cancel {
+            auth_event(&self.state, "cancelled", String::new());
+        }
+        unsafe {
+            if let Some(controller) = controller {
+                close_controller(&controller);
+            }
+            if !child.is_invalid() {
+                let _ = DestroyWindow(child);
+            }
+        }
+    }
+}
+
+impl Drop for WindowsSystemBrowser {
+    fn drop(&mut self) {
+        self.cleanup();
+    }
+}
+
+unsafe fn close_controller(controller: &ICoreWebView2Controller) {
+    // InPrivate never persists cookies/storage. Delete the fresh profile as
+    // well, so its on-disk bookkeeping does not accumulate across app cards.
+    if let Ok(profile) = controller
+        .CoreWebView2()
+        .and_then(|view| view.cast::<ICoreWebView2_13>())
+        .and_then(|view| view.Profile())
+        .and_then(|profile| profile.cast::<ICoreWebView2Profile8>())
+    {
+        let _ = profile.Delete();
+    }
+    let _ = controller.Close();
+}
+
+unsafe fn start_environment(state: &Shared, child: HWND) -> Result<()> {
+    let weak = Rc::downgrade(state);
+    let options: ICoreWebView2EnvironmentOptions = CoreWebView2EnvironmentOptions::default().into();
+    // Never attach an OS account or share a browser profile with another app
+    // card. Controllers use a fresh InPrivate profile below, including auth.
+    options.SetAllowSingleSignOnUsingOSPrimaryAccount(false)?;
+    let folder = std::env::var_os("LOCALAPPDATA")
+        .ok_or_else(|| webview2_windows::core::Error::from(E_FAIL))?;
+    let folder = std::path::PathBuf::from(folder)
+        .join("Makepad")
+        .join("WebView2");
+    let folder = wide(&folder.to_string_lossy());
+    CreateCoreWebView2EnvironmentWithOptions(
+        PCWSTR::null(),
+        PCWSTR(folder.as_ptr()),
+        &options,
+        &CreateCoreWebView2EnvironmentCompletedHandler::create(Box::new(
+            move |result, environment| {
+                let Some(state) = weak.upgrade() else {
+                    return Ok(());
+                };
+                if state.borrow().closed {
+                    return Ok(());
+                }
+                let result = result
+                    .and_then(|_| {
+                        environment.ok_or_else(|| webview2_windows::core::Error::from(E_FAIL))
+                    })
+                    .and_then(|environment| create_controller(&state, &environment, child));
+                if let Err(error) = result {
+                    report_error(
+                        &state,
+                        "WebView2 is unavailable or does not support isolated browser profiles",
+                        error.code().0,
+                    );
+                }
+                Ok(())
+            },
+        )),
+    )
+}
+
+unsafe fn create_controller(
+    state: &Shared,
+    environment: &ICoreWebView2Environment,
+    child: HWND,
+) -> Result<()> {
+    let version: ICoreWebView2Environment10 = environment.cast()?;
+    let options = version.CreateCoreWebView2ControllerOptions()?;
+    options.SetIsInPrivateModeEnabled(true)?;
+    let profile = wide(&format!(
+        "makepad-{}-{}",
+        std::process::id(),
+        NEXT_PROFILE.fetch_add(1, Ordering::Relaxed)
+    ));
+    options.SetProfileName(PCWSTR(profile.as_ptr()))?;
+    let weak = Rc::downgrade(state);
+    let environment = environment.clone();
+    version.CreateCoreWebView2ControllerWithOptions(
+        child,
+        &options,
+        &CreateCoreWebView2ControllerCompletedHandler::create(Box::new(
+            move |result, controller| {
+                let Some(state) = weak.upgrade() else {
+                    if let Some(controller) = controller {
+                        close_controller(&controller);
+                    }
+                    return Ok(());
+                };
+                if state.borrow().closed {
+                    if let Some(controller) = controller {
+                        close_controller(&controller);
+                    }
+                    return Ok(());
+                }
+                let result = result
+                    .and_then(|_| {
+                        controller.ok_or_else(|| webview2_windows::core::Error::from(E_FAIL))
+                    })
+                    .and_then(|controller| {
+                        let webview = controller.CoreWebView2()?;
+                        if let Err(error) = configure(&state, &environment, &webview) {
+                            close_controller(&controller);
+                            return Err(error);
+                        }
+                        let (bounds, visible) = {
+                            let s = state.borrow();
+                            (s.bounds, s.visible)
+                        };
+                        if let Err(error) = controller
+                            .SetBounds(bounds)
+                            .and_then(|_| controller.SetIsVisible(visible))
+                        {
+                            close_controller(&controller);
+                            return Err(error);
+                        }
+                        {
+                            let mut s = state.borrow_mut();
+                            s.controller = Some(controller);
+                            s.webview = Some(webview);
+                        }
+                        load_pending(&state);
+                        Ok(())
+                    });
+                if let Err(error) = result {
+                    report_error(
+                        &state,
+                        "Cannot initialize the embedded browser safely",
+                        error.code().0,
+                    );
+                }
+                Ok(())
+            },
+        )),
+    )
+}
+
+unsafe fn configure(
+    state: &Shared,
+    environment: &ICoreWebView2Environment,
+    webview: &ICoreWebView2,
+) -> Result<()> {
+    let settings = webview.Settings()?;
+    settings.SetAreHostObjectsAllowed(false)?;
+    settings.SetIsWebMessageEnabled(false)?;
+    // Count delivery only for native acceptance diagnostics. Never read the
+    // payload, dispatch it to an app, or grant access to any host operation.
+    // Register before navigation so an initial document cannot evade observation.
+    let weak = Rc::downgrade(state);
+    let mut observer_token = 0;
+    webview.add_WebMessageReceived(
+        &WebMessageReceivedEventHandler::create(Box::new(move |_, _| {
+            if let Some(state) = weak.upgrade() {
+                let mut s = state.borrow_mut();
+                if !s.closed {
+                    s.observed_web_messages = s.observed_web_messages.saturating_add(1);
+                }
+            }
+            Ok(())
+        })),
+        &mut observer_token,
+    )?;
+    state.borrow_mut().web_message_observer_active = true;
+    settings.SetAreDefaultContextMenusEnabled(false)?;
+    settings.SetAreDevToolsEnabled(false)?;
+    settings.SetAreDefaultScriptDialogsEnabled(false)?;
+    settings.SetIsStatusBarEnabled(false)?;
+    settings
+        .cast::<ICoreWebView2Settings3>()?
+        .SetAreBrowserAcceleratorKeysEnabled(false)?;
+    let autofill: ICoreWebView2Settings4 = settings.cast()?;
+    autofill.SetIsPasswordAutosaveEnabled(false)?;
+    autofill.SetIsGeneralAutofillEnabled(false)?;
+    let mut token = 0;
+    for main_frame in [true, false] {
+        let weak = Rc::downgrade(state);
+        let handler = NavigationStartingEventHandler::create(Box::new(move |_, args| {
+            let Some(args) = args else {
+                return Ok(());
+            };
+            let Some(state) = weak.upgrade() else {
+                return args.SetCancel(true);
+            };
+            let url = read_string(|p| args.Uri(p))?;
+            let decision = {
+                let s = state.borrow();
+                if s.closed || s.auth_finished {
+                    NavigationDecision::Block
+                } else if s.inline && url == "about:blank" && main_frame {
+                    NavigationDecision::Allow
+                } else {
+                    s.policy
+                        .as_ref()
+                        .map(|p| p.decide(&url, main_frame))
+                        .unwrap_or(NavigationDecision::Block)
+                }
+            };
+            match decision {
+                NavigationDecision::Allow => {
+                    if main_frame {
+                        navigation(&state, &url, true, None);
+                    }
+                }
+                NavigationDecision::Block => {
+                    args.SetCancel(true)?;
+                    report_blocked(&state);
+                }
+                NavigationDecision::Callback => {
+                    args.SetCancel(true)?;
+                    let emit = {
+                        let mut s = state.borrow_mut();
+                        let emit = !s.auth_finished;
+                        s.auth_finished = true;
+                        emit
+                    };
+                    if emit {
+                        auth_event(&state, "callback", url);
+                    }
+                }
+            }
+            Ok(())
+        }));
+        if main_frame {
+            webview.add_NavigationStarting(&handler, &mut token)?;
+        } else {
+            webview.add_FrameNavigationStarting(&handler, &mut token)?;
+        }
+    }
+    let weak = Rc::downgrade(state);
+    webview.add_NavigationCompleted(
+        &NavigationCompletedEventHandler::create(Box::new(move |sender, args| {
+            let (Some(state), Some(sender), Some(args)) = (weak.upgrade(), sender, args) else {
+                return Ok(());
+            };
+            if state.borrow().closed || state.borrow().auth_finished {
+                return Ok(());
+            }
+            let mut success = BOOL::default();
+            args.IsSuccess(&mut success)?;
+            if success.as_bool() {
+                let url = read_string(|p| sender.Source(p))?;
+                let title = read_string(|p| sender.DocumentTitle(p))?;
+                navigation(&state, &url, false, Some(title));
+            } else {
+                let mut status = COREWEBVIEW2_WEB_ERROR_STATUS::default();
+                args.WebErrorStatus(&mut status)?;
+                // Cancelled policy navigations are reported by NavigationStarting.
+                if status != COREWEBVIEW2_WEB_ERROR_STATUS_OPERATION_CANCELED {
+                    report_error(&state, "The embedded page failed to load", status.0);
+                }
+            }
+            Ok(())
+        })),
+        &mut token,
+    )?;
+    let weak = Rc::downgrade(state);
+    webview.add_DocumentTitleChanged(
+        &DocumentTitleChangedEventHandler::create(Box::new(move |sender, _| {
+            let (Some(state), Some(sender)) = (weak.upgrade(), sender) else {
+                return Ok(());
+            };
+            let url = read_string(|p| sender.Source(p))?;
+            let title = read_string(|p| sender.DocumentTitle(p))?;
+            navigation(&state, &url, false, Some(title));
+            Ok(())
+        })),
+        &mut token,
+    )?;
+    webview.add_NewWindowRequested(
+        &NewWindowRequestedEventHandler::create(Box::new(|_, args| {
+            if let Some(args) = args {
+                args.SetHandled(true)?;
+            }
+            Ok(())
+        })),
+        &mut token,
+    )?;
+    webview.add_PermissionRequested(
+        &PermissionRequestedEventHandler::create(Box::new(|_, args| {
+            if let Some(args) = args {
+                args.SetState(COREWEBVIEW2_PERMISSION_STATE_DENY)?;
+                if let Ok(args) = args.cast::<ICoreWebView2PermissionRequestedEventArgs3>() {
+                    args.SetSavesInProfile(false)?;
+                }
+            }
+            Ok(())
+        })),
+        &mut token,
+    )?;
+    // Require APIs that can block native downloads and client-certificate UI;
+    // an old runtime fails closed instead of silently weakening the boundary.
+    webview.cast::<ICoreWebView2_4>()?.add_DownloadStarting(
+        &DownloadStartingEventHandler::create(Box::new(|_, args| {
+            if let Some(args) = args {
+                args.SetCancel(true)?;
+                args.SetHandled(true)?;
+            }
+            Ok(())
+        })),
+        &mut token,
+    )?;
+    webview
+        .cast::<ICoreWebView2_5>()?
+        .add_ClientCertificateRequested(
+            &ClientCertificateRequestedEventHandler::create(Box::new(|_, args| {
+                if let Some(args) = args {
+                    args.SetCancel(true)?;
+                    args.SetHandled(true)?;
+                }
+                Ok(())
+            })),
+            &mut token,
+        )?;
+    webview
+        .cast::<ICoreWebView2_10>()?
+        .add_BasicAuthenticationRequested(
+            &BasicAuthenticationRequestedEventHandler::create(Box::new(|_, args| {
+                if let Some(args) = args {
+                    args.SetCancel(true)?;
+                }
+                Ok(())
+            })),
+            &mut token,
+        )?;
+    webview
+        .cast::<ICoreWebView2_18>()?
+        .add_LaunchingExternalUriScheme(
+            &LaunchingExternalUriSchemeEventHandler::create(Box::new(|_, args| {
+                if let Some(args) = args {
+                    args.SetCancel(true)?;
+                }
+                Ok(())
+            })),
+            &mut token,
+        )?;
+    webview
+        .cast::<ICoreWebView2_14>()?
+        .add_ServerCertificateErrorDetected(
+            &ServerCertificateErrorDetectedEventHandler::create(Box::new(|_, args| {
+                if let Some(args) = args {
+                    args.SetAction(COREWEBVIEW2_SERVER_CERTIFICATE_ERROR_ACTION_CANCEL)?;
+                }
+                Ok(())
+            })),
+            &mut token,
+        )?;
+    webview.cast::<ICoreWebView2_25>()?.add_SaveAsUIShowing(
+        &SaveAsUIShowingEventHandler::create(Box::new(|_, args| {
+            if let Some(args) = args {
+                args.SetCancel(true)?;
+                args.SetSuppressDefaultDialog(true)?;
+            }
+            Ok(())
+        })),
+        &mut token,
+    )?;
+    // Screen sharing is a separate WebView2 event, not PermissionRequested.
+    // It bubbles from subframes as well; never show the native screen picker.
+    webview
+        .cast::<ICoreWebView2_27>()?
+        .add_ScreenCaptureStarting(
+            &ScreenCaptureStartingEventHandler::create(Box::new(|_, args| {
+                if let Some(args) = args {
+                    args.SetCancel(true)?;
+                    args.SetHandled(true)?;
+                }
+                Ok(())
+            })),
+            &mut token,
+        )?;
+    let weak = Rc::downgrade(state);
+    webview.add_ProcessFailed(
+        &ProcessFailedEventHandler::create(Box::new(move |_, _| {
+            if let Some(state) = weak.upgrade() {
+                report_error(&state, "The embedded browser process stopped", -1);
+            }
+            Ok(())
+        })),
+        &mut token,
+    )?;
+    // Filter fetches as well as top-level navigation. Auth is confined to its
+    // declared origin; readers may fetch public HTTPS resources, never local
+    // files or literal private-network endpoints. DNS rebinding is not solved
+    // by URL policy alone and is not advertised as an OS network sandbox.
+    webview.AddWebResourceRequestedFilter(w!("*"), COREWEBVIEW2_WEB_RESOURCE_CONTEXT_ALL)?;
+    let weak = Rc::downgrade(state);
+    let environment = environment.clone();
+    webview.add_WebResourceRequested(
+        &WebResourceRequestedEventHandler::create(Box::new(move |_, args| {
+            let Some(args) = args else {
+                return Ok(());
+            };
+            let url = read_string(|p| args.Request()?.Uri(p))?;
+            let allowed = weak.upgrade().is_some_and(|state| {
+                let s = state.borrow();
+                !s.closed
+                    && !s.auth_finished
+                    && if s.auth {
+                        s.policy.as_ref().is_some_and(|p| {
+                            matches!(p.decide(&url, false), NavigationDecision::Allow)
+                        })
+                    } else {
+                        public_resource(&url)
+                            || s.policy.as_ref().is_some_and(|p| {
+                                matches!(p.decide(&url, false), NavigationDecision::Allow)
+                            })
+                            || url == "about:blank"
+                            || url.starts_with("data:")
+                            || url.starts_with("blob:")
+                    }
+            });
+            if !allowed {
+                let response = environment.CreateWebResourceResponse(
+                    None::<&IStream>,
+                    403,
+                    w!("Blocked"),
+                    w!("Content-Type: text/plain\r\n"),
+                )?;
+                args.SetResponse(&response)?;
+            }
+            Ok(())
+        })),
+        &mut token,
+    )?;
+    Ok(())
+}
+
+fn load_pending(state: &Shared) {
+    let (webview, document, allowed) = {
+        let s = state.borrow();
+        (
+            s.webview.clone(),
+            s.pending.clone(),
+            !s.closed && !s.auth_finished && (s.policy.is_some() || s.inline),
+        )
+    };
+    if !allowed {
+        return;
+    }
+    let Some(webview) = webview else {
+        return;
+    };
+    let result = unsafe {
+        match document {
+            Document::Url(url, true) => {
+                execute(&webview, &format!("location.replace({})", js_string(&url)))
+            }
+            Document::Url(url, false) => {
+                let url = wide(&url);
+                webview.Navigate(PCWSTR(url.as_ptr()))
+            }
+            Document::Html(html) => {
+                let html = wide(&html);
+                webview.NavigateToString(PCWSTR(html.as_ptr()))
+            }
+        }
+    };
+    if let Err(error) = result {
+        report_error(state, "Cannot load the embedded page", error.code().0);
+    }
+}
+
+unsafe fn capture(
+    webview: &ICoreWebView2,
+    path: String,
+    result_path: String,
+    metadata: String,
+) -> Result<()> {
+    let stream = CreateStreamOnHGlobal(Default::default(), true)?;
+    let output = stream.clone();
+    webview.CapturePreview(
+        COREWEBVIEW2_CAPTURE_PREVIEW_IMAGE_FORMAT_PNG,
+        &stream,
+        &CapturePreviewCompletedHandler::create(Box::new(move |result| {
+            let result = result.and_then(|_| {
+                let mut stat = STATSTG::default();
+                output.Stat(&mut stat, STATFLAG_NONAME)?;
+                if stat.cbSize == 0 || stat.cbSize > 32 * 1024 * 1024 {
+                    return Err(webview2_windows::core::Error::from(E_FAIL));
+                }
+                output.Seek(0, STREAM_SEEK_SET, None)?;
+                let mut bytes = vec![0u8; stat.cbSize as usize];
+                let mut read = 0;
+                output
+                    .Read(
+                        bytes.as_mut_ptr().cast(),
+                        bytes.len() as u32,
+                        Some(&mut read),
+                    )
+                    .ok()?;
+                if read as usize != bytes.len() {
+                    return Err(webview2_windows::core::Error::from(E_FAIL));
+                }
+                std::fs::write(path, bytes)
+                    .map_err(|_| webview2_windows::core::Error::from(E_FAIL))?;
+                Ok(())
+            });
+            // The metadata file is the completion marker: the PNG is fully
+            // written first, so acceptance never races a partial snapshot.
+            let text = if result.is_ok() {
+                metadata
+            } else {
+                r#"{"error":"Browser capture failed"}"#.into()
+            };
+            let _ = std::fs::write(result_path, text);
+            Ok(())
+        })),
+    )
+}
+
+unsafe fn execute(webview: &ICoreWebView2, js: &str) -> Result<()> {
+    let js = wide(js);
+    webview.ExecuteScript(
+        PCWSTR(js.as_ptr()),
+        &ExecuteScriptCompletedHandler::create(Box::new(|result, _| result)),
+    )
+}
+
+unsafe fn read_string(read: impl FnOnce(*mut PWSTR) -> Result<()>) -> Result<String> {
+    let mut raw = PWSTR::null();
+    let result = read(&mut raw);
+    let value = if result.is_ok() {
+        raw.to_string().unwrap_or_default()
+    } else {
+        String::new()
+    };
+    CoTaskMemFree(Some(raw.0.cast()));
+    result.map(|_| value)
+}
+
+fn public_resource(url: &str) -> bool {
+    BrowserPolicy::reader("about:blank", true)
+        .is_ok_and(|p| matches!(p.decide(url, false), NavigationDecision::Allow))
+}
+
+fn wide(value: &str) -> Vec<u16> {
+    value.encode_utf16().chain(Some(0)).collect()
+}
+fn js_string(value: &str) -> String {
+    let mut result = String::from("\"");
+    for unit in value.encode_utf16() {
+        use std::fmt::Write;
+        let _ = write!(result, "\\u{unit:04x}");
+    }
+    result.push('"');
+    result
+}
+fn html_attribute(value: &str) -> String {
+    value
+        .replace('&', "&amp;")
+        .replace('"', "&quot;")
+        .replace('<', "&lt;")
+        .replace('>', "&gt;")
+}
+fn auth_event(state: &Shared, kind: &str, url: String) {
+    Cx::post_action(NativeAuthBrowserEvent {
+        browser_id: state.borrow().id.0,
+        kind: kind.into(),
+        url,
+    });
+}
+fn report_blocked(state: &Shared) {
+    let s = state.borrow();
+    if s.closed || s.auth_finished {
+        return;
+    }
+    if s.auth {
+        drop(s);
+        auth_event(state, "blocked", String::new());
+    } else {
+        Cx::post_action(NativeSystemBrowserPolicyBlocked {
+            browser_id: s.id.0,
+            description: "Navigation is not permitted in this embedded browser".into(),
+        });
+    }
+}
+fn report_error(state: &Shared, description: &str, code: i32) {
+    let s = state.borrow();
+    if s.closed || s.auth_finished {
+        return;
+    }
+    if s.auth {
+        drop(s);
+        auth_event(state, "error", String::new());
+    } else {
+        Cx::post_action(NativeSystemBrowserPageError {
+            browser_id: s.id.0,
+            code,
+            description: description.into(),
+            url: String::new(),
+        });
+    }
+}
+fn navigation(state: &Shared, url: &str, loading: bool, title: Option<String>) {
+    let s = state.borrow();
+    if s.auth || s.closed {
+        return;
+    }
+    Cx::post_action(NativeSystemBrowserNavigation {
+        browser_id: s.id.0,
+        url: url.chars().take(16384).collect(),
+        title: title.unwrap_or_default().chars().take(2048).collect(),
+        loading,
+        error: None,
+    });
+}
