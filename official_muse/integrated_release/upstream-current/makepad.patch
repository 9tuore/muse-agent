+use std::{
+    cell::{Cell, RefCell},
+    ffi::{c_char, c_int, c_long, c_uint, c_ulong, c_void, CStr, CString},
+    mem::ManuallyDrop,
+    ptr,
+    rc::Rc,
+};
+
+type Object = *mut c_void;
+type Callback = unsafe extern "C" fn();
+
+#[repr(C)]
+struct Allocation { x: c_int, y: c_int, width: c_int, height: c_int }
+
+macro_rules! api {
+    ($($name:ident: $ty:ty),* $(,)?) => {
+        struct Api {
+            // GTypes retain class/vtable addresses until process exit, even
+            // after the last view closes. Never dlclose their libraries.
+            _libraries: ManuallyDrop<Vec<ModuleLoader>>,
+            $($name: $ty,)*
+        }
+        impl Api {
+            fn load() -> Result<Rc<Self>, &'static str> {
+                let gtk = ModuleLoader::load("libgtk-3.so.0")
+                    .map_err(|_| "Install the system GTK3 and WebKitGTK 4.1 runtime to use embedded browsing")?;
+                let webkit = ModuleLoader::load("libwebkit2gtk-4.1.so.0")
+                    .or_else(|_| ModuleLoader::load("libwebkit2gtk-4.0.so.37"))
+                    .map_err(|_| "Install the system WebKitGTK 4.1 runtime to use embedded browsing")?;
+                let api = Self {
+                    $($name: webkit.get_symbol(stringify!($name))
+                        .or_else(|_| gtk.get_symbol(stringify!($name)))
+                        .map_err(|_| "The installed WebKitGTK/GTK3 runtime is missing a required browser API")?,)*
+                    _libraries: ManuallyDrop::new(vec![gtk, webkit]),
+                };
+                unsafe {
+                    // GTK must use the same protocol as our parent X11 window.
+                    // This does not change Makepad's backend or process env.
+                    (api.gdk_set_allowed_backends)(c"x11".as_ptr());
+                    if (api.gtk_init_check)(ptr::null_mut(), ptr::null_mut()) == 0 {
+                        return Err("GTK could not connect to the X11 display");
+                    }
+                }
+                Ok(Rc::new(api))
+            }
+        }
+    };
+}
