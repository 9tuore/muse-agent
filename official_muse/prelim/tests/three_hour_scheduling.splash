// Production scheduling/calendar functions; transport-only synthetic services.
// Full path requires the matching SDK fs.sha256. Pure mode remains a separate run.
let sh_full = true
let sh_checks = {}
let sh_calls = []
let sh_models = []
let sh_gets = []
let sh_lists = []
let sh_hold_get = false
let sh_hold_list = false
let sh_event = nil
let sh_events = []
let sh_truncated = false
let sh_list_ok = true
let sh_permission = true
let sh_writes = 0
let sh_forbidden = []
let sh_goal = ""
let sh_update_payload = nil
let sh_model_output = nil
let sh_block_update = false
let sh_approval_variant = "after-confirm"
let sh_approval_near_start = ""
fn three_hour_request(service,args,cb){
    sh_calls.push({service: service args: args})
    if service == "mail.accounts" { cb({is_ok: true data: [{id: "synthetic-account" address: "self@example.invalid"}]}) return }
    if service == "model.complete" { sh_models.push(cb) return }
    if service == "calendar.status" {
        cb({is_ok: true data: {permission: "full_access" calendars: [{id: "fixture-calendar" writable: sh_permission}]}}) return
    }
    if service == "calendar.list" {
        if sh_hold_list { sh_lists.push(cb) return }
        let events = []
        for event in sh_events {
            let a = calendar_iso_epoch(event.start) let b = calendar_iso_epoch(event.end)
            if a == nil || b == nil || (a < calendar_iso_epoch(args.end) && b > calendar_iso_epoch(args.start)) { events.push(event) }
        }
        cb({is_ok: sh_list_ok data: {events: events truncated: sh_truncated}}) return
    }
    if service == "calendar.get" {
        if sh_hold_get { sh_gets.push(cb) return }
        cb({is_ok: true data: {found: sh_event != nil event: sh_event}}) return
    }
    if service == "calendar.update" {
        if sh_block_update { cb({is_ok: false error: "Boundary probe intercepted mutation"}) return }
        sh_writes = sh_writes + 1
        sh_update_payload = args.to_json().parse_json()
        sh_event.start = args.changes.start sh_event.end = args.changes.end sh_event.version = "fixture-v2"
        cb({is_ok: true data: {event_id: sh_event.id version: sh_event.version}}) return
    }
    // The scenario starts with an existing synthetic event. No creation/deletion/send allowed.
    sh_forbidden.push(service)
    cb({is_ok: false error: "Synthetic scheduling forbids this service"})
}
fn sh_count(service){
    let n = 0 for call in sh_calls { if call.service == service { n = n + 1 } }
    return n
}
fn sh_progress(phase){ fs.write("progress.json",{phase: phase checks: sh_checks calls: sh_calls}.to_json()) }
fn sh_original(){
    return {id: "fixture-event" calendar_id: "fixture-calendar" version: "fixture-v1"
        title: "MUSE-R2-SCHEDULING" start: "2030-06-12T09:00:00+08:00" end: "2030-06-12T10:00:00+08:00"
        time_zone: "Asia/Shanghai" location: "合成地点" recurring: false all_day: false availability: 0
        attendees: ["synthetic@example.invalid"] notes: "保留的合成备注"}
}
fn sh_policy(){
    return {search_start: "2030-06-12T00:00:00+08:00" search_end: "2030-06-16T00:00:00+08:00"
        time_zone: "Asia/Shanghai" reason: "合成已确认软偏好，禁止时间以hard_windows表达"
        hard_windows: [{start: "2030-06-12T09:00:00+08:00" end: "2030-06-12T12:00:00+08:00"}]
        preferred_windows: [{start: "2030-06-12T09:00:00+08:00" end: "2030-06-12T10:00:00+08:00"}]}
}
fn sh_query_reset(){
    calendar_pending = false calendar_selected_goal = "fixture-slot-goal" calendar_operation = "create"
    calendar_selected_event = nil calendar_context_refs = [] calendar_candidate_revision = 1
    calendar_calendar_id = "fixture-calendar" calendar_preview = "" calendar_error = ""
    calendar_checked = "" calendar_conflicts = []
    ui.calendar_title.set_text("MUSE-R2-SCHEDULING") ui.calendar_start.set_text("2030-06-12T09:00:00+08:00")
    ui.calendar_end.set_text("2030-06-12T10:00:00+08:00") ui.calendar_timezone.set_text("Asia/Shanghai")
    ui.calendar_location.set_text("合成地点")
    calendar_links = [{goal_id: "fixture-slot-goal" message_id: "fixture-slot-mail" status: "candidate"
        event_id: "" candidate_revision: 1 candidate: calendar_draft_payload() schedule_policy: sh_policy()}]
    sh_calls = [] sh_events = [] sh_truncated = false sh_list_ok = true sh_hold_list = false sh_lists = "[]".parse_json()
    schedule_slots = [] schedule_slot_snapshot = ""
}
fn probe(){
    fixture_seed()
    let one = [{start: "2030-06-12T09:00:00+08:00" end: "2030-06-12T10:00:00+08:00"}]
    let answer = schedule_free_slots([],one,3600,"",0)
    sh_checks.one_slot_not_padded = answer.error == "" && answer.slots.len() == 1
    answer = schedule_free_slots([],one,3601,"",0)
    sh_checks.too_short_window_zero_slots = answer.error == "" && answer.slots.len() == 0
    answer = schedule_free_slots([],one,900,"",calendar_iso_epoch("2030-06-12T09:16:00+08:00"))
    sh_checks.past_removed_and_quarter_rounded = answer.slots.len() == 2 && answer.slots[0].start == "2030-06-12T01:30:00Z"
    let touching = [{id: "before" start: "2030-06-12T08:00:00+08:00" end: "2030-06-12T09:00:00+08:00" all_day: false availability: 0}
        {id: "after" start: "2030-06-12T10:00:00+08:00" end: "2030-06-12T11:00:00+08:00" all_day: false availability: 3}]
    answer = schedule_free_slots(touching,one,3600,"",0)
    sh_checks.adjacent_boundaries_do_not_overlap = answer.slots.len() == 1
    touching[1].start = "2030-06-12T09:59:00+08:00"
    answer = schedule_free_slots(touching,one,3600,"",0)
    sh_checks.unavailable_one_minute_overlap_blocks = answer.slots.len() == 0
    touching[1].availability = 1
    answer = schedule_free_slots(touching,one,3600,"",0)
    sh_checks.transparent_overlap_is_free = answer.slots.len() == 1
    touching[1].availability = 4
    answer = schedule_free_slots(touching,one,3600,"",0)
    sh_checks.out_of_range_busy_refuses = answer.error != "" && answer.slots.len() == 0
    touching[1].availability = 0 touching[1].all_day = nil
    answer = schedule_free_slots(touching,one,3600,"",0)
    sh_checks.missing_all_day_refuses = answer.error != "" && answer.slots.len() == 0
    touching[1].all_day = false touching[1].end = "2030-06-12T09:00:00+08:00"
    answer = schedule_free_slots(touching,one,3600,"",0)
    sh_checks.reversed_busy_refuses = answer.error != "" && answer.slots.len() == 0
    let duplicate_windows = [one[0],one[0]]
    answer = schedule_free_slots([],duplicate_windows,3600,"",0)
    sh_checks.overlapping_windows_do_not_duplicate_candidate = answer.slots.len() == 1
    sh_checks.overlapping_windows_actual = answer.slots
    sh_checks.pure_no_external_actions = sh_calls.len() == 0 && sh_writes == 0
    start_timeout(0.03,|| sh_month_boundaries())
}
fn sh_month_boundaries(){
    sh_progress("month-boundaries")
    let midnight = calendar_iso_epoch("2032-03-01T00:00:00Z")
    sh_checks.utc_leap_midnight_previous_second_formats_exactly = core_utc_iso(midnight-1) == "2032-02-29T23:59:59Z"
    sh_checks.utc_leap_midnight_exact_formats_exactly = core_utc_iso(midnight) == "2032-03-01T00:00:00Z"
    sh_checks.utc_leap_midnight_next_second_formats_exactly = core_utc_iso(midnight+1) == "2032-03-01T00:00:01Z"
    let windows = [{start: "2032-01-31T23:30:00+08:00" end: "2032-02-01T01:30:00+08:00"}]
    let busy = [{id: "midnight-busy" start: "2032-01-31T23:30:00+08:00" end: "2032-02-01T00:00:00+08:00" all_day: false availability: 0}]
    let answer = schedule_free_slots(busy,windows,1800,"",0)
    sh_checks.cross_month_midnight_slot_uses_correct_utc_day = answer.error == "" && answer.slots.len() == 2
        && answer.slots[0].start == "2032-01-31T16:00:00Z" && answer.slots[1].end == "2032-01-31T17:00:00Z"
    sh_checks.midnight_now_rounds_into_next_local_day = schedule_round_up(calendar_iso_epoch("2032-01-31T23:59:59+08:00"))
        == calendar_iso_epoch("2032-02-01T00:00:00+08:00")
    sh_query_reset()
    ui.calendar_start.set_text("2032-02-29T23:00:00+08:00") ui.calendar_end.set_text("2032-03-01T00:00:00+08:00")
    let policy = {search_start: "2032-02-29T00:00:00+08:00" search_end: "2032-03-04T00:00:00+08:00" time_zone: "Asia/Shanghai"
        hard_windows: [{start: "2032-02-29T23:00:00+08:00" end: "2032-03-01T00:00:00+08:00"}]
        preferred_windows: [{start: "2032-02-29T23:00:00+08:00" end: "2032-03-01T00:00:00+08:00"}]}
    calendar_links[0].schedule_policy = policy calendar_links[0].candidate = calendar_draft_payload()
    sh_checks.leap_month_four_day_range_and_exact_hard_edges_valid = calendar_draft_error(calendar_draft_payload()) == ""
    schedule_find_slots(false)
    sh_checks.leap_month_query_recommends_exact_slot = sh_count("calendar.list") == 1 && schedule_slots.len() == 1
        && schedule_slots[0].start == "2032-02-29T15:00:00Z" && schedule_slots[0].end == "2032-02-29T16:00:00Z"
    let leap_start = calendar_iso_epoch(ui.calendar_start.text()) let leap_end = calendar_iso_epoch(ui.calendar_end.text())
    sh_checks.leap_month_query_observed = {slots: schedule_slots error: calendar_error calls: sh_calls start_epoch: leap_start
        end_epoch: leap_end duration: leap_end - leap_start rounded: schedule_round_up(leap_start) now: time_now()
        windows: policy.preferred_windows pure: schedule_free_slots([],policy.preferred_windows,leap_end - leap_start,"",0)
        literal: schedule_free_slots([],[{start: "2032-02-29T23:00:00+08:00" end: "2032-03-01T00:00:00+08:00"}],3600,"",0)}.to_json().parse_json()
    ui.calendar_end.set_text("2032-03-01T00:00:01+08:00")
    sh_checks.one_second_past_midnight_hard_end_refuses = calendar_draft_error(calendar_draft_payload()) != ""
    ui.calendar_end.set_text("2032-03-01T00:00:00+08:00")
    policy.search_end = "2032-03-04T00:00:01+08:00"
    let calls = sh_calls.len() schedule_find_slots(false)
    sh_checks.leap_month_four_day_plus_one_second_no_query = calendar_draft_error(calendar_draft_payload()) != "" && sh_calls.len() == calls
    start_timeout(0.03,|| sh_queries())
}
fn sh_queries(){
    sh_progress("queries")
    sh_query_reset()
    sh_events = [{id: "busy-soft" calendar_id: "fixture-calendar" version: "v1" start: "2030-06-12T09:00:00+08:00" end: "2030-06-12T10:00:00+08:00" all_day: false availability: 0}]
    schedule_find_slots(false)
    sh_checks.target_calendar_only = sh_count("calendar.list") == 1 && sh_calls[0].args.calendar_id == "fixture-calendar"
        && sh_calls[0].args.start == "2030-06-12T00:00:00+08:00" && sh_calls[0].args.end == "2030-06-16T00:00:00+08:00"
    sh_checks.soft_conflict_asks_no_relax_no_write = schedule_slots.len() == 0 && calendar_error.search("是否只为这次") >= 0 && sh_writes == 0
    schedule_find_slots(true)
    sh_checks.once_relax_fits_hard_only = schedule_slots.len() == 2 && schedule_slots[0].start == "2030-06-12T02:00:00Z"
        && schedule_slots[1].end == "2030-06-12T04:00:00Z" && calendar_links[0].slot_check.relaxed_once == true && sh_writes == 0
    schedule_find_slots(false)
    sh_checks.relax_not_permanent = schedule_slots.len() == 0 && calendar_links[0].schedule_policy.preferred_windows.len() == 1
        && calendar_links[0].schedule_policy.preferred_windows[0].end == "2030-06-12T10:00:00+08:00"
    start_timeout(0.03,|| sh_query_bounds())
}
fn sh_query_bounds(){
    sh_progress("query-bounds")
    sh_query_reset() calendar_links[0].schedule_policy.search_end = "2030-06-16T00:01:00+08:00" schedule_find_slots(false)
    sh_checks.four_day_excess_no_query = sh_calls.len() == 0 && schedule_slots.len() == 0 && calendar_error != ""
    sh_query_reset() calendar_links[0].schedule_policy.search_start = "2030-06-11T23:59:00+08:00" schedule_find_slots(false)
    sh_checks.before_original_day_no_query = sh_calls.len() == 0 && schedule_slots.len() == 0
    sh_query_reset() calendar_links[0].schedule_policy.preferred_windows[0].end = "2030-06-12T12:01:00+08:00" schedule_find_slots(false)
    sh_checks.soft_cannot_bypass_hard = sh_calls.len() == 0 && schedule_slots.len() == 0 && calendar_error.search("硬性") >= 0
    sh_query_reset() sh_truncated = true schedule_find_slots(false)
    sh_checks.truncated_refuses_candidates = sh_count("calendar.list") == 1 && schedule_slots.len() == 0 && calendar_error != ""
    sh_query_reset() sh_list_ok = false schedule_find_slots(false)
    sh_checks.failed_query_refuses_candidates = sh_count("calendar.list") == 1 && schedule_slots.len() == 0 && calendar_error != ""
    sh_query_reset() ui.calendar_end.set_text("") schedule_find_slots(false)
    sh_checks.missing_duration_no_query = sh_calls.len() == 0 && schedule_slots.len() == 0
    sh_query_reset() ui.calendar_timezone.set_text("America/New_York")
    calendar_links[0].schedule_policy.time_zone = "America/New_York" schedule_find_slots(false)
    sh_checks.unverified_dst_boundary_asks = sh_calls.len() == 0 && calendar_error.search("边界尚未核实") >= 0
    start_timeout(0.03,|| sh_query_late())
}
fn sh_query_late(){
    sh_progress("query-late")
    sh_query_reset() sh_hold_list = true schedule_find_slots(false)
    calendar_candidate_revision = calendar_candidate_revision + 1
    sh_lists[0]({is_ok: true data: {events: [] truncated: false}})
    sh_checks.late_slots_rejected_after_revision = schedule_slots.len() == 0 && schedule_slot_snapshot == ""
    sh_hold_list = false
    sh_query_reset() ui.calendar_start.set_text("2030-06-12T12:00:00+08:00") ui.calendar_end.set_text("2030-06-12T13:00:00+08:00")
    sh_checks.candidate_outside_hard_rejected_before_conflict_query = calendar_draft_error(calendar_draft_payload()) != ""
    sh_query_reset() ui.calendar_start.set_text("2030-06-12T10:00:00+08:00") ui.calendar_end.set_text("2030-06-12T11:00:00+08:00")
    sh_checks.candidate_outside_soft_requires_once_permission = calendar_draft_error(calendar_draft_payload()) != ""
    sh_query_reset() sh_events = [{id: "wrong-calendar-event" calendar_id: "another-calendar" version: "v1"
        start: "2030-06-12T09:00:00+08:00" end: "2030-06-12T10:00:00+08:00" all_day: false availability: 0}]
    schedule_find_slots(false)
    sh_checks.wrong_calendar_list_refuses_candidates = schedule_slots.len() == 0 && calendar_error != ""
    start_timeout(0.03,|| sh_stale_link_revision())
}
fn sh_stale_link_revision(){
    sh_progress("stale-link-revision")
    sh_query_reset() sh_hold_list = true schedule_find_slots(false)
    calendar_links[0].candidate_revision = 2
