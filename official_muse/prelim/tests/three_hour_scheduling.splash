}
fn sh_source_query_reset(){
    sh_query_reset()
    gm_set_accounts(["synthetic-account"])
    calendar_links[0].account_id = "synthetic-account" calendar_links[0].source_id = "slot-source"
    calendar_links[0].source_claim_id = "slot-claim"
    memory_sources = [{source_id: "slot-source" kind: "runtime_receipt" locator: "fixture-mail:slot-mail"
        content_sha256: fs.sha256("synthetic") observed_at: "2026-10-03T00:00:00Z" updated_at: "2026-10-03T00:00:00Z"
        support_excerpt: "synthetic" "scope": core_memory_scope("synthetic-account")}]
    memory = [{pinned: false document: {schema_version: "muse.dsl/1" kind: "memory" id: "slot-claim" revision: 1
        created_at: "2026-10-03T00:00:00Z" updated_at: "2026-10-03T00:00:00Z"
        origin: {type: "local_runtime" ref: "fixture-mail-host"} "scope": core_memory_scope("synthetic-account")
        payload: {subject_id: "fixture-slot-goal" predicate: "calendar_source_message" value: "synthetic" epistemic_type: "external_claim"
            source_ids: ["slot-source"] observed_at: "2026-10-03T00:00:00Z" valid_from: nil valid_until: nil relations: [] deleted: false}}}]
    memory_sources = memory_sources.to_json().parse_json() memory = memory.to_json().parse_json()
}
fn sh_source_digest_binding(){
    sh_progress("source-digest-binding")
    sh_source_query_reset() sh_hold_list = true schedule_find_slots(false)
    memory_sources[0].content_sha256 = fs.sha256("replaced")
    let changed = memory_sources[0].content_sha256 == fs.sha256("replaced")
    sh_checks.source_digest_mutation_before_callback = {changed: changed digest: memory_sources[0].content_sha256 callbacks: sh_lists.len()}
    sh_lists[sh_lists.len()-1]({is_ok: true data: {events: [] truncated: false}})
    sh_checks.late_slots_reject_replaced_bound_source_digest = changed && sh_count("calendar.list") == 1 && schedule_slots.len() == 0 && schedule_slot_snapshot == ""
    start_timeout(0.03,|| sh_source_claim_binding())
}
fn sh_source_claim_binding(){
    sh_progress("source-claim-binding")
    sh_source_query_reset() sh_hold_list = true schedule_find_slots(false)
    memory[0].document.revision = 2
    let changed = memory[0].document.revision == 2
    sh_checks.source_claim_mutation_before_callback = {changed: changed revision: memory[0].document.revision callbacks: sh_lists.len()}
    sh_lists[sh_lists.len()-1]({is_ok: true data: {events: [] truncated: false}})
    sh_checks.late_slots_reject_bound_source_claim_revision_even_without_context_refs = changed && sh_count("calendar.list") == 1 && schedule_slots.len() == 0 && schedule_slot_snapshot == ""
    sh_checks.source_claim_binding_observed = {claim_revision: memory[0].document.revision refs: calendar_context_refs
        slots: schedule_slots link: calendar_links[0]}.to_json().parse_json()
    start_timeout(0.03,|| sh_source_account_binding())
}
fn sh_source_account_binding(){
    sh_progress("source-account-binding")
    sh_source_query_reset() sh_hold_list = true schedule_find_slots(false)
    gm_set_accounts([])
    sh_lists[sh_lists.len()-1]({is_ok: true data: {events: [] truncated: false}})
    sh_checks.late_slots_reject_account_revocation_after_query = sh_count("calendar.list") == 1 && schedule_slots.len() == 0 && schedule_slot_snapshot == ""
    memory = [] memory_sources = []
