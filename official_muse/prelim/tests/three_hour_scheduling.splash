fn sh_direct_bounds(){
    sh_progress("direct-bounds")
    sh_query_reset()
    ui.calendar_start.set_text("2030-06-13T09:00:00+08:00") ui.calendar_end.set_text("2030-06-13T10:00:00+08:00")
    let policy = calendar_links[0].schedule_policy
