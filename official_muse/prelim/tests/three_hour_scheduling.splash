    sh_finish()
}
fn sh_finish(){
    sh_checks.forbidden_calls = sh_forbidden sh_checks.host_calls = sh_calls
    sh_checks.execution_mode = "pure"
    if sh_full { sh_checks.execution_mode = "full_matching_sdk" }
    sh_checks.boundary = "FIXTURE_PRODUCTION_FUNCTIONS: synthetic Host/model replies; real isolated fs; no external mail, EventKit or model inference."
    fs.write("probe.json",sh_checks.to_json())
}
