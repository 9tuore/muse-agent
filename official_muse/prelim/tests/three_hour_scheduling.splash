fn sh_approval_source_replan(){
    let li = calendar_link_index(sh_goal)
    if li < 0 || sh_models.len() != 1 { sh_checks.approved_update_rejects_canonical_source_change = false sh_finish() return }
    sh_event = sh_original()
    if sh_approval_variant == "time-expired" { sh_event.time_zone = "UTC" }
    calendar_links[li].status = "verified" calendar_links[li].calendar_id = sh_event.calendar_id
    calendar_links[li].event_id = sh_event.id calendar_links[li].version = sh_event.version
    calendar_links[li].original_event = sh_event calendar_links[li].candidate = calendar_draft_payload()
    calendar_save()
    let requested_time = "2030-06-12 10:00至11:00"
    if sh_approval_variant == "time-expired" { requested_time = sh_approval_near_start }
    schedule_replan_original(sh_goal,"synthetic-account",{id: "approval-replan" message_id: "<approval-replan@example.invalid>"
        in_reply_to: "<approval-origin@example.invalid>" address: "sender@example.invalid" subject: "改期合成约定"
        body: "事项ID：" + sh_goal + "；改到" + requested_time + "，沿用原来时长。"})
    start_timeout(0.03,|| sh_approval_source_preview())
}
fn sh_approval_source_preview(){
    if sh_models.len() != 2 { sh_checks.approved_update_rejects_canonical_source_change = false sh_finish() return }
    let policy = sh_policy() policy.preferred_windows = policy.hard_windows
    if sh_approval_variant == "soft-exception" { policy = sh_policy() }
    let start = "2030-06-12T10:00:00+08:00" let end = "2030-06-12T11:00:00+08:00" let zone = "Asia/Shanghai"
    if sh_approval_variant == "time-expired" {
        start = sh_approval_near_start end = core_utc_iso(calendar_iso_epoch(start)+3600) zone = "UTC"
        let day = page_time_floor(calendar_iso_epoch(start)/86400)*86400
        policy = {search_start: core_utc_iso(day) search_end: core_utc_iso(day+345600) time_zone: "UTC"
            hard_windows: [{start: core_utc_iso(day) end: core_utc_iso(day+345600)}]
            preferred_windows: [{start: core_utc_iso(day) end: core_utc_iso(day+345600)}]}
    }
    sh_models[1]({is_ok: true data: {output: {title: "MUSE-R2-SCHEDULING" start: start
        end: end time_zone: zone location: "合成地点"
        question: "" policy: policy duration_changed: false duration_quote: ""}}})
    if sh_approval_variant == "different-event" {
        let other = sh_original().to_json().parse_json()
        other.id = "fixture-event-b" other.version = "fixture-b-v1"
        other.start = "2030-06-12T12:00:00+08:00" other.end = "2030-06-12T13:00:00+08:00"
        sh_event = other
        calendar_select_event(other)
        sh_checks.other_event_selection = {original_goal: sh_goal selected_goal: calendar_selected_goal
            selected_event: calendar_selected_event original_link: calendar_links[calendar_link_index(sh_goal)] refs: calendar_context_refs}.to_json().parse_json()
        ui.calendar_start.set_text("2030-06-12T11:00:00+08:00") ui.calendar_end.set_text("2030-06-12T12:00:00+08:00")
        calendar_edit()
    }
    if sh_approval_variant == "same-event" {
        let refs_before = calendar_context_refs.to_json().parse_json()
        let same = sh_original().to_json().parse_json()
        sh_event = same
        calendar_select_event(same)
        sh_checks.same_event_selection = {original_goal: sh_goal selected_goal: calendar_selected_goal
            selected_event: calendar_selected_event original_link: calendar_links[calendar_link_index(sh_goal)]
            refs_before: refs_before refs: calendar_context_refs}.to_json().parse_json()
        ui.calendar_start.set_text("2030-06-12T11:00:00+08:00") ui.calendar_end.set_text("2030-06-12T12:00:00+08:00")
        calendar_edit()
    }
    if sh_approval_variant == "soft-exception" { schedule_find_slots(true) schedule_choose_slot(schedule_slots[1]) }
    calendar_check_conflicts() calendar_preview_action()
    let li = calendar_link_index(sh_goal)
    sh_checks.approval_source_before = {preview: calendar_preview goal: goals[core_goal_index(sh_goal)] link: calendar_links[li]
        refs: calendar_context_refs calls: sh_calls source_binding: calendar_preview_binding}.to_json().parse_json()
    start_timeout(0.03,|| sh_approval_source_mutate())
}
fn sh_approval_source_mutate(){
    let li = calendar_link_index(sh_goal)
    let si = core_source_index(calendar_links[li].source_id,"synthetic-account")
    let mi = core_memory_index(calendar_links[li].source_claim_id,"synthetic-account")
    let ready = calendar_preview != "" && calendar_links[li].status == "waiting_user" && si >= 0 && mi >= 0
        && calendar_context_refs.len() > 0 && sh_count("calendar.update") == 0 && calendar_preview_binding != ""
    if sh_approval_variant == "different-event" {
        ready = calendar_preview != "" && calendar_selected_event.id == "fixture-event-b" && sh_count("calendar.update") == 0
    }
    if sh_approval_variant == "soft-exception" { ready = ready && calendar_links[li]["soft_exception"] != nil && calendar_draft_error(calendar_draft_payload()) == "" }
    if !ready { sh_checks.approved_update_rejects_canonical_source_change = false sh_checks.approval_setup_error = calendar_error sh_finish() return }
    let old_digest = memory_sources[si].content_sha256 let old_claim_revision = memory[mi].document.revision
    sh_hold_get = true sh_gets = "[]".parse_json()
    if sh_approval_variant != "before-confirm" && sh_approval_variant != "soft-exception" { calendar_confirm_action() }
    if sh_approval_variant == "time-expired" {
        sh_checks.approval_time_before = {now: time_now() start: ui.calendar_start.text() preview_age: time_now()-calendar_preview_at callbacks: sh_gets.len()}
        start_timeout(9,|| sh_approval_time_release()) return
    }
    let committed = false
    if sh_approval_variant == "after-confirm" || sh_approval_variant == "before-confirm" {
        let next_sources = memory_sources.to_json().parse_json()
        next_sources[si].content_sha256 = fs.sha256("隔离批准期间新来源内容")
        next_sources[si].updated_at = core_utc_iso(time_now()+1)
        next_sources[si].support_excerpt = "隔离批准期间新来源内容"
        committed = core_commit_memory(memory,next_sources,memory_forget)
    }
    let changed = committed && memory_sources[si].content_sha256 != old_digest
        && memory[mi].document.revision == old_claim_revision
    sh_checks.approval_source_mutation = {variant: sh_approval_variant committed: committed changed: changed old_digest: old_digest new_digest: memory_sources[si].content_sha256
        claim_revision: memory[mi].document.revision refs: calendar_context_refs refs_still_valid: chat_reply_context_valid({memory_refs: calendar_context_refs})
        callbacks: sh_gets.len()}.to_json().parse_json()
    if sh_approval_variant == "before-confirm" { calendar_confirm_action() }
    let cleared = false
    if sh_approval_variant == "soft-exception" {
        calendar_links[li].soft_exception = nil cleared = calendar_save()
        sh_checks.approval_soft_exception_after = {saved: cleared exception: calendar_links[li]["soft_exception"]
            candidate_error: schedule_candidate_error(calendar_draft_payload(),calendar_links[li])}
        calendar_confirm_action()
    }
    sh_hold_get = false sh_block_update = sh_approval_variant != "control"
    let read_event = sh_original()
    if sh_approval_variant == "different-event" { read_event = sh_event }
    if sh_gets.len() > 0 { sh_gets[sh_gets.len()-1]({is_ok: true data: {found: true event: read_event}}) }
    if sh_approval_variant == "after-confirm" {
        sh_checks.approved_update_rejects_canonical_source_change = changed && sh_gets.len() == 1
            && sh_count("calendar.update") == 0 && sh_writes == 0 && calendar_preview == ""
    }
    if sh_approval_variant == "before-confirm" {
        sh_checks.preview_update_rejects_canonical_source_change_before_click = changed && sh_gets.len() == 0
            && sh_count("calendar.update") == 0 && sh_writes == 0 && calendar_preview == ""
    }
    if sh_approval_variant == "control" {
        sh_checks.unchanged_source_approved_update_and_independent_readback = memory_sources[si].content_sha256 == old_digest && sh_gets.len() == 1
            && sh_count("calendar.update") == 1 && sh_count("calendar.get") == 3 && sh_writes == 1
            && calendar_links[calendar_link_index(sh_goal)].status == "verified"
            && goals.len() == 1 && goals[0].status == "completed" && runs.len() == 1 && runs[0].status == "completed"
            && actions.len() == 1 && actions[0].status == "verified"
    }
    if sh_approval_variant == "soft-exception" {
        sh_checks.preview_update_rejects_cleared_actual_one_time_soft_exception = cleared && calendar_links[li]["soft_exception"] == nil
            && sh_gets.len() == 0 && sh_count("calendar.update") == 0 && sh_writes == 0 && calendar_preview == ""
    }
    if sh_approval_variant == "different-event" {
        let wrong_goal = false
        for action in actions {
            if action.service == "calendar.update" && action.goal_id == sh_goal
                && action.payload_json.parse_json().event_id == "fixture-event-b" { wrong_goal = true }
        }
        sh_checks.select_other_event_detaches_goal_before_approved_update = calendar_selected_goal == ""
            && sh_count("calendar.update") == 1 && sh_writes == 0 && !wrong_goal && actions.len() == 1
            && actions[0].goal_id == "" && actions[0].run_id == "" && runs.len() == 0
            && goals.len() == 1 && goals[0].status == "planned" && calendar_links[li].event_id == "fixture-event"
    }
    if sh_approval_variant == "same-event" {
        let selection = sh_checks.same_event_selection
        let bound_action = false
        if actions.len() == 1 {
            let payload = actions[0].payload_json.parse_json()
            bound_action = actions[0].goal_id == sh_goal && actions[0].run_id != ""
                && payload.event_id == "fixture-event" && payload.calendar_id == "fixture-calendar"
                && payload.changes.start == "2030-06-12T11:00:00+08:00" && payload.changes.end == "2030-06-12T12:00:00+08:00"
        }
        sh_checks.select_same_event_preserves_goal_before_approved_update = selection.selected_goal == sh_goal
            && selection.selected_event.id == "fixture-event" && selection.refs_before.len() > 0
            && selection.refs.to_json() == selection.refs_before.to_json() && calendar_selected_goal == sh_goal
            && sh_gets.len() == 1 && sh_count("calendar.update") == 1 && sh_writes == 0 && bound_action
            && runs.len() == 1 && goals.len() == 1 && goals[0].id == sh_goal && calendar_links[li].event_id == "fixture-event"
        sh_checks.same_event_interception = {writes: sh_writes runs: runs goals: goals actions: actions
            selected_goal: calendar_selected_goal refs: calendar_context_refs}.to_json().parse_json()
    }
    sh_checks.approval_source_after = {calls: sh_calls goals: goals links: calendar_links actions: actions
        error: calendar_error preview: calendar_preview}.to_json().parse_json()
    sh_hold_get = false sh_block_update = false sh_finish()
}
fn sh_approval_time_release(){
    let expired = calendar_iso_epoch(ui.calendar_start.text()) <= time_now()
    let card_live = time_now()-calendar_preview_at < 300
    sh_hold_get = false sh_block_update = true
    if sh_gets.len() > 0 { sh_gets[sh_gets.len()-1]({is_ok: true data: {found: true event: sh_event}}) }
    sh_checks.pending_update_rejects_start_expiry_while_confirmation_card_live = expired && card_live && sh_gets.len() == 1
        && sh_count("calendar.update") == 0 && sh_writes == 0 && calendar_preview == ""
    sh_checks.approval_time_after = {now: time_now() start: ui.calendar_start.text() preview_age: time_now()-calendar_preview_at
        error: calendar_error calls: sh_calls actions: actions}
    sh_block_update = false sh_finish()
}
