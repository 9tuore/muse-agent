fn sh_candidate_input_missing_end(){
    let payload = {title: "合成日程" start: "2030-06-12T15:00:00+08:00" end: "" time_zone: "Asia/Shanghai" location: ""}
    let message = "安排2030-06-12下午15点的合成日程，结束时间待补。"
    let error = chat_candidate_input_error("calendar_candidate",payload,message,false)
