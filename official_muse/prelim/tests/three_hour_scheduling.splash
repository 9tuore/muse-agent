fn sh_chain_start(){
    sh_progress("chain-start")
    calendar_pending = false goals = [] runs = [] actions = [] calendar_links = [] calendar_receipts = []
    fixture_seed() chat_boot() gm_boot() gm_set_focus("合成安排项目","本人") gm_set_accounts(["synthetic-account"])
    notification_enabled = false mail_analysis.enabled = false mail_analysis.permitted = false
    mail_scope_project = "合成安排项目" mail_scope_owner = "本人"
    mail_account = {id: "synthetic-account" address: "self@example.invalid"}
    mail_selected = {id: "original-mail" message_id: "<original@example.invalid>" address: "sender@example.invalid"
        subject: "MUSE-R2-SCHEDULING" body: "项目：合成安排项目；归属：本人；2030-06-12 09:00到10:00，Asia/Shanghai。"}
    mail_link_calendar() sh_goal = selected_id
    let li = calendar_link_index(sh_goal)
    sh_checks.chain_goal_source_bound = goals.len() == 1 && li >= 0 && sh_models.len() == 1
    if !sh_checks.chain_goal_source_bound { sh_finish() return }
    // Seed an independently existing external event, then use the real replan path.
    sh_event = sh_original()
    calendar_links[li].status = "verified" calendar_links[li].calendar_id = sh_event.calendar_id
    calendar_links[li].event_id = sh_event.id calendar_links[li].version = sh_event.version
    calendar_links[li].original_event = sh_event calendar_links[li].candidate = calendar_draft_payload()
    calendar_links[li].soft_exception = {payload: calendar_draft_payload().to_json() message_id: "original-mail" revision: 1}
    calendar_save()
    let next_mail = {id: "reschedule-mail-1" address: "sender@example.invalid" subject: "改期MUSE-R2-SCHEDULING"
        body: "事项ID：" + sh_goal + "；改到2030-06-13 10:00，时长不变。" in_reply_to: "<original@example.invalid>" message_id: "<reschedule-1@example.invalid>"}
    schedule_replan_original(sh_goal,"synthetic-account",next_mail)
    li = calendar_link_index(sh_goal)
    sh_checks.replan_same_goal_one_event = goals.len() == 1 && goals[0].id == sh_goal && goals[0].version == 2
        && calendar_links.len() == 1 && calendar_links[li].operation == "update" && calendar_links[li].event_id == "fixture-event"
        && calendar_links[li].history.len() == 1 && calendar_links[li].history[0].message_id == "original-mail" && sh_writes == 0
    sh_checks.actual_replan_clears_previous_exception = calendar_links[li]["soft_exception"] == nil
    if !sh_checks.replan_same_goal_one_event || sh_models.len() < 2 { sh_finish() return }
    let competing_mail = {id: "reschedule-mail-2" address: "sender@example.invalid" subject: "后一封改期"
        body: "事项ID：" + sh_goal + "；再改到2030-06-14。"}
    schedule_replan_original(sh_goal,"synthetic-account",competing_mail)
    sh_checks.later_mail_does_not_overwrite_pending_first = goals[0].version == 2 && calendar_links[li].message_id == "reschedule-mail-1"
        && sh_models.len() == 2 && sh_writes == 0
    sh_models[0]({is_ok: true data: {output: {title: "迟到的原邮件候选" start: "2030-06-12T09:00:00+08:00"
        end: "2030-06-12T10:00:00+08:00" time_zone: "Asia/Shanghai" location: "旧地点" question: "" policy: sh_policy()
        duration_changed: false duration_quote: ""}}})
    sh_checks.old_original_generation_does_not_fill_replan = calendar_links[li].message_id == "reschedule-mail-1"
        && calendar_links[li].candidate.title == "MUSE-R2-SCHEDULING" && calendar_links[li].candidate.location == "合成地点"
