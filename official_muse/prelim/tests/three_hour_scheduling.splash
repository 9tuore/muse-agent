}
// One approval-boundary case; uses canonical Goal/source/replan production paths.
fn sh_approval_source_start(){
    fixture_seed() chat_boot() gm_boot() gm_set_focus("批准绑定复现","本人") gm_set_accounts(["synthetic-account"])
