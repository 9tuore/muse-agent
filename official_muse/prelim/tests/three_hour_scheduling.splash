}
fn sh_normal_slot_adoption(){
    sh_progress("normal-slot-adoption")
    sh_query_reset() schedule_find_slots(true)
    schedule_choose_slot(schedule_slots[1])
    sh_checks.current_bound_relaxed_slot_still_adopts_and_checks_conflicts = calendar_links[0]["soft_exception"] != nil
        && calendar_draft_error(calendar_draft_payload()) == "" && sh_count("calendar.list") == 2 && sh_writes == 0
