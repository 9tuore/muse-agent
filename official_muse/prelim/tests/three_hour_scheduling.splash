        && calendar_links.len() == 1 && calendar_links[0].event_id == "fixture-event" && sh_writes == 1
    if queued {
        let before = calendar_links[0].candidate.to_json()
        sh_checks.cancel_pending_goal_saved = core_cancel_goal(sh_goal)
        sh_models[before_models]({is_ok: true data: {output: {title: "已取消后迟到候选"
            start: "2030-06-14T09:00:00+08:00" end: "2030-06-14T10:00:00+08:00" time_zone: "Asia/Shanghai"
            location: "旧地点" question: "" policy: sh_policy() duration_changed: false duration_quote: ""}}})
        sh_checks.late_model_does_not_revive_cancelled_goal = goals[0].status == "cancelled"
            && calendar_links[0].candidate.to_json() == before && sh_writes == 1
