// Exact extracted production chat_payload_error; no boot/model/Goal storage calls.
let gb_a160 = "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
let gb_s4000 = ""
let gb_e40 = "😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀😀"
let gb_checks = {}
let gb_rows = []
fn gb_check(name,objective,source,expected,objective_bytes,source_bytes){
    let error = chat_payload_error("goal_plan",{objective: objective source: source})
    let measured_objective = objective.trim().len()
    let measured_source = source.trim().len()
    gb_checks[name] = error == expected && measured_objective == objective_bytes && measured_source == source_bytes
    gb_rows.push({name: name objective_bytes: measured_objective source_bytes: measured_source
        error: error expected: expected})
}
fn gb_probe(){
    gb_check("ascii_objective160_accepted",gb_a160,"资料","",160,6)
    gb_check("ascii_objective161_rejected",gb_a160 + "a","资料","任务目标或资料过长，请缩短后再建立计划。",161,6)
    gb_check("ascii_source4000_accepted","一次任务",gb_s4000,"",12,4000)
    gb_check("ascii_source4001_rejected","一次任务",gb_s4000 + "s","任务目标或资料过长，请缩短后再建立计划。",12,4001)
    gb_check("emoji_objective40_160bytes_accepted",gb_e40,"资料","",160,6)
    gb_check("emoji_objective41_164bytes_rejected",gb_e40 + "😀","资料","任务目标或资料过长，请缩短后再建立计划。",164,6)
    gb_check("empty_objective_rejected","","资料","请提供本次任务的目标与资料；初赛版不创建通用周期任务。",0,6)
    gb_check("empty_source_rejected","一次任务","","请提供本次任务的目标与资料；初赛版不创建通用周期任务。",12,0)
    gb_check("periodic_objective_rejected","每周整理会议记录","资料","请提供本次任务的目标与资料；初赛版不创建通用周期任务。",24,6)
    gb_check("valid_one_time_goal_accepted","整理项目会议记录","用户原始资料：第一条记录；第二条记录。","",24,57)
    gb_checks.observed = gb_rows
    gb_checks.boundary = "LOCAL_FUNCTION_SLICE: SDK byte lengths; no model, Goal storage or external services; only probe.json written."
    fs.write("probe.json",gb_checks.to_json())
}
start_timeout(0.1,|| gb_probe())
