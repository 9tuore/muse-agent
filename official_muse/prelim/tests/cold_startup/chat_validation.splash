let cold_cases = []
let cold_index = 0
fn cold_seed(){
    return {schema: 1 selected_id: "synthetic-chat" sessions: [{id: "synthetic-chat" title: "恢复历史"
        created_at: 123 updated_at: 124 focus_project: "合成项目" focus_owner: "synthetic" goal_id: "" proposals: []
        messages: [{role: "user" text: "安排时保留原消息。" state: "success" at: 123}
            {role: "assistant" text: "这是隔离恢复验证。" state: "success" at: 124}]}]}
}
fn cold_check_case(name,saved,expected){
    let actual = chat_state_valid(saved)
    cold_cases.push({name: name expected: expected actual: actual pass: actual == expected})
}
fn cold_validate_step(){
    let saved = cold_seed()
    if cold_index == 0 { cold_check_case("valid_history",saved,true) }
    if cold_index == 1 { saved.schema = 2 cold_check_case("wrong_schema",saved,false) }
    if cold_index == 2 { saved.sessions = {} cold_check_case("wrong_sessions_type",saved,false) }
    if cold_index == 3 { saved.selected_id = "missing" cold_check_case("missing_selected",saved,false) }
    if cold_index == 4 { saved.sessions.push(saved.sessions[0]) cold_check_case("duplicate_id",saved,false) }
    if cold_index == 5 { saved.sessions[0].messages[0].text = 123 cold_check_case("numeric_text",saved,false) }
    if cold_index == 6 { saved.sessions[0].messages[0].role = "system" cold_check_case("untrusted_role",saved,false) }
    if cold_index == 7 { saved.sessions[0].messages[0].state = [] cold_check_case("invalid_state",saved,false) }
    if cold_index == 8 { saved.sessions[0].messages[0].at = true cold_check_case("boolean_timestamp",saved,false) }
    if cold_index == 9 { saved.sessions[0].focus_owner = {} cold_check_case("invalid_owner",saved,false) }
    if cold_index == 10 { saved.sessions[0].messages[0].memory_refs = [{}] cold_check_case("invalid_memory_provenance",saved,false) }
    if cold_index == 11 { saved.sessions[0].proposals = [{id: "proposal" session_id: "other" account_id: "synthetic"}]
        cold_check_case("wrong_proposal_session",saved,false) }
    cold_index = cold_index + 1
    if cold_index < 12 { start_timeout(0.02, || cold_validate_step()) return }
    let report = {schema: 1 cases: cold_cases calls: 0 kind: "real card-host validator with synthetic records"}
    fs.write("cold-validation.json",report.to_json())
}
start_timeout(0.05,|| cold_validate_step())
View{width: Fill height: Fill Label{text: "冷启动历史校验 · 合成测试"}}
