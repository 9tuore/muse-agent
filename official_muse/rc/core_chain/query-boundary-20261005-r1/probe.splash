let qb_case="__CASE__"
let cc_phase="first"
let qb_checks={}
let qb_calls=[]
let qb_models=[]
let qb_goal=""
let qb_wait=0
let qb_source="2030-06-12 15:00–15:30，Asia/Shanghai，合成地点。"
let qb_date="2030-06-12"
fn chain_fixture_request(service,args,cb){
    qb_calls.push({service:service args:args.to_json().parse_json()})
    if service=="mail.accounts" {cb({is_ok:true data:[{id:"synthetic-account" address:"self@example.invalid"}]}) return}
    if service=="model.complete" {qb_models.push(cb) return}
    if service=="calendar.list" {
        let events=[]
        if qb_case=="wrong_calendar" {events=[{id:"synthetic-foreign-event" calendar_id:"synthetic-other-calendar" version:"v1"
            start:args.start end:args.end all_day:false availability:0}]}
        cb({is_ok:true data:{events:events truncated:false}}) return
    }
    cb({is_ok:false error:"Query-boundary fixture forbids external services"})
}
fn qb_count(service){let n=0 for call in qb_calls {if call.service==service {n=n+1}} return n}
fn qb_broad_policy(){
    return {search_start:qb_date+"T00:00:00+08:00" search_end:"2030-06-16T00:00:00+08:00" time_zone:"Asia/Shanghai" reason:"合成模型宽范围"
        hard_windows:[{start:qb_date+"T00:00:00+08:00" end:"2030-06-16T00:00:00+08:00"}]
        preferred_windows:[{start:qb_date+"T00:00:00+08:00" end:"2030-06-16T00:00:00+08:00"}]}
}
fn qb_finish(){
    let forbidden=false
    for call in qb_calls {if call.service!="mail.accounts" && call.service!="model.complete" && call.service!="calendar.list" {forbidden=true}}
    qb_checks.no_actions=!forbidden && runs.len()==0 && actions.len()==0
    qb_checks.host_calls=qb_calls
    if calendar_links.len()>0 {qb_checks.observed_link=calendar_links[0].to_json().parse_json()}
    qb_checks.observed_error=calendar_error
    qb_checks.observed_slots=schedule_slots.to_json().parse_json()
    if cc_phase=="first" {
        fs.write("query-baseline.json",{goals_bytes:fs.read("goals.json") memory_bytes:fs.read("memory.json")
            calendar_bytes:fs.read("calendar-state.json") source_id:calendar_links[0].source_id requested_range:calendar_links[0]["requested_range"]}.to_json())
    }
    fs.write("probe.json",qb_checks.to_json())
}
fn qb_wait_link(){
    if mail_calendar_link_pending && qb_wait<40 {qb_wait=qb_wait+1 start_timeout(0.05,|| qb_wait_link()) return}
    qb_checks.source_ready=goals.len()==1 && calendar_links.len()==1 && qb_models.len()==1
    if !qb_checks.source_ready {qb_finish() return}
    qb_goal=goals[0].id
    if qb_case=="reschedule" {
        calendar_links[0].original_event={id:"synthetic-original-event" calendar_id:"synthetic-calendar" version:"v1" recurring:false
            title:"合成约定" start:"2030-06-12T15:00:00+08:00" end:"2030-06-12T15:30:00+08:00" time_zone:"Asia/Shanghai" location:"合成地点"}
        qb_date="2030-06-13"
        schedule_clarify(qb_goal,"本次改为2030-06-13 16:00–16:30，其他字段不变。")
    }
    start_timeout(0.03,|| qb_model_output())
}
fn qb_model_output(){
    let policy=qb_broad_policy()
    let start=qb_date+"T15:00:00+08:00" let end=qb_date+"T15:30:00+08:00"
    if qb_case=="reschedule" {start=qb_date+"T16:00:00+08:00" end=qb_date+"T16:30:00+08:00"}
    if qb_case=="soft_empty" || qb_case=="hard_empty" || qb_case=="wrong_calendar" {
        policy.search_start=start policy.search_end=end
        policy.hard_windows=[{start:start end:end}] policy.preferred_windows=[{start:start end:end}]
    }
    if qb_case=="soft_empty" {policy.preferred_windows=[]}
    if qb_case=="intersection" {
        policy.hard_windows=[{start:"2030-06-12T15:00:00+08:00" end:"2030-06-12T17:00:00+08:00"}]
        policy.preferred_windows=[{start:"2030-06-12T16:00:00+08:00" end:"2030-06-12T17:00:00+08:00"}]
    }
    if qb_case=="soft_disjoint" {
        policy.hard_windows=[{start:start end:end}]
        policy.preferred_windows=[{start:"2030-06-12T16:00:00+08:00" end:"2030-06-12T16:30:00+08:00"}]
    }
    if qb_case=="hard_empty" {policy.hard_windows=[] policy.preferred_windows=[]}
    if qb_case=="limit" {
        policy.search_end="2030-06-17T00:00:00+08:00"
        policy.hard_windows[0].end=policy.search_end policy.preferred_windows[0].end=policy.search_end
    }
    if qb_case=="timezone" {policy.time_zone="UTC"}
    let zone="Asia/Shanghai"
    if qb_case=="source_timezone" {
        zone="UTC" start="2030-06-12T15:00:00Z" end="2030-06-12T15:30:00Z"
        policy.time_zone="UTC" policy.search_start="2030-06-12T00:00:00Z" policy.search_end="2030-06-16T00:00:00Z"
        policy.hard_windows=[{start:policy.search_start end:policy.search_end}] policy.preferred_windows=policy.hard_windows.to_json().parse_json()
    }
    if qb_case=="source_day" {
        start="2030-06-13T15:00:00+08:00" end="2030-06-13T15:30:00+08:00"
        policy.search_start="2030-06-13T00:00:00+08:00"
        policy.hard_windows[0].start=policy.search_start policy.preferred_windows[0].start=policy.search_start
    }
    let output={title:"合成约定" start:start end:end time_zone:zone location:"合成地点" question:""
        policy:policy duration_changed:false duration_quote:""}
    qb_models[qb_models.len()-1]({is_ok:true data:{output:output}})
    start_timeout(0.03,|| qb_check())
}
fn qb_check(){
    calendar_calendar_id="synthetic-calendar"
    calendar_permission="full_access"
    calendar_calendars=[{id:"synthetic-calendar" writable:true}]
    let link=calendar_links[0]
    if qb_case=="exact" || qb_case=="reschedule" || qb_case=="manual" {
        let bound_start="2030-06-12T15:00:00+08:00" let bound_end="2030-06-12T15:30:00+08:00"
        if qb_case=="reschedule" {bound_start="2030-06-13T16:00:00+08:00" bound_end="2030-06-13T16:30:00+08:00"}
        let a=calendar_iso_epoch(link.schedule_policy.search_start) let b=calendar_iso_epoch(link.schedule_policy.search_end)
        qb_checks.exact_policy_not_widened=a==calendar_iso_epoch(bound_start) && b==calendar_iso_epoch(bound_end)
        if qb_case=="manual" {
            ui.calendar_start.set_text("2030-06-12T16:00:00+08:00") ui.calendar_end.set_text("2030-06-12T16:30:00+08:00")
            calendar_edit()
            qb_checks.manual_outside_bound_rejected=calendar_draft_error(calendar_draft_payload())!=""
            calendar_check_conflicts()
            qb_checks.manual_no_conflict_query=qb_count("calendar.list")==0
            schedule_find_slots(false)
            let within=true
            for call in qb_calls {if call.service=="calendar.list" {
                if call.args.calendar_id!="synthetic-calendar" || calendar_iso_epoch(call.args.start)<calendar_iso_epoch(bound_start)
                    || calendar_iso_epoch(call.args.end)>calendar_iso_epoch(bound_end) {within=false}
            }}
            for slot in schedule_slots {
                if calendar_iso_epoch(slot.start)<calendar_iso_epoch(bound_start) || calendar_iso_epoch(slot.end)>calendar_iso_epoch(bound_end) {within=false}
            }
            qb_checks.manual_correction_query_slots_stay_in_bound=within qb_finish() return
        }
        schedule_find_slots(false)
        qb_checks.exact_one_verified_slot=schedule_slots.len()==1 && schedule_slots[0].start==core_utc_iso(calendar_iso_epoch(bound_start))
            && schedule_slots[0].end==core_utc_iso(calendar_iso_epoch(bound_end))
        qb_checks.exact_narrow_query=false
        for call in qb_calls {if call.service=="calendar.list" {
            qb_checks.exact_narrow_query=calendar_iso_epoch(call.args.start)==calendar_iso_epoch(bound_start)
                && calendar_iso_epoch(call.args.end)==calendar_iso_epoch(bound_end) && call.args.calendar_id=="synthetic-calendar"
        }}
        qb_finish() return
    }
    if qb_case=="flexible" || qb_case=="intersection" {
        schedule_find_slots(false)
        qb_checks.flexible_two_verified_slots=schedule_slots.len()==2 && qb_count("calendar.list")==1
        let within=true
        for slot in schedule_slots {
            if calendar_iso_epoch(slot.start)<calendar_iso_epoch("2030-06-12T15:00:00+08:00")
                || calendar_iso_epoch(slot.end)>calendar_iso_epoch("2030-06-12T17:00:00+08:00")
                || calendar_iso_epoch(slot.end)-calendar_iso_epoch(slot.start)!=1800 {within=false}
        }
        qb_checks.flexible_slots_within_user_window=within
        if qb_case=="intersection" {
            qb_checks.hard_soft_intersection=schedule_slots.len()==2 && schedule_slots[0].start=="2030-06-12T08:00:00Z"
                && schedule_slots[1].end=="2030-06-12T09:00:00Z"
        }
        qb_checks.flexible_query_narrow=false
        for call in qb_calls {if call.service=="calendar.list" {qb_checks.flexible_query_narrow=call.args.calendar_id=="synthetic-calendar"
            && calendar_iso_epoch(call.args.start)==calendar_iso_epoch("2030-06-12T15:00:00+08:00")
            && calendar_iso_epoch(call.args.end)==calendar_iso_epoch("2030-06-12T17:00:00+08:00")}}
        qb_finish() return
    }
    if qb_case=="source_day" {
        schedule_find_slots(false) calendar_check_conflicts()
        qb_checks.source_day_bound_preserved=link["requested_range"]!=nil && link.requested_range.start=="2030-06-11T16:00:00Z"
            && link.requested_range.end=="2030-06-12T16:00:00Z"
        qb_checks.model_changed_day_needs_clarification=calendar_error!="" && link["question"]!=nil && link.question!=""
        qb_checks.model_changed_day_no_query=qb_count("calendar.list")==0
    } else if qb_case=="soft_disjoint" {
        schedule_find_slots(false)
        qb_checks.disjoint_requires_decision=schedule_slots.len()==0 && calendar_error!=""
        let narrow=true
        for call in qb_calls {if call.service=="calendar.list" {
            if calendar_iso_epoch(call.args.start)<calendar_iso_epoch("2030-06-12T15:00:00+08:00")
                || calendar_iso_epoch(call.args.end)>calendar_iso_epoch("2030-06-12T15:30:00+08:00") {narrow=false}
        }}
        qb_checks.disjoint_no_query_outside_bound=narrow
    } else if qb_case=="soft_empty" {
        schedule_find_slots(false)
        qb_checks.soft_empty_asks_user=schedule_slots.len()==0 && calendar_error.search("是否只为这次")>=0
        schedule_find_slots(true)
        qb_checks.soft_relax_keeps_hard=schedule_slots.len()==1 && schedule_slots[0].start=="2030-06-12T07:00:00Z" && schedule_slots[0].end=="2030-06-12T07:30:00Z"
    } else if qb_case=="wrong_calendar" {
        schedule_find_slots(false)
        qb_checks.foreign_calendar_refused=schedule_slots.len()==0 && calendar_error.search("范围")>=0 && qb_count("calendar.list")==1
    } else {
        let error=schedule_policy_error(calendar_draft_payload(),link)
        schedule_find_slots(false) calendar_check_conflicts()
        qb_checks.invalid_policy_refused=error!="" && calendar_error!=""
        qb_checks.invalid_policy_no_query=qb_count("calendar.list")==0 && schedule_slots.len()==0
    }
    qb_finish()
}
fn qb_probe(){
    notification_enabled=false
    core_boot_goals() core_boot_activity() core_boot_memory() gm_boot() chat_boot() calendar_boot()
    gm_set_focus("synthetic-project","synthetic-owner") gm_set_accounts(["synthetic-account"])
    if cc_phase=="restart" {
        let base=fs.read("query-baseline.json").parse_json()
        qb_checks.restore_primary_bytes=fs.read("goals.json")==base.goals_bytes && fs.read("memory.json")==base.memory_bytes
            && fs.read("calendar-state.json")==base.calendar_bytes
        qb_checks.restore_one_goal_link=goals.len()==1 && calendar_links.len()==1
        qb_checks.restore_bound=calendar_links[0]["requested_range"]!=nil
            && calendar_links[0].requested_range.start==base.requested_range.start && calendar_links[0].requested_range.end==base.requested_range.end
            && calendar_links[0].requested_range.source_revision==base.requested_range.source_revision
        qb_checks.restore_source=calendar_links[0].source_id==base.source_id
        qb_checks.no_model_query_replay=qb_calls.len()==0 && qb_models.len()==0
        qb_finish() return
    }
    let si=chat_session_index(chat_selected_id)
    chat_sessions[si].focus_project=gm_project chat_sessions[si].focus_owner=gm_owner
    mail_scope_project=gm_project mail_scope_owner=gm_owner
    mail_account={id:"synthetic-account" address:"self@example.invalid"}
    if qb_case=="flexible" || qb_case=="intersection" {qb_source="2030-06-12可在当天15–17点任择30分钟，Asia/Shanghai，合成地点。"}
    if qb_case=="source_day" {qb_source="2030-06-12当天任选30分钟，Asia/Shanghai，合成地点。"}
    if qb_case=="limit" {qb_source="可在2030-06-12至2030-06-17任择30分钟，Asia/Shanghai，合成地点。"}
    mail_selected={id:"synthetic-query-message" message_id:"<synthetic-query@example.invalid>" subject:"合成约定"
        body:qb_source date:"2030-06-01T00:00:00Z" address:"sender@example.invalid"}
    mail_link_calendar()
    start_timeout(0.35,|| qb_wait_link())
}
start_timeout(0.1,|| qb_probe())
