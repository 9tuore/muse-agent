let mc_case="__CASE__"
let cc_phase="first"
let mc_checks={}
let mc_models=[]
let mc_inputs=[]
let mc_calls=[]
let mc_original="请起草邮件，主题为合成进度，正文为今天已完成资料核对。"
let mc_addr="self@example.invalid"
let mc_invalid_index=0
let mc_plain_index=0
let mc_plain_base=nil
let mc_invalid_addresses=["a@example.invalid,b@example.invalid","a@example.invalid;b@example.invalid","a@example.invalid；b@example.invalid",
    "a@example.invalid b@example.invalid","a@example.invalid\nb@example.invalid","a@@example.invalid","@example.invalid",
    "a@example","a@.invalid","<self@example.invalid>","self@example.invalid\t"]
fn chain_fixture_request(service,args,cb){
    mc_calls.push(service)
    if service=="mail.accounts" {cb({is_ok:true data:[]}) return}
    if service=="model.complete" {mc_inputs.push(args.to_json().parse_json()) mc_models.push(cb) return}
    cb({is_ok:false error:"Fixture forbids all external system services"})
}
fn mc_focus(){
    gm_set_focus("synthetic-project","synthetic-owner")
    let i=chat_session_index(chat_selected_id)
    chat_sessions[i].focus_project=gm_project chat_sessions[i].focus_owner=gm_owner
}
fn mc_send(text){ui.goal_input.set_text(text) send_chat()}
fn mc_output(to){return {to:to subject:"合成进度" body:"今天已完成资料核对。"}.to_json().parse_json()}
fn mc_seed(){
    mc_send(mc_original)
    mc_checks.initial_model_enqueued=mc_models.len()==1
    if mc_models.len()!=1 {return}
    mc_checks.initial_mail_schema=gm_has(mc_inputs[0].schema.properties,"to")
    mc_models[0]({is_ok:true data:{output:mc_output("")}})
    let reply=messages[messages.len()-1]
    mc_checks.initial_waiting=reply.state=="waiting_user" && reply.text.search("地址")>=0
    mc_checks.initial_meta=reply["clarification_action"]=="mail_compose"
        && reply["clarification_need"]=="recipient" && reply["clarification_input"]==mc_original
    mc_checks.initial_valid=chat_entry_valid(reply) && chat_reply_is_context(reply)
    mc_checks.initial_no_candidate=chat_sessions[chat_session_index(chat_selected_id)].proposals.len()==0
    mc_checks.initial_persisted=fs.read("chat-sessions.json").parse_json().sessions[chat_session_index(chat_selected_id)].messages[1].to_json()==reply.to_json()
}
fn mc_complete(){
    let before=mc_models.len()
    mc_send(mc_addr)
    mc_checks.followup_enqueued=mc_models.len()==before+1
    if mc_models.len()!=before+1 {return}
    let input=mc_inputs[mc_inputs.len()-1]
    mc_checks.followup_mail_schema=gm_has(input.schema.properties,"to") && !gm_has(input.schema.properties,"start")
    mc_checks.original_context=input.messages.len()>=3 && input.messages[0].content==mc_original
        && input.messages[1].role=="assistant"
        && input.messages[input.messages.len()-1].content.search(mc_addr+"\n以下仅为相关资料，") == 0
    mc_checks.synthetic_followup_input=input
    mc_models[mc_models.len()-1]({is_ok:true data:{output:mc_output(mc_addr)}})
    let cards=chat_sessions[chat_session_index(chat_selected_id)].proposals
    mc_checks.one_mail_candidate=cards.len()==1 && cards[0].action=="mail_compose" && cards[0].state=="candidate"
        && cards[0].payload.to==mc_addr && cards[0].payload.subject=="合成进度"
        && cards[0].payload.body=="今天已完成资料核对。"
    mc_checks.followup_success=messages[messages.len()-1].state=="success"
    mc_checks.candidate_persisted=fs.read("chat-sessions.json").parse_json().sessions[chat_session_index(chat_selected_id)].proposals.to_json()==cards.to_json()
}
fn mc_pending(){
    let prior=messages[1].to_json().parse_json()
    messages=[messages[0],prior,{role:"user" text:mc_addr state:"success" at:time_now() project:gm_project owner:gm_owner}].to_json().parse_json()
}
fn mc_invalid_next(){
    if mc_invalid_index>=mc_invalid_addresses.len() {
        messages=[messages[0],messages[1]].to_json().parse_json() mc_finish() return
    }
    let text=mc_invalid_addresses[mc_invalid_index]
    mc_checks["invalid_no_merge:"+text]=chat_mail_followup_message(text)==text
    mc_invalid_index=mc_invalid_index+1
    start_timeout(0.03,|| mc_invalid_next())
}
fn mc_plain_next(){
    if mc_plain_index>=5 {
        messages=[messages[0],mc_plain_base].to_json().parse_json() mc_finish() return
    }
    let state="success"
    if mc_plain_index==1 || mc_plain_index==2 {state="waiting_user"}
    if mc_plain_index==3 {state="error"}
    if mc_plain_index==4 {state="cancelled"}
    let prior={role:"assistant" text:"合成普通回复" state:state at:time_now() project:gm_project owner:gm_owner}
    if mc_plain_index==2 {prior.clarification_action="mail_compose" prior.clarification_input=mc_original}
    messages[1]=prior
    mc_checks["plain_meta_no_merge:"+mc_plain_index]=chat_mail_followup_message(mc_addr)==mc_addr
    mc_plain_index=mc_plain_index+1
    start_timeout(0.03,|| mc_plain_next())
}
fn mc_guard(){
    mc_pending()
    let base=messages[1].to_json().parse_json()
    let combined=mc_original+"\n用户补充：收件人 "+mc_addr
    mc_checks.valid_merge=chat_mail_followup_message(mc_addr)==combined
    if mc_case=="scope" {
        gm_set_focus("synthetic-other-project","synthetic-owner")
        mc_checks.other_project_no_merge=chat_mail_followup_message(mc_addr)==mc_addr
        mc_checks.other_project_no_history=chat_model_history(messages).turns.len()==0
        gm_set_focus("synthetic-project","synthetic-other-owner")
        mc_checks.other_owner_no_merge=chat_mail_followup_message(mc_addr)==mc_addr
        mc_checks.other_owner_no_history=chat_model_history(messages).turns.len()==0
    }
    if mc_case=="refs" {
        messages[1].memory_refs=[{id:"synthetic-missing" revision:1 account:"local" source_ids:[]}]
        mc_checks.missing_ref_no_merge=chat_mail_followup_message(mc_addr)==mc_addr
        mc_checks.missing_ref_no_history=chat_model_history(messages).turns.len()==0
        mc_checks.seed_expiry=gm_save("合成已过期资料","fact","synthetic-subject","source",chat_selected_id,gm_project,gm_owner,"local")
        let claims=memory.to_json().parse_json()
        claims[0].document.payload.valid_until="2020-01-01T00:00:00Z"
        mc_checks.commit_expiry=core_commit_memory(claims,memory_sources,memory_forget)
        let doc=memory[0].document
        messages[1]=base.to_json().parse_json()
        messages[1].memory_refs=[{id:doc.id revision:doc.revision account:"local" source_ids:doc.payload.source_ids}]
        mc_checks.expired_ref_no_merge=chat_mail_followup_message(mc_addr)==mc_addr
        mc_checks.expired_ref_no_history=chat_model_history(messages).turns.len()==0
    }
    if mc_case=="forgot" {
        mc_checks.seed_forget=gm_save(mc_original,"fact","synthetic-subject","source",chat_selected_id,gm_project,gm_owner,"local")
        let id=memory[0].document.id
        mc_checks.forget_saved=gm_forget(id,"local")
        messages[1]=base.to_json().parse_json()
        mc_checks.original_retired=gm_retired_text(mc_original,"local")
        mc_checks.forgot_no_merge=chat_mail_followup_message(mc_addr)==mc_addr
        mc_checks.forgot_no_history=chat_model_history(messages).turns.len()==0
    }
    if mc_case=="topic" {
        for text in ["为什么要收件地址","请安排2026年12月15日15:00到16:00开会","请整理目标资料：合成资料","不要继续","取消","这是另外的话题"] {
            mc_checks["topic_no_merge:"+text]=chat_mail_followup_message(text)==text
        }
        mc_checks.mail_waiter_not_calendar=chat_calendar_followup_message("2026-12-15T15:00:00+08:00")=="2026-12-15T15:00:00+08:00"
        messages=[messages[0],base,{role:"assistant" text:"较新的普通回复" state:"success" at:time_now()},messages[2]].to_json().parse_json()
        mc_checks.not_latest_no_merge=chat_mail_followup_message(mc_addr)==mc_addr
    }
    if mc_case=="bounds" {
        messages[1].clarification_input=__BOUND_INPUT__
        mc_checks.bound_2400=chat_mail_followup_message(mc_addr).len()==2400
        messages[1].clarification_input=__BOUND_OVER_INPUT__
        mc_checks.bound_2401_no_merge=chat_mail_followup_message(mc_addr)==mc_addr
    }
    messages=[messages[0],base].to_json().parse_json()
}
fn mc_metadata(){
    let base=messages[1].to_json().parse_json()
    for i in 12 {
        let bad=base.to_json().parse_json()
        if i==0 {bad.role="user"}
        if i==1 {bad.state="error"}
        if i==2 {bad.clarification_need=nil}
        if i==3 {bad.clarification_need="body"}
        if i==4 {bad.clarification_action=nil}
        if i==5 {bad.clarification_input=nil}
        if i==6 {bad.clarification_input=3}
        if i==7 {bad.clarification_input=""}
        if i==8 {bad.clarification_input=__OVERLONG_INPUT__}
        if i==9 {bad.clarification_input=[]}
        if i==10 {bad.state="cancelled"}
        if i==11 {bad.clarification_action="goal_plan"}
        mc_checks["invalid_meta:"+i]=!chat_entry_valid(bad)
    }
    mc_checks.error_not_context=!chat_reply_is_context({role:"assistant" text:"旧失败回复" state:"error" at:1})
    let saved=fs.read("chat-sessions.json").parse_json()
    saved.sessions[chat_session_index(chat_selected_id)].messages[1].clarification_need=nil
    let invalid=saved.to_json()
    fs.write("chat-sessions.json",invalid) fs.write("chat-sessions.backup.json",invalid)
    mc_checks.invalid_store_rejected=!chat_state_valid(saved)
}
fn mc_cancel(){
    let before=mc_models.len()
    mc_send("取消")
    mc_checks.cancel_no_model=mc_models.len()==before && messages[messages.len()-1].state=="cancelled"
    mc_send(mc_addr)
    mc_checks.after_cancel_generic=gm_has(mc_inputs[mc_inputs.len()-1].schema.properties,"reply")
    mc_models[mc_models.len()-1]({is_ok:true data:{output:{reply:"请说明新的请求。"}}})
    mc_checks.after_cancel_no_candidate=chat_sessions[chat_session_index(chat_selected_id)].proposals.len()==0
}
fn mc_finish(){
    let forbidden=false
    for call in mc_calls {if call!="model.complete" && call!="mail.accounts" {forbidden=true}}
    mc_checks.no_system_requests=!forbidden
    mc_checks.no_goal_run_action=goals.len()==0 && runs.len()==0 && actions.len()==0
    if mc_case!="metadata" {mc_checks.saved_schema_valid=chat_state_valid(fs.read("chat-sessions.json").parse_json())}
    fs.write("probe.json",mc_checks.to_json())
}
fn mc_probe(){
    core_boot_goals() core_boot_activity() core_boot_memory() gm_boot()
    let before="" if fs.exists("chat-sessions.json") {before=fs.read("chat-sessions.json")}
    let ready=chat_boot()
    if cc_phase=="restart" {
        if mc_case=="metadata" {
            mc_checks.malformed_restart_rejected=!ready && !chat_ready
            mc_checks.malformed_restart_preserved=fs.read("chat-sessions.json")==before
            mc_checks.no_model_replay=mc_models.len()==0 mc_finish() return
        }
        mc_checks.restore_ready=ready && chat_ready
        mc_checks.restore_unchanged=fs.read("chat-sessions.json")==before
        mc_checks.no_model_replay=mc_models.len()==0
        if mc_case=="waiting_restore" {
            mc_checks.waiter_restored=messages.len()==2 && messages[1]["clarification_need"]=="recipient"
            mc_complete()
        } else {
            mc_checks.candidate_restored=chat_sessions[chat_session_index(chat_selected_id)].proposals.len()==1
                && chat_sessions[chat_session_index(chat_selected_id)].proposals[0].action=="mail_compose"
        }
        mc_finish() return
    }
    mc_focus() mc_checks.boot_ready=ready && chat_ready && gm_ready
    mc_seed()
    if mc_case=="invalid_address" {mc_pending() start_timeout(0.03,|| mc_invalid_next()) return}
    if mc_case=="plain_metadata_guard" {mc_pending() mc_plain_base=messages[1].to_json().parse_json() start_timeout(0.03,|| mc_plain_next()) return}
    if mc_case=="flow" {mc_complete()}
    if mc_case=="scope" || mc_case=="refs" || mc_case=="forgot" || mc_case=="invalid_address" || mc_case=="topic" || mc_case=="bounds" {mc_guard()}
    if mc_case=="metadata" {mc_metadata()}
    if mc_case=="cancel" {mc_cancel()}
    mc_finish()
}
start_timeout(0.1,|| mc_probe())
