// Real production functions and jailed persistence; synthetic Host/model only.
let auto_checks = {} let auto_calls = [] let auto_models = [] let auto_event = nil
let auto_waits = 0
let auto_variant = "__VARIANT__"
fn incoming_fixture_request(service,args,cb){
    auto_calls.push({service: service args: args})
    if service == "mail.accounts" { cb({is_ok: true data: [{id: "synthetic-account" address: "self@example.invalid"}]}) return }
    if service == "model.complete" { auto_models.push(cb) return }
    if service == "calendar.status" {
        if auto_variant == "revoke_before_dispatch" { calendar_auto_pause() }
        cb({is_ok: true data: {permission: "full_access" calendars: calendar_calendars.to_json().parse_json()}}) return
    }
    if service == "calendar.list" {
        let events = []
        if auto_variant == "conflict" { events = [{id: "busy-event" calendar_id: args.calendar_id version: "busy-v1" start: args.start end: args.end availability: 0}] }
        if auto_variant == "revoke_after_query" { calendar_auto_pause() }
        if auto_variant == "edited_after_query" { ui.calendar_title.set_text("用户修改后的标题") }
        cb({is_ok: true data: {events: events truncated: auto_variant == "truncated"}}) return
    }
    if service == "calendar.create" {
        auto_event = {id: "synthetic-created-event" calendar_id: args.calendar_id title: args.title
            start: args.start end: args.end time_zone: args.time_zone location: args.location version: "synthetic-v1"}
        cb({is_ok: true data: {event_id: auto_event.id version: auto_event.version}}) return
    }
    if service == "calendar.get" { cb({is_ok: true data: {found: auto_event != nil event: auto_event}}) return }
    auto_checks.no_unexpected_transport = false
}
fn auto_count(service){ let n = 0 for c in auto_calls { if c.service == service { n = n + 1 } } return n }
fn auto_seed(){
    fixture_seed() chat_boot() gm_boot() gm_set_focus("合成项目","个人") gm_set_accounts(["synthetic-account"])
    mail_account = {id: "synthetic-account" address: "self@example.invalid"}
    mail_accounts = [mail_account] calendar_calendars[0].title = "测试日历"
    auto_checks.no_unexpected_transport = true
    calendar_auto_allow()
    auto_checks.grant_is_durable = fs.read("mail-watch.json").parse_json().calendar_auto.grant_id == calendar_auto.grant_id && calendar_auto.enabled
    let grant = calendar_auto.to_json().parse_json()
    let alert = {key: "synthetic-account:synthetic-auto-mail" account_id: "synthetic-account" message_id: "synthetic-auto-mail"
        subject: "MUSE-R2-AUTO-FIXTURE" status: "new" intent: "" received_at: time_now()+1
        source_body: "请于2030年6月12日09:00至10:00（Asia/Shanghai）在合成地点见面。"
        source_message: {id: "synthetic-auto-mail" subject: "MUSE-R2-AUTO-FIXTURE" address: "self@example.invalid"
            body: "请于2030年6月12日09:00至10:00（Asia/Shanghai）在合成地点见面。" date: "2030-06-01T00:00:00Z"}}
    auto_checks.new_authorized_mail_has_scope = calendar_auto_scope(alert) != nil
    let old = alert.to_json().parse_json() old.received_at = grant.granted_at-1
    auto_checks.old_inbox_is_not_replayed = calendar_auto_scope(old) == nil
    old = alert.to_json().parse_json() old.received_at = nil
    auto_checks.legacy_alert_missing_time_is_not_replayed = calendar_auto_scope(old) == nil
    old = alert.to_json().parse_json() old.account_id = "other-account"
    auto_checks.other_account_refused = calendar_auto_scope(old) == nil
    old = alert.to_json().parse_json() old.source_body = "项目：老师项目；归属：老师；安排见面。"
    auto_checks.other_project_not_silently_inherited = calendar_auto_scope(old) == nil
    auto_checks.malformed_grant_refused = !calendar_auto_valid({enabled: true})
    calendar_auto_pause()
    auto_checks.revoked_grant_refused = calendar_auto_scope(alert) == nil
    calendar_auto = grant mail_watch.calendar_auto = grant
    mail_watch.alerts = [alert]
    page = "Chat" mail_analysis_pump()
    start_timeout(0.3,|| auto_analysis())
}
fn auto_analysis(){
    auto_checks.model_analysis_queued = auto_models.len() == 1
    if auto_models.len() != 1 { auto_finish() return }
    auto_models[0]({is_ok: true data: {output: {kind: "appointment" summary: "见面安排" question: ""}}})
    start_timeout(0.8,|| auto_candidate())
}
fn auto_candidate(){
    if auto_models.len() < 2 && auto_waits < 35 { auto_waits = auto_waits+1 start_timeout(0.1,|| auto_candidate()) return }
    auto_checks.candidate_model_queued = auto_models.len() == 2 && calendar_links.len() == 1
    if auto_models.len() != 2 { auto_finish() return }
    let question = "" if auto_variant == "question" { question = "请补充缺少的安排信息。" }
    auto_models[1]({is_ok: true data: {output: {title: "MUSE-R2-AUTO-FIXTURE" start: "2030-06-12T09:00:00+08:00"
        end: "2030-06-12T10:00:00+08:00" time_zone: "Asia/Shanghai" location: "合成地点" question: question
        duration_changed: false duration_quote: "" policy: {search_start: "2030-06-12T09:00:00+08:00" search_end: "2030-06-12T10:00:00+08:00"
            time_zone: "Asia/Shanghai" hard_windows: [{start: "2030-06-12T09:00:00+08:00" end: "2030-06-12T10:00:00+08:00"}]
            preferred_windows: [{start: "2030-06-12T09:00:00+08:00" end: "2030-06-12T10:00:00+08:00"}] reason: "精确来信时间"}}}})
    auto_waits = 0
    start_timeout(0.1,|| auto_settled())
}
fn auto_settled(){
    if auto_variant != "flow" && auto_waits >= 15 { auto_finish() return }
    if (calendar_links.len() == 0 || calendar_links[0].status != "verified") && auto_waits < 60 {
        auto_waits = auto_waits+1 start_timeout(0.1,|| auto_settled()) return
    }
    auto_finish()
}
fn auto_finish(){
    let flow = auto_variant == "flow"
    if flow {
        auto_checks.exactly_one_calendar_create = auto_count("calendar.create") == 1
        auto_checks.preconditions_rechecked = auto_count("calendar.status") == 1 && auto_count("calendar.list") == 2
        auto_checks.independent_get = auto_count("calendar.get") == 1
        auto_checks.durable_result_and_source = calendar_links.len() == 1 && calendar_links[0].status == "verified" && actions.len() == 1
            && actions[0].status == "verified" && fs.exists(goals[0].result_path)
    } else {
        auto_checks.variant_never_mutates = auto_count("calendar.create") == 0 && actions.len() == 0 && auto_event == nil
        auto_checks.variant_keeps_source_and_candidate = calendar_links.len() == 1 && calendar_links[0].event_id == ""
            && calendar_links[0].status != "verified" && goals.len() == 1
    }
    auto_checks.no_automatic_mail_update_or_delete = auto_count("mail.send") == 0 && auto_count("calendar.update") == 0 && auto_count("calendar.delete") == 0
    if calendar_links.len() == 1 {
        let id = calendar_links[0].goal_id
        let created = auto_count("calendar.create")
        calendar_auto_prepare(id)
        auto_checks.existing_attempt_is_not_replayed = auto_count("calendar.create") == created
        auto_checks.manual_context_remains_manual = calendar_auto_context_current({operation: "update" goal_id: id})
        auto_checks.auto_update_refused = !calendar_auto_context_current({auto_grant: calendar_auto.grant_id operation: "update" goal_id: id})
        calendar_auto_pause()
        auto_checks.auto_context_revoked = !calendar_auto_context_current({auto_grant: calendar_auto.grant_id operation: "create" goal_id: id})
    }
    fs.write("probe.json",auto_checks.to_json())
    fs.write("auto-details.json",{calls: auto_calls error: calendar_error links: calendar_links actions: actions goals: goals}.to_json())
}
start_timeout(0.1,|| auto_seed())
