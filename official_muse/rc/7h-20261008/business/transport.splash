// DRY RUN ONLY. Nothing here calls the Host request object.
let be_checks = {} let be_calls = [] let be_models = [] let be_model_inputs = []
let be_event = nil let be_sent = [] let be_forbidden = [] let be_goal = ""
let be_hold_get = false let be_gets = [] let be_hold_list = false let be_lists = []
let be_hold_send = false let be_send_callbacks = [] let be_external_changed = false
let be_wait_count = 0 let be_phase = "boot"
let be_fail_on_get = "" let be_fail_on_send = ""
let be_fail_on_written_get = ""
let be_fail_on_calendar_write = "" let be_calendar_unknown = false
let be_test_id = "MUSE-R2-7H-ISOLATED"
fn be_clone(value){return value.to_json().parse_json()}
fn be_count(service){let count=0 for call in be_calls {if call.service==service {count=count+1}} return count}
fn business_request(service,args,cb){
    be_calls.push({service: service payload: be_clone(args)})
    if service == "mail.accounts" {cb({is_ok: true data: [{id: "test-account" address: "self@example.invalid"}]}) return}
    if service == "model.complete" {be_models.push(cb) be_model_inputs.push(be_clone(args)) return}
    if service == "calendar.status" {cb({is_ok: true data: {permission: "full_access" calendars: [{id: "test-calendar" title: "Test" writable: true}]}}) return}
    if service == "calendar.list" {
        if be_hold_list {be_lists.push(cb) return}
        let rows=[]
        if be_event != nil && calendar_iso_epoch(be_event.start)<calendar_iso_epoch(args.end)
            && calendar_iso_epoch(be_event.end)>calendar_iso_epoch(args.start) {rows.push(be_clone(be_event))}
        cb({is_ok: true data: {events: rows truncated: false}}) return
    }
    if service == "calendar.get" {
        if be_hold_get {be_gets.push(cb) return}
        if be_event==nil && be_fail_on_get!="" {be_fault_path=be_fail_on_get}
        if be_event!=nil && be_count("calendar.update")==1 && be_fail_on_written_get!="" {be_fault_path=be_fail_on_written_get}
        cb({is_ok: true data: {found: be_event != nil event: be_clone(be_event)}}) return
    }
    if service == "calendar.create" {
        be_event={id: "test-event" calendar_id: args.calendar_id version: "v1" title: args.title
            start: args.start end: args.end time_zone: args.time_zone location: args.location
            all_day: false availability: 0 recurring: false notes: "Keep synthetic metadata"}
        cb({is_ok: true data: {event_id: be_event.id version: be_event.version}}) return
    }
    if service == "calendar.update" {
        if be_event == nil || be_event.id != args.event_id || be_event.version != args.expected_version {
            cb({is_ok: false error: "Synthetic compare-and-swap version mismatch"}) return
        }
        be_event.start=args.changes.start be_event.end=args.changes.end
        if be_event.version=="v2" {be_event.version="v3"} else {be_event.version="v2"}
        cb({is_ok: true data: {event_id: be_event.id version: be_event.version}}) return
    }
    if service == "calendar.delete" {
        if be_event == nil || be_event.id != args.event_id || be_event.version != args.expected_version {
            cb({is_ok: false error: "Synthetic compare-and-swap version mismatch"}) return
        }
        be_event=nil
        if be_fail_on_calendar_write!="" {be_fault_path=be_fail_on_calendar_write}
        if be_calendar_unknown {cb({is_ok: false error: "Synthetic response lost after server commit"}) return}
        cb({is_ok: true data: {deleted: true}}) return
    }
    if service == "mail.send" {
        if be_hold_send {be_send_callbacks.push(cb) return}
        let item=be_clone(args) item.id="recipient-copy-"+be_sent.len()
        be_sent.push(item)
        fs.write("synthetic-recipient.json",be_sent.to_json())
        if be_fail_on_send!="" {be_fault_path=be_fail_on_send}
        cb({is_ok: true data: {accepted: true}}) return
    }
    if service == "mail.message" {
        if args.account=="test-account" && args.message=="recipient-copy-0" && be_sent.len()==1 {
            cb({is_ok: true data: be_clone(be_sent[0])}) return
        }
    }
    be_forbidden.push(service)
    cb({is_ok: false error: "Synthetic test denies unexpected service"})
}
fn be_finish(){
    be_checks.forbidden_calls=be_forbidden
    be_checks.observation={phase: be_phase goal: be_goal goals: goals.len() runs: runs.len() actions: actions.len()
        calendar_error: calendar_error core_error: core_error mail_error: mail_error
        calendar_pending: calendar_pending mail_pending: mail_sending
        calls: be_calls memory_count: memory.len()}
    fs.write("probe.json",be_checks.to_json())
}
fn be_until(ready,next,label,tries){
    be_phase=label
    fs.write("progress.json",{phase: label tries: tries calendar_error: calendar_error
        mail_error: mail_error gm_error: gm_error core_error: core_error checks: be_checks}.to_json())
    if ready() {start_timeout(0.03,next) return}
    if tries>=120 {be_checks["ready_"+label]=false be_finish() return}
    start_timeout(0.05,|| be_until(ready,next,label,tries+1))
}
fn be_boot(){
    notification_enabled=false core_boot_goals() core_boot_activity() core_boot_memory()
    gm_boot() chat_boot()
    calendar_permission="full_access" calendar_calendar_id="test-calendar"
    calendar_calendars=[{id: "test-calendar" title: "Test" writable: true}]
    mail_accounts=[{id: "test-account" address: "self@example.invalid"}] mail_account=mail_accounts[0]
    gm_set_accounts(["test-account"]) gm_set_focus("合成验收项目","本人")
    mail_scope_project="合成验收项目" mail_scope_owner="本人"
    mail_analysis.enabled=false mail_analysis.permitted=false
}
fn be_message(id,start,end,parent){
    return {id: id sender: "Synthetic sender" address: "sender@example.invalid" subject: be_test_id
        date: "2026-10-08T12:00:00Z" message_id: "<"+id+"@example.invalid>" in_reply_to: parent
        body: "项目：合成验收项目；归属：本人；请于"+start+"至"+end+"（Asia/Shanghai）在合成会议室见面。"}
}
fn be_output(start,end){
    return {title: be_test_id start: start end: end time_zone: "Asia/Shanghai" location: "合成会议室"
        question: "" duration_changed: false duration_quote: ""
        policy: {search_start: start search_end: end time_zone: "Asia/Shanghai" reason: "Synthetic exact authorized range"
            hard_windows: [{start: start end: end}] preferred_windows: [{start: start end: end}]}}
}
