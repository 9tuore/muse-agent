":"Button","r":[790,546,241,58],"w":0,"window_id":"main_window","enabled":true,"t":"已安装"},{"i":"2","ty":"MpModuleView","r":[84,134,990,479],"w":0,"window_id":"main_window","enabled":true},{"i":"card","ty":"Splash","r":[84,134,990,479],"w":0,"window_id":"main_window","enabled":true,"t":"// Dedicated real HostService diagnostic. No watcher, model, CRUD or secrets.\nlet probe_pending = false\nlet probe_count = 0\nfn probe(method){\n    if probe_pending { return }\n    probe_pending = true\n    probe_count = probe_count + 1\n    let number = probe_count\n    let record = {method: method dispatch_number: number dispatched_at: time_now() callback: false}\n    fs.write(\"calendar-permission-probe.json\",record.to_json())\n    ui.probe_status.set_text(\"已实际分发：\"+method+\"；等待宿主回调。\")\n    host.request(method,{},fn(answer){\n        probe_pending = false\n        let permission = \"\"\n        let error = \"\"\n        if answer.is_ok && answer.data != nil && answer.data.permission != nil { permission = answer.data.permission }\n        if !answer.is_ok { error = answer.error }\n        fs.write(\"calendar-permission-probe.json\",{method: method dispatch_number: number\n            dispatched_at: record.dispatched_at callback: true completed_at: time_now()\n            is_ok: answer.is_ok permission: permission error: error}.to_json())\n        ui.probe_status.set_text(\"宿主回调：\"+method+\"；实际权限：\"+permission+\"；错误：\"+error)\n    })\n}\nSolidView{width: Fill height: Fill flow: Down padding: 24 spacing: 16 draw_bg.color: #x222326\n    Label{width: Fill text: \"日历授权最小诊断（不执行日历写入）\" draw_text.color: #xe9eaee draw_text.wrap: Words}\n    probe_status := Label{width: Fill text: \"尚未调用宿主。\" draw_text.color: #xe9eaee draw_text.wrap: Words}\n    ButtonFlat{text: \"只读：查询当前日历权限\" on_click: ||probe(\"calendar.status\")}\n    Label{width: Fill text: \"下一按钮仅供本人操作：会请求系统弹窗。是否授权由本人选择。\" draw_text.color: #x979ca5 draw_text.wrap: Words}\n    ButtonFlat{text: \"本人点击：请求完整日历访问\" on_click: ||probe(\"calendar.request_access\")}\n}\n"},{"i":"1","ty":"View","r":[84,134,990,479],"w":0,"window_id":"main_window","enabled":true},{"i":"-","ty":"Label","r":[112,162,935,20],"w":0,"window_id":"main_window","enabled":true,"t":"日历授权最小诊断（不执行日历写入）"},{"i":"probe_status","ty":"Label","r":[112,205,935,20],"w":0,"window_id":"main_window","enabled":true,"t":"已实际分发：calendar.request_access；等待宿主回调。"},{"i":"1","ty":"Button","r":[108,248,161,20],"w":0,"window_id":"main_window","enabled":true,"t":"只读：查询当前日历权限"},{"i":"2","ty":"Label","r":[112,290,935,20],"w":0,"window_id":"main_window","enabled":true,"t":"下一按钮仅供本人操作：会请求系统弹窗。是否授权由本人选择。"},{"i":"3","ty":"Button","r":[108,333,187,20],"w":0,"window_id":"main_window","enabled":true,"t":"本人点击：请求完整日历访问"},{"i":"shell_overlay","ty":"View","r":[0,28,1400,785],"w":0,"window_id":"main_window","enabled":true},{"i":"desktop_shelf","ty":"DesktopShelf","r":[946,792,4,4],"w":0,"window_id":"main_window","enabled":true}]}